;;;;
;;;; Write src/nlib.lisp: the package BATTEN.NLIB, which exports the port --
;;;; every ported NLib routine that is not file-private, under its Lisp name
;;;; (PORTING.md's rule: N_CrvEval is crv-eval), and NLib's constants -- for a
;;;; program that wants NLib's own interface rather than the readable API.
;;;; The symbols are BATTEN's own; this package only re-exports them.
;;;;
;;;; Run in a Lisp with Batten loaded, from the checkout:
;;;;   (load "tools/gen-nlib-package.lisp")

(in-package :cl-user)

(let* ((root (asdf:system-source-directory "batten"))
       (manifest (with-open-file (in (merge-pathnames "tools/manifest.sexp" root)) (read in)))
       (routines (sort (remove-duplicates
                        (mapcan #'(lambda (entry)
                                    (let ((symbol (find-symbol (string-upcase (getf entry :lisp)) :batten)))
                                      (when (and (member (getf entry :status) '(:done :core))
                                                 (not (getf entry :static))
                                                 symbol (fboundp symbol))
                                        (list (string-downcase (symbol-name symbol))))))
                                manifest)
                        :test #'string=)
                       #'string<))
       (constants (let (names)
                    (do-symbols (s :batten (sort names #'string<))
                      (let ((name (symbol-name s)))
                        (when (and (eq (symbol-package s) (find-package :batten))
                                   (> (length name) 2)
                                   (char= #\+ (char name 0) (char name (1- (length name))))
                                   (constantp s))
                          (pushnew (string-downcase name) names :test #'string=))))))
       (names (append routines constants)))
  (with-open-file (out (merge-pathnames "src/nlib.lisp" root) :direction :output :if-exists :supersede)
    (format out ";;;; SPDX-FileCopyrightText: Copyright (c) 2026 Genworks International
;;;; SPDX-License-Identifier: Apache-2.0
;;;;
;;;; Generated by tools/gen-nlib-package.lisp from tools/manifest.sexp; do not
;;;; edit.  ~d routines and ~d constants.

(defpackage :batten.nlib
  (:use)
  (:documentation \"NLib's own interface: every ported NLib routine that is
not file-private, under its Lisp name (N_CrvEval is crv-eval; PORTING.md
gives the rule and the signature mapping), and NLib's constants.  Each is
bit-identical with the C routine named on its docstring's last line.  The
symbols are BATTEN's; the readable API is BATTEN's own exports.\")
  (:import-from :batten~{~%   #:~a~})
  (:export~{~%   #:~a~}))~%"
            (length routines) (length constants) names names))
  (format t "~&wrote src/nlib.lisp: ~d routines, ~d constants~%" (length routines) (length constants)))
