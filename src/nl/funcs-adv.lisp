                                (let* ((alf (/ (- (aref sk bs) (aref tk i)) (- (aref sk as) (aref tk i))))
                                       (oma (- 1d0 alf)))
                                  (declare (type double-float alf oma))
                                  (%combine-2-c-pt-rows alf hw i oma hw (1- i) hw i)))
                              (when (>= j lbz)
                                (if (<= (- j k) (+ (- kind pq) rem))
                                    (let* ((gam (/ (- (aref sk bs) (aref tk (- j k))) den))
                                           (omg (- 1d0 gam)))
                                      (declare (type double-float gam omg))
                                      (%combine-2-c-pt-rows gam fgw l omg fgw (1+ l) fgw l))
                                    (%combine-2-c-pt-rows bet fgw l omb fgw (1+ l) fgw l)))
                              (incf i)
                              (decf j)
                              (decf l)))
                          (decf first)
                          (incf last)))))
                  ;; load knots and control points
                  (when (and (/= ar p) (/= as q))
                    (dotimes (i (- pq rem))
                      (setf (aref tk kind) (aref sk as))
                      (incf kind)))
                  (do ((i lbz (1+ i))) ((> i rbz))
                    (declare (type fixnum i))
                    (%copy-c-pt-row fgw i hw cind)
                    (incf cind))
                  ;; initialize for the next pass
                  (if (and (< br mr) (< bs ms))
                      (progn
                        (dotimes (i rr)
                          (setf (aref fb i) (aref fn i)))
                        (do ((i rr (1+ i))) ((> i p))
                          (declare (type fixnum i))
                          (setf (aref fb i) (aref f (+ (- br p) i))))
                        (dotimes (j rs)
                          (%copy-c-pt-row gnw j gbw j))
                        (do ((j rs (1+ j))) ((> j q))
                          (declare (type fixnum j))
                          (%copy-c-pt-row gw (+ (- bs q) j) gbw j))
                        (setf ar br)
                        (incf br)
                        (setf rem (- pq mi))
                        (setf as bs)
                        (incf bs))
                      ;; the end knots
                      (do ((i 0 (1+ i))) ((> i pq))
                        (declare (type fixnum i))
                        (setf (aref tk kind) (aref sk bs))
                        (incf kind))))))
            ;; compact the output curve
            (if (< cind (1+ nh))
                (let ((qw (make-cpoint-array cind)))
                  (declare (type cpoint-array qw))
                  (dotimes (i cind)
                    (%copy-c-pt-row hw i qw i))
                  (crv-compress (%make-curve pq (subseq tk 0 kind) qw)))
                (%make-curve pq tk hw))))))))

(defun crv-func-sum-diff-crv-func (cfn-p cfn-q opr cmp)
  "The sum (OPR +plus+) or difference (+minus+) of curve functions CFN-P and
CFN-Q, fresh.  With CMP +yes+ the two are taken to be compatible as they are
(same degree and knots: the control values are combined over CFN-Q's count
and the knots copied from CFN-P); otherwise copies of them are degree elevated
to the higher degree and refined to common knots first, the knots of the one
with the shorter domain being rescaled, in place in its copy, onto the other's
(GET-COMPATIBLE-KNOT-ARRAY-MULT).  Signals :cal-err for any other OPR, and
the errors of the elevation and refinement.
NLib: N_CrvFuncSumDiffCrvFunc."
  (declare (type cfun cfn-p cfn-q) (type fixnum opr cmp))
  (let ((n 0) (m 0) (p 0) (q 0)
        (fp (cfun-vals cfn-p)) (fq (cfun-vals cfn-q))
        (up (cfun-knots cfn-p)))
    (declare (type fixnum n m p q) (type real-vector fp fq up))
    (if (= cmp +yes+)
        ;; compatible functions
        (setf p (cfun-degree cfn-p)
              q (cfun-degree cfn-q)
              n (1- (length fq))
              m (1- (length (cfun-knots cfn-q))))
        ;; make them compatible, on copies
        (let ((cfn-pw (crv-func-copy cfn-p))
              (cfn-qw (crv-func-copy cfn-q)))
          (flet ((data-p ()
                   (setf n (1- (length (cfun-vals cfn-pw)))
                         fp (cfun-vals cfn-pw)
                         p (cfun-degree cfn-pw)
                         m (1- (length (cfun-knots cfn-pw)))
                         up (cfun-knots cfn-pw)))
                 (data-q ()
                   (setf n (1- (length (cfun-vals cfn-qw)))
                         fq (cfun-vals cfn-qw)
                         q (cfun-degree cfn-qw)
                         m (1- (length (cfun-knots cfn-qw))))))
            (data-p)
            (data-q)
            ;; degree elevate
            (when (/= p q)
              (if (< p q)
                  (progn
                    (setf cfn-pw (crv-func-degree-elevate cfn-pw (- q p)))
                    (data-p))
                  (progn
                    (setf cfn-qw (crv-func-degree-elevate cfn-qw (- p q)))
                    (data-q))))
            ;; refine
            (multiple-value-bind (kxp kxq)
                (get-compatible-knot-array-mult (cfun-knots cfn-pw) (cfun-knots cfn-qw) p)
              (declare (type real-vector kxp kxq))
              (when (>= (1- (length kxp)) 0)
                (setf cfn-pw (crv-func-refine cfn-pw kxp))
                (data-p))
              (when (>= (1- (length kxq)) 0)
                (setf cfn-qw (crv-func-refine cfn-qw kxq))
                (data-q))))))
    (let ((fr (make-real-vector (1+ n)))
          (ur (make-real-vector (1+ m))))
      (declare (type real-vector fr ur))
      (cond ((= opr +plus+)
             (dotimes (i (1+ n))
               (setf (aref fr i) (+ (aref fp i) (aref fq i)))))
            ((= opr +minus+)
             (dotimes (i (1+ n))
               (setf (aref fr i) (- (aref fp i) (aref fq i)))))
            (t (nurbs-error :cal-err 'crv-func-sum-diff-crv-func)))
      (dotimes (i (1+ m))
        (setf (aref ur i) (aref up i)))
      (%make-cfun p ur fr))))
