                (%row-c-pt aw j cb)
                (combine-2-c-pts 1.0d0 ca (* du one-3) cb cc)
                (%c-pt-net cc uw 1 j)))
            (let ((aw (curve-cpoints (svref cur-aa 3))))
              (declare (type cpoint-array aw))
              (setf m (curve-n (svref cur-aa 3)))
              (dotimes (j (1+ m))
                (%net-c-pt uw 3 j ca)
                (%row-c-pt aw j cb)
                (combine-2-c-pts 1.0d0 ca (* (- du) one-3) cb cc)
                (%c-pt-net cc uw 2 j)))
            (let ((uk (surface-knots-u sur-u)) (vk (surface-knots-v sur-u)))
              (declare (type real-vector uk vk))
              (dotimes (i 4)
                (setf (aref uk i) us
                      (aref uk (+ 4 i)) ue))
              (dotimes (j (1+ s))
                (setf (aref vk j) (aref va j))))
            ;; the v-blend
            (let ((aw (curve-cpoints (svref cur-bb 0))))
              (declare (type cpoint-array aw))
              (dotimes (i (1+ (curve-n (svref cur-bb 0))))
                (%row-c-pt aw i ca)
                (%c-pt-net ca vw i 0)))
            (let ((aw (curve-cpoints (svref cur-bb 1))))
              (declare (type cpoint-array aw))
              (setf n (curve-n (svref cur-bb 1)))
              (dotimes (i (1+ n))
                (%row-c-pt aw i ca)
                (%c-pt-net ca vw i 3)))
            (let ((aw (curve-cpoints (svref cur-bb 2))))
              (declare (type cpoint-array aw))
              (setf n (curve-n (svref cur-bb 2)))
              (dotimes (i (1+ n))
                (%net-c-pt vw i 0 ca)
                (%row-c-pt aw i cb)
                (combine-2-c-pts 1.0d0 ca (* dv one-3) cb cc)
                (%c-pt-net cc vw i 1)))
            (let ((aw (curve-cpoints (svref cur-bb 3))))
              (declare (type cpoint-array aw))
              (setf n (curve-n (svref cur-bb 3)))
              (dotimes (i (1+ n))
                (%net-c-pt vw i 3 ca)
                (%row-c-pt aw i cb)
                (combine-2-c-pts 1.0d0 ca (* (- dv) one-3) cb cc)
                (%c-pt-net cc vw i 2)))
            (let ((uk (surface-knots-u sur-v)) (vk (surface-knots-v sur-v)))
              (declare (type real-vector uk vk))
              (dotimes (i (1+ r))
                (setf (aref uk i) (aref ua i)))
              (dotimes (j 4)
                (setf (aref vk j) vs
                      (aref vk (+ 4 j)) ve)))
            ;; the tensor product surface
            (dotimes (i 4)
              (%copy-c-pt-net uw i 0 tw i 0)
              (%copy-c-pt-net uw i m tw i 3))
            (do ((j 1 (1+ j))) ((> j 2))
              (declare (type fixnum j))
              (%copy-c-pt-net vw 0 j tw 0 j)
              (%copy-c-pt-net vw n j tw 3 j))
            (let ((t00w (make-cpoint)) (t10w (make-cpoint))
                  (t01w (make-cpoint)) (t11w (make-cpoint))
                  (d1 (* (* du dv) one-9)))
              (declare (dynamic-extent t00w t10w t01w t11w) (type double-float d1))
              (pt-to-c-pt t00 t00w)
              (pt-to-c-pt t10 t10w)
              (pt-to-c-pt t01 t01w)
              (pt-to-c-pt t11 t11w)
              (flet ((combine (alf aw bi bj ci cj di dj ri rj)
                       (%net-c-pt tw bi bj cb)
                       (%net-c-pt tw ci cj cc)
                       (%net-c-pt tw di dj cdd)
                       (combine-4-c-pts alf aw 1.0d0 cb 1.0d0 cc -1.0d0 cdd ce)
                       (%c-pt-net ce tw ri rj)))
                (combine d1 t00w 1 0 0 1 0 0 1 1)
                (combine (- d1) t10w 3 1 2 0 3 0 2 1)
                (combine (- d1) t01w 1 3 0 2 0 3 1 2)
                (combine d1 t11w 2 3 3 2 3 3 2 2)))
            (let ((uk (surface-knots-u sur-t)) (vk (surface-knots-v sur-t)))
              (declare (type real-vector uk vk))
              (dotimes (i 4)
                (setf (aref uk i) us
                      (aref uk (+ 4 i)) ue))
              (dotimes (j 4)
                (setf (aref vk j) vs
                      (aref vk (+ 4 j)) ve)))
            ;; make the surfaces compatible
            (let ((sur-a (vector sur-u sur-v sur-t)))
              (declare (type simple-vector sur-a))
              (make-srfs-compatible-uv sur-a 2)
              ;; the output surface
              (let* ((s0 (svref sur-a 0))
                     (uw (surface-cpoints s0))
                     (ua (surface-knots-u s0)) (va (surface-knots-v s0))
                     (n0 (surface-n s0)) (m0 (surface-m s0))
                     (pw (make-cpoint-net (1+ n0) (1+ m0)))
                     (uo (make-real-vector (length ua)))
                     (vo (make-real-vector (length va)))
                     (vw (surface-cpoints (svref sur-a 1)))
                     (tw (surface-cpoints (svref sur-a 2)))
                     (n (surface-n (svref sur-a 2)))
                     (m (surface-m (svref sur-a 2))))
                (declare (type cpoint-net uw pw vw tw) (type real-vector ua va uo vo)
                         (type fixnum n0 m0 n m))
                (dotimes (i (1+ n))
                  (dotimes (j (1+ m))
                    (%net-c-pt uw i j ca)
                    (%net-c-pt vw i j cb)
                    (%net-c-pt tw i j cc)
                    (translate-sum-2-c-pts ca 1.0d0 cb -1.0d0 cc cdd)
                    (%c-pt-net cdd pw i j)))
                (dotimes (i (length ua))
                  (setf (aref uo i) (aref ua i)))
                (dotimes (j (length va))
                  (setf (aref vo j) (aref va j)))
                (%make-surface (surface-degree-u s0) (surface-degree-v s0) uo vo pw)))))))))

