  (flet ((inp-err () (nurbs-error :inp-err 'create-coons-boundary-crvs)))
    ;; rationality, parameter domains, constants
    (when (is-crv-rat cur-l) (inp-err))
    (when (is-crv-rat cur-r) (inp-err))
    (when (is-crv-rat cur-b) (inp-err))
    (when (is-crv-rat cur-t) (inp-err))
    (when (is-crv-rat der-l) (inp-err))
    (when (is-crv-rat der-r) (inp-err))
    (when (is-crv-rat der-b) (inp-err))
    (when (is-crv-rat der-t) (inp-err))
    (let ((one-3 (/ 1.0d0 3.0d0))
          (one-9 (/ 1.0d0 9.0d0))
          (mtol *mtol*)
          (dtwist-tol (* (the double-float *mtol*) 1.0d2))
