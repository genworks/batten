(in-package :batten)

(defun srf-eval-pt-normal-deriv (sur u v ufl vfl nd)
  "Write the first and second derivatives of the unit normal of surface SUR
at (U, V) into ND, a point-net of at least 3 by 3: ND[1][0] = N_u,
ND[0][1] = N_v, ND[2][0] = N_uu, ND[1][1] = N_uv, ND[0][2] = N_vv; the other
entries are left alone.  UFL, VFL are +left+ or +right+.  Signals :num-err
where S_u x S_v vanishes.  Returns ND.
NLib: N_SrfEvalPtNormalDeriv."
  (declare (type surface sur) (type double-float u v) (type fixnum ufl vfl) (type point-net nd))
  (let ((sd (make-point-net 4 4)))
    (declare (type point-net sd))
    (srf-derivs sur u v ufl vfl +true+ 3 3 sd)
    (flet ((d (k l)
             (make-point (aref sd k l 0) (aref sd k l 1) (aref sd k l 2)))
           (put (pt k l)
             (declare (type point pt))
             (setf (aref nd k l 0) (aref pt 0) (aref nd k l 1) (aref pt 1) (aref nd k l 2) (aref pt 2))))
      (let ((d10 (d 1 0)) (d01 (d 0 1)) (d20 (d 2 0)) (d11 (d 1 1)) (d02 (d 0 2))
            (d30 (d 3 0)) (d21 (d 2 1)) (d12 (d 1 2)) (d03 (d 0 3))
            (s* (make-point)) (su* (make-point)) (sv* (make-point))
            (suu* (make-point)) (suv* (make-point)) (svv* (make-point))
            (a* (make-point)) (b* (make-point)) (c* (make-point)) (d* (make-point)) (v* (make-point)))
        (declare (type point d10 d01 d20 d11 d02 d30 d21 d12 d03 s* su* sv* suu* suv* svv*
                       a* b* c* d* v*))
        ;; derivatives of the cross product S_u x S_v
        (vector-cross d10 d01 s*)
        (vector-cross d20 d01 a*)
        (vector-cross d10 d11 b*)
        (vector-sum a* b* su*)
        (vector-cross d11 d01 a*)
        (vector-cross d10 d02 b*)
        (vector-sum a* b* sv*)
        (vector-cross d30 d01 a*)
        (vector-cross d20 d11 b*)
        (vector-scale b* 2d0 b*)
        (vector-cross d10 d21 c*)
        (vector-sum a* b* v*)
        (vector-sum v* c* suu*)
        (vector-cross d21 d01 a*)
        (vector-cross d20 d02 b*)
        (vector-cross d10 d12 c*)
        (vector-sum a* b* v*)
        (vector-sum v* c* suv*)
        (vector-cross d12 d01 a*)
        (vector-cross d11 d02 b*)
        (vector-scale b* 2d0 b*)
        (vector-cross d10 d03 c*)
        (vector-sum a* b* v*)
        (vector-sum v* c* svv*)
        ;; derivatives of |S_u x S_v|
        (let ((s (vector-magnitude s*)))
          (declare (type double-float s))
          (when (float-op-is-bad 1d0 s +division+)
            (nurbs-error :num-err 'srf-eval-pt-normal-deriv))
          (let* ((os (/ 1d0 s))
                 (mlt os)
                 (a 0d0) (b 0d0) (c 0d0)
                 (su 0d0) (sv 0d0) (suu 0d0) (suv 0d0) (svv 0d0)
                 (ss 0d0) (fac 0d0))
            (declare (type double-float os mlt a b c su sv suu suv svv ss fac))
            (setf a (vector-dot s* su*)
                  su (* mlt a))
            (setf a (vector-dot s* sv*)
                  sv (* mlt a))
            (setf a (vector-dot s* suu*)
                  b (vector-dot su* su*)
                  c (* su su)
                  suu (* mlt (- (+ a b) c)))
            (setf a (vector-dot s* suv*)
                  b (vector-dot su* sv*)
                  c (* su sv)
                  suv (* mlt (- (+ a b) c)))
            (setf a (vector-dot s* svv*)
                  b (vector-dot sv* sv*)
                  c (* sv sv)
                  svv (* mlt (- (+ a b) c)))
            ;; derivatives of the unit normal
            (setf mlt (* os os))
            (vector-scale su* s a*)
            (vector-scale s* su b*)
            (vector-diff a* b* c*)
            (vector-scale c* mlt c*)
            (put c* 1 0)
            (vector-scale sv* s a*)
            (vector-scale s* sv b*)
            (vector-diff a* b* c*)
            (vector-scale c* mlt c*)
            (put c* 0 1)
            (setf ss (* s s)
                  mlt (* mlt os))
            (vector-scale suu* ss a*)
            (setf fac (* (* 2d0 s) su))
            (vector-scale su* fac b*)
            (setf fac (- (* (* 2d0 su) su) (* s suu)))
            (vector-scale s* fac c*)
            (vector-diff a* b* d*)
            (vector-sum d* c* v*)
            (vector-scale v* mlt v*)
            (put v* 2 0)
            (vector-scale suv* ss a*)
            (setf fac (* s sv))
            (vector-scale su* fac b*)
            (setf fac (* s su))
            (vector-scale sv* fac c*)
            (setf fac (- (* (* 2d0 su) sv) (* s suv)))
            (vector-scale s* fac d*)
            (vector-diff a* b* v*)
            (vector-diff v* c* v*)
            (vector-sum v* d* v*)
            (vector-scale v* mlt v*)
            (put v* 1 1)
            (vector-scale svv* ss a*)
            (setf fac (* (* 2d0 s) sv))
            (vector-scale sv* fac b*)
            (setf fac (- (* (* 2d0 sv) sv) (* s svv)))
            (vector-scale s* fac c*)
            (vector-diff a* b* v*)
            (vector-sum v* c* v*)
            (vector-scale v* mlt v*)
            (put v* 0 2)))))
    nd))
