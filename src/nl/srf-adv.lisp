(in-package :batten)

(defun srf-eval-pt-normal-deriv (sur u v ufl vfl nd)
  "Write the first and second derivatives of the unit normal of surface SUR
at (U, V) into ND, a point-net of at least 3 by 3: ND[1][0] = N_u,
ND[0][1] = N_v, ND[2][0] = N_uu, ND[1][1] = N_uv, ND[0][2] = N_vv; the other
entries are left alone.  UFL, VFL are +left+ or +right+.  Signals :num-err
where S_u x S_v vanishes.  Returns ND.
NLib: N_SrfEvalPtNormalDeriv."
  (declare (type surface sur) (type double-float u v) (type fixnum ufl vfl) (type point-net nd))
  (let ((sd (make-point-net 4 4)))
    (declare (type point-net sd))
    (srf-derivs sur u v ufl vfl +true+ 3 3 sd)
    (flet ((d (k l)
             (make-point (aref sd k l 0) (aref sd k l 1) (aref sd k l 2)))
           (put (pt k l)
             (declare (type point pt))
             (setf (aref nd k l 0) (aref pt 0) (aref nd k l 1) (aref pt 1) (aref nd k l 2) (aref pt 2))))
      (let ((d10 (d 1 0)) (d01 (d 0 1)) (d20 (d 2 0)) (d11 (d 1 1)) (d02 (d 0 2))
            (d30 (d 3 0)) (d21 (d 2 1)) (d12 (d 1 2)) (d03 (d 0 3))
            (s* (make-point)) (su* (make-point)) (sv* (make-point))
            (suu* (make-point)) (suv* (make-point)) (svv* (make-point))
            (a* (make-point)) (b* (make-point)) (c* (make-point)) (d* (make-point)) (v* (make-point)))
        (declare (type point d10 d01 d20 d11 d02 d30 d21 d12 d03 s* su* sv* suu* suv* svv*
                       a* b* c* d* v*))
        ;; derivatives of the cross product S_u x S_v
        (vector-cross d10 d01 s*)
        (vector-cross d20 d01 a*)
        (vector-cross d10 d11 b*)
        (vector-sum a* b* su*)
        (vector-cross d11 d01 a*)
        (vector-cross d10 d02 b*)
        (vector-sum a* b* sv*)
        (vector-cross d30 d01 a*)
        (vector-cross d20 d11 b*)
        (vector-scale b* 2d0 b*)
        (vector-cross d10 d21 c*)
        (vector-sum a* b* v*)
        (vector-sum v* c* suu*)
        (vector-cross d21 d01 a*)
        (vector-cross d20 d02 b*)
        (vector-cross d10 d12 c*)
        (vector-sum a* b* v*)
        (vector-sum v* c* suv*)
        (vector-cross d12 d01 a*)
        (vector-cross d11 d02 b*)
        (vector-scale b* 2d0 b*)
        (vector-cross d10 d03 c*)
        (vector-sum a* b* v*)
        (vector-sum v* c* svv*)
        ;; derivatives of |S_u x S_v|
        (let ((s (vector-magnitude s*)))
          (declare (type double-float s))
          (when (float-op-is-bad 1d0 s +division+)
            (nurbs-error :num-err 'srf-eval-pt-normal-deriv))
          (let* ((os (/ 1d0 s))
                 (mlt os)
                 (a 0d0) (b 0d0) (c 0d0)
                 (su 0d0) (sv 0d0) (suu 0d0) (suv 0d0) (svv 0d0)
                 (ss 0d0) (fac 0d0))
            (declare (type double-float os mlt a b c su sv suu suv svv ss fac))
            (setf a (vector-dot s* su*)
                  su (* mlt a))
            (setf a (vector-dot s* sv*)
                  sv (* mlt a))
            (setf a (vector-dot s* suu*)
                  b (vector-dot su* su*)
                  c (* su su)
                  suu (* mlt (- (+ a b) c)))
            (setf a (vector-dot s* suv*)
                  b (vector-dot su* sv*)
                  c (* su sv)
                  suv (* mlt (- (+ a b) c)))
            (setf a (vector-dot s* svv*)
                  b (vector-dot sv* sv*)
                  c (* sv sv)
                  svv (* mlt (- (+ a b) c)))
            ;; derivatives of the unit normal
            (setf mlt (* os os))
            (vector-scale su* s a*)
            (vector-scale s* su b*)
            (vector-diff a* b* c*)
            (vector-scale c* mlt c*)
            (put c* 1 0)
            (vector-scale sv* s a*)
            (vector-scale s* sv b*)
            (vector-diff a* b* c*)
            (vector-scale c* mlt c*)
            (put c* 0 1)
            (setf ss (* s s)
                  mlt (* mlt os))
            (vector-scale suu* ss a*)
            (setf fac (* (* 2d0 s) su))
            (vector-scale su* fac b*)
            (setf fac (- (* (* 2d0 su) su) (* s suu)))
            (vector-scale s* fac c*)
            (vector-diff a* b* d*)
            (vector-sum d* c* v*)
            (vector-scale v* mlt v*)
            (put v* 2 0)
            (vector-scale suv* ss a*)
            (setf fac (* s sv))
            (vector-scale su* fac b*)
            (setf fac (* s su))
            (vector-scale sv* fac c*)
            (setf fac (- (* (* 2d0 su) sv) (* s suv)))
            (vector-scale s* fac d*)
            (vector-diff a* b* v*)
            (vector-diff v* c* v*)
            (vector-sum v* d* v*)
            (vector-scale v* mlt v*)
            (put v* 1 1)
            (vector-scale svv* ss a*)
            (setf fac (* (* 2d0 s) sv))
            (vector-scale sv* fac b*)
            (setf fac (- (* (* 2d0 sv) sv) (* s svv)))
            (vector-scale s* fac c*)
            (vector-diff a* b* v*)
            (vector-sum v* c* v*)
            (vector-scale v* mlt v*)
            (put v* 0 2)))))
    nd))

;;; ------------------------------------------------------- offset derivatives

(defun srf-offset-get-max-deriv (sur d)
  "An estimate of the largest second derivatives of the offset at distance D
of surface SUR, from samples at the nodes of its Bezier patches.  Returns
(values muu muv mvv), the bounds for S_uu, S_uv and S_vv.  Samples where the
normal derivatives fail are skipped, as in the C.
NLib: N_SrfOffsetGetMaxDeriv."
  (declare (type surface sur) (type double-float d))
  (let ((p (surface-degree-u sur))
        (q (surface-degree-v sur)))
    (declare (type fixnum p q))
    (multiple-value-bind (bez k l) (srf-decompose-to-bez sur)
      (declare (type (simple-array t (* *)) bez) (type fixnum k l))
      (let ((sd (make-point-net 3 3))
            (nd (make-point-net 3 3))
            (u (make-real-vector (1+ p)))
            (v (make-real-vector (1+ q)))
            (pt (make-point))
            (luu 0d0) (luv 0d0) (lvv 0d0))
        (declare (type point-net sd nd) (type real-vector u v) (type point pt)
                 (type double-float luu luv lvv))
        (dotimes (i (1+ k))
          (let ((al (if (= i 0) 0 1)))
            (declare (type fixnum al))
            (dotimes (j (1+ l))
              (let* ((bl (if (= j 0) 0 1))
                     (patch (aref bez i j))
                     (uk (surface-knots-u patch))
                     (vk (surface-knots-v patch))
                     (r (1- (length uk)))
                     (s (1- (length vk)))
                     (ui (/ (- (aref uk r) (aref uk 0)) (float p 1d0)))
                     (vi (/ (- (aref vk s) (aref vk 0)) (float q 1d0))))
                (declare (type fixnum bl r s) (type surface patch) (type real-vector uk vk)
                         (type double-float ui vi))
                (setf (aref u 0) (aref uk 0)
                      (aref u p) (aref uk r)
                      (aref v 0) (aref vk 0)
                      (aref v q) (aref vk s))
                (do ((a 1 (1+ a))) ((> a (- p 1)))
                  (declare (type fixnum a))
                  (setf (aref u a) (+ (aref uk 0) (* (float a 1d0) ui))))
                (do ((b 1 (1+ b))) ((> b (- q 1)))
                  (declare (type fixnum b))
                  (setf (aref v b) (+ (aref vk 0) (* (float b 1d0) vi))))
                (do ((a al (1+ a))) ((> a p))
                  (declare (type fixnum a))
                  (do ((b bl (1+ b))) ((> b q))
                    (declare (type fixnum b))
                    (srf-derivs patch (aref u a) (aref v b) +left+ +left+ +true+ 2 2 sd)
                    (when (handler-case
                              (progn (srf-eval-pt-normal-deriv patch (aref u a) (aref v b)
                                                               +left+ +left+ nd)
                                     t)
                            (nurbs-error () (err-clear) nil))
                      (let* ((muu (pt-magnitude (%net-pt sd 2 0 pt)))
                             (muv (pt-magnitude (%net-pt sd 1 1 pt)))
                             (mvv (pt-magnitude (%net-pt sd 0 2 pt)))
                             (nuu (pt-magnitude (%net-pt nd 2 0 pt)))
                             (nuv (pt-magnitude (%net-pt nd 1 1 pt)))
                             (nvv (pt-magnitude (%net-pt nd 0 2 pt)))
                             (duu (+ muu (* d nuu)))
                             (duv (+ muv (* d nuv)))
                             (dvv (+ mvv (* d nvv))))
                        (declare (type double-float muu muv mvv nuu nuv nvv duu duv dvv))
                        (when (> duu luu) (setf luu duu))
                        (when (> duv luv) (setf luv duv))
                        (when (> dvv lvv) (setf lvv dvv))))))))))
        (values luu luv lvv)))))

;;; ------------------------------------------------------ grids of normals

(defun srf-get-grid-pts-normals (sur u v mu mv ufl vfl p n)
  "Write the points of surface SUR at the grid (U[i], V[j]), i <= MU, j <= MV,
into P and the unit normals there into N, point-nets the caller allocates of
at least (1+ MU) by (1+ MV).  U and V ascend; UFL and VFL are +left+ or
+right+.  Where S_u x S_v (nearly) vanishes the pole routine supplies the
point and normal.  Signals :ind-err for a negative MU or MV, :par-err when U
or V leaves the domain, and the pole routine's errors.  Returns P.
NLib: N_SrfGetGridPtsNormals."
  (declare (type surface sur) (type real-vector u v) (type fixnum mu mv ufl vfl)
           (type point-net p n))
  (let* ((nn (surface-n sur)) (m (surface-m sur))
         (pw (surface-cpoints sur))
         (pd (surface-degree-u sur)) (q (surface-degree-v sur))
         (uk (surface-knots-u sur)) (vk (surface-knots-v sur))
         (r (1- (length uk))) (s (1- (length vk))))
    (declare (type fixnum nn m pd q r s) (type cpoint-net pw) (type real-vector uk vk))
    ;; check parameters
    (when (or (< mu 0) (< mv 0))
      (nurbs-error :ind-err 'srf-get-grid-pts-normals))
    (when (or (< (aref u 0) (aref uk 0)) (> (aref u mu) (aref uk r)))
      (nurbs-error :par-err 'srf-get-grid-pts-normals))
    (when (or (< (aref v 0) (aref vk 0)) (> (aref v mv) (aref vk s)))
      (nurbs-error :par-err 'srf-get-grid-pts-normals))
    (let ((cross-tol (* 0.001d0 *mtol*))
          (nu (make-array (list 2 (1+ pd) (1+ mu)) :element-type 'double-float :initial-element 0d0))
          (nv (make-array (list 2 (1+ q) (1+ mv)) :element-type 'double-float :initial-element 0d0))
          (usp (make-index-vector (1+ mu)))
          (vsp (make-index-vector (1+ mv)))
          (sd (make-point-net 2 2))
          (qn (make-point-net (1+ nn) (1+ m)))
          (cp (make-cpoint)) (pt (make-point))
          (a* (make-point)) (bb (make-point)) (cc (make-point))
          (sd00 (make-point)) (sd10 (make-point)) (sd01 (make-point))
          (pp (make-point)) (np (make-point)))
      (declare (type double-float cross-tol) (type real-3d-array nu nv)
               (type index-vector usp vsp) (type point-net sd qn) (type cpoint cp)
               (type point pt a* bb cc sd00 sd10 sd01 pp np))
      ;; non-vanishing B-splines; control points mapped to 3-D
      (basis-derivs-array uk pd u mu ufl 1 nu usp)
      (basis-derivs-array vk q v mv vfl 1 nv vsp)
      (dotimes (i (1+ nn))
        (dotimes (j (1+ m))
          (%pt-net (c-pt-to-pt (%net-c-pt pw i j cp) pt) qn i j)))
      (flet ((normal-at (a b)
               ;; P[a][b] = SD[0][0]; N[a][b] = unit SD[1][0] x SD[0][1], or the pole's
               (declare (type fixnum a b))
               (%net-pt sd 0 0 sd00)
               (%net-pt sd 1 0 sd10)
               (%net-pt sd 0 1 sd01)
               (%pt-net sd00 p a b)
               (vector-cross sd10 sd01 a*)
               (let ((fac (handler-case (vector-normalize a* np)
                            (nurbs-error () nil))))
                 (%pt-net np n a b)
                 (when (or (null fac) (<= (the double-float fac) cross-tol))
                   (%net-pt p a b pp)
                   (srf-eval-pt-normal-at-pole sur (aref u a) (aref v b) ufl vfl pp bb cc np sd)
                   (%pt-net pp p a b)
                   (%pt-net np n a b)))))
        (if (not (is-srf-rat sur))
            ;; non-rational case
            (dotimes (a (1+ mu))
              (dotimes (b (1+ mv))
                (fast
                  (dotimes (k 2)
                    (dotimes (l (- 2 k))
                      (let ((sx 0d0) (sy 0d0) (sz 0d0))
                        (declare (type double-float sx sy sz))
                        (dotimes (i (1+ pd))
                          (let ((tx 0d0) (ty 0d0) (tz 0d0)
                                (c (+ (- (aref usp a) pd) i)))
                            (declare (type double-float tx ty tz) (type fixnum c))
                            (dotimes (j (1+ q))
                              (let ((d (+ (- (aref vsp b) q) j))
                                    (alpha (aref nv l j b)))
                                (declare (type fixnum d) (type double-float alpha))
                                (setf tx (+ tx (* alpha (aref qn c d 0)))
                                      ty (+ ty (* alpha (aref qn c d 1)))
                                      tz (+ tz (* alpha (aref qn c d 2))))))
                            (let ((alpha (aref nu k i a)))
                              (declare (type double-float alpha))
                              (setf sx (+ sx (* alpha tx))
                                    sy (+ sy (* alpha ty))
                                    sz (+ sz (* alpha tz))))))
                        (setf (aref sd k l 0) sx (aref sd k l 1) sy (aref sd k l 2) sz)))))
                (normal-at a b)))
            ;; rational case
            (let ((w (make-real-matrix (1+ nn) (1+ m)))
                  (wd (make-real-matrix 2 2))
                  (ad (make-point-net 2 2))
                  (ad00 (make-point)) (ad10 (make-point)) (ad01 (make-point)))
              (declare (type real-matrix w wd) (type point-net ad) (type point ad00 ad10 ad01))
              (dotimes (i (1+ nn))
                (dotimes (j (1+ m))
                  (setf (aref w i j) (c-pt-get-w (%net-c-pt pw i j cp)))))
              (dotimes (a (1+ mu))
                (dotimes (b (1+ mv))
                  (fast
                    (dotimes (k 2)
                      (dotimes (l (- 2 k))
                        (let ((sx 0d0) (sy 0d0) (sz 0d0) (ws 0d0))
                          (declare (type double-float sx sy sz ws))
                          (dotimes (i (1+ pd))
                            (let ((tx 0d0) (ty 0d0) (tz 0d0) (tt 0d0)
                                  (c (+ (- (aref usp a) pd) i)))
                              (declare (type double-float tx ty tz tt) (type fixnum c))
                              (dotimes (j (1+ q))
                                (let ((d (+ (- (aref vsp b) q) j))
                                      (alpha (aref nv l j b)))
                                  (declare (type fixnum d) (type double-float alpha))
                                  (setf tt (+ tt (* (aref w c d) alpha)))
                                  (setf tx (+ tx (* alpha (aref qn c d 0)))
                                        ty (+ ty (* alpha (aref qn c d 1)))
                                        tz (+ tz (* alpha (aref qn c d 2))))))
                              (let ((alpha (aref nu k i a)))
                                (declare (type double-float alpha))
                                (setf sx (+ sx (* alpha tx))
                                      sy (+ sy (* alpha ty))
                                      sz (+ sz (* alpha tz)))
                                (setf ws (+ ws (* tt alpha))))))
                          (setf (aref ad k l 0) sx (aref ad k l 1) sy (aref ad k l 2) sz
                                (aref wd k l) ws)))))
                  (%net-pt ad 0 0 ad00)
                  (%net-pt ad 1 0 ad10)
                  (%net-pt ad 0 1 ad01)
                  (let ((fac (/ 1d0 (aref wd 0 0))))
                    (declare (type double-float fac))
                    (scale-pt fac ad00 sd00)
                    (scale-pt (aref wd 1 0) sd00 a*)
                    (diff-2-pts ad10 a* a*)
                    (scale-pt fac a* sd10)
                    (scale-pt (aref wd 0 1) sd00 a*)
                    (diff-2-pts ad01 a* a*)
                    (scale-pt fac a* sd01))
                  (%pt-net sd00 sd 0 0)
                  (%pt-net sd10 sd 1 0)
                  (%pt-net sd01 sd 0 1)
                  (normal-at a b))))))
      p)))

;;; ----------------------------------------------------------- sweep vectors

(defun create-b-vectors (cur b0 tt k b)
  "Write the unit \"B\" vectors of trajectory curve CUR at the parameters
TT[1..K] into B, a point-array the caller allocates of at least K+1 rows,
starting from B0 (normalized into B[0]); each is the previous one with its
component along the curve's unit tangent removed, and for a closed curve
they are relaxed so that B[K] meets B[0].  Signals :geo-err where a B vector
vanishes, and the tangent evaluation's errors.  Returns B.
NLib: N_CreateBVectors."
  (declare (type curve cur) (type point b0) (type real-vector tt) (type fixnum k)
           (type point-array b))
  (let ((tn (make-point-array (1+ k)))
        (a* (make-point))
        (bi (make-point)) (bj (make-point)) (ti (make-point)))
    (declare (type point-array tn) (type point a* bi bj ti))
    ;; initialize
    (vector-copy b0 bi)
    (vector-normalize-ref bi)
    (%pt-row bi b 0)
    ;; unit tangents and the B's in one direction
    (do ((i 1 (1+ i))) ((> i k))
      (declare (type fixnum i))
      (crv-eval-tangent cur (aref tt i) +left+ a* ti)
      (%pt-row ti tn i)
      ;; B[i] = B[i-1] - (B[i-1].T[i]) T[i]
      (%row-pt b (1- i) bj)
      (let ((dot (vector-dot bj ti)))
        (declare (type double-float dot))
        (combine-2-pts 1d0 bj (- dot) ti bi))
      (vector-normalize-ref bi)
      (%pt-row bi b i))
    ;; correct for closed curves
    (when (crv-is-closed cur)
      (%row-pt b 0 bi)
      (%row-pt b k bj)
      (when (> (dist-pt-pt bi bj) *mtol*)
        (%pt-row bi b k)
        (do ((i k (1- i))) ((< i 2))
          (declare (type fixnum i))
          (%row-pt b i bi)
          (%row-pt tn (1- i) ti)
          (let ((dot (vector-dot bi ti)))
            (declare (type double-float dot))
            (combine-2-pts 1d0 bi (- dot) ti a*))
          (vector-normalize-ref a*)
          (%row-pt b (1- i) bj)
          (combine-2-pts 0.5d0 bj 0.5d0 a* bj)
          (vector-normalize-ref bj)
          (%pt-row bj b (1- i)))))
    b))
