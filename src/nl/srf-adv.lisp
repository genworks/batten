(defconstant +srf-adv--kn-tol+ 1.0d-6 "KN_TOL in NL_SrfAdv.cpp: relative knot tolerance.")

(defun %srf-adv-become-crv (cur new)
  "Make curve CUR, in place, the curve NEW (sharing NEW's arrays), as the C's
in-place operators (curP = curQ) overwrite their input.  Returns CUR."
  (declare (type curve cur new))
  (setf (curve-degree cur) (curve-degree new)
        (curve-knots cur) (curve-knots new)
        (curve-cpoints cur) (curve-cpoints new))
  cur)

(defun srf-modify-boundary-crv (sur-p newbdy dirflg end uv cont)
  "Surface SUR-P with one boundary replaced by curve NEWBDY, as a fresh
surface: DIRFLG +udir+ replaces the u = umin (END +start+) or u = umax
boundary, +vdir+ the v = vmin or v = vmax one.  A surface that is zero up to
the parameter UV (u or v; moved onto a knot within KN_TOL of it, and off the
domain's ends) and then rises to NEWBDY minus the old boundary, of degree 2
for CONT +c-1+, 3 for +c-2+, else SUR-P's (never above SUR-P's), is added to
SUR-P after the two are made compatible; the sum is reparametrized onto
SUR-P's domain.  Signals :par-err for UV outside the domain, and what the
compatibility operators signal.  (The C's in-place case, surP = surQ,
computes the same surface.)
NLib: N_SrfModifyBoundaryCrv."
  (declare (type surface sur-p) (type curve newbdy) (type fixnum dirflg end cont)
           (type double-float uv))
  ;; copies of the curve and surface
  (let ((cur-c (crv-copy newbdy))
        (sur-c (srf-copy sur-p))
        (kn-tol +srf-adv--kn-tol+))
    (declare (type curve cur-c) (type surface sur-c) (type double-float kn-tol))
    (multiple-value-bind (u uu v vv) (srf-get-parameter-bounds sur-c)
      (declare (type double-float u uu v vv))
      ;; make the curve and surface directions compatible
      (if (= dirflg +udir+)
          (crv-make-compatible-with-srf cur-c sur-c +vdir+ v vv)
          (crv-make-compatible-with-srf cur-c sur-c +udir+ u uu))
      (let* ((n (surface-n sur-c)) (m (surface-m sur-c))
             (pw (surface-cpoints sur-c))
             (p (surface-degree-u sur-c)) (q (surface-degree-v sur-c))
             (up (surface-knots-u sur-c)) (vp (surface-knots-v sur-c))
             (r (1- (length up))) (s (1- (length vp)))
             (cw (curve-cpoints cur-c))
             (rw (make-cpoint))
             (a (make-cpoint)) (b (make-cpoint)) (c (make-cpoint))
             (pq 0) (kk 0)
             (sur-b nil))
        (declare (type fixnum n m p q r s pq kk) (type cpoint-net pw) (type real-vector up vp)
                 (type cpoint-array cw) (dynamic-extent rw a b c))
        ;; set uv: not too close to a knot, not on an end knot
        (let* ((kn (if (= dirflg +udir+) up vp))
               (dg (if (= dirflg +udir+) p q))
               (e (if (= dirflg +udir+) r s))
               (ii (1+ dg)))
          (declare (type real-vector kn) (type fixnum dg e ii))
          (when (or (< uv (aref kn 0)) (> uv (aref kn e)))
            (nurbs-error :par-err 'srf-modify-boundary-crv))
          (do () ((> ii e))
            (when (<= uv (aref kn ii))
              (return))
            (incf ii))
          (cond ((< (- uv (aref kn (1- ii))) (* kn-tol (- (aref kn e) (aref kn 0))))
                 (setf uv (aref kn (1- ii))))
                ((< (- (aref kn ii) uv) (* kn-tol (- (aref kn e) (aref kn 0))))
                 (setf uv (aref kn ii))))
          (when (= uv (aref kn 0))
            (setf uv (+ (aref kn 0) (* kn-tol (- (aref kn e) (aref kn 0))))))
          (when (= uv (aref kn e))
            (setf uv (- (aref kn e) (* kn-tol (- (aref kn e) (aref kn 0)))))))
        ;; the zero control point
        (if (is-crv-rat cur-c)
            (c-pt-from-wx-wy-wz 0d0 0d0 0d0 0d0 rw)
            (c-pt-from-wx-wy-wz 0d0 0d0 0d0 +no-w+ rw))
        ;; the surface to be added to SUR-P
        (if (= dirflg +udir+)
            (progn
              (setf pq (cond ((= cont +c-1+) 2) ((= cont +c-2+) 3) (t p)))
              (when (> pq p)
                (setf pq p))
              (let ((bw (make-cpoint-net (+ pq 2) (1+ m)))
                    (ub (make-real-vector (1+ (* 2 (1+ pq)))))
                    (vb (make-real-vector (1+ s))))
                (declare (type cpoint-net bw) (type real-vector ub vb))
                ;; knots
                (dotimes (ii (1+ s))
                  (setf (aref vb ii) (aref vp ii)))
                (setf (aref ub (1+ pq)) uv)
                (dotimes (ii (1+ pq))
                  (setf (aref ub ii) (aref up 0)
                        (aref ub (+ ii pq 2)) (aref up r)))
                ;; control points
                (setf kk (1+ pq))
                (if (= end +start+)
                    (dotimes (ii (1+ m))
                      (%row-c-pt cw ii a)
                      (%net-c-pt pw 0 ii b)
                      (diff-2-c-pts a b c)
                      (%c-pt-net c bw 0 ii)
                      (do ((jj 1 (1+ jj))) ((> jj kk))
                        (declare (type fixnum jj))
                        (%c-pt-net rw bw jj ii)))
                    (dotimes (ii (1+ m))
                      (%row-c-pt cw ii a)
                      (%net-c-pt pw n ii b)
                      (diff-2-c-pts a b c)
                      (%c-pt-net c bw kk ii)
                      (dotimes (jj (1+ pq))
                        (%c-pt-net rw bw jj ii))))
                (setf sur-b (%make-surface pq q ub vb bw))))
            (progn
              (setf pq (cond ((= cont +c-1+) 2) ((= cont +c-2+) 3) (t q)))
              (when (> pq q)
                (setf pq q))
              (let ((bw (make-cpoint-net (1+ n) (+ pq 2)))
                    (ub (make-real-vector (1+ r)))
                    (vb (make-real-vector (1+ (* 2 (1+ pq))))))
                (declare (type cpoint-net bw) (type real-vector ub vb))
                ;; knots
                (dotimes (ii (1+ r))
                  (setf (aref ub ii) (aref up ii)))
                (setf (aref vb (1+ pq)) uv)
                (dotimes (ii (1+ pq))
                  (setf (aref vb ii) (aref vp 0)
                        (aref vb (+ ii pq 2)) (aref vp s)))
                ;; control points
                (setf kk (1+ pq))
                (if (= end +start+)
                    (dotimes (ii (1+ n))
                      (%row-c-pt cw ii a)
                      (%net-c-pt pw ii 0 b)
                      (diff-2-c-pts a b c)
                      (%c-pt-net c bw ii 0)
                      (do ((jj 1 (1+ jj))) ((> jj kk))
                        (declare (type fixnum jj))
                        (%c-pt-net rw bw ii jj)))
                    (dotimes (ii (1+ n))
                      (%row-c-pt cw ii a)
                      (%net-c-pt pw ii m b)
                      (diff-2-c-pts a b c)
                      (%c-pt-net c bw ii kk)
                      (dotimes (jj (1+ pq))
                        (%c-pt-net rw bw ii jj))))
                (setf sur-b (%make-surface p pq ub vb bw)))))
        ;; make surC and surB compatible
        (let ((surs (vector sur-c sur-b)))
          (declare (type simple-vector surs))
          (make-srfs-compatible-uv surs 1)
          (setf sur-c (svref surs 0)
                sur-b (svref surs 1)))
        (let* ((pw (surface-cpoints sur-c))
               (up (surface-knots-u sur-c)) (vp (surface-knots-v sur-c))
               (bw (surface-cpoints sur-b))
               (n (surface-n sur-b)) (m (surface-m sur-b))
               (p (surface-degree-u sur-b)) (q (surface-degree-v sur-b))
               (r (1- (length (surface-knots-u sur-b))))
               (s (1- (length (surface-knots-v sur-b))))
               (qw (make-cpoint-net (1+ n) (1+ m)))
               (uq (make-real-vector (1+ r)))
               (vq (make-real-vector (1+ s)))
               (sur-q (%make-surface p q uq vq qw)))
          (declare (type cpoint-net pw bw qw) (type real-vector up vp uq vq)
                   (type fixnum n m p q r s))
          ;; add the two surfaces together
          (dotimes (ii (1+ n))
            (dotimes (jj (1+ m))
              (%net-c-pt pw ii jj a)
              (%net-c-pt bw ii jj b)
              (sum-2-c-pts a b c)
              (%c-pt-net c qw ii jj)))
          ;; the knots
          (dotimes (ii (1+ r))
            (setf (aref uq ii) (aref up ii)))
          (dotimes (ii (1+ s))
            (setf (aref vq ii) (aref vp ii)))
          ;; reparametrize back to the original rectangle if necessary
          (when (or (/= u (aref uq 0)) (/= uu (aref uq r)) (/= v (aref vq 0)) (/= vv (aref vq s)))
            (let ((rect (make-real-vector 4)))
              (create-rectangle rect u uu v vv)
              (srf-reparam-to-interval sur-q rect +uvdir+)))
          sur-q)))))

(defun reparm-crvs-isect-pt (cur-u cur-v k l uu vv rep)
  "Reparametrize the curve network CUR-U[0..K] (u-curves C_j(u)) and
CUR-V[0..L] (v-curves C_i(v)), simple-vectors of curves changed in place, so
that their intersections fall at common parameters: UU[i][j] and VV[i][j]
(real-matrices of L+1 rows and K+1 columns) are the parameters of the
intersection of C_i and C_j on C_j and on C_i.  The new parameters are the
averages of each curve's intersection parameters, and each curve is composed
with the B-spline function (degree 1 for REP +linear+, 2 for +quadratic+)
interpolating its own parameters at them; both sets are then made compatible.
Returns (values u v), fresh real-vectors of L+1 and K+1 averages.  Signals
:cal-err for another REP, :der-err when a quadratic function's derivative is
not positive at an interior knot, and what the fit, the reparametrization and
the compatibility operators signal.
NLib: N_ReparmCrvsIsectPt."
  (declare (type simple-vector cur-u cur-v) (type fixnum k l rep) (type real-matrix uu vv))
  (let ((p (cond ((= rep +linear+) 1)
                 ((= rep +quadratic+) 2)
                 (t (nurbs-error :cal-err 'reparm-crvs-isect-pt))))
        (u-avg (make-real-vector (1+ l)))
        (v-avg (make-real-vector (1+ k)))
        (fd (make-real-vector 2)))
    (declare (type fixnum p) (type real-vector u-avg v-avg fd))
    ;; the new parameters: each curve's intersection parameters averaged
    (dotimes (i (1+ l))
      (let ((sum 0d0))
        (declare (type double-float sum))
        (dotimes (j (1+ k))
          (setf sum (+ sum (aref uu i j))))
        (setf (aref u-avg i) (/ sum (+ (float k 1d0) 1d0)))))
    (dotimes (j (1+ k))
      (let ((sum 0d0))
        (declare (type double-float sum))
        (dotimes (i (1+ l))
          (setf sum (+ sum (aref vv i j))))
        (setf (aref v-avg j) (/ sum (+ (float l 1d0) 1d0)))))
    ;; reparametrize the u-curves
    (dotimes (j (1+ k))
      (let ((this (make-real-vector (1+ l))))
        (declare (type real-vector this))
        (dotimes (i (1+ l))
          (setf (aref this i) (aref uu i j)))
        (let* ((cfn (fit-func-interp-given-params this l p u-avg))
               (u (cfun-knots cfn)))
          (declare (type cfun cfn) (type real-vector u))
          (when (= p 2)
            (do ((r (1+ p) (1+ r))) ((> r l))
              (declare (type fixnum r))
              (c-func-derivs cfn (aref u r) +left+ 1 fd)
              (when (<= (aref fd 1) 0d0)
                (nurbs-error :der-err 'reparm-crvs-isect-pt))))
          (%srf-adv-become-crv (svref cur-u j) (srf-reparam-func (svref cur-u j) cfn)))))
    ;; reparametrize the v-curves
    (dotimes (i (1+ l))
      (let ((this (make-real-vector (1+ k))))
        (declare (type real-vector this))
        (dotimes (j (1+ k))
          (setf (aref this j) (aref vv i j)))
        (let* ((cfn (fit-func-interp-given-params this k p v-avg))
               (u (cfun-knots cfn)))
          (declare (type cfun cfn) (type real-vector u))
          (when (= p 2)
            (do ((r (1+ p) (1+ r))) ((> r k))
              (declare (type fixnum r))
              (c-func-derivs cfn (aref u r) +left+ 1 fd)
              (when (<= (aref fd 1) 0d0)
                (nurbs-error :der-err 'reparm-crvs-isect-pt))))
          (%srf-adv-become-crv (svref cur-v i) (srf-reparam-func (svref cur-v i) cfn)))))
    ;; make compatible again
    (crvs-make-compatible cur-u k)
    (crvs-make-compatible cur-v l)
    (values u-avg v-avg)))

(defun create-coons-boundary-crvs (cur-l der-l cur-r der-r cur-b der-b cur-t der-t cpf)
  "The bicubically blended Coons surface of the non-rational boundary curves
CUR-L, CUR-R (on one v-domain) and CUR-B, CUR-T (on one u-domain) and their
cross-boundary derivative curves DER-L, DER-R, DER-B, DER-T, as a fresh
surface: the u-blend plus the v-blend minus their tensor product, made
compatible.  Opposite curves and derivatives that are not compatible are made
so in place.  With CPF +yes+ the derivative curves must match the boundary
tangents at the corners to within *mtol*, and the twists from either side to
