(in-package :batten)

(declaim (inline %srf-fit-net-cpt))
(defun %srf-fit-net-cpt (pw row col dst)
  "Copy control point PW[ROW][COL] of a cpoint-net into the cpoint DST; return DST."
  (declare (type cpoint-net pw) (type fixnum row col) (type cpoint dst))
  (set-cpoint dst (aref pw row col 0) (aref pw row col 1) (aref pw row col 2) (aref pw row col 3)))

(defun fit-srf-removal-boundary (sur r s f l dir br mr)
  "Update the knot removal error bounds BR (a real-matrix indexed by control
point row and column) and the maximum error MR for removing once the knot of
index R and multiplicity S of surface SUR in direction DIR (+udir+ or
+vdir+), over rows/columns F..L of the other direction.  T[r] must be an
interior knot with T[r] /= T[r+1] and S > 0; these are not checked.  MR equal
to +bigd+ is first reset to -1.  BR is updated in place; returns the new MR.
As in the C, which returns NL_NO even then, a DIR other than +udir+ or +vdir+
updates nothing and signals nothing.  NLib: N_FitSrfRemovalBoundary."
  (declare (type surface sur) (type fixnum r s f l dir) (type real-matrix br)
           (type double-float mr))
  (let* ((p (surface-degree-u sur))
         (q (surface-degree-v sur))
         (pw (surface-cpoints sur))
         (udir (= dir +udir+))
         (deg (if udir p q))
         (knots (if udir (surface-knots-u sur) (surface-knots-v sur)))
         (size (1+ (* 2 (nl-max p q))))
         (alf (make-real-vector size))
         (oma (make-real-vector size))
         (bet (make-real-vector size))
         (omb (make-real-vector size))
         (rw (make-array size))
         (a (make-cpoint))
         (pt (make-cpoint)))
    (declare (type fixnum p q deg size) (type cpoint-net pw) (type real-vector knots alf oma bet omb)
             (type simple-vector rw) (type cpoint a pt))
    (dotimes (k size) (setf (svref rw k) (make-cpoint)))
    (when (= mr +bigd+)
      (setf mr -1d0))
    (unless (or (= dir +udir+) (= dir +vdir+))
      ;; NL_ERROR(NL_CAL_ERR), but the routine returns NL_NO
      (return-from fit-srf-removal-boundary mr))
    (flet ((net (k other)
             ;; Pw[k][col] removing in u, Pw[row][k] removing in v
             (if udir
                 (%srf-fit-net-cpt pw k other pt)
                 (%srf-fit-net-cpt pw other k pt)))
           (rw (k) (the cpoint (svref rw k))))
      (declare (inline net rw))
      (let* ((first (- r deg))
             (last (- r s))
             (off (1- first))
             (i first)
             (j last)
             (del 0d0)
             (omd 0d0))
        (declare (type fixnum first last off i j) (type double-float del omd))
        ;; save some parameters
        (do () ((not (> (- j i) 0)))
          (setf (aref alf (- i first)) (/ (- (aref knots (+ i deg 1)) (aref knots i))
                                          (- (aref knots r) (aref knots i)))
                (aref oma (- i first)) (- 1d0 (aref alf (- i first)))
                (aref bet (- j first)) (/ (- (aref knots (+ j deg 1)) (aref knots j))
                                          (- (aref knots (+ j deg 1)) (aref knots r)))
                (aref omb (- j first)) (- 1d0 (aref bet (- j first))))
          (incf i)
          (decf j))
        (setf del (/ (- (aref knots r) (aref knots i))
                     (- (aref knots (+ i deg 1)) (aref knots i)))
              omd (- 1d0 del))
        ;; update the maximum error for the requested rows/columns
        (do ((other f (1+ other))) ((> other l))
          (declare (type fixnum other))
          (let ((ii 1)
                (jj (- last off))
                (dw 0d0))
            (declare (type fixnum ii jj) (type double-float dw))
            (setf i first
                  j last)
            (copy-c-pt (net off other) (rw 0))
            (copy-c-pt (net (1+ last) other) (rw (- (1+ last) off)))
            ;; new control points for one removal step
            (do () ((not (> (- j i) 0)))
              (combine-2-c-pts (aref alf (- i first)) (net i other)
                               (aref oma (- i first)) (rw (1- ii)) (rw ii))
              (combine-2-c-pts (aref bet (- j first)) (net j other)
                               (aref omb (- j first)) (rw (1+ jj)) (rw jj))
              (incf i)
              (decf j)
              (incf ii)
              (decf jj))
            ;; the error
            (if (< (- j i) 0)
                (setf dw (dist-cpt-cpt-homo (rw (1- ii)) (rw (1+ jj))))
                (progn
                  (combine-2-c-pts del (rw (1+ jj)) omd (rw (1- ii)) a)
                  (setf dw (dist-cpt-cpt-homo (net i other) a))))
            (if udir
                (incf (aref br r other) dw)
                (incf (aref br other r) dw))
            (when (> dw mr)
              (setf mr dw))))))
    mr))

;;; ------------------------------------------------ least-squares surface fits

(defun fit-calc-srf-param-values (a n m ptp par u v)
  "Write into U[0..N] and V[0..M] (allocated by the caller) parameters for
global surface interpolation of the grid A[0..N][0..M] (a point-net when PTP
is +epoint+, a cpoint-net when +hpoint+), each row and column of points on an
isoparameter line.  PAR is +uniform+, +chordlength+ or +centripetal+ (the
averaged square roots of the chord lengths).  Signals :cal-err for an unknown
PAR or PTP and :inp-err when every row (or every column) has total chord
length not above *mtol*; U, and for the v error V too, are partly written
then, as in the C.  Returns U.
NLib: N_FitCalcSrfParamValues."
  (declare (type (simple-array double-float (* * *)) a) (type fixnum n m ptp par)
           (type real-vector u v))
  (unless (or (= par +uniform+) (= par +chordlength+) (= par +centripetal+))
    (nurbs-error :cal-err 'fit-calc-srf-param-values))
  (unless (or (= ptp +epoint+) (= ptp +hpoint+))
    (nurbs-error :cal-err 'fit-calc-srf-param-values))
  (setf (aref u 0) 0d0
        (aref u n) 1d0
        (aref v 0) 0d0
        (aref v m) 1d0)
  (when (= par +uniform+)
    (let ((d (/ 1d0 (float n 1d0))))
      (declare (type double-float d))
      (do ((i 1 (1+ i))) ((>= i n))
        (declare (type fixnum i))
        (setf (aref u i) (* (float i 1d0) d)))
      (setf d (/ 1d0 (float m 1d0)))
      (do ((j 1 (1+ j))) ((>= j m))
        (declare (type fixnum j))
        (setf (aref v j) (* (float j 1d0) d))))
    (return-from fit-calc-srf-param-values u))
  (let ((dist (make-real-vector (1+ (nl-max n m))))
        (p0 (make-point)) (p1 (make-point))
        (q0 (make-cpoint)) (q1 (make-cpoint))
        (epoint (= ptp +epoint+))
        (centripetal (= par +centripetal+))
        (mtol *mtol*))
    (declare (type real-vector dist) (type point p0 p1) (type cpoint q0 q1)
             (type double-float mtol) (dynamic-extent p0 p1 q0 q1))
    (flet ((dist (i0 j0 i1 j1)
             (declare (type fixnum i0 j0 i1 j1))
             (let ((dd (if epoint
                           (dist-pt-pt (%net-pt a i0 j0 p0) (%net-pt a i1 j1 p1))
                           (dist-cpt-cpt-homo (%net-c-pt a i0 j0 q0) (%net-c-pt a i1 j1 q1)))))
               (declare (type double-float dd))
               (if centripetal (sqrt (the (double-float 0d0) dd)) dd))))
      (declare (inline dist))
      ;; u-directional parameters
      (do ((i 1 (1+ i))) ((>= i n))
        (declare (type fixnum i))
        (setf (aref u i) 0d0))
      (let ((num (1+ m)))
        (declare (type fixnum num))
        (do ((j 0 (1+ j))) ((> j m))
          (declare (type fixnum j))
          (let ((sum 0d0))
            (declare (type double-float sum))
            (do ((i 1 (1+ i))) ((> i n))
              (declare (type fixnum i))
              (setf (aref dist i) (dist (1- i) j i j))
              (setf sum (+ sum (aref dist i))))
            (if (> sum mtol)
                (let ((d 0d0))
                  (declare (type double-float d))
                  (do ((i 1 (1+ i))) ((>= i n))
                    (declare (type fixnum i))
                    (setf d (+ d (aref dist i)))
                    (setf (aref u i) (+ (aref u i) (/ d sum)))))
                (decf num))))
        (when (= num 0)
          (nurbs-error :inp-err 'fit-calc-srf-param-values))
        (do ((i 1 (1+ i))) ((>= i n))
          (declare (type fixnum i))
          (setf (aref u i) (/ (aref u i) (float num 1d0)))))
      ;; v-directional parameters
      (do ((j 1 (1+ j))) ((>= j m))
        (declare (type fixnum j))
        (setf (aref v j) 0d0))
      (let ((num (1+ n)))
        (declare (type fixnum num))
        (do ((i 0 (1+ i))) ((> i n))
          (declare (type fixnum i))
          (let ((sum 0d0))
            (declare (type double-float sum))
            (do ((j 1 (1+ j))) ((> j m))
              (declare (type fixnum j))
              (setf (aref dist j) (dist i (1- j) i j))
              (setf sum (+ sum (aref dist j))))
            (if (> sum mtol)
                (let ((d 0d0))
                  (declare (type double-float d))
                  (do ((j 1 (1+ j))) ((>= j m))
                    (declare (type fixnum j))
                    (setf d (+ d (aref dist j)))
                    (setf (aref v j) (+ (aref v j) (/ d sum)))))
                (decf num))))
        (when (= num 0)
          (nurbs-error :inp-err 'fit-calc-srf-param-values))
        (do ((j 1 (1+ j))) ((>= j m))
          (declare (type fixnum j))
          (setf (aref v j) (/ (aref v j) (float num 1d0)))))))
  u)

(defun fit-srf-to-pts-knots (a n m ptp u v knu knv p q)
  "The surface of degrees P, Q (each at least 1) with knot vectors KNU, KNV
(copied; N+P+2 and M+Q+2 knots, :inp-err otherwise) interpolating the grid
A[0..N][0..M] -- a point-net when PTP is +epoint+, a cpoint-net when +hpoint+
(:cal-err otherwise) -- at parameters U[0..N], V[0..M], each row and column of
A on an isoparameter line.  Signals :inp-err for P > N or Q > M and for a
parameter outside the band the knots allow, and whatever the banded LU solve
signals (:num-err for a singular system).  Returns a fresh surface.
NLib: N_FitSrfToPtsKnots."
  (declare (type (simple-array double-float (* * *)) a) (type fixnum n m ptp p q)
           (type real-vector u v knu knv))
  (let ((r (1- (length knu)))
        (s (1- (length knv)))
        (rs (+ n p 1))
        (ss (+ m q 1)))
    (declare (type fixnum r s rs ss))
    (when (or (/= r rs) (/= s ss))
      (nurbs-error :inp-err 'fit-srf-to-pts-knots))
    (when (or (> p n) (> q m))
      (nurbs-error :inp-err 'fit-srf-to-pts-knots))
    (let ((pw (make-cpoint-net (1+ n) (1+ m)))
          (us (make-real-vector (1+ r)))
          (vs (make-real-vector (1+ s)))
          (rw (make-cpoint-array (1+ (nl-max n m))))
          (nb (make-real-vector (1+ (nl-max p q))))
          (pt (make-point))
          (cp (make-cpoint)))
      (declare (type cpoint-net pw) (type real-vector us vs nb) (type cpoint-array rw)
               (type point pt) (type cpoint cp))
      (replace us knu)
      (replace vs knv)
      (flet ((band-matrix (cnt deg kn par)
               ;; the LU-decomposed banded interpolation matrix of one
               ;; direction: CNT the highest data index, DEG the degree
               (declare (type fixnum cnt deg) (type real-vector kn par))
               (let* ((bw (1- (* 2 deg)))
                      (sbw (1- deg))
                      (cm (set-real-matrix (make-rmatrix) cnt cnt +mt-banded+ bw))
                      (b (rmatrix-rm cm)))
                 (declare (type fixnum bw sbw) (type real-matrix b))
                 (dotimes (i (1+ cnt))
                   (dotimes (j bw)
                     (setf (aref b i j) 0d0)))
                 (setf (aref b 0 sbw) 1d0
                       (aref b cnt sbw) 1d0)
                 (do ((i 1 (1+ i))) ((>= i cnt))
                   (declare (type fixnum i))
                   (let* ((j (basis-eval kn deg (aref par i) +left+ nb))
                          (l (- j i 1)))
                     (declare (type fixnum j l))
                     (when (or (< l 0) (>= (+ l deg) bw))
                       (nurbs-error :inp-err 'fit-srf-to-pts-knots))
                     (dotimes (k (1+ deg))
                       (setf (aref b i (+ l k)) (aref nb k)))))
                 (real-matrix-lu-decompose cm))))
        ;; interpolate in the u-direction
        (if (= p 1)
            (cond ((= ptp +epoint+)
                   (dotimes (i (1+ n))
                     (dotimes (j (1+ m))
                       (%c-pt-net (pt-to-c-pt (%net-pt a i j pt) cp) pw i j))))
                  ((= ptp +hpoint+)
                   (dotimes (i (1+ n))
                     (dotimes (j (1+ m))
                       (%copy-c-pt-net a i j pw i j))))
                  (t (nurbs-error :cal-err 'fit-srf-to-pts-knots)))
            (let ((cm (band-matrix n p knu u)))
              (dotimes (j (1+ m))
                (fit-crv-c-pts-from-srf-data a n m ptp j +udir+ cm rw)
                (dotimes (i (1+ n))
                  (%c-pt-net (%row-c-pt rw i cp) pw i j)))))
        ;; interpolate in the v-direction
        (when (> q 1)
          (let ((cm (band-matrix m q knv v)))
            (dotimes (i (1+ n))
              (fit-crv-c-pts-from-srf-data pw n m +hpoint+ i +vdir+ cm rw)
              (dotimes (j (1+ m))
                (%c-pt-net (%row-c-pt rw j cp) pw i j))))))
      (%make-surface p q us vs pw))))

(defun %fit-srf-lst-sq-core (a ptp u v knu knv r s n m p q pw rname)
  "The common body of N_FitSrfLstSqApprox and N_FitSrfLstSqKnots, from their
special cases on: write into PW, the (N+1) x (M+1) cpoint-net of the fitted
surface, the least-squares control points for grid A[0..R][0..S] (a point-net
for PTP +epoint+, a cpoint-net for +hpoint+) at parameters U, V with knot
vectors KNU, KNV and degrees P, Q.  A is modified in place when N or M is 1,
as in the C.  Errors are signaled for RNAME.  Returns PW."
  (declare (type (simple-array double-float (* * *)) a) (type fixnum ptp r s n m p q)
           (type real-vector u v knu knv) (type cpoint-net pw))
  (let ((epoint (= ptp +epoint+))
        (cp (make-cpoint))
        (pt (make-point)))
    (declare (type cpoint cp) (type point pt))
    (unless (or epoint (= ptp +hpoint+))
      (nurbs-error :cal-err rname))
    (flet ((corner (i j k l)
             ;; N_PtToCPt( S[i][j], &Pw[k][l] ) or N_CopyCPt( Sw[i][j], &Pw[k][l] )
             (declare (type fixnum i j k l))
             (if epoint
                 (%c-pt-net (pt-to-c-pt (%net-pt a i j pt) cp) pw k l)
                 (%copy-c-pt-net a i j pw k l)))
           (copy-entry (i j k l)
             ;; N_CopyPt( S[i][j], &S[k][l] ) or N_CopyCPt( Sw[i][j], &Sw[k][l] )
             (declare (type fixnum i j k l))
             (if epoint
                 (%pt-net (copy-pt (%net-pt a i j pt) pt) a k l)
                 (%copy-c-pt-net a i j a k l))))
      ;; handle special cases
      (when (and (= n 1) (= m 1))
        (corner 0 0 0 0)
        (corner r 0 1 0)
        (corner 0 s 0 1)
        (corner r s 1 1)
        (return-from %fit-srf-lst-sq-core pw))
      (when (= n 1)
        (do ((j 0 (1+ j))) ((> j s))
          (declare (type fixnum j))
          (copy-entry r j 1 j)))
      (when (= m 1)
        (do ((i 0 (1+ i))) ((> i r))
          (declare (type fixnum i))
          (copy-entry i s i 1))))
    ;; allocate memory, sized as the C sizes it
    (let* ((ub (1+ (* 2 p)))
           (vb (1+ (* 2 q)))
           (usb p)
           (vsb q)
           (ia (nl-max (- r 2) (- s 2)))
           (ka (nl-max p q))
           (ja (nl-max (- n 2) (- m 2)))
           (la (nl-max (1- ub) (1- vb)))
           (am (make-real-matrix (1+ ia) (1+ ka)))
           (ntn (make-real-matrix (1+ ja) (1+ la)))
           (nb (make-real-vector (1+ ka)))
           (ts (make-real-vector (1+ ia)))
           (te (make-real-vector (1+ ia)))
           (index (make-index-vector (1+ ia)))
           (start (make-index-vector (1+ ja)))
           (end (make-index-vector (1+ ja)))
           (rk (make-point-array (1+ ia)))
           (rr (make-point-array (1+ ja)))
           (rkw (make-cpoint-array (1+ ia)))
           (rw (make-cpoint-array (1+ ja)))
           (aw (make-cpoint-array (1+ ja)))
           (qw (make-cpoint-net (1+ n) (1+ s)))
           (cm (make-rmatrix))
           (p0 (make-point)) (p1 (make-point)) (p2 (make-point)) (p3 (make-point))
           (c0 (make-cpoint)) (c1 (make-cpoint)) (c2 (make-cpoint)) (c3 (make-cpoint)))
      (declare (type fixnum ub vb usb vsb ia ka ja la)
               (type real-matrix am ntn) (type real-vector nb ts te)
               (type index-vector index start end) (type point-array rk rr)
               (type cpoint-array rkw rw aw) (type cpoint-net qw)
               (type point p0 p1 p2 p3) (type cpoint c0 c1 c2 c3))
      (labels ((coefficients (rs ns deg kn par bw sbw)
                 ;; the banded normal matrix of one direction, LU-decomposed
                 ;; into CM, and the end basis functions TS, TE: RS is the
                 ;; highest data index, NS the highest control point index
                 (declare (type fixnum rs ns deg bw sbw) (type real-vector kn par))
                 (let ((rj deg) (sj (1- deg)) (ej -2))
                   (declare (type fixnum rj sj ej))
                   (do ((i 0 (1+ i))) ((> i (- ns 2)))
                     (declare (type fixnum i))
                     (dotimes (j bw)
                       (setf (aref ntn i j) 0d0)))
                   (do ((i 0 (1+ i))) ((> i (- rs 2)))
                     (declare (type fixnum i))
                     (setf (aref am i deg) 0d0))
                   (do ((i 0 (1+ i))) ((> i (nl-min (1- deg) (- ns 2))))
                     (declare (type fixnum i))
                     (setf (aref start i) 0))
                   (setf (aref end 0) -2)
                   (do ((i 1 (1+ i))) ((> i (1- rs)))
                     (declare (type fixnum i))
                     (let* ((j (basis-eval kn deg (aref par i) +left+ nb))
                            (l (if (= j deg) 1 0))
                            (hk (if (or (= j deg) (= j ns)) (1- deg) deg)))
                       (declare (type fixnum j l hk))
                       (do ((k 0 (1+ k))) ((> k hk))
                         (declare (type fixnum k))
                         (setf (aref am (1- i) k) (aref nb (+ l k))))
                       (setf (aref index (1- i)) (nl-max 0 (- j deg 1)))
                       (when (> j rj)
                         (do ((k 1 (1+ k))) ((> k (- j rj)))
                           (declare (type fixnum k))
                           (incf sj)
                           (incf ej)
                           (when (<= sj (- ns 2))
                             (setf (aref start sj) (1- i)))
                           (when (>= ej 0)
                             (setf (aref end ej) (- i 2))))
                         (setf rj j))))
                   (when (or (< sj (- ns 2)) (= (aref end 0) -1))
                     (nurbs-error :inp-err rname))
                   (do ((i (nl-max 0 (1+ ej)) (1+ i))) ((> i (- ns 2)))
                     (declare (type fixnum i))
                     (setf (aref end i) (- rs 2)))
                   (fast
                     (do ((i 0 (1+ i))) ((> i (- ns 2)))
                       (declare (type fixnum i))
                       (let ((lj (nl-max 0 (- i deg)))
                             (hj (nl-min (- ns 2) (+ i deg))))
                         (declare (type fixnum lj hj))
                         (do ((j lj (1+ j))) ((> j hj))
                           (declare (type fixnum j))
                           (let ((lk (nl-max (aref start i) (aref start j)))
                                 (hk (nl-min (aref end i) (aref end j))))
                             (declare (type fixnum lk hk))
                             (do ((k lk (1+ k))) ((> k hk))
                               (declare (type fixnum k))
                               (setf (aref ntn i (+ (- j i) sbw))
                                     (+ (aref ntn i (+ (- j i) sbw))
                                        (* (aref am k (- i (aref index k)))
                                           (aref am k (- j (aref index k))))))))))))
                   (create-real-matrix cm (- ns 2) (- ns 2) ntn +mt-banded+ bw)
                   (real-matrix-lu-decompose cm)
                   (do ((i 1 (1+ i))) ((> i (1- rs)))
                     (declare (type fixnum i))
                     (setf (aref ts (1- i)) (basis-i-eval kn 0 deg (aref par i) +left+))
                     (setf (aref te (1- i)) (basis-i-eval kn ns deg (aref par i) +left+)))))
               (solve-e (rs ns fetch store)
                 ;; one row of Euclidean data: FETCH writes data point k
                 ;; (0..RS) into a point, STORE puts a cpoint at control
                 ;; point k (0..NS)
                 (declare (type fixnum rs ns) (type function fetch store))
                 (funcall store 0 (pt-to-c-pt (funcall fetch 0 p0) c0))
                 (funcall store ns (pt-to-c-pt (funcall fetch rs p0) c0))
                 (do ((i 1 (1+ i))) ((> i (1- rs)))
                   (declare (type fixnum i))
                   (funcall fetch i p1)
                   (funcall fetch 0 p0)
                   (funcall fetch rs p2)
                   (translate-sum-2-pts p1 (- (aref ts (1- i))) p0 (- (aref te (1- i))) p2 p3)
                   (%pt-row p3 rk (1- i)))
                 (do ((i 1 (1+ i))) ((> i (1- ns)))
                   (declare (type fixnum i))
                   (set-point p3 0d0 0d0 0d0)
                   (do ((k (aref start (1- i)) (1+ k))) ((> k (aref end (1- i))))
                     (declare (type fixnum k))
                     (vector-blend-pt (aref am k (- i (aref index k) 1)) (%row-pt rk k p0) p3))
                   (%pt-row p3 rr (1- i)))
                 (real-matrix-for-back cm rr +epoint+ aw)
                 (do ((i 0 (1+ i))) ((> i (- ns 2)))
                   (declare (type fixnum i))
                   (funcall store (1+ i) (%row-c-pt aw i c0))))
               (solve-h (rs ns fetch store)
                 ;; one row of homogeneous data: FETCH writes data point k
                 ;; into a cpoint
                 (declare (type fixnum rs ns) (type function fetch store))
                 (funcall store 0 (copy-c-pt (funcall fetch 0 c0) c3))
                 (funcall store ns (copy-c-pt (funcall fetch rs c0) c3))
                 (do ((i 1 (1+ i))) ((> i (1- rs)))
                   (declare (type fixnum i))
                   (funcall fetch i c1)
                   (funcall fetch 0 c0)
                   (funcall fetch rs c2)
                   (translate-sum-2-c-pts c1 (- (aref ts (1- i))) c0 (- (aref te (1- i))) c2 c3)
                   (%c-pt-row c3 rkw (1- i)))
                 (do ((i 1 (1+ i))) ((> i (1- ns)))
                   (declare (type fixnum i))
                   (set-cpoint c3 0d0 0d0 0d0 0d0)
                   (do ((k (aref start (1- i)) (1+ k))) ((> k (aref end (1- i))))
                     (declare (type fixnum k))
                     (vector-blend-c-pt (aref am k (- i (aref index k) 1)) (%row-c-pt rkw k c0) c3))
                   (%c-pt-row c3 rw (1- i)))
                 (real-matrix-for-back cm rw +hpoint+ aw)
                 (do ((i 0 (1+ i))) ((> i (- ns 2)))
                   (declare (type fixnum i))
                   (funcall store (1+ i) (%row-c-pt aw i c0)))))
        ;; u-directional approximation
        (when (> n 1)
          (coefficients r n p knu u ub usb)
          (let ((dst (if (= m 1) pw qw)))
            (declare (type cpoint-net dst))
            (do ((j 0 (1+ j))) ((> j (if (= m 1) 1 s)))
              (declare (type fixnum j))
              (flet ((store (k c) (%c-pt-net c dst k j)))
                (if epoint
                    (solve-e r n (lambda (k x) (%net-pt a k j x)) #'store)
                    (solve-h r n (lambda (k x) (%net-c-pt a k j x)) #'store))))))
        ;; v-directional approximation
        (when (> m 1)
          (coefficients s m q knv v vb vsb)
          (do ((i 0 (1+ i))) ((> i n))
            (declare (type fixnum i))
            (flet ((store (k c) (%c-pt-net c pw i k)))
              (cond ((/= n 1)
                     (solve-h s m (lambda (k x) (%net-c-pt qw i k x)) #'store))
                    (epoint
                     (solve-e s m (lambda (k x) (%net-pt a i k x)) #'store))
                    (t
                     (solve-h s m (lambda (k x) (%net-c-pt a i k x)) #'store))))))))
    pw))

(defun fit-srf-lst-sq-approx (pnet r s n m p q par)
  "The least-squares surface of degrees P, Q with (N+1) x (M+1) control
points approximating the grid of points PNET[0..R][0..S] (a point-net),
each row and column of points placed on an isoparameter line: parameters by
PAR (+uniform+, +chordlength+ or +centripetal+), knot vectors by
fit-calc-knot-vector-crv-approx.  Requires 1 <= N <= R, 1 <= M <= S, P <= N,
Q <= M (:inp-err otherwise, and for parameters the fit cannot use); PNET is
modified in place when N or M is 1, as in the C.  Returns a fresh surface.
NLib: N_FitSrfLstSqApprox."
  (declare (type point-net pnet) (type fixnum r s n m p q par))
  (when (or (> n r) (< n 1) (> p n))
    (nurbs-error :inp-err 'fit-srf-lst-sq-approx))
  (when (or (> m s) (< m 1) (> q m))
    (nurbs-error :inp-err 'fit-srf-lst-sq-approx))
  (cond ((= n 1)
         (when (and (> m 1) (> q m))
           (nurbs-error :inp-err 'fit-srf-lst-sq-approx)))
        ((= m 1)
         (when (and (> n 1) (> p n))
           (nurbs-error :inp-err 'fit-srf-lst-sq-approx)))
        ((and (and (> n 1) (> m 1)) (or (> p n) (> q m)))
         (nurbs-error :inp-err 'fit-srf-lst-sq-approx)))
  (let ((pw (make-cpoint-net (1+ n) (1+ m)))
        (knu (make-real-vector (+ n p 2)))
        (knv (make-real-vector (+ m q 2)))
        (u (make-real-vector (1+ r)))
        (v (make-real-vector (1+ s))))
    ;; parameters and knot vectors
    (fit-calc-srf-param-values pnet r s +epoint+ par u v)
    (fit-calc-knot-vector-crv-approx u r n p knu)
    (fit-calc-knot-vector-crv-approx v s m q knv)
    (%fit-srf-lst-sq-core pnet +epoint+ u v knu knv r s n m p q pw 'fit-srf-lst-sq-approx)
    (%make-surface p q knu knv pw)))

(defun fit-srf-lst-sq-knots (a r s ptp u v knu knv n m p q)
  "The least-squares surface of degrees P, Q with (N+1) x (M+1) control
points and knot vectors KNU, KNV (copied; N+P+2 and M+Q+2 knots, :inp-err
otherwise) approximating the grid A[0..R][0..S] -- a point-net when PTP is
+epoint+, a cpoint-net when +hpoint+ (:cal-err otherwise) -- at parameters
U[0..R], V[0..S], each row and column of A on an isoparameter line.  Requires
1 <= N <= R, 1 <= M <= S, P <= N, Q <= M (:inp-err otherwise, and for
parameters the fit cannot use); A is modified in place when N or M is 1, as in
the C.  Returns a fresh surface.
NLib: N_FitSrfLstSqKnots."
  (declare (type (simple-array double-float (* * *)) a) (type fixnum r s ptp n m p q)
           (type real-vector u v knu knv))
  (let ((rk (1- (length knu)))
        (sk (1- (length knv))))
    (declare (type fixnum rk sk))
    (when (or (/= rk (+ n p 1)) (/= sk (+ m q 1)))
      (nurbs-error :inp-err 'fit-srf-lst-sq-knots))
    (when (or (> n r) (< n 1) (> p n))
      (nurbs-error :inp-err 'fit-srf-lst-sq-knots))
    (when (or (> m s) (< m 1) (> q m))
      (nurbs-error :inp-err 'fit-srf-lst-sq-knots))
    (cond ((= n 1)
           (when (and (> m 1) (> q m))
             (nurbs-error :inp-err 'fit-srf-lst-sq-knots)))
          ((= m 1)
           (when (and (> n 1) (> p n))
             (nurbs-error :inp-err 'fit-srf-lst-sq-knots)))
          ((and (and (> n 1) (> m 1)) (or (> p n) (> q m)))
           (nurbs-error :inp-err 'fit-srf-lst-sq-knots)))
    (let ((pw (make-cpoint-net (1+ n) (1+ m)))
          (us (make-real-vector (1+ rk)))
          (vs (make-real-vector (1+ sk))))
      (replace us knu)
      (replace vs knv)
      (%fit-srf-lst-sq-core a ptp u v us vs r s n m p q pw 'fit-srf-lst-sq-knots)
      (%make-surface p q us vs pw))))

;;; ------------------------------------------------ surface function interpolation

(defun fit-srf-func-interp (f n m p q u v)
  "The surface function of degrees P, Q (P at least 1) interpolating the
values F[0..N][0..M] (a real-matrix) at parameters U[0..N], V[0..M], knot
vectors by fit-crv-calc-knot-vector.  Signals :inp-err for P > N or Q > M,
and whatever the banded LU solve signals.  As in the C, which writes outside
its band matrix then, the parameters must be strictly increasing (with
averaged knots each lies in the band); here such a write signals an array
index error.  Returns a fresh sfun.
NLib: N_FitSrfFuncInterp."
  (declare (type real-matrix f) (type fixnum n m p q) (type real-vector u v))
  (when (or (> p n) (> q m))
    (nurbs-error :inp-err 'fit-srf-func-interp))
  (let ((sfn (%make-sfun p q (make-real-vector (+ n p 2)) (make-real-vector (+ m q 2))
                         (make-real-matrix (1+ n) (1+ m)))))
    (multiple-value-bind (knu knv) (s-func-get-knot-vectors sfn)
      (declare (type real-vector knu knv))
      (multiple-value-bind (fn fm fuv) (srf-func-cntrl-val sfn)
        (declare (ignore fn fm) (type real-matrix fuv))
        ;; knot vectors
        (fit-crv-calc-knot-vector u n p knu)
        (fit-crv-calc-knot-vector v m q knv)
        (let ((g (make-real-vector (1+ (nl-max n m))))
              (h (make-real-vector (1+ (nl-max n m))))
              (nb (make-real-vector (1+ (nl-max p q)))))
          (declare (type real-vector g h nb))
          (flet ((band-matrix (cnt deg kn par)
                   ;; the LU-decomposed banded interpolation matrix of one
                   ;; direction: CNT the highest data index, DEG the degree
                   (declare (type fixnum cnt deg) (type real-vector kn par))
                   (let* ((bw (1- (* 2 deg)))
                          (sbw (1- deg))
                          (cm (set-real-matrix (make-rmatrix) cnt cnt +mt-banded+ bw))
                          (a (rmatrix-rm cm)))
                     (declare (type fixnum bw sbw) (type real-matrix a))
                     (dotimes (i (1+ cnt))
                       (dotimes (j bw)
                         (setf (aref a i j) 0d0)))
                     (setf (aref a 0 sbw) 1d0
                           (aref a cnt sbw) 1d0)
                     (do ((i 1 (1+ i))) ((>= i cnt))
                       (declare (type fixnum i))
                       (let* ((j (basis-eval kn deg (aref par i) +left+ nb))
                              (l (- j i 1)))
                         (declare (type fixnum j l))
                         (dotimes (k (1+ deg))
                           (setf (aref a i (+ l k)) (aref nb k)))))
                     (real-matrix-lu-decompose cm))))
            ;; interpolate in the u-direction
            (if (= p 1)
                (dotimes (i (1+ n))
                  (dotimes (j (1+ m))
                    (setf (aref fuv i j) (aref f i j))))
                (let ((cm (band-matrix n p knu u)))
                  (dotimes (j (1+ m))
                    (dotimes (i (1+ n))
                      (setf (aref g i) (aref f i j)))
                    (real-matrix-right-for-back cm g h)
                    (dotimes (i (1+ n))
                      (setf (aref fuv i j) (aref h i))))))
            ;; interpolate in the v-direction
            (when (> q 1)
              (let ((cm (band-matrix m q knv v)))
                (dotimes (i (1+ n))
                  (dotimes (j (1+ m))
                    (setf (aref g j) (aref fuv i j)))
                  (real-matrix-right-for-back cm g h)
                  (dotimes (j (1+ m))
                    (setf (aref fuv i j) (aref h j))))))))))
    sfn))

;;; ------------------------------------------------ knot removal

(defconstant +srf-fit--norem+ 1d25
  "NOREM in N_FitSrfApproxRemoveKnots: a knot found not removable.")

(defun fit-srf-approx-remove-knots (sur u-params v-params er mu mv e dir)
  "Remove from surface SUR, in place, every knot -- in the u-direction, the
v-direction or both, as DIR is +udir+, +vdir+ or +uvdir+ -- whose removal
keeps the cumulative error at the parameters U-PARAMS[0..MU] x V-PARAMS[0..MV]
within E, cheapest knot first.  ER, an (MU+1) x (MV+1) real-matrix, holds the
error bounds; as in the C its entries [0..MU-1][0..MV-1] are first zeroed and
the last row and column kept, and it is updated in place.  The parameters
must be sorted and inside the domain (:par-err otherwise, from the basis and
function evaluations).  SUR's knot vectors and control net are replaced by
shorter arrays when knots go.  A DIR other than the three, on which the C
loops for ever, signals :cal-err.  Returns SUR.
NLib: N_FitSrfApproxRemoveKnots."
  (declare (type surface sur) (type real-vector u-params v-params) (type real-matrix er)
           (type fixnum mu mv dir) (type double-float e))
  (unless (or (= dir +udir+) (= dir +vdir+) (= dir +uvdir+))
    (nurbs-error :cal-err 'fit-srf-approx-remove-knots))
  (let* ((n (surface-n sur))
         (m (surface-m sur))
         (pw (surface-cpoints sur))
         (p (surface-degree-u sur))
         (q (surface-degree-v sur))
         (uk (surface-knots-u sur))
         (vk (surface-knots-v sur))
         (r (1- (length uk)))
         (s (1- (length vk)))
         (n0 n) (m0 m)
         ;; the knot vectors N_BasisIEval sees, of highest index r and s
         (knu uk)
         (knv vk)
         (size (1+ (* 2 (nl-max p q))))
         (alf (make-real-vector size))
         (oma (make-real-vector size))
         (bet (make-real-vector size))
         (omb (make-real-vector size))
         (rw (make-cpoint-array size))
         (fuv (make-real-vector (1+ (nl-max n m))))
         (te (make-real-matrix (1+ mu) (1+ mv)))
         (in-u (or (= dir +udir+) (= dir +uvdir+)))
         (in-v (or (= dir +vdir+) (= dir +uvdir+)))
         (mru (make-real-vector (if in-u (1+ r) 0)))
         (sru (make-index-vector (if in-u (1+ r) 0)))
         (uleft (make-index-vector (if in-u (1+ n) 0)))
         (uright (make-index-vector (if in-u (1+ n) 0)))
         (bru (if in-u (make-real-matrix (1+ r) (1+ m)) (make-real-matrix 0 0)))
         (mrv (make-real-vector (if in-v (1+ s) 0)))
         (srv (make-index-vector (if in-v (1+ s) 0)))
         (vleft (make-index-vector (if in-v (1+ m) 0)))
         (vright (make-index-vector (if in-v (1+ m) 0)))
         (brv (if in-v (make-real-matrix (1+ n) (1+ s)) (make-real-matrix 0 0)))
         (lam 0d0) (oml 0d0)
         (bu 0d0) (bv 0d0)
         (ru 0) (su 0) (rv 0) (sv 0)
         (c0 (make-cpoint)) (c1 (make-cpoint)) (c2 (make-cpoint)))
    (declare (type fixnum n m p q r s n0 m0 size mu mv ru su rv sv)
             (type cpoint-net pw) (type real-vector uk vk knu knv alf oma bet omb fuv mru mrv)
             (type cpoint-array rw) (type real-matrix te bru brv)
             (type index-vector sru uleft uright srv vleft vright)
             (type double-float lam oml bu bv) (type cpoint c0 c1 c2))
    (labels ((cfun-of (cnt deg kn kr)
               ;; N_CFuncFromKnots( &cf, fuv, cnt, deg, kn, kr ): fuv is
               ;; shared in the C and refilled before each use, so the
               ;; function is made when it is used
               (declare (type fixnum cnt deg kr) (type real-vector kn))
               (c-func-from-knots (%make-cfun 0 (make-real-vector 0) (make-real-vector 0))
                                  fuv cnt deg kn kr))
             (combine-net (alpha i j beta k dst)
               ;; N_Combine2CPts( alpha, Pw[i][j], beta, Rw[k], &Rw[dst] )
               (declare (type double-float alpha beta) (type fixnum i j k dst))
               (combine-2-c-pts alpha (%net-c-pt pw i j c0) beta (%row-c-pt rw k c1) c2)
               (%c-pt-row c2 rw dst))
             (net-to-row (i j k)
               ;; N_CopyCPt( Pw[i][j], &Rw[k] )
               (declare (type fixnum i j k))
               (%c-pt-row (%net-c-pt pw i j c0) rw k))
             (row-to-net (k i j)
               ;; N_CopyCPt( Rw[k], &Pw[i][j] )
               (declare (type fixnum i j k))
               (%c-pt-net (%row-c-pt rw k c0) pw i j))
             (removed (b)
               (declare (type double-float b))
               (or (= b +bigd+) (= b +srf-fit--norem+))))
      (unwind-protect
           (progn
             ;; set the error matrix to 0s, short of its last row and column
             (dotimes (ii mu)
               (dotimes (jj mv)
                 (setf (aref er ii jj) 0d0)))
             ;; initialize
             (when in-u
               (dotimes (i (1+ r))
                 (setf (aref mru i) +bigd+
                       (aref sru i) 0)))
             (when in-v
               (dotimes (j (1+ s))
                 (setf (aref mrv j) +bigd+
                       (aref srv j) 0)))
             ;; the maximum knot removal error of each distinct knot, and
             ;; the ranges of parameter indexes
             (when in-u
               (setf ru (1+ p))
               (do () ((not (<= ru n)))
                 (let ((i ru))
                   (declare (type fixnum i))
                   (do () ((not (and (<= ru n) (= (aref uk ru) (aref uk (1+ ru))))))
                     (incf ru))
                   (setf (aref sru ru) (1+ (- ru i)))
                   (setf (aref mru ru)
                         (fit-srf-removal-boundary sur ru (aref sru ru) 0 m +udir+ bru (aref mru ru)))
                   (incf ru)))
               (let ((k 1))
                 (declare (type fixnum k))
                 (dotimes (i (1+ n))
                   (setf (aref uleft i) k)
                   (do () ((not (and (< k mu) (> (aref u-params k) (aref uk i))
                                     (<= (aref u-params k) (aref uk (1+ i))))))
                     (incf k))
                   (let ((l k))
                     (declare (type fixnum l))
                     (do () ((not (< l mu)))
                       (when (>= (aref u-params l) (aref uk (+ i p 1)))
                         (return))
                       (incf l))
                     (setf (aref uright i) (1- l))))))
             (when in-v
               (setf rv (1+ q))
               (do () ((not (<= rv m)))
                 (let ((j rv))
                   (declare (type fixnum j))
                   (do () ((not (and (<= rv m) (= (aref vk rv) (aref vk (1+ rv))))))
                     (incf rv))
                   (setf (aref srv rv) (1+ (- rv j)))
                   (setf (aref mrv rv)
                         (fit-srf-removal-boundary sur rv (aref srv rv) 0 n +vdir+ brv (aref mrv rv)))
                   (incf rv)))
               (let ((k 1))
                 (declare (type fixnum k))
                 (dotimes (j (1+ m))
                   (setf (aref vleft j) k)
                   (do () ((not (and (< k mv) (> (aref v-params k) (aref vk j))
                                     (<= (aref v-params k) (aref vk (1+ j))))))
                     (incf k))
                   (let ((l k))
                     (declare (type fixnum l))
                     (do () ((not (< l mv)))
                       (when (>= (aref v-params l) (aref vk (+ j q 1)))
                         (return))
                       (incf l))
                     (setf (aref vright j) (1- l))))))
             ;; try to remove each knot
             (do () (nil)
               ;; the knot with the smallest error
               (when in-u
                 (setf bu (aref mru (1+ p))
                       su (aref sru (1+ p))
                       ru (1+ p))
                 (do ((i (+ p 2) (1+ i))) ((> i n))
                   (declare (type fixnum i))
                   (when (< (aref mru i) bu)
                     (setf bu (aref mru i)
                           su (aref sru i)
                           ru i))))
               (when in-v
                 (setf bv (aref mrv (1+ q))
                       sv (aref srv (1+ q))
                       rv (1+ q))
                 (do ((j (+ q 2) (1+ j))) ((> j m))
                   (declare (type fixnum j))
                   (when (< (aref mrv j) bv)
                     (setf bv (aref mrv j)
                           sv (aref srv j)
                           rv j))))
               ;; no more removable knot: finished
               (when (cond ((= dir +udir+) (removed bu))
                           ((= dir +vdir+) (removed bv))
                           (t (and (removed bu) (removed bv))))
                 (return))
               ;; the C's switch; its breaks leave it, not the loop
               (block switch
                 (if (= (if (= dir +uvdir+) (if (< bu bv) +udir+ +vdir+) dir) +udir+)
                     ;; remove in the u-direction
                     (let ((rmf t) (i 0) (odd (oddp (+ p su))))
                       (declare (type fixnum i))
                       (dotimes (j (1+ m))
                         (setf (aref fuv j) (aref bru ru j)))
                       (let ((cfv (cfun-of m q vk s)))
                         (if odd
                             (let ((k (truncate (+ p su 1) 2)))
                               (declare (type fixnum k))
                               (setf i (- ru k))
                               (let* ((al (/ (- (aref uk ru) (aref uk i))
                                             (- (aref uk (+ i p 1)) (aref uk i))))
                                      (be (/ (- (aref uk ru) (aref uk (1+ i)))
                                             (- (aref uk (+ i p 2)) (aref uk (1+ i)))))
                                      (ob (- 1d0 be)))
                                 (declare (type double-float al be ob))
                                 (setf lam (/ al (+ al be))
                                       oml (- 1d0 lam))
                                 (do ((k (aref uleft i) (1+ k))) ((> k (aref uright (1+ i))))
                                   (declare (type fixnum k))
                                   (let* ((bf (basis-i-eval knu i p (aref u-params k) +left+))
                                          (n1 (basis-i-eval knu (1+ i) p (aref u-params k) +left+))
                                          (tmp (abs (- (* (* lam al) bf) (* (* oml ob) n1)))))
                                     (declare (type double-float bf n1 tmp))
                                     (do ((l 0 (1+ l))) ((> l mv))
                                       (declare (type fixnum l))
                                       (let ((fl (c-func-eval cfv (aref v-params l) +left+)))
                                         (declare (type double-float fl))
                                         (setf (aref te k l) (+ (aref er k l) (* tmp fl)))
                                         (when (> (aref te k l) e)
                                           (setf rmf nil)
                                           (return))))
                                     (unless rmf (return))))))
                             (let ((k (truncate (+ p su) 2)))
                               (declare (type fixnum k))
                               (setf i (- ru k))
                               (do ((k (aref uleft i) (1+ k))) ((> k (aref uright i)))
                                 (declare (type fixnum k))
                                 (let ((bf (basis-i-eval knu i p (aref u-params k) +left+)))
                                   (declare (type double-float bf))
                                   (do ((l 0 (1+ l))) ((> l mv))
                                     (declare (type fixnum l))
                                     (let ((fl (c-func-eval cfv (aref v-params l) +left+)))
                                       (declare (type double-float fl))
                                       (setf (aref te k l) (+ (aref er k l) (* bf fl)))
                                       (when (> (aref te k l) e)
                                         (setf rmf nil)
                                         (return))))
                                   (unless rmf (return)))))))
                       (unless rmf
                         ;; the knot is not removable
                         (setf (aref mru ru) +srf-fit--norem+)
                         (return-from switch))
                       ;; the error test passed: update the error matrix and
                       ;; remove the knot
                       (let ((a (if odd (aref uright (1+ i)) (aref uright i))))
                         (declare (type fixnum a))
                         (do ((k (aref uleft i) (1+ k))) ((> k a))
                           (declare (type fixnum k))
                           (dotimes (l (1+ mv))
                             (setf (aref er k l) (aref te k l)))))
                       (let* ((fout (truncate (- (* 2 ru) su p) 2))
                              (first (- ru p))
                              (last (- ru su))
                              (off (1- first)))
                         (declare (type fixnum fout first last off))
                         ;; save some parameters
                         (let ((i first) (j last))
                           (declare (type fixnum i j))
                           (do () ((not (> (- j i) 0)))
                             (setf (aref alf (- i first)) (/ (- (aref uk (+ i p 1)) (aref uk i))
                                                             (- (aref uk ru) (aref uk i)))
                                   (aref oma (- i first)) (- 1d0 (aref alf (- i first)))
                                   (aref bet (- j first)) (/ (- (aref uk (+ j p 1)) (aref uk j))
                                                             (- (aref uk (+ j p 1)) (aref uk ru)))
                                   (aref omb (- j first)) (- 1d0 (aref bet (- j first))))
                             (incf i)
                             (decf j)))
                         ;; remove the knot for each column
                         (dotimes (col (1+ m))
                           (let ((i first) (j last) (ii 1) (jj (- last off)))
                             (declare (type fixnum i j ii jj))
                             (net-to-row off col 0)
                             (net-to-row (1+ last) col (- (1+ last) off))
                             ;; new control points for one removal step
                             (do () ((not (> (- j i) 0)))
                               (combine-net (aref alf (- i first)) i col (aref oma (- i first)) (1- ii) ii)
                               (combine-net (aref bet (- j first)) j col (aref omb (- j first)) (1+ jj) jj)
                               (incf i) (decf j) (incf ii) (decf jj))
                             ;; save the new control points
                             (when odd
                               (%combine-2-c-pt-rows lam rw (1+ jj) oml rw (1- ii) rw (1+ jj)))
                             (setf i first
                                   j last)
                             (do () ((not (> (- j i) 0)))
                               (row-to-net (- i off) i col)
                               (row-to-net (- j off) j col)
                               (incf i) (decf j))))
                         ;; successful removal: shift down some entities
                         (when (> su 1)
                           (setf (aref sru (1- ru)) (1- (aref sru ru))))
                         (do ((i (1+ ru) (1+ i))) ((> i r))
                           (declare (type fixnum i))
                           (setf (aref mru (1- i)) (aref mru i)
                                 (aref sru (1- i)) (aref sru i)
                                 (aref uk (1- i)) (aref uk i))
                           (dotimes (j (1+ m))
                             (setf (aref bru (1- i) j) (aref bru i j))))
                         (dotimes (col (1+ m))
                           (do ((i (1+ fout) (1+ i))) ((> i n))
                             (declare (type fixnum i))
                             (%copy-c-pt-net pw i col pw (1- i) col)))
                         (decf n)
                         (decf r)
                         ;; N_SrfSetSizeIndices
                         (setf knu (subseq uk 0 (1+ r)))
                         ;; no more internal knots: finished
                         (when (if (= dir +udir+) (= n p) (and (= n p) (= m q)))
                           (return-from switch))
                         ;; update the error bounds
                         (let ((k (nl-max (- ru p) (1+ p)))
                               (l (nl-min n (- (+ ru p) su))))
                           (declare (type fixnum k l))
                           (do ((i k (1+ i))) ((> i l))
                             (declare (type fixnum i))
                             (when (and (/= (aref uk i) (aref uk (1+ i)))
                                        (/= (aref mru i) +srf-fit--norem+))
                               (setf (aref mru i)
                                     (fit-srf-removal-boundary sur i (aref sru i) 0 m +udir+ bru
                                                               (aref mru i))))))
                         (when (= dir +uvdir+)
                           (do ((j (1+ q) (1+ j))) ((> j m))
                             (declare (type fixnum j))
                             (when (and (/= (aref vk j) (aref vk (1+ j)))
                                        (/= (aref mrv j) +srf-fit--norem+))
                               (setf (aref mrv j)
                                     (fit-srf-removal-boundary sur j (aref srv j) first last +vdir+ brv
                                                               (aref mrv j))))))
                         ;; update the index ranges in the u-direction
                         (do ((i (- ru p 1) (1+ i))) ((> i (- ru su)))
                           (declare (type fixnum i))
                           (let ((k (1+ (aref uright i))))
                             (declare (type fixnum k))
                             (do () ((not (<= k mu)))
                               (when (>= (aref u-params k) (aref uk (+ i p 1)))
                                 (return))
                               (incf k))
                             (setf (aref uright i) (1- k))))
                         (do ((i (1+ (- ru su)) (1+ i))) ((> i n))
                           (declare (type fixnum i))
                           (setf (aref uleft i) (aref uleft (1+ i))
                                 (aref uright i) (aref uright (1+ i))))))
                     ;; remove in the v-direction
                     (let ((rmf t) (j 0) (odd (oddp (+ q sv))))
                       (declare (type fixnum j))
                       (dotimes (i (1+ n))
                         (setf (aref fuv i) (aref brv i rv)))
                       (let ((cfu (cfun-of n p uk r)))
                         (if odd
                             (let ((k (truncate (+ q sv 1) 2)))
                               (declare (type fixnum k))
                               (setf j (- rv k))
                               (let* ((al (/ (- (aref vk rv) (aref vk j))
                                             (- (aref vk (+ j q 1)) (aref vk j))))
                                      (be (/ (- (aref vk rv) (aref vk (1+ j)))
                                             (- (aref vk (+ j q 2)) (aref vk (1+ j)))))
                                      (ob (- 1d0 be)))
                                 (declare (type double-float al be ob))
                                 (setf lam (/ al (+ al be))
                                       oml (- 1d0 lam))
                                 (do ((l (aref vleft j) (1+ l))) ((> l (aref vright (1+ j))))
                                   (declare (type fixnum l))
                                   (let* ((bf (basis-i-eval knv j q (aref v-params l) +left+))
                                          (n1 (basis-i-eval knv (1+ j) q (aref v-params l) +left+))
                                          (tmp (abs (- (* (* lam al) bf) (* (* oml ob) n1)))))
                                     (declare (type double-float bf n1 tmp))
                                     (do ((k 0 (1+ k))) ((> k mu))
                                       (declare (type fixnum k))
                                       (let ((fl (c-func-eval cfu (aref u-params k) +left+)))
                                         (declare (type double-float fl))
                                         (setf (aref te k l) (+ (aref er k l) (* tmp fl)))
                                         (when (> (aref te k l) e)
                                           (setf rmf nil)
                                           (return))))
                                     (unless rmf (return))))))
                             (let ((k (truncate (+ q sv) 2)))
                               (declare (type fixnum k))
                               (setf j (- rv k))
                               (do ((l (aref vleft j) (1+ l))) ((> l (aref vright j)))
                                 (declare (type fixnum l))
                                 (let ((bf (basis-i-eval knv j q (aref v-params l) +left+)))
                                   (declare (type double-float bf))
                                   (do ((k 0 (1+ k))) ((> k mu))
                                     (declare (type fixnum k))
                                     (let ((fl (c-func-eval cfu (aref u-params k) +left+)))
                                       (declare (type double-float fl))
                                       (setf (aref te k l) (+ (aref er k l) (* bf fl)))
                                       (when (> (aref te k l) e)
                                         (setf rmf nil)
                                         (return))))
                                   (unless rmf (return)))))))
                       (unless rmf
                         ;; the knot is not removable
                         (setf (aref mrv rv) +srf-fit--norem+)
                         (return-from switch))
                       ;; the error test passed: update the error matrix and
                       ;; remove the knot
                       (let ((a (if odd (aref vright (1+ j)) (aref vright j))))
                         (declare (type fixnum a))
                         (do ((l (aref vleft j) (1+ l))) ((> l a))
                           (declare (type fixnum l))
                           (dotimes (k (1+ mu))
                             (setf (aref er k l) (aref te k l)))))
                       (let* ((fout (truncate (- (* 2 rv) sv q) 2))
                              (first (- rv q))
                              (last (- rv sv))
                              (off (1- first)))
                         (declare (type fixnum fout first last off))
                         ;; save some parameters
                         (let ((i first) (j last))
                           (declare (type fixnum i j))
                           (do () ((not (> (- j i) 0)))
                             (setf (aref alf (- i first)) (/ (- (aref vk (+ i q 1)) (aref vk i))
                                                             (- (aref vk rv) (aref vk i)))
                                   (aref oma (- i first)) (- 1d0 (aref alf (- i first)))
                                   (aref bet (- j first)) (/ (- (aref vk (+ j q 1)) (aref vk j))
                                                             (- (aref vk (+ j q 1)) (aref vk rv)))
                                   (aref omb (- j first)) (- 1d0 (aref bet (- j first))))
                             (incf i)
                             (decf j)))
                         ;; remove the knot for each row
                         (dotimes (row (1+ n))
                           (let ((i first) (j last) (ii 1) (jj (- last off)))
                             (declare (type fixnum i j ii jj))
                             (net-to-row row off 0)
                             (net-to-row row (1+ last) (- (1+ last) off))
                             ;; new control points for one removal step
                             (do () ((not (> (- j i) 0)))
                               (combine-net (aref alf (- i first)) row i (aref oma (- i first)) (1- ii) ii)
                               (combine-net (aref bet (- j first)) row j (aref omb (- j first)) (1+ jj) jj)
                               (incf i) (decf j) (incf ii) (decf jj))
                             ;; save the new control points
                             (when odd
                               (%combine-2-c-pt-rows lam rw (1+ jj) oml rw (1- ii) rw (1+ jj)))
                             (setf i first
                                   j last)
                             (do () ((not (> (- j i) 0)))
                               (row-to-net (- i off) row i)
                               (row-to-net (- j off) row j)
                               (incf i) (decf j))))
                         ;; successful removal: shift down some entities
                         (when (> sv 1)
                           (setf (aref srv (1- rv)) (1- (aref srv rv))))
                         (do ((j (1+ rv) (1+ j))) ((> j s))
                           (declare (type fixnum j))
                           (setf (aref mrv (1- j)) (aref mrv j)
                                 (aref srv (1- j)) (aref srv j)
                                 (aref vk (1- j)) (aref vk j))
                           (dotimes (i (1+ n))
                             (setf (aref brv i (1- j)) (aref brv i j))))
                         (dotimes (row (1+ n))
                           (do ((j (1+ fout) (1+ j))) ((> j m))
                             (declare (type fixnum j))
                             (%copy-c-pt-net pw row j pw row (1- j))))
                         (decf m)
                         (decf s)
                         ;; N_SrfSetSizeIndices
                         (setf knv (subseq vk 0 (1+ s)))
                         ;; no more internal knots: finished
                         (when (if (= dir +vdir+) (= m q) (and (= n p) (= m q)))
                           (return-from switch))
                         ;; update the error bounds
                         (let ((k (nl-max (- rv q) (1+ q)))
                               (l (nl-min m (- (+ rv q) sv))))
                           (declare (type fixnum k l))
                           (do ((j k (1+ j))) ((> j l))
                             (declare (type fixnum j))
                             (when (and (/= (aref vk j) (aref vk (1+ j)))
                                        (/= (aref mrv j) +srf-fit--norem+))
                               (setf (aref mrv j)
                                     (fit-srf-removal-boundary sur j (aref srv j) 0 n +vdir+ brv
                                                               (aref mrv j))))))
                         (when (= dir +uvdir+)
                           (do ((i (1+ p) (1+ i))) ((> i n))
                             (declare (type fixnum i))
                             (when (and (/= (aref uk i) (aref uk (1+ i)))
                                        (/= (aref mru i) +srf-fit--norem+))
                               (setf (aref mru i)
                                     (fit-srf-removal-boundary sur i (aref sru i) first last +udir+ bru
                                                               (aref mru i))))))
                         ;; update the index ranges in the v-direction
                         (do ((j (- rv q 1) (1+ j))) ((> j (- rv sv)))
                           (declare (type fixnum j))
                           (let ((k (1+ (aref vright j))))
                             (declare (type fixnum k))
                             (do () ((not (<= k mv)))
                               (when (>= (aref v-params k) (aref vk (+ j q 1)))
                                 (return))
                               (incf k))
                             (setf (aref vright j) (1- k))))
                         (do ((j (1+ (- rv sv)) (1+ j))) ((> j m))
                           (declare (type fixnum j))
                           (setf (aref vleft j) (aref vleft (1+ j))
                                 (aref vright j) (aref vright (1+ j))))))))))
        ;; SUR keeps the knots and control points left, as N_SrfSetSizeIndices
        ;; records them in C
        (when (/= n n0)
          (setf (surface-knots-u sur) (subseq uk 0 (1+ r))))
        (when (/= m m0)
          (setf (surface-knots-v sur) (subseq vk 0 (1+ s))))
        (when (or (/= n n0) (/= m m0))
          (let ((net (make-cpoint-net (1+ n) (1+ m))))
            (dotimes (i (1+ n))
              (dotimes (j (1+ m))
                (%copy-c-pt-net pw i j net i j)))
            (setf (surface-cpoints sur) net))))))
  sur)
