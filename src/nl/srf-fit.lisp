(in-package :batten)

(defun fit-srf-removal-boundary (sur r s f l dir br mr)
  "Update the knot removal error bounds BR (a real-matrix indexed by control
point row and column) and the maximum error MR for removing once the knot of
index R and multiplicity S of surface SUR in direction DIR (+udir+ or
+vdir+), over rows/columns F..L of the other direction.  T[r] must be an
interior knot with T[r] /= T[r+1] and S > 0; these are not checked.  MR equal
to +bigd+ is first reset to -1.  BR is updated in place; returns the new MR.
As in the C, which returns NL_NO even then, a DIR other than +udir+ or +vdir+
updates nothing and signals nothing.  NLib: N_FitSrfRemovalBoundary."
  (declare (type surface sur) (type fixnum r s f l dir) (type real-matrix br)
           (type double-float mr))
  (let* ((p (surface-degree-u sur))
         (q (surface-degree-v sur))
         (pw (surface-cpoints sur))
         (udir (= dir +udir+))
         (deg (if udir p q))
         (knots (if udir (surface-knots-u sur) (surface-knots-v sur)))
         (size (1+ (* 2 (nl-max p q))))
         (alf (make-real-vector size))
         (oma (make-real-vector size))
         (bet (make-real-vector size))
         (omb (make-real-vector size))
         (rw (make-array size))
         (a (make-cpoint))
         (pt (make-cpoint)))
    (declare (type fixnum p q deg size) (type cpoint-net pw) (type real-vector knots alf oma bet omb)
             (type simple-vector rw) (type cpoint a pt))
    (dotimes (k size) (setf (svref rw k) (make-cpoint)))
    (when (= mr +bigd+)
      (setf mr -1d0))
    (unless (or (= dir +udir+) (= dir +vdir+))
      ;; NL_ERROR(NL_CAL_ERR), but the routine returns NL_NO
      (return-from fit-srf-removal-boundary mr))
    (flet ((net (k other)
             ;; Pw[k][col] removing in u, Pw[row][k] removing in v
             (if udir
                 (%net-c-pt pw k other pt)
                 (%net-c-pt pw other k pt)))
           (rw (k) (the cpoint (svref rw k))))
      (declare (inline net rw))
      (let* ((first (- r deg))
             (last (- r s))
             (off (1- first))
             (i first)
             (j last)
             (del 0d0)
             (omd 0d0))
        (declare (type fixnum first last off i j) (type double-float del omd))
        ;; save some parameters
        (do () ((not (> (- j i) 0)))
          (setf (aref alf (- i first)) (/ (- (aref knots (+ i deg 1)) (aref knots i))
                                          (- (aref knots r) (aref knots i)))
                (aref oma (- i first)) (- 1d0 (aref alf (- i first)))
                (aref bet (- j first)) (/ (- (aref knots (+ j deg 1)) (aref knots j))
                                          (- (aref knots (+ j deg 1)) (aref knots r)))
                (aref omb (- j first)) (- 1d0 (aref bet (- j first))))
          (incf i)
          (decf j))
        (setf del (/ (- (aref knots r) (aref knots i))
                     (- (aref knots (+ i deg 1)) (aref knots i)))
              omd (- 1d0 del))
        ;; update the maximum error for the requested rows/columns
        (do ((other f (1+ other))) ((> other l))
          (declare (type fixnum other))
          (let ((ii 1)
                (jj (- last off))
                (dw 0d0))
            (declare (type fixnum ii jj) (type double-float dw))
            (setf i first
                  j last)
            (copy-c-pt (net off other) (rw 0))
            (copy-c-pt (net (1+ last) other) (rw (- (1+ last) off)))
            ;; new control points for one removal step
            (do () ((not (> (- j i) 0)))
              (combine-2-c-pts (aref alf (- i first)) (net i other)
                               (aref oma (- i first)) (rw (1- ii)) (rw ii))
              (combine-2-c-pts (aref bet (- j first)) (net j other)
                               (aref omb (- j first)) (rw (1+ jj)) (rw jj))
              (incf i)
              (decf j)
              (incf ii)
              (decf jj))
            ;; the error
            (if (< (- j i) 0)
                (setf dw (dist-cpt-cpt-homo (rw (1- ii)) (rw (1+ jj))))
                (progn
                  (combine-2-c-pts del (rw (1+ jj)) omd (rw (1- ii)) a)
                  (setf dw (dist-cpt-cpt-homo (net i other) a))))
            (if udir
                (incf (aref br r other) dw)
                (incf (aref br other r) dw))
            (when (> dw mr)
              (setf mr dw))))))
    mr))

;;; ------------------------------------------------ least-squares surface fits

(defun fit-calc-srf-param-values (a n m ptp par u v)
  "Write into U[0..N] and V[0..M] (allocated by the caller) parameters for
global surface interpolation of the grid A[0..N][0..M] (a point-net when PTP
is +epoint+, a cpoint-net when +hpoint+), each row and column of points on an
isoparameter line.  PAR is +uniform+, +chordlength+ or +centripetal+ (the
averaged square roots of the chord lengths).  Signals :cal-err for an unknown
PAR or PTP and :inp-err when every row (or every column) has total chord
length not above *mtol*; U, and for the v error V too, are partly written
then, as in the C.  Returns U.
NLib: N_FitCalcSrfParamValues."
  (declare (type (simple-array double-float (* * *)) a) (type fixnum n m ptp par)
           (type real-vector u v))
  (unless (or (= par +uniform+) (= par +chordlength+) (= par +centripetal+))
    (nurbs-error :cal-err 'fit-calc-srf-param-values))
  (unless (or (= ptp +epoint+) (= ptp +hpoint+))
    (nurbs-error :cal-err 'fit-calc-srf-param-values))
  (setf (aref u 0) 0d0
        (aref u n) 1d0
        (aref v 0) 0d0
        (aref v m) 1d0)
  (when (= par +uniform+)
    (let ((d (/ 1d0 (float n 1d0))))
      (declare (type double-float d))
      (do ((i 1 (1+ i))) ((>= i n))
        (declare (type fixnum i))
        (setf (aref u i) (* (float i 1d0) d)))
      (setf d (/ 1d0 (float m 1d0)))
      (do ((j 1 (1+ j))) ((>= j m))
        (declare (type fixnum j))
        (setf (aref v j) (* (float j 1d0) d))))
    (return-from fit-calc-srf-param-values u))
  (let ((dist (make-real-vector (1+ (nl-max n m))))
        (p0 (make-point)) (p1 (make-point))
        (q0 (make-cpoint)) (q1 (make-cpoint))
        (epoint (= ptp +epoint+))
        (centripetal (= par +centripetal+))
        (mtol *mtol*))
    (declare (type real-vector dist) (type point p0 p1) (type cpoint q0 q1)
             (type double-float mtol) (dynamic-extent p0 p1 q0 q1))
    (flet ((dist (i0 j0 i1 j1)
             (declare (type fixnum i0 j0 i1 j1))
             (let ((dd (if epoint
                           (dist-pt-pt (%net-pt a i0 j0 p0) (%net-pt a i1 j1 p1))
                           (dist-cpt-cpt-homo (%net-c-pt a i0 j0 q0) (%net-c-pt a i1 j1 q1)))))
               (declare (type double-float dd))
               (if centripetal (c-sqrt dd) dd))))
      (declare (inline dist))
      ;; u-directional parameters
      (do ((i 1 (1+ i))) ((>= i n))
        (declare (type fixnum i))
        (setf (aref u i) 0d0))
      (let ((num (1+ m)))
        (declare (type fixnum num))
        (do ((j 0 (1+ j))) ((> j m))
          (declare (type fixnum j))
          (let ((sum 0d0))
            (declare (type double-float sum))
            (do ((i 1 (1+ i))) ((> i n))
              (declare (type fixnum i))
              (setf (aref dist i) (dist (1- i) j i j))
              (setf sum (+ sum (aref dist i))))
            (if (> sum mtol)
                (let ((d 0d0))
                  (declare (type double-float d))
                  (do ((i 1 (1+ i))) ((>= i n))
                    (declare (type fixnum i))
                    (setf d (+ d (aref dist i)))
                    (setf (aref u i) (+ (aref u i) (/ d sum)))))
                (decf num))))
        (when (= num 0)
          (nurbs-error :inp-err 'fit-calc-srf-param-values))
        (do ((i 1 (1+ i))) ((>= i n))
          (declare (type fixnum i))
          (setf (aref u i) (/ (aref u i) (float num 1d0)))))
      ;; v-directional parameters
      (do ((j 1 (1+ j))) ((>= j m))
        (declare (type fixnum j))
        (setf (aref v j) 0d0))
      (let ((num (1+ n)))
        (declare (type fixnum num))
        (do ((i 0 (1+ i))) ((> i n))
          (declare (type fixnum i))
          (let ((sum 0d0))
            (declare (type double-float sum))
            (do ((j 1 (1+ j))) ((> j m))
              (declare (type fixnum j))
              (setf (aref dist j) (dist i (1- j) i j))
              (setf sum (+ sum (aref dist j))))
            (if (> sum mtol)
                (let ((d 0d0))
                  (declare (type double-float d))
                  (do ((j 1 (1+ j))) ((>= j m))
                    (declare (type fixnum j))
                    (setf d (+ d (aref dist j)))
                    (setf (aref v j) (+ (aref v j) (/ d sum)))))
                (decf num))))
        (when (= num 0)
          (nurbs-error :inp-err 'fit-calc-srf-param-values))
        (do ((j 1 (1+ j))) ((>= j m))
          (declare (type fixnum j))
          (setf (aref v j) (/ (aref v j) (float num 1d0)))))))
  u)

(defun fit-srf-to-pts-knots (a n m ptp u v knu knv p q)
  "The surface of degrees P, Q (each at least 1) with knot vectors KNU, KNV
(copied; N+P+2 and M+Q+2 knots, :inp-err otherwise) interpolating the grid
A[0..N][0..M] -- a point-net when PTP is +epoint+, a cpoint-net when +hpoint+
(:cal-err otherwise) -- at parameters U[0..N], V[0..M], each row and column of
A on an isoparameter line.  Signals :inp-err for P > N or Q > M and for a
parameter outside the band the knots allow, and whatever the banded LU solve
signals (:num-err for a singular system).  Returns a fresh surface.
NLib: N_FitSrfToPtsKnots."
  (declare (type (simple-array double-float (* * *)) a) (type fixnum n m ptp p q)
           (type real-vector u v knu knv))
  (let ((r (1- (length knu)))
        (s (1- (length knv)))
        (rs (+ n p 1))
        (ss (+ m q 1)))
    (declare (type fixnum r s rs ss))
    (when (or (/= r rs) (/= s ss))
      (nurbs-error :inp-err 'fit-srf-to-pts-knots))
    (when (or (> p n) (> q m))
      (nurbs-error :inp-err 'fit-srf-to-pts-knots))
    (let ((pw (make-cpoint-net (1+ n) (1+ m)))
          (us (make-real-vector (1+ r)))
          (vs (make-real-vector (1+ s)))
          (rw (make-cpoint-array (1+ (nl-max n m))))
          (nb (make-real-vector (1+ (nl-max p q))))
          (pt (make-point))
          (cp (make-cpoint)))
      (declare (type cpoint-net pw) (type real-vector us vs nb) (type cpoint-array rw)
               (type point pt) (type cpoint cp))
      (replace us knu)
      (replace vs knv)
      (flet ((band-matrix (cnt deg kn par)
               ;; the LU-decomposed banded interpolation matrix of one
               ;; direction: CNT the highest data index, DEG the degree
               (declare (type fixnum cnt deg) (type real-vector kn par))
               (let* ((bw (1- (* 2 deg)))
                      (sbw (1- deg))
                      (cm (set-real-matrix (make-rmatrix) cnt cnt +mt-banded+ bw))
                      (b (rmatrix-rm cm)))
                 (declare (type fixnum bw sbw) (type real-matrix b))
                 (dotimes (i (1+ cnt))
                   (dotimes (j bw)
                     (setf (aref b i j) 0d0)))
                 (setf (aref b 0 sbw) 1d0
                       (aref b cnt sbw) 1d0)
                 (do ((i 1 (1+ i))) ((>= i cnt))
                   (declare (type fixnum i))
                   (let* ((j (basis-eval kn deg (aref par i) +left+ nb))
                          (l (- j i 1)))
                     (declare (type fixnum j l))
                     (when (or (< l 0) (>= (+ l deg) bw))
                       (nurbs-error :inp-err 'fit-srf-to-pts-knots))
                     (dotimes (k (1+ deg))
                       (setf (aref b i (+ l k)) (aref nb k)))))
                 (real-matrix-lu-decompose cm))))
        ;; interpolate in the u-direction
        (if (= p 1)
            (cond ((= ptp +epoint+)
                   (dotimes (i (1+ n))
                     (dotimes (j (1+ m))
                       (%c-pt-net (pt-to-c-pt (%net-pt a i j pt) cp) pw i j))))
                  ((= ptp +hpoint+)
                   (dotimes (i (1+ n))
                     (dotimes (j (1+ m))
                       (%copy-c-pt-net a i j pw i j))))
                  (t (nurbs-error :cal-err 'fit-srf-to-pts-knots)))
            (let ((cm (band-matrix n p knu u)))
              (dotimes (j (1+ m))
                (fit-crv-c-pts-from-srf-data a n m ptp j +udir+ cm rw)
                (dotimes (i (1+ n))
                  (%c-pt-net (%row-c-pt rw i cp) pw i j)))))
        ;; interpolate in the v-direction
        (when (> q 1)
          (let ((cm (band-matrix m q knv v)))
            (dotimes (i (1+ n))
              (fit-crv-c-pts-from-srf-data pw n m +hpoint+ i +vdir+ cm rw)
              (dotimes (j (1+ m))
                (%c-pt-net (%row-c-pt rw j cp) pw i j))))))
      (%make-surface p q us vs pw))))

(defun %fit-srf-lst-sq-core (a ptp u v knu knv r s n m p q pw rname)
  "The common body of N_FitSrfLstSqApprox and N_FitSrfLstSqKnots, from their
special cases on: write into PW, the (N+1) x (M+1) cpoint-net of the fitted
surface, the least-squares control points for grid A[0..R][0..S] (a point-net
for PTP +epoint+, a cpoint-net for +hpoint+) at parameters U, V with knot
vectors KNU, KNV and degrees P, Q.  A is modified in place when N or M is 1,
as in the C.  Errors are signaled for RNAME.  Returns PW."
  (declare (type (simple-array double-float (* * *)) a) (type fixnum ptp r s n m p q)
           (type real-vector u v knu knv) (type cpoint-net pw))
  (let ((epoint (= ptp +epoint+))
        (cp (make-cpoint))
        (pt (make-point)))
    (declare (type cpoint cp) (type point pt))
    (unless (or epoint (= ptp +hpoint+))
      (nurbs-error :cal-err rname))
    (flet ((corner (i j k l)
             ;; N_PtToCPt( S[i][j], &Pw[k][l] ) or N_CopyCPt( Sw[i][j], &Pw[k][l] )
             (declare (type fixnum i j k l))
             (if epoint
                 (%c-pt-net (pt-to-c-pt (%net-pt a i j pt) cp) pw k l)
                 (%copy-c-pt-net a i j pw k l)))
           (copy-entry (i j k l)
             ;; N_CopyPt( S[i][j], &S[k][l] ) or N_CopyCPt( Sw[i][j], &Sw[k][l] )
             (declare (type fixnum i j k l))
             (if epoint
                 (%pt-net (copy-pt (%net-pt a i j pt) pt) a k l)
                 (%copy-c-pt-net a i j a k l))))
      ;; handle special cases
      (when (and (= n 1) (= m 1))
        (corner 0 0 0 0)
        (corner r 0 1 0)
        (corner 0 s 0 1)
        (corner r s 1 1)
        (return-from %fit-srf-lst-sq-core pw))
      (when (= n 1)
        (do ((j 0 (1+ j))) ((> j s))
          (declare (type fixnum j))
          (copy-entry r j 1 j)))
      (when (= m 1)
        (do ((i 0 (1+ i))) ((> i r))
          (declare (type fixnum i))
          (copy-entry i s i 1))))
    ;; allocate memory, sized as the C sizes it
    (let* ((ub (1+ (* 2 p)))
           (vb (1+ (* 2 q)))
           (usb p)
           (vsb q)
           (ia (nl-max (- r 2) (- s 2)))
           (ka (nl-max p q))
           (ja (nl-max (- n 2) (- m 2)))
           (la (nl-max (1- ub) (1- vb)))
           (am (make-real-matrix (1+ ia) (1+ ka)))
           (ntn (make-real-matrix (1+ ja) (1+ la)))
           (nb (make-real-vector (1+ ka)))
           (ts (make-real-vector (1+ ia)))
           (te (make-real-vector (1+ ia)))
           (index (make-index-vector (1+ ia)))
           (start (make-index-vector (1+ ja)))
           (end (make-index-vector (1+ ja)))
           (rk (make-point-array (1+ ia)))
           (rr (make-point-array (1+ ja)))
           (rkw (make-cpoint-array (1+ ia)))
           (rw (make-cpoint-array (1+ ja)))
           (aw (make-cpoint-array (1+ ja)))
           (qw (make-cpoint-net (1+ n) (1+ s)))
           (cm (make-rmatrix))
           (p0 (make-point)) (p1 (make-point)) (p2 (make-point)) (p3 (make-point))
           (c0 (make-cpoint)) (c1 (make-cpoint)) (c2 (make-cpoint)) (c3 (make-cpoint)))
      (declare (type fixnum ub vb usb vsb ia ka ja la)
               (type real-matrix am ntn) (type real-vector nb ts te)
               (type index-vector index start end) (type point-array rk rr)
               (type cpoint-array rkw rw aw) (type cpoint-net qw)
               (type point p0 p1 p2 p3) (type cpoint c0 c1 c2 c3))
      (labels ((coefficients (rs ns deg kn par bw sbw)
                 ;; the banded normal matrix of one direction, LU-decomposed
                 ;; into CM, and the end basis functions TS, TE: RS is the
                 ;; highest data index, NS the highest control point index
                 (declare (type fixnum rs ns deg bw sbw) (type real-vector kn par))
                 (let ((rj deg) (sj (1- deg)) (ej -2))
                   (declare (type fixnum rj sj ej))
                   (do ((i 0 (1+ i))) ((> i (- ns 2)))
                     (declare (type fixnum i))
                     (dotimes (j bw)
                       (setf (aref ntn i j) 0d0)))
                   (do ((i 0 (1+ i))) ((> i (- rs 2)))
                     (declare (type fixnum i))
                     (setf (aref am i deg) 0d0))
                   (do ((i 0 (1+ i))) ((> i (nl-min (1- deg) (- ns 2))))
                     (declare (type fixnum i))
                     (setf (aref start i) 0))
                   (setf (aref end 0) -2)
                   (do ((i 1 (1+ i))) ((> i (1- rs)))
                     (declare (type fixnum i))
                     (let* ((j (basis-eval kn deg (aref par i) +left+ nb))
                            (l (if (= j deg) 1 0))
                            (hk (if (or (= j deg) (= j ns)) (1- deg) deg)))
                       (declare (type fixnum j l hk))
                       (do ((k 0 (1+ k))) ((> k hk))
                         (declare (type fixnum k))
                         (setf (aref am (1- i) k) (aref nb (+ l k))))
                       (setf (aref index (1- i)) (nl-max 0 (- j deg 1)))
                       (when (> j rj)
                         (do ((k 1 (1+ k))) ((> k (- j rj)))
                           (declare (type fixnum k))
                           (incf sj)
                           (incf ej)
                           (when (<= sj (- ns 2))
                             (setf (aref start sj) (1- i)))
                           (when (>= ej 0)
                             (setf (aref end ej) (- i 2))))
                         (setf rj j))))
                   (when (or (< sj (- ns 2)) (= (aref end 0) -1))
                     (nurbs-error :inp-err rname))
                   (do ((i (nl-max 0 (1+ ej)) (1+ i))) ((> i (- ns 2)))
                     (declare (type fixnum i))
                     (setf (aref end i) (- rs 2)))
                   (fast
                     (do ((i 0 (1+ i))) ((> i (- ns 2)))
                       (declare (type fixnum i))
                       (let ((lj (nl-max 0 (- i deg)))
                             (hj (nl-min (- ns 2) (+ i deg))))
                         (declare (type fixnum lj hj))
                         (do ((j lj (1+ j))) ((> j hj))
                           (declare (type fixnum j))
                           (let ((lk (nl-max (aref start i) (aref start j)))
                                 (hk (nl-min (aref end i) (aref end j))))
                             (declare (type fixnum lk hk))
                             (do ((k lk (1+ k))) ((> k hk))
                               (declare (type fixnum k))
                               (setf (aref ntn i (+ (- j i) sbw))
                                     (+ (aref ntn i (+ (- j i) sbw))
                                        (* (aref am k (- i (aref index k)))
                                           (aref am k (- j (aref index k))))))))))))
                   (create-real-matrix cm (- ns 2) (- ns 2) ntn +mt-banded+ bw)
                   (real-matrix-lu-decompose cm)
                   (do ((i 1 (1+ i))) ((> i (1- rs)))
                     (declare (type fixnum i))
                     (setf (aref ts (1- i)) (basis-i-eval kn 0 deg (aref par i) +left+))
                     (setf (aref te (1- i)) (basis-i-eval kn ns deg (aref par i) +left+)))))
               (solve-e (rs ns fetch store)
                 ;; one row of Euclidean data: FETCH writes data point k
                 ;; (0..RS) into a point, STORE puts a cpoint at control
                 ;; point k (0..NS)
                 (declare (type fixnum rs ns) (type function fetch store))
                 (funcall store 0 (pt-to-c-pt (funcall fetch 0 p0) c0))
                 (funcall store ns (pt-to-c-pt (funcall fetch rs p0) c0))
                 (do ((i 1 (1+ i))) ((> i (1- rs)))
                   (declare (type fixnum i))
                   (funcall fetch i p1)
                   (funcall fetch 0 p0)
                   (funcall fetch rs p2)
                   (translate-sum-2-pts p1 (- (aref ts (1- i))) p0 (- (aref te (1- i))) p2 p3)
                   (%pt-row p3 rk (1- i)))
                 (do ((i 1 (1+ i))) ((> i (1- ns)))
                   (declare (type fixnum i))
                   (set-point p3 0d0 0d0 0d0)
                   (do ((k (aref start (1- i)) (1+ k))) ((> k (aref end (1- i))))
                     (declare (type fixnum k))
                     ;; B[k][i - index[k] - 1]: the C's rows are contiguous,
                     ;; and unsorted parameters take the column out of the band
                     (vector-blend-pt (row-major-aref am (+ (* k (array-dimension am 1))
                                                            (- i (aref index k) 1)))
                                      (%row-pt rk k p0) p3))
                   (%pt-row p3 rr (1- i)))
                 (real-matrix-for-back cm rr +epoint+ aw)
                 (do ((i 0 (1+ i))) ((> i (- ns 2)))
                   (declare (type fixnum i))
                   (funcall store (1+ i) (%row-c-pt aw i c0))))
               (solve-h (rs ns fetch store)
                 ;; one row of homogeneous data: FETCH writes data point k
                 ;; into a cpoint
                 (declare (type fixnum rs ns) (type function fetch store))
                 (funcall store 0 (copy-c-pt (funcall fetch 0 c0) c3))
                 (funcall store ns (copy-c-pt (funcall fetch rs c0) c3))
                 (do ((i 1 (1+ i))) ((> i (1- rs)))
                   (declare (type fixnum i))
                   (funcall fetch i c1)
                   (funcall fetch 0 c0)
                   (funcall fetch rs c2)
                   (translate-sum-2-c-pts c1 (- (aref ts (1- i))) c0 (- (aref te (1- i))) c2 c3)
                   (%c-pt-row c3 rkw (1- i)))
                 (do ((i 1 (1+ i))) ((> i (1- ns)))
                   (declare (type fixnum i))
                   (set-cpoint c3 0d0 0d0 0d0 0d0)
                   (do ((k (aref start (1- i)) (1+ k))) ((> k (aref end (1- i))))
                     (declare (type fixnum k))
                     (vector-blend-c-pt (row-major-aref am (+ (* k (array-dimension am 1))
                                                              (- i (aref index k) 1)))
                                        (%row-c-pt rkw k c0) c3))
                   (%c-pt-row c3 rw (1- i)))
                 (real-matrix-for-back cm rw +hpoint+ aw)
                 (do ((i 0 (1+ i))) ((> i (- ns 2)))
                   (declare (type fixnum i))
                   (funcall store (1+ i) (%row-c-pt aw i c0)))))
        ;; u-directional approximation
        (when (> n 1)
          (coefficients r n p knu u ub usb)
          (let ((dst (if (= m 1) pw qw)))
            (declare (type cpoint-net dst))
            (do ((j 0 (1+ j))) ((> j (if (= m 1) 1 s)))
              (declare (type fixnum j))
              (flet ((store (k c) (%c-pt-net c dst k j)))
                (if epoint
                    (solve-e r n (lambda (k x) (%net-pt a k j x)) #'store)
                    (solve-h r n (lambda (k x) (%net-c-pt a k j x)) #'store))))))
        ;; v-directional approximation
        (when (> m 1)
          (coefficients s m q knv v vb vsb)
          (do ((i 0 (1+ i))) ((> i n))
            (declare (type fixnum i))
            (flet ((store (k c) (%c-pt-net c pw i k)))
              (cond ((/= n 1)
                     (solve-h s m (lambda (k x) (%net-c-pt qw i k x)) #'store))
                    (epoint
                     (solve-e s m (lambda (k x) (%net-pt a i k x)) #'store))
                    (t
                     (solve-h s m (lambda (k x) (%net-c-pt a i k x)) #'store))))))))
    pw))

(defun fit-srf-lst-sq-approx (pnet r s n m p q par)
  "The least-squares surface of degrees P, Q with (N+1) x (M+1) control
points approximating the grid of points PNET[0..R][0..S] (a point-net),
each row and column of points placed on an isoparameter line: parameters by
PAR (+uniform+, +chordlength+ or +centripetal+), knot vectors by
fit-calc-knot-vector-crv-approx.  Requires 1 <= N <= R, 1 <= M <= S, P <= N,
Q <= M (:inp-err otherwise, and for parameters the fit cannot use); PNET is
modified in place when N or M is 1, as in the C.  Returns a fresh surface.
NLib: N_FitSrfLstSqApprox."
  (declare (type point-net pnet) (type fixnum r s n m p q par))
  (when (or (> n r) (< n 1) (> p n))
    (nurbs-error :inp-err 'fit-srf-lst-sq-approx))
  (when (or (> m s) (< m 1) (> q m))
    (nurbs-error :inp-err 'fit-srf-lst-sq-approx))
  (cond ((= n 1)
         (when (and (> m 1) (> q m))
           (nurbs-error :inp-err 'fit-srf-lst-sq-approx)))
        ((= m 1)
         (when (and (> n 1) (> p n))
           (nurbs-error :inp-err 'fit-srf-lst-sq-approx)))
        ((and (and (> n 1) (> m 1)) (or (> p n) (> q m)))
         (nurbs-error :inp-err 'fit-srf-lst-sq-approx)))
  (let ((pw (make-cpoint-net (1+ n) (1+ m)))
        (knu (make-real-vector (+ n p 2)))
        (knv (make-real-vector (+ m q 2)))
        (u (make-real-vector (1+ r)))
        (v (make-real-vector (1+ s))))
    ;; parameters and knot vectors
    (fit-calc-srf-param-values pnet r s +epoint+ par u v)
    (fit-calc-knot-vector-crv-approx u r n p knu)
    (fit-calc-knot-vector-crv-approx v s m q knv)
    (%fit-srf-lst-sq-core pnet +epoint+ u v knu knv r s n m p q pw 'fit-srf-lst-sq-approx)
    (%make-surface p q knu knv pw)))

(defun fit-srf-lst-sq-knots (a r s ptp u v knu knv n m p q)
  "The least-squares surface of degrees P, Q with (N+1) x (M+1) control
points and knot vectors KNU, KNV (copied; N+P+2 and M+Q+2 knots, :inp-err
otherwise) approximating the grid A[0..R][0..S] -- a point-net when PTP is
+epoint+, a cpoint-net when +hpoint+ (:cal-err otherwise) -- at parameters
U[0..R], V[0..S], each row and column of A on an isoparameter line.  Requires
1 <= N <= R, 1 <= M <= S, P <= N, Q <= M (:inp-err otherwise, and for
parameters the fit cannot use); A is modified in place when N or M is 1, as in
the C.  Returns a fresh surface.
NLib: N_FitSrfLstSqKnots."
  (declare (type (simple-array double-float (* * *)) a) (type fixnum r s ptp n m p q)
           (type real-vector u v knu knv))
  (let ((rk (1- (length knu)))
        (sk (1- (length knv))))
    (declare (type fixnum rk sk))
    (when (or (/= rk (+ n p 1)) (/= sk (+ m q 1)))
      (nurbs-error :inp-err 'fit-srf-lst-sq-knots))
    (when (or (> n r) (< n 1) (> p n))
      (nurbs-error :inp-err 'fit-srf-lst-sq-knots))
    (when (or (> m s) (< m 1) (> q m))
      (nurbs-error :inp-err 'fit-srf-lst-sq-knots))
    (cond ((= n 1)
           (when (and (> m 1) (> q m))
             (nurbs-error :inp-err 'fit-srf-lst-sq-knots)))
          ((= m 1)
           (when (and (> n 1) (> p n))
             (nurbs-error :inp-err 'fit-srf-lst-sq-knots)))
          ((and (and (> n 1) (> m 1)) (or (> p n) (> q m)))
           (nurbs-error :inp-err 'fit-srf-lst-sq-knots)))
    (let ((pw (make-cpoint-net (1+ n) (1+ m)))
          (us (make-real-vector (1+ rk)))
          (vs (make-real-vector (1+ sk))))
      (replace us knu)
      (replace vs knv)
      (%fit-srf-lst-sq-core a ptp u v us vs r s n m p q pw 'fit-srf-lst-sq-knots)
      (%make-surface p q us vs pw))))

;;; ------------------------------------------------ surface function interpolation

(defun fit-srf-func-interp (f n m p q u v)
  "The surface function of degrees P, Q (P at least 1) interpolating the
values F[0..N][0..M] (a real-matrix) at parameters U[0..N], V[0..M], knot
vectors by fit-crv-calc-knot-vector.  Signals :inp-err for P > N or Q > M,
and whatever the banded LU solve signals.  As in the C, which writes outside
its band matrix then, the parameters must be strictly increasing (with
averaged knots each lies in the band); here such a write signals an array
index error.  Returns a fresh sfun.
NLib: N_FitSrfFuncInterp."
  (declare (type real-matrix f) (type fixnum n m p q) (type real-vector u v))
  (when (or (> p n) (> q m))
    (nurbs-error :inp-err 'fit-srf-func-interp))
  (let ((sfn (%make-sfun p q (make-real-vector (+ n p 2)) (make-real-vector (+ m q 2))
                         (make-real-matrix (1+ n) (1+ m)))))
    (multiple-value-bind (knu knv) (s-func-get-knot-vectors sfn)
      (declare (type real-vector knu knv))
      (multiple-value-bind (fn fm fuv) (srf-func-cntrl-val sfn)
        (declare (ignore fn fm) (type real-matrix fuv))
        ;; knot vectors
        (fit-crv-calc-knot-vector u n p knu)
        (fit-crv-calc-knot-vector v m q knv)
        (let ((g (make-real-vector (1+ (nl-max n m))))
              (h (make-real-vector (1+ (nl-max n m))))
              (nb (make-real-vector (1+ (nl-max p q)))))
          (declare (type real-vector g h nb))
          (flet ((band-matrix (cnt deg kn par)
                   ;; the LU-decomposed banded interpolation matrix of one
                   ;; direction: CNT the highest data index, DEG the degree
                   (declare (type fixnum cnt deg) (type real-vector kn par))
                   (let* ((bw (1- (* 2 deg)))
                          (sbw (1- deg))
                          (cm (set-real-matrix (make-rmatrix) cnt cnt +mt-banded+ bw))
                          (a (rmatrix-rm cm)))
                     (declare (type fixnum bw sbw) (type real-matrix a))
                     (dotimes (i (1+ cnt))
                       (dotimes (j bw)
                         (setf (aref a i j) 0d0)))
                     (setf (aref a 0 sbw) 1d0
                           (aref a cnt sbw) 1d0)
                     (do ((i 1 (1+ i))) ((>= i cnt))
                       (declare (type fixnum i))
                       (let* ((j (basis-eval kn deg (aref par i) +left+ nb))
                              (l (- j i 1)))
                         (declare (type fixnum j l))
                         (dotimes (k (1+ deg))
                           (setf (aref a i (+ l k)) (aref nb k)))))
                     (real-matrix-lu-decompose cm))))
            ;; interpolate in the u-direction
            (if (= p 1)
                (dotimes (i (1+ n))
                  (dotimes (j (1+ m))
                    (setf (aref fuv i j) (aref f i j))))
                (let ((cm (band-matrix n p knu u)))
                  (dotimes (j (1+ m))
                    (dotimes (i (1+ n))
                      (setf (aref g i) (aref f i j)))
                    (real-matrix-right-for-back cm g h)
                    (dotimes (i (1+ n))
                      (setf (aref fuv i j) (aref h i))))))
            ;; interpolate in the v-direction
            (when (> q 1)
              (let ((cm (band-matrix m q knv v)))
                (dotimes (i (1+ n))
                  (dotimes (j (1+ m))
                    (setf (aref g j) (aref fuv i j)))
                  (real-matrix-right-for-back cm g h)
                  (dotimes (j (1+ m))
                    (setf (aref fuv i j) (aref h j))))))))))
    sfn))

;;; ------------------------------------------------ knot removal

(defconstant +srf-fit--norem+ 1d25
  "NOREM in N_FitSrfApproxRemoveKnots: a knot found not removable.")

(defun fit-srf-approx-remove-knots (sur u-params v-params er mu mv e dir)
  "Remove from surface SUR, in place, every knot -- in the u-direction, the
v-direction or both, as DIR is +udir+, +vdir+ or +uvdir+ -- whose removal
keeps the cumulative error at the parameters U-PARAMS[0..MU] x V-PARAMS[0..MV]
within E, cheapest knot first.  ER, an (MU+1) x (MV+1) real-matrix, holds the
error bounds; as in the C its entries [0..MU-1][0..MV-1] are first zeroed and
the last row and column kept, and it is updated in place.  The parameters
must be sorted and inside the domain (:par-err otherwise, from the basis and
function evaluations).  SUR's knot vectors and control net are replaced by
shorter arrays when knots go.  A DIR other than the three, on which the C
loops for ever, signals :cal-err.  Returns SUR.
NLib: N_FitSrfApproxRemoveKnots."
  (declare (type surface sur) (type real-vector u-params v-params) (type real-matrix er)
           (type fixnum mu mv dir) (type double-float e))
  (unless (or (= dir +udir+) (= dir +vdir+) (= dir +uvdir+))
    (nurbs-error :cal-err 'fit-srf-approx-remove-knots))
  (let* ((n (surface-n sur))
         (m (surface-m sur))
         (pw (surface-cpoints sur))
         (p (surface-degree-u sur))
         (q (surface-degree-v sur))
         (uk (surface-knots-u sur))
         (vk (surface-knots-v sur))
         (r (1- (length uk)))
         (s (1- (length vk)))
         (n0 n) (m0 m)
         ;; the knot vectors N_BasisIEval sees, of highest index r and s
         (knu uk)
         (knv vk)
         (size (1+ (* 2 (nl-max p q))))
         (alf (make-real-vector size))
         (oma (make-real-vector size))
         (bet (make-real-vector size))
         (omb (make-real-vector size))
         (rw (make-cpoint-array size))
         (fuv (make-real-vector (1+ (nl-max n m))))
         (te (make-real-matrix (1+ mu) (1+ mv)))
         (in-u (or (= dir +udir+) (= dir +uvdir+)))
         (in-v (or (= dir +vdir+) (= dir +uvdir+)))
         (mru (make-real-vector (if in-u (1+ r) 0)))
         (sru (make-index-vector (if in-u (1+ r) 0)))
         (uleft (make-index-vector (if in-u (1+ n) 0)))
         (uright (make-index-vector (if in-u (1+ n) 0)))
         (bru (if in-u (make-real-matrix (1+ r) (1+ m)) (make-real-matrix 0 0)))
         (mrv (make-real-vector (if in-v (1+ s) 0)))
         (srv (make-index-vector (if in-v (1+ s) 0)))
         (vleft (make-index-vector (if in-v (1+ m) 0)))
         (vright (make-index-vector (if in-v (1+ m) 0)))
         (brv (if in-v (make-real-matrix (1+ n) (1+ s)) (make-real-matrix 0 0)))
         (lam 0d0) (oml 0d0)
         (bu 0d0) (bv 0d0)
         (ru 0) (su 0) (rv 0) (sv 0)
         (c0 (make-cpoint)) (c1 (make-cpoint)) (c2 (make-cpoint)))
    (declare (type fixnum n m p q r s n0 m0 size mu mv ru su rv sv)
             (type cpoint-net pw) (type real-vector uk vk knu knv alf oma bet omb fuv mru mrv)
             (type cpoint-array rw) (type real-matrix te bru brv)
             (type index-vector sru uleft uright srv vleft vright)
             (type double-float lam oml bu bv) (type cpoint c0 c1 c2))
    (labels ((cfun-of (cnt deg kn kr)
               ;; N_CFuncFromKnots( &cf, fuv, cnt, deg, kn, kr ): fuv is
               ;; shared in the C and refilled before each use, so the
               ;; function is made when it is used
               (declare (type fixnum cnt deg kr) (type real-vector kn))
               (c-func-from-knots (%make-cfun 0 (make-real-vector 0) (make-real-vector 0))
                                  fuv cnt deg kn kr))
             (combine-net (alpha i j beta k dst)
               ;; N_Combine2CPts( alpha, Pw[i][j], beta, Rw[k], &Rw[dst] )
               (declare (type double-float alpha beta) (type fixnum i j k dst))
               (combine-2-c-pts alpha (%net-c-pt pw i j c0) beta (%row-c-pt rw k c1) c2)
               (%c-pt-row c2 rw dst))
             (net-to-row (i j k)
               ;; N_CopyCPt( Pw[i][j], &Rw[k] )
               (declare (type fixnum i j k))
               (%c-pt-row (%net-c-pt pw i j c0) rw k))
             (row-to-net (k i j)
               ;; N_CopyCPt( Rw[k], &Pw[i][j] )
               (declare (type fixnum i j k))
               (%c-pt-net (%row-c-pt rw k c0) pw i j))
             (removed (b)
               (declare (type double-float b))
               (or (= b +bigd+) (= b +srf-fit--norem+))))
      (unwind-protect
           (progn
             ;; set the error matrix to 0s, short of its last row and column
             (dotimes (ii mu)
               (dotimes (jj mv)
                 (setf (aref er ii jj) 0d0)))
             ;; initialize
             (when in-u
               (dotimes (i (1+ r))
                 (setf (aref mru i) +bigd+
                       (aref sru i) 0)))
             (when in-v
               (dotimes (j (1+ s))
                 (setf (aref mrv j) +bigd+
                       (aref srv j) 0)))
             ;; the maximum knot removal error of each distinct knot, and
             ;; the ranges of parameter indexes
             (when in-u
               (setf ru (1+ p))
               (do () ((not (<= ru n)))
                 (let ((i ru))
                   (declare (type fixnum i))
                   (do () ((not (and (<= ru n) (= (aref uk ru) (aref uk (1+ ru))))))
                     (incf ru))
                   (setf (aref sru ru) (1+ (- ru i)))
                   (setf (aref mru ru)
                         (fit-srf-removal-boundary sur ru (aref sru ru) 0 m +udir+ bru (aref mru ru)))
                   (incf ru)))
               (let ((k 1))
                 (declare (type fixnum k))
                 (dotimes (i (1+ n))
                   (setf (aref uleft i) k)
                   (do () ((not (and (< k mu) (> (aref u-params k) (aref uk i))
                                     (<= (aref u-params k) (aref uk (1+ i))))))
                     (incf k))
                   (let ((l k))
                     (declare (type fixnum l))
                     (do () ((not (< l mu)))
                       (when (>= (aref u-params l) (aref uk (+ i p 1)))
                         (return))
                       (incf l))
                     (setf (aref uright i) (1- l))))))
             (when in-v
               (setf rv (1+ q))
               (do () ((not (<= rv m)))
                 (let ((j rv))
                   (declare (type fixnum j))
                   (do () ((not (and (<= rv m) (= (aref vk rv) (aref vk (1+ rv))))))
                     (incf rv))
                   (setf (aref srv rv) (1+ (- rv j)))
                   (setf (aref mrv rv)
                         (fit-srf-removal-boundary sur rv (aref srv rv) 0 n +vdir+ brv (aref mrv rv)))
                   (incf rv)))
               (let ((k 1))
                 (declare (type fixnum k))
                 (dotimes (j (1+ m))
                   (setf (aref vleft j) k)
                   (do () ((not (and (< k mv) (> (aref v-params k) (aref vk j))
                                     (<= (aref v-params k) (aref vk (1+ j))))))
                     (incf k))
                   (let ((l k))
                     (declare (type fixnum l))
                     (do () ((not (< l mv)))
                       (when (>= (aref v-params l) (aref vk (+ j q 1)))
                         (return))
                       (incf l))
                     (setf (aref vright j) (1- l))))))
             ;; try to remove each knot
             (do () (nil)
               ;; the knot with the smallest error
               (when in-u
                 (setf bu (aref mru (1+ p))
                       su (aref sru (1+ p))
                       ru (1+ p))
                 (do ((i (+ p 2) (1+ i))) ((> i n))
                   (declare (type fixnum i))
                   (when (< (aref mru i) bu)
                     (setf bu (aref mru i)
                           su (aref sru i)
                           ru i))))
               (when in-v
                 (setf bv (aref mrv (1+ q))
                       sv (aref srv (1+ q))
                       rv (1+ q))
                 (do ((j (+ q 2) (1+ j))) ((> j m))
                   (declare (type fixnum j))
                   (when (< (aref mrv j) bv)
                     (setf bv (aref mrv j)
                           sv (aref srv j)
                           rv j))))
               ;; no more removable knot: finished
               (when (cond ((= dir +udir+) (removed bu))
                           ((= dir +vdir+) (removed bv))
                           (t (and (removed bu) (removed bv))))
                 (return))
               ;; the C's switch; its breaks leave it, not the loop
               (block switch
                 (if (= (if (= dir +uvdir+) (if (< bu bv) +udir+ +vdir+) dir) +udir+)
                     ;; remove in the u-direction
                     (let ((rmf t) (i 0) (odd (oddp (+ p su))))
                       (declare (type fixnum i))
                       (dotimes (j (1+ m))
                         (setf (aref fuv j) (aref bru ru j)))
                       (let ((cfv (cfun-of m q vk s)))
                         (if odd
                             (let ((k (truncate (+ p su 1) 2)))
                               (declare (type fixnum k))
                               (setf i (- ru k))
                               (let* ((al (/ (- (aref uk ru) (aref uk i))
                                             (- (aref uk (+ i p 1)) (aref uk i))))
                                      (be (/ (- (aref uk ru) (aref uk (1+ i)))
                                             (- (aref uk (+ i p 2)) (aref uk (1+ i)))))
                                      (ob (- 1d0 be)))
                                 (declare (type double-float al be ob))
                                 (setf lam (/ al (+ al be))
                                       oml (- 1d0 lam))
                                 (do ((k (aref uleft i) (1+ k))) ((> k (aref uright (1+ i))))
                                   (declare (type fixnum k))
                                   (let* ((bf (basis-i-eval knu i p (aref u-params k) +left+))
                                          (n1 (basis-i-eval knu (1+ i) p (aref u-params k) +left+))
                                          (tmp (abs (- (* (* lam al) bf) (* (* oml ob) n1)))))
                                     (declare (type double-float bf n1 tmp))
                                     (do ((l 0 (1+ l))) ((> l mv))
                                       (declare (type fixnum l))
                                       (let ((fl (c-func-eval cfv (aref v-params l) +left+)))
                                         (declare (type double-float fl))
                                         (setf (aref te k l) (+ (aref er k l) (* tmp fl)))
                                         (when (> (aref te k l) e)
                                           (setf rmf nil)
                                           (return))))
                                     (unless rmf (return))))))
                             (let ((k (truncate (+ p su) 2)))
                               (declare (type fixnum k))
                               (setf i (- ru k))
                               (do ((k (aref uleft i) (1+ k))) ((> k (aref uright i)))
                                 (declare (type fixnum k))
                                 (let ((bf (basis-i-eval knu i p (aref u-params k) +left+)))
                                   (declare (type double-float bf))
                                   (do ((l 0 (1+ l))) ((> l mv))
                                     (declare (type fixnum l))
                                     (let ((fl (c-func-eval cfv (aref v-params l) +left+)))
                                       (declare (type double-float fl))
                                       (setf (aref te k l) (+ (aref er k l) (* bf fl)))
                                       (when (> (aref te k l) e)
                                         (setf rmf nil)
                                         (return))))
                                   (unless rmf (return)))))))
                       (unless rmf
                         ;; the knot is not removable
                         (setf (aref mru ru) +srf-fit--norem+)
                         (return-from switch))
                       ;; the error test passed: update the error matrix and
                       ;; remove the knot
                       (let ((a (if odd (aref uright (1+ i)) (aref uright i))))
                         (declare (type fixnum a))
                         (do ((k (aref uleft i) (1+ k))) ((> k a))
                           (declare (type fixnum k))
                           (dotimes (l (1+ mv))
                             (setf (aref er k l) (aref te k l)))))
                       (let* ((fout (truncate (- (* 2 ru) su p) 2))
                              (first (- ru p))
                              (last (- ru su))
                              (off (1- first)))
                         (declare (type fixnum fout first last off))
                         ;; save some parameters
                         (let ((i first) (j last))
                           (declare (type fixnum i j))
                           (do () ((not (> (- j i) 0)))
                             (setf (aref alf (- i first)) (/ (- (aref uk (+ i p 1)) (aref uk i))
                                                             (- (aref uk ru) (aref uk i)))
                                   (aref oma (- i first)) (- 1d0 (aref alf (- i first)))
                                   (aref bet (- j first)) (/ (- (aref uk (+ j p 1)) (aref uk j))
                                                             (- (aref uk (+ j p 1)) (aref uk ru)))
                                   (aref omb (- j first)) (- 1d0 (aref bet (- j first))))
                             (incf i)
                             (decf j)))
                         ;; remove the knot for each column
                         (dotimes (col (1+ m))
                           (let ((i first) (j last) (ii 1) (jj (- last off)))
                             (declare (type fixnum i j ii jj))
                             (net-to-row off col 0)
                             (net-to-row (1+ last) col (- (1+ last) off))
                             ;; new control points for one removal step
                             (do () ((not (> (- j i) 0)))
                               (combine-net (aref alf (- i first)) i col (aref oma (- i first)) (1- ii) ii)
                               (combine-net (aref bet (- j first)) j col (aref omb (- j first)) (1+ jj) jj)
                               (incf i) (decf j) (incf ii) (decf jj))
                             ;; save the new control points
                             (when odd
                               (%combine-2-c-pt-rows lam rw (1+ jj) oml rw (1- ii) rw (1+ jj)))
                             (setf i first
                                   j last)
                             (do () ((not (> (- j i) 0)))
                               (row-to-net (- i off) i col)
                               (row-to-net (- j off) j col)
                               (incf i) (decf j))))
                         ;; successful removal: shift down some entities
                         (when (> su 1)
                           (setf (aref sru (1- ru)) (1- (aref sru ru))))
                         (do ((i (1+ ru) (1+ i))) ((> i r))
                           (declare (type fixnum i))
                           (setf (aref mru (1- i)) (aref mru i)
                                 (aref sru (1- i)) (aref sru i)
                                 (aref uk (1- i)) (aref uk i))
                           (dotimes (j (1+ m))
                             (setf (aref bru (1- i) j) (aref bru i j))))
                         (dotimes (col (1+ m))
                           (do ((i (1+ fout) (1+ i))) ((> i n))
                             (declare (type fixnum i))
                             (%copy-c-pt-net pw i col pw (1- i) col)))
                         (decf n)
                         (decf r)
                         ;; N_SrfSetSizeIndices
                         (setf knu (subseq uk 0 (1+ r)))
                         ;; no more internal knots: finished
                         (when (if (= dir +udir+) (= n p) (and (= n p) (= m q)))
                           (return-from switch))
                         ;; update the error bounds
                         (let ((k (nl-max (- ru p) (1+ p)))
                               (l (nl-min n (- (+ ru p) su))))
                           (declare (type fixnum k l))
                           (do ((i k (1+ i))) ((> i l))
                             (declare (type fixnum i))
                             (when (and (/= (aref uk i) (aref uk (1+ i)))
                                        (/= (aref mru i) +srf-fit--norem+))
                               (setf (aref mru i)
                                     (fit-srf-removal-boundary sur i (aref sru i) 0 m +udir+ bru
                                                               (aref mru i))))))
                         (when (= dir +uvdir+)
                           (do ((j (1+ q) (1+ j))) ((> j m))
                             (declare (type fixnum j))
                             (when (and (/= (aref vk j) (aref vk (1+ j)))
                                        (/= (aref mrv j) +srf-fit--norem+))
                               (setf (aref mrv j)
                                     (fit-srf-removal-boundary sur j (aref srv j) first last +vdir+ brv
                                                               (aref mrv j))))))
                         ;; update the index ranges in the u-direction
                         (do ((i (- ru p 1) (1+ i))) ((> i (- ru su)))
                           (declare (type fixnum i))
                           (let ((k (1+ (aref uright i))))
                             (declare (type fixnum k))
                             (do () ((not (<= k mu)))
                               (when (>= (aref u-params k) (aref uk (+ i p 1)))
                                 (return))
                               (incf k))
                             (setf (aref uright i) (1- k))))
                         (do ((i (1+ (- ru su)) (1+ i))) ((> i n))
                           (declare (type fixnum i))
                           (setf (aref uleft i) (aref uleft (1+ i))
                                 (aref uright i) (aref uright (1+ i))))))
                     ;; remove in the v-direction
                     (let ((rmf t) (j 0) (odd (oddp (+ q sv))))
                       (declare (type fixnum j))
                       (dotimes (i (1+ n))
                         (setf (aref fuv i) (aref brv i rv)))
                       (let ((cfu (cfun-of n p uk r)))
                         (if odd
                             (let ((k (truncate (+ q sv 1) 2)))
                               (declare (type fixnum k))
                               (setf j (- rv k))
                               (let* ((al (/ (- (aref vk rv) (aref vk j))
                                             (- (aref vk (+ j q 1)) (aref vk j))))
                                      (be (/ (- (aref vk rv) (aref vk (1+ j)))
                                             (- (aref vk (+ j q 2)) (aref vk (1+ j)))))
                                      (ob (- 1d0 be)))
                                 (declare (type double-float al be ob))
                                 (setf lam (/ al (+ al be))
                                       oml (- 1d0 lam))
                                 (do ((l (aref vleft j) (1+ l))) ((> l (aref vright (1+ j))))
                                   (declare (type fixnum l))
                                   (let* ((bf (basis-i-eval knv j q (aref v-params l) +left+))
                                          (n1 (basis-i-eval knv (1+ j) q (aref v-params l) +left+))
                                          (tmp (abs (- (* (* lam al) bf) (* (* oml ob) n1)))))
                                     (declare (type double-float bf n1 tmp))
                                     (do ((k 0 (1+ k))) ((> k mu))
                                       (declare (type fixnum k))
                                       (let ((fl (c-func-eval cfu (aref u-params k) +left+)))
                                         (declare (type double-float fl))
                                         (setf (aref te k l) (+ (aref er k l) (* tmp fl)))
                                         (when (> (aref te k l) e)
                                           (setf rmf nil)
                                           (return))))
                                     (unless rmf (return))))))
                             (let ((k (truncate (+ q sv) 2)))
                               (declare (type fixnum k))
                               (setf j (- rv k))
                               (do ((l (aref vleft j) (1+ l))) ((> l (aref vright j)))
                                 (declare (type fixnum l))
                                 (let ((bf (basis-i-eval knv j q (aref v-params l) +left+)))
                                   (declare (type double-float bf))
                                   (do ((k 0 (1+ k))) ((> k mu))
                                     (declare (type fixnum k))
                                     (let ((fl (c-func-eval cfu (aref u-params k) +left+)))
                                       (declare (type double-float fl))
                                       (setf (aref te k l) (+ (aref er k l) (* bf fl)))
                                       (when (> (aref te k l) e)
                                         (setf rmf nil)
                                         (return))))
                                   (unless rmf (return)))))))
                       (unless rmf
                         ;; the knot is not removable
                         (setf (aref mrv rv) +srf-fit--norem+)
                         (return-from switch))
                       ;; the error test passed: update the error matrix and
                       ;; remove the knot
                       (let ((a (if odd (aref vright (1+ j)) (aref vright j))))
                         (declare (type fixnum a))
                         (do ((l (aref vleft j) (1+ l))) ((> l a))
                           (declare (type fixnum l))
                           (dotimes (k (1+ mu))
                             (setf (aref er k l) (aref te k l)))))
                       (let* ((fout (truncate (- (* 2 rv) sv q) 2))
                              (first (- rv q))
                              (last (- rv sv))
                              (off (1- first)))
                         (declare (type fixnum fout first last off))
                         ;; save some parameters
                         (let ((i first) (j last))
                           (declare (type fixnum i j))
                           (do () ((not (> (- j i) 0)))
                             (setf (aref alf (- i first)) (/ (- (aref vk (+ i q 1)) (aref vk i))
                                                             (- (aref vk rv) (aref vk i)))
                                   (aref oma (- i first)) (- 1d0 (aref alf (- i first)))
                                   (aref bet (- j first)) (/ (- (aref vk (+ j q 1)) (aref vk j))
                                                             (- (aref vk (+ j q 1)) (aref vk rv)))
                                   (aref omb (- j first)) (- 1d0 (aref bet (- j first))))
                             (incf i)
                             (decf j)))
                         ;; remove the knot for each row
                         (dotimes (row (1+ n))
                           (let ((i first) (j last) (ii 1) (jj (- last off)))
                             (declare (type fixnum i j ii jj))
                             (net-to-row row off 0)
                             (net-to-row row (1+ last) (- (1+ last) off))
                             ;; new control points for one removal step
                             (do () ((not (> (- j i) 0)))
                               (combine-net (aref alf (- i first)) row i (aref oma (- i first)) (1- ii) ii)
                               (combine-net (aref bet (- j first)) row j (aref omb (- j first)) (1+ jj) jj)
                               (incf i) (decf j) (incf ii) (decf jj))
                             ;; save the new control points
                             (when odd
                               (%combine-2-c-pt-rows lam rw (1+ jj) oml rw (1- ii) rw (1+ jj)))
                             (setf i first
                                   j last)
                             (do () ((not (> (- j i) 0)))
                               (row-to-net (- i off) row i)
                               (row-to-net (- j off) row j)
                               (incf i) (decf j))))
                         ;; successful removal: shift down some entities
                         (when (> sv 1)
                           (setf (aref srv (1- rv)) (1- (aref srv rv))))
                         (do ((j (1+ rv) (1+ j))) ((> j s))
                           (declare (type fixnum j))
                           (setf (aref mrv (1- j)) (aref mrv j)
                                 (aref srv (1- j)) (aref srv j)
                                 (aref vk (1- j)) (aref vk j))
                           (dotimes (i (1+ n))
                             (setf (aref brv i (1- j)) (aref brv i j))))
                         (dotimes (row (1+ n))
                           (do ((j (1+ fout) (1+ j))) ((> j m))
                             (declare (type fixnum j))
                             (%copy-c-pt-net pw row j pw row (1- j))))
                         (decf m)
                         (decf s)
                         ;; N_SrfSetSizeIndices
                         (setf knv (subseq vk 0 (1+ s)))
                         ;; no more internal knots: finished
                         (when (if (= dir +vdir+) (= m q) (and (= n p) (= m q)))
                           (return-from switch))
                         ;; update the error bounds
                         (let ((k (nl-max (- rv q) (1+ q)))
                               (l (nl-min m (- (+ rv q) sv))))
                           (declare (type fixnum k l))
                           (do ((j k (1+ j))) ((> j l))
                             (declare (type fixnum j))
                             (when (and (/= (aref vk j) (aref vk (1+ j)))
                                        (/= (aref mrv j) +srf-fit--norem+))
                               (setf (aref mrv j)
                                     (fit-srf-removal-boundary sur j (aref srv j) 0 n +vdir+ brv
                                                               (aref mrv j))))))
                         (when (= dir +uvdir+)
                           (do ((i (1+ p) (1+ i))) ((> i n))
                             (declare (type fixnum i))
                             (when (and (/= (aref uk i) (aref uk (1+ i)))
                                        (/= (aref mru i) +srf-fit--norem+))
                               (setf (aref mru i)
                                     (fit-srf-removal-boundary sur i (aref sru i) first last +udir+ bru
                                                               (aref mru i))))))
                         ;; update the index ranges in the v-direction
                         (do ((j (- rv q 1) (1+ j))) ((> j (- rv sv)))
                           (declare (type fixnum j))
                           (let ((k (1+ (aref vright j))))
                             (declare (type fixnum k))
                             (do () ((not (<= k mv)))
                               (when (>= (aref v-params k) (aref vk (+ j q 1)))
                                 (return))
                               (incf k))
                             (setf (aref vright j) (1- k))))
                         (do ((j (1+ (- rv sv)) (1+ j))) ((> j m))
                           (declare (type fixnum j))
                           (setf (aref vleft j) (aref vleft (1+ j))
                                 (aref vright j) (aref vright (1+ j))))))))))
        ;; SUR keeps the knots and control points left, as N_SrfSetSizeIndices
        ;; records them in C
        (when (/= n n0)
          (setf (surface-knots-u sur) (subseq uk 0 (1+ r))))
        (when (/= m m0)
          (setf (surface-knots-v sur) (subseq vk 0 (1+ s))))
        (when (or (/= n n0) (/= m m0))
          (let ((net (make-cpoint-net (1+ n) (1+ m))))
            (dotimes (i (1+ n))
              (dotimes (j (1+ m))
                (%copy-c-pt-net pw i j net i j)))
            (setf (surface-cpoints sur) net))))))
  sur)

;;; ------------------------------------------------ level 3: global interpolation

(defun fit-srf-to-pts (pnet n m p q par)
  "The surface of degrees P, Q (each at least 1) interpolating the grid of
points PNET[0..N][0..M] (a point-net), each row and column of points on an
isoparameter line: parameters by PAR (+uniform+, +chordlength+ or
+centripetal+, see fit-calc-srf-param-values), knot vectors averaged by
fit-crv-calc-knot-vector.  Signals :inp-err for P > N or Q > M, what the
parametrization signals, and what the banded LU solve signals (:num-err for a
singular system).  As in the C, which does not check it, a parameter whose
basis functions fall outside the band of the interpolation matrix (repeated
parameters) is written into the band storage row-major, where the C's
contiguous rows put it.  Returns a fresh surface.
NLib: N_FitSrfToPts."
  (declare (type point-net pnet) (type fixnum n m p q par))
  (when (or (> p n) (> q m))
    (nurbs-error :inp-err 'fit-srf-to-pts))
  (let ((pw (make-cpoint-net (1+ n) (1+ m)))
        (knu (make-real-vector (+ n p 2)))
        (knv (make-real-vector (+ m q 2)))
        (u (make-real-vector (1+ n)))
        (v (make-real-vector (1+ m)))
        (qw (make-cpoint-array (1+ (nl-max n m))))
        (nb (make-real-vector (1+ (nl-max p q))))
        (pt (make-point))
        (cp (make-cpoint)))
    (declare (type cpoint-net pw) (type real-vector knu knv u v nb) (type cpoint-array qw)
             (type point pt) (type cpoint cp))
    ;; parameters and knot vectors
    (fit-calc-srf-param-values pnet n m +epoint+ par u v)
    (fit-crv-calc-knot-vector u n p knu)
    (fit-crv-calc-knot-vector v m q knv)
    (flet ((band-matrix (cnt deg kn par)
             ;; the LU-decomposed banded interpolation matrix of one direction:
             ;; CNT the highest data index, DEG the degree
             (declare (type fixnum cnt deg) (type real-vector kn par))
             (let* ((bw (1- (* 2 deg)))
                    (sbw (1- deg))
                    (cm (set-real-matrix (make-rmatrix) cnt cnt +mt-banded+ bw))
                    (a (rmatrix-rm cm))
                    (stride (array-dimension a 1)))
               (declare (type fixnum bw sbw stride) (type real-matrix a))
               (dotimes (i (1+ cnt))
                 (dotimes (j bw)
                   (setf (aref a i j) 0d0)))
               (setf (aref a 0 sbw) 1d0
                     (aref a cnt sbw) 1d0)
               (do ((i 1 (1+ i))) ((>= i cnt))
                 (declare (type fixnum i))
                 (let* ((j (basis-eval kn deg (aref par i) +left+ nb))
                        (l (- j i 1)))
                   (declare (type fixnum j l))
                   ;; A[i][l + k] = N[k]: the C's rows are contiguous
                   (dotimes (k (1+ deg))
                     (setf (row-major-aref a (+ (* i stride) l k)) (aref nb k)))))
               (real-matrix-lu-decompose cm))))
      ;; interpolate in the u-direction
      (if (= p 1)
          (dotimes (i (1+ n))
            (dotimes (j (1+ m))
              (%c-pt-net (pt-to-c-pt (%net-pt pnet i j pt) cp) pw i j)))
          (let ((cm (band-matrix n p knu u)))
            (dotimes (j (1+ m))
              (fit-crv-c-pts-from-srf-data pnet n m +epoint+ j +udir+ cm qw)
              (dotimes (i (1+ n))
                (%c-pt-net (%row-c-pt qw i cp) pw i j)))))
      ;; interpolate in the v-direction
      (when (> q 1)
        (let ((cm (band-matrix m q knv v)))
          (dotimes (i (1+ n))
            (fit-crv-c-pts-from-srf-data pw n m +hpoint+ i +vdir+ cm qw)
            (dotimes (j (1+ m))
              (%c-pt-net (%row-c-pt qw j cp) pw i j))))))
    (%make-surface p q knu knv pw)))

;;; ------------------------------------------------ bicubic fit to points and normals

(defun fit-pts-normals (pnet nnet k l tan)
  "The C11 nonrational bicubic surface, (2K+2) x (2L+2) control points with
double interior knots at the averaged chord-length parameters, very nearly
interpolating the points PNET[0..K][0..L] (a point-net) with the unit
tangents of TAN (+bessel+ or +akima+, :cal-err otherwise).  When the normals
NNET (a point-net like PNET, or NIL) are given, the Bezier points next to each
data point are projected onto the plane through it normal to its normal.  K
and L must be at least 2 (the C reads unset tangents for less).  Signals
:num-err for parameters that cannot be divided by (Bessel), and :geo-err for
a zero tangent away from the boundary or a zero one at the boundary whose
chord is zero too.  A projection that fails leaves its point as it was, as
the C ignores that error.  Returns a fresh surface.
NLib: N_FitPtsNormals."
  (declare (type point-net pnet) (type (or null point-net) nnet) (type fixnum k l tan))
  (let* ((ib (* 3 k))
         (jb (* 3 l))
         (n (1+ (* 2 k)))
         (m (1+ (* 2 l)))
         (od3 (/ 1d0 3d0))
         (od9 (/ 1d0 9d0))
         (uk (make-real-vector (+ n 5)))
         (vk (make-real-vector (+ m 5)))
         (pw (make-cpoint-net (1+ n) (1+ m)))
         (u (make-real-vector (+ k 3)))
         (v (make-real-vector (+ l 3)))
         (r (make-real-vector (1+ l)))
         (s (make-real-vector (1+ k)))
         (b (make-point-net (1+ ib) (1+ jb)))
         (su (make-point-net (+ k 4) (1+ l)))
         (sv (make-point-net (1+ k) (+ l 4)))
         (tu (make-point-net (+ k 3) (+ l 3)))
         (tv (make-point-net (+ k 3) (+ l 3)))
         (duv (make-point-net (1+ k) (1+ l)))
         (av (make-point)) (bv (make-point)) (d1 (make-point)) (d2 (make-point))
         (p0 (make-point)) (p1 (make-point)) (p2 (make-point)) (p3 (make-point))
         (cp (make-cpoint))
         (pln (%make-plane (make-point) (make-point)))
         (ltol *ltol*)
         (utl 0d0) (vtl 0d0)
         (uclosed nil) (vclosed nil))
    (declare (type fixnum ib jb n m) (type double-float od3 od9 ltol utl vtl)
             (type real-vector uk vk u v r s) (type cpoint-net pw)
             (type point-net b su sv tu tv duv)
             (type point av bv d1 d2 p0 p1 p2 p3) (type cpoint cp))
    (labels ((gpt (net i j pt)
               (declare (type point-net net) (type fixnum i j) (type point pt))
               (%net-pt net i j pt))
             (ppt (pt net i j)
               (declare (type point-net net) (type fixnum i j) (type point pt))
               (%pt-net pt net i j))
             (copy (src i j dst ii jj)
               ;; N_VectorCopy / N_CopyPt( src[i][j], &dst[ii][jj] )
               (ppt (gpt src i j p0) dst ii jj))
             (combine (alf src i j bet src2 i2 j2 dst ii jj)
               ;; N_VectorCombine( alf, src[i][j], bet, src2[i2][j2], &dst[ii][jj] )
               (declare (type double-float alf bet))
               (vector-combine alf (gpt src i j p0) bet (gpt src2 i2 j2 p1) p2)
               (ppt p2 dst ii jj))
             (along (i j a tn ti tj ii jj)
               ;; N_VectorPtAlongVector( P[i][j], a, tn[ti][tj], &B[ii][jj] )
               (declare (type double-float a))
               (vector-pt-along-vector (gpt pnet i j p0) a (gpt tn ti tj p1) p2)
               (ppt p2 b ii jj))
             (unit (net i j edge alt ai aj)
               ;; N_VectorNormalizeRef( &net[i][j] ); when that fails at an
               ;; edge (EDGE true), alt[ai][aj] is copied in and normalized
               (gpt net i j p0)
               (handler-case (vector-normalize-ref p0)
                 (nurbs-error (c)
                   (unless edge (error c))
                   (gpt alt ai aj p0)
                   (vector-normalize-ref p0)))
               (ppt p0 net i j))
             (inner (gam di dj ib1 jb1 ib2 jb2 ib3 jb3 ii jj)
               ;; N_Combine4Pts( gam, DUV[di][dj], 1, B[ib1][jb1], 1,
               ;; B[ib2][jb2], -1, B[ib3][jb3], &B[ii][jj] )
               (declare (type double-float gam))
               (combine-4-pts gam (gpt duv di dj d1) 1d0 (gpt b ib1 jb1 p0)
                              1d0 (gpt b ib2 jb2 p1) -1d0 (gpt b ib3 jb3 p2) p3)
               (ppt p3 b ii jj))
             (plane-at (i j)
               ;; N_CreatePlanePtNormal( &Pln, P[i][j], N[i][j] )
               (create-plane-pt-normal pln (gpt pnet i j p0) (gpt nnet i j p1)))
             (proj (i j)
               ;; N_ProjectPtPlane( Pln, B[i][j], &B[i][j] ): its error is
               ;; ignored, leaving B[i][j] as it was
               (gpt b i j p2)
               (gpt b i j p3)
               (handler-case (project-pt-plane pln p2 p3)
                 (nurbs-error () nil))
               (ppt p3 b i j)))
      (declare (inline gpt ppt))
      ;; the chords and the parameters
      (let ((ntl (e-net-from-pts k l pnet)))
        (setf uclosed (e-net-is-closed ntl +udir+)
              vclosed (e-net-is-closed ntl +vdir+)))
      (dotimes (j (1+ l))
        (setf (aref r j) 0d0)
        (do ((i 1 (1+ i))) ((> i k))
          (declare (type fixnum i))
          (vector-diff (gpt pnet i j p0) (gpt pnet (1- i) j p1) p2)
          (ppt p2 su (1+ i) j)
          (let ((d (vector-magnitude p2)))
            (declare (type double-float d))
            (setf (aref u (1+ i)) (+ (aref u (1+ i)) d))
            (setf (aref r j) (+ (aref r j) d))))
        (if uclosed
            (progn
              (copy su (1+ k) j su 1 j)
              (copy su k j su 0 j)
              (copy su 2 j su (+ k 2) j)
              (copy su 3 j su (+ k 3) j))
            (progn
              (combine 2d0 su 2 j -1d0 su 3 j su 1 j)
              (combine 2d0 su 1 j -1d0 su 2 j su 0 j)
              (combine 2d0 su (1+ k) j -1d0 su k j su (+ k 2) j)
              (combine 2d0 su (+ k 2) j -1d0 su (1+ k) j su (+ k 3) j)))
        (setf utl (+ utl (aref r j))))
      (dotimes (i (1+ k))
        (setf (aref s i) 0d0)
        (do ((j 1 (1+ j))) ((> j l))
          (declare (type fixnum j))
          (vector-diff (gpt pnet i j p0) (gpt pnet i (1- j) p1) p2)
          (ppt p2 sv i (1+ j))
          (let ((d (vector-magnitude p2)))
            (declare (type double-float d))
            (setf (aref v (1+ j)) (+ (aref v (1+ j)) d))
            (setf (aref s i) (+ (aref s i) d))))
        (if vclosed
            (progn
              (copy sv i (1+ l) sv i 1)
              (copy sv i l sv i 0)
              (copy sv i 2 sv i (+ l 2))
              (copy sv i 3 sv i (+ l 3)))
            (progn
              (combine 2d0 sv i 2 -1d0 sv i 3 sv i 1)
              (combine 2d0 sv i 1 -1d0 sv i 2 sv i 0)
              (combine 2d0 sv i (1+ l) -1d0 sv i l sv i (+ l 2))
              (combine 2d0 sv i (+ l 2) -1d0 sv i (1+ l) sv i (+ l 3))))
        (setf vtl (+ vtl (aref s i))))
      (do ((i 2 (1+ i))) ((> i k))
        (declare (type fixnum i))
        (setf (aref u i) (+ (aref u (1- i)) (/ (aref u i) utl))))
      (setf (aref u 0) (- (aref u 2))
            (aref u (1+ k)) 1d0
            (aref u (+ k 2)) (- 2d0 (aref u k)))
      (do ((j 2 (1+ j))) ((> j l))
        (declare (type fixnum j))
        (setf (aref v j) (+ (aref v (1- j)) (/ (aref v j) vtl))))
      (setf (aref v 0) (- (aref v 2))
            (aref v (1+ l)) 1d0
            (aref v (+ l 2)) (- 2d0 (aref v l)))
      ;; the knot vectors
      (dotimes (i 4)
        (setf (aref uk i) 0d0
              (aref uk (+ n i 1)) 1d0))
      (do ((i 1 (1+ i))) ((>= i k))
        (declare (type fixnum i))
        (let ((ii (* 2 (1+ i))))
          (declare (type fixnum ii))
          (setf (aref uk ii) (aref u (1+ i))
                (aref uk (1+ ii)) (aref u (1+ i)))))
      (dotimes (j 4)
        (setf (aref vk j) 0d0
              (aref vk (+ m j 1)) 1d0))
      (do ((j 1 (1+ j))) ((>= j l))
        (declare (type fixnum j))
        (let ((jj (* 2 (1+ j))))
          (declare (type fixnum jj))
          (setf (aref vk jj) (aref v (1+ j))
                (aref vk (1+ jj)) (aref v (1+ j)))))
      ;; the unit tangents
      (flet ((tangents (i j oma alf omb bet)
               (declare (type fixnum i j) (type double-float oma alf omb bet))
               (combine oma su (1+ i) j alf su (+ i 2) j tu (1+ i) (1+ j))
               (combine omb sv i (1+ j) bet sv i (+ j 2) tv (1+ i) (1+ j))
               ;; at i = 0 the copy of SU[i+2][j], at i = k that of SU[i+1][j]
               (unit tu (1+ i) (1+ j) (or (= i 0) (= i k)) su (if (= i k) (1+ i) (+ i 2)) j)
               (unit tv (1+ i) (1+ j) (or (= j 0) (= j l)) sv i (if (= j l) (1+ j) (+ j 2)))))
        (cond
          ((= tan +bessel+)
           (dotimes (i (1+ k))
             (let* ((dui (- (aref u (1+ i)) (aref u i)))
                    (dui1 (- (aref u (+ i 2)) (aref u (1+ i))))
                    (alf 0d0) (oma 0d0))
               (declare (type double-float dui dui1 alf oma))
               (when (float-op-is-bad dui (+ dui dui1) +division+)
                 (nurbs-error :num-err 'fit-pts-normals))
               (setf alf (/ dui (+ dui dui1))
                     oma (- 1d0 alf))
               (when (float-op-is-bad oma dui +division+)
                 (nurbs-error :num-err 'fit-pts-normals))
               (when (float-op-is-bad alf dui1 +division+)
                 (nurbs-error :num-err 'fit-pts-normals))
               (setf oma (/ oma dui)
                     alf (/ alf dui1))
               (dotimes (j (1+ l))
                 (let* ((dvj (- (aref v (1+ j)) (aref v j)))
                        (dvj1 (- (aref v (+ j 2)) (aref v (1+ j))))
                        (bet 0d0) (omb 0d0))
                   (declare (type double-float dvj dvj1 bet omb))
                   (when (float-op-is-bad dvj (+ dvj dvj1) +division+)
                     (nurbs-error :num-err 'fit-pts-normals))
                   (setf bet (/ dvj (+ dvj dvj1))
                         omb (- 1d0 bet))
                   (when (float-op-is-bad omb dvj +division+)
                     (nurbs-error :num-err 'fit-pts-normals))
                   (when (float-op-is-bad bet dvj1 +division+)
                     (nurbs-error :num-err 'fit-pts-normals))
                   (setf omb (/ omb dvj)
                         bet (/ bet dvj1))
                   (tangents i j oma alf omb bet))))))
          ((= tan +akima+)
           (dotimes (i (1+ k))
             (dotimes (j (1+ l))
               (let ((a 0d0) (bb 0d0) (alf 0d0) (bet 0d0))
                 (declare (type double-float a bb alf bet))
                 (vector-cross (gpt su i j p0) (gpt su (1+ i) j p1) av)
                 (setf a (vector-magnitude av))
                 (vector-cross (gpt su (+ i 2) j p0) (gpt su (+ i 3) j p1) bv)
                 (setf bb (vector-magnitude bv))
                 (setf alf (if (> (+ a bb) ltol) (/ a (+ a bb)) 0.5d0))
                 (vector-cross (gpt sv i j p0) (gpt sv i (1+ j) p1) av)
                 (setf a (vector-magnitude av))
                 (vector-cross (gpt sv i (+ j 2) p0) (gpt sv i (+ j 3) p1) bv)
                 (setf bb (vector-magnitude bv))
                 (setf bet (if (> (+ a bb) ltol) (/ a (+ a bb)) 0.5d0))
                 (tangents i j (- 1d0 alf) alf (- 1d0 bet) bet)))))
          (t (nurbs-error :cal-err 'fit-pts-normals))))
      ;; the Bezier points along rows and columns
      (dotimes (j (1+ l))
        (let ((jj (* 3 j)))
          (declare (type fixnum jj))
          (dotimes (i k)
            (let ((ii (* 3 i))
                  (a (* (* od3 (aref r j)) (- (aref u (+ i 2)) (aref u (1+ i))))))
              (declare (type fixnum ii) (type double-float a))
              (copy pnet i j b ii jj)
              (along i j a tu (1+ i) (1+ j) (1+ ii) jj)
              (along (1+ i) j (- a) tu (+ i 2) (1+ j) (+ ii 2) jj)))
          (copy pnet k j b ib jj)))
      (dotimes (i (1+ k))
        (let ((ii (* 3 i)))
          (declare (type fixnum ii))
          (dotimes (j l)
            (let ((jj (* 3 j))
                  (bb (* (* od3 (aref s i)) (- (aref v (+ j 2)) (aref v (1+ j))))))
              (declare (type fixnum jj) (type double-float bb))
              (along i j bb tv (1+ i) (1+ j) ii (1+ jj))
              (along i (1+ j) (- bb) tv (1+ i) (+ j 2) ii (+ jj 2))))))
      ;; the mixed partial derivatives
      (dotimes (i (1+ k))
        (dotimes (j (1+ l))
          (ppt (vector-scale (gpt tu (1+ i) (1+ j) p0) (aref r j) p1) tu (1+ i) (1+ j))
          (ppt (vector-scale (gpt tv (1+ i) (1+ j) p0) (aref s i) p1) tv (1+ i) (1+ j))))
      (dotimes (i (1+ k))
        (combine 2d0 tu (1+ i) 1 -1d0 tu (1+ i) 2 tu (1+ i) 0)
        (combine 2d0 tu (1+ i) (1+ l) -1d0 tu (1+ i) l tu (1+ i) (+ l 2)))
      (dotimes (j (1+ l))
        (combine 2d0 tv 1 (1+ j) -1d0 tv 2 (1+ j) tv 0 (1+ j))
        (combine 2d0 tv (1+ k) (1+ j) -1d0 tv k (1+ j) tv (+ k 2) (1+ j)))
      (dotimes (i (1+ k))
        (let* ((dui (- (aref u (1+ i)) (aref u i)))
               (dui1 (- (aref u (+ i 2)) (aref u (1+ i))))
               (alf 0d0) (oma 0d0))
          (declare (type double-float dui dui1 alf oma))
          (when (float-op-is-bad dui (+ dui dui1) +division+)
            (nurbs-error :num-err 'fit-pts-normals))
          (setf alf (/ dui (+ dui dui1))
                oma (- 1d0 alf))
          (when (float-op-is-bad oma dui +division+)
            (nurbs-error :num-err 'fit-pts-normals))
          (when (float-op-is-bad alf dui1 +division+)
            (nurbs-error :num-err 'fit-pts-normals))
          (setf oma (/ oma dui)
                alf (/ alf dui1))
          (dotimes (j (1+ l))
            (let* ((dvj (- (aref v (1+ j)) (aref v j)))
                   (dvj1 (- (aref v (+ j 2)) (aref v (1+ j))))
                   (bet 0d0) (omb 0d0) (gam 0d0))
              (declare (type double-float dvj dvj1 bet omb gam))
              (when (float-op-is-bad dvj (+ dvj dvj1) +division+)
                (nurbs-error :num-err 'fit-pts-normals))
              (setf bet (/ dvj (+ dvj dvj1))
                    omb (- 1d0 bet))
              (when (float-op-is-bad omb dvj +division+)
                (nurbs-error :num-err 'fit-pts-normals))
              (when (float-op-is-bad bet dvj1 +division+)
                (nurbs-error :num-err 'fit-pts-normals))
              (setf omb (/ omb dvj)
                    bet (/ bet dvj1))
              (vector-diff (gpt tv (1+ i) (1+ j) p0) (gpt tv i (1+ j) p1) d1)
              (vector-diff (gpt tv (+ i 2) (1+ j) p0) (gpt tv (1+ i) (1+ j) p1) d2)
              (vector-combine oma d1 alf d2 av)
              (vector-diff (gpt tu (1+ i) (1+ j) p0) (gpt tu (1+ i) j p1) d1)
              (vector-diff (gpt tu (1+ i) (+ j 2) p0) (gpt tu (1+ i) (1+ j) p1) d2)
              (vector-combine omb d1 bet d2 bv)
              (setf gam (/ alf (+ alf bet)))
              (vector-combine (- 1d0 gam) av gam bv p2)
              (ppt p2 duv i j)))))
      ;; the inner Bezier points
      (dotimes (i k)
        (let ((ii (* 3 i))
              (dui1 (- (aref u (+ i 2)) (aref u (1+ i)))))
          (declare (type fixnum ii) (type double-float dui1))
          (dotimes (j l)
            (let* ((jj (* 3 j))
                   (dvj1 (- (aref v (+ j 2)) (aref v (1+ j))))
                   (gam (* (* od9 dui1) dvj1)))
              (declare (type fixnum jj) (type double-float dvj1 gam))
              (inner gam i j (1+ ii) jj ii (1+ jj) ii jj (1+ ii) (1+ jj))
              (inner (- gam) (1+ i) j (+ ii 2) jj (+ ii 3) (1+ jj) (+ ii 3) jj (+ ii 2) (1+ jj))
              (inner (- gam) i (1+ j) ii (+ jj 2) (1+ ii) (+ jj 3) ii (+ jj 3) (1+ ii) (+ jj 2))
              (inner gam (1+ i) (1+ j) (+ ii 3) (+ jj 2) (+ ii 2) (+ jj 3) (+ ii 3) (+ jj 3)
                     (+ ii 2) (+ jj 2))))))
      ;; project the Bezier points next to each data point onto its plane
      (when nnet
        ;; the corners
        (plane-at 0 0)
        (proj 0 1) (proj 1 1) (proj 1 0)
        (plane-at k 0)
        (proj (1- ib) 0) (proj (1- ib) 1) (proj ib 1)
        (plane-at 0 l)
        (proj 0 (1- jb)) (proj 1 (1- jb)) (proj 1 jb)
        (plane-at k l)
        (proj (1- ib) jb) (proj (1- ib) (1- jb)) (proj ib (1- jb))
        ;; along j = 0 and j = jb
        (let ((ii 0))
          (declare (type fixnum ii))
          (do ((i 1 (1+ i))) ((>= i ib))
            (declare (type fixnum i))
            (when (= (rem i 3) 0)
              (incf ii)
              (plane-at ii 0)
              (proj (1- i) 0) (proj (1- i) 1) (proj (1+ i) 1) (proj (1+ i) 0)
              (plane-at ii l)
              (proj (1- i) jb) (proj (1- i) (1- jb)) (proj (1+ i) (1- jb)) (proj (1+ i) jb))))
        ;; along i = 0 and i = ib
        (let ((jj 0))
          (declare (type fixnum jj))
          (do ((j 1 (1+ j))) ((>= j jb))
            (declare (type fixnum j))
            (when (= (rem j 3) 0)
              (incf jj)
              (plane-at 0 jj)
              (proj 0 (1- j)) (proj 1 (1- j)) (proj 1 (1+ j)) (proj 0 (1+ j))
              (plane-at k jj)
              (proj ib (1- j)) (proj (1- ib) (1- j)) (proj (1- ib) (1+ j)) (proj ib (1+ j)))))
        ;; the interior points
        (let ((jj 0))
          (declare (type fixnum jj))
          (do ((j 1 (1+ j))) ((>= j jb))
            (declare (type fixnum j))
            (when (= (rem j 3) 0)
              (incf jj)
              (let ((ii 0))
                (declare (type fixnum ii))
                (do ((i 1 (1+ i))) ((>= i ib))
                  (declare (type fixnum i))
                  (when (= (rem i 3) 0)
                    (incf ii)
                    (plane-at ii jj)
                    (proj (1- i) (1- j)) (proj (1- i) (1+ j))
                    (proj (1+ i) (1+ j)) (proj (1+ i) (1- j)))))))))
      ;; the control points
      (flet ((cpt (net i j ii jj)
               ;; N_PtToCPt( net[i][j], &Pw[ii][jj] )
               (%c-pt-net (pt-to-c-pt (gpt net i j p0) cp) pw ii jj)))
        (cpt pnet 0 0 0 0)
        (cpt pnet k 0 n 0)
        (cpt pnet 0 l 0 m)
        (cpt pnet k l n m)
        (let ((ii 0))
          (declare (type fixnum ii))
          (do ((i 1 (1+ i))) ((>= i ib))
            (declare (type fixnum i))
            (unless (= (rem i 3) 0)
              (incf ii)
              (cpt b i 0 ii 0)
              (cpt b i jb ii m))))
        (let ((jj 0))
          (declare (type fixnum jj))
          (do ((j 1 (1+ j))) ((>= j jb))
            (declare (type fixnum j))
            (unless (= (rem j 3) 0)
              (incf jj)
              (cpt b 0 j 0 jj)
              (cpt b ib j n jj))))
        (let ((ii 0))
          (declare (type fixnum ii))
          (do ((i 1 (1+ i))) ((>= i ib))
            (declare (type fixnum i))
            (unless (= (rem i 3) 0)
              (incf ii)
              (let ((jj 0))
                (declare (type fixnum jj))
                (do ((j 1 (1+ j))) ((>= j jb))
                  (declare (type fixnum j))
                  (unless (= (rem j 3) 0)
                    (incf jj)
                    (cpt b i j ii jj)))))))))
    (%make-surface 3 3 uk vk pw)))

;;; ------------------------------------------------ fit to points and boundary curves

(defun %srf-fit-boundary-knots (pars mu nn deg ns0 kb ke meth bk ki kp rname)
  "The knot selection of N_FitSrfToPtsAndBoundary for one direction: write
into a fresh knot array of NS0+DEG+2 knots (the C's allocation) the knots of
degree DEG for NS0 control points (fewer for METH 2, which only takes knots
of the boundary knot vector BK, of highest control point index NN) from the
parameters PARS[0..MU] between KB and KE, using KI and KP as scratch for the
ideal knot vectors of degrees DEG and DEG-1, and for METH 2 add knots of BK
where parameters are plenty.  Returns (values knots ns).  Signals :num-err
for RNAME when METH 2 runs out of control points."
  (declare (type real-vector pars bk ki kp) (type fixnum mu nn deg ns0 meth)
           (type double-float kb ke))
  (let ((uk (make-real-vector (+ ns0 deg 2)))
        (ns ns0)
        (per 0.8d0))
    (declare (type real-vector uk) (type fixnum ns) (type double-float per))
    ;; loop until the knot vector is done
    (do () (nil)
      (dotimes (ii (1+ deg))
        (setf (aref uk ii) kb
              (aref uk (+ ns ii 1)) ke))
      (when (= deg ns)
        (return))
      ;; ideal knot vectors for degrees deg and deg-1
      (fit-calc-knot-vector-crv-approx pars mu ns deg ki)
      (fit-calc-knot-vector-crv-approx pars mu ns (1- deg) kp)
      ;; select knots from BK
      (let ((jj (1+ deg))
            (ii (1+ deg)))
        (declare (type fixnum jj ii))
        (do () ((> ii ns))
          (let ((a (+ (* (- 1d0 per) (aref ki ii)) (* per (aref kp (1- ii)))))
                (b (+ (* (- 1d0 per) (aref ki ii)) (* per (aref kp ii))))
                (fac 0d0)
                (jc -1))
            (declare (type double-float a b fac) (type fixnum jc))
            (do () ((not (<= (aref bk jj) a)))
              (incf jj))
            (setf fac (- b a))
            (do () ((not (and (> (aref bk jj) a) (< (aref bk jj) b))))
              (let ((d1 (abs (- (aref ki ii) (aref bk jj)))))
                (declare (type double-float d1))
                (when (< d1 fac)
                  (setf fac d1
                        jc jj)))
              (incf jj))
            ;; now depends on the method
            (if (= meth 1)
                (setf (aref uk ii) (if (= jc -1) (aref ki ii) (aref bk jc)))
                (if (= jc -1)
                    (progn
                      (decf ns)
                      (decf ii)
                      (when (< ns deg)
                        (nurbs-error :num-err rname))
                      (return))
                    (setf (aref uk ii) (aref bk jc)))))
          (incf ii))
        (when (> ii ns)
          (return))))
    ;; try to use more knots in areas where there are plenty of parameters
    (when (and (= meth 2) (< ns nn) (> mu nn))
      (let ((kpmin (* 2 (1+ deg)))
            (kn1 deg) (kn2 (1+ deg))     ; [kn1,kn2] index range in UK
            (kn3 deg) (kn4 deg)          ; [kn3,kn4] index range in BK
            (kp1 0) (kp2 0)              ; [kp1,kp2] index range in PARS
            (count 0))
        (declare (type fixnum kpmin kn1 kn2 kn3 kn4 kp1 kp2 count))
        (do () (nil)
          (block next
            (let ((ii kn3))
              (declare (type fixnum ii))
              (do () ((or (> ii nn) (> (aref bk ii) (aref uk kn1))))
                (incf ii))
              (if (> ii nn)
                  (return-from next)
                  (setf kn3 ii)))
            (do () ((not (< (aref bk kn4) (aref uk kn2))))
              (incf kn4))
            (decf kn4)
            (when (> kn3 kn4)
              (return-from next))
            (let ((ii kp1))
              (declare (type fixnum ii))
              (do () ((or (>= ii mu) (> (aref pars ii) (aref uk kn1))))
                (incf ii))
              (if (>= ii mu)
                  (return-from next)
                  (setf kp1 ii)))
            (do () ((not (< (aref pars kp2) (aref uk kn2))))
              (incf kp2))
            (decf kp2)
            (when (<= (- kp2 kp1) (* 2 kpmin))
              (return-from next))
            (let* ((k1 (truncate (+ kp1 kp2) 2))
                   (a (if (= (rem (- kp2 kp1) 2) 0)
                          (aref pars k1)
                          (* 0.5d0 (+ (aref pars k1) (aref pars (1+ k1))))))
                   (d1 0d0) (k2 0) (k3 0))
              (declare (type fixnum k1 k2 k3) (type double-float a d1))
              ;; the BK knot closest to the parameter value a
              (setf k1 kn3
                    d1 (abs (- a (aref bk k1))))
              (do ((ii (1+ kn3) (1+ ii))) ((> ii kn4))
                (declare (type fixnum ii))
                (when (< (abs (- a (aref bk ii))) d1)
                  (setf k1 ii
                        d1 (abs (- a (aref bk ii))))))
              (do ((ii kp1 (1+ ii))) ((> ii kp2))
                (declare (type fixnum ii))
                (if (< (aref pars ii) (aref bk k1))
                    (incf k2)
                    (incf k3)))
              (when (and (>= k2 kpmin) (>= k3 kpmin))
                ;; plenty of parameters to either side
                (setf k2 (+ ns deg 1))
                (do () ((not (> (aref uk k2) (aref bk k1))))
                  (setf (aref uk (1+ k2)) (aref uk k2))
                  (decf k2))
                (setf (aref uk (1+ k2)) (aref bk k1))
                (incf ns)
                (incf count)
                (incf kn2))))
          ;; NEXT
          (if (> kn2 ns)
              (progn
                (if (= count 0)
                    (return)
                    (setf count 0))
                (setf kn1 deg
                      kn2 (1+ deg)
                      kn3 deg
                      kn4 deg
                      kp1 0
                      kp2 0))
              (progn
                (setf kn1 kn2)
                (do () ((not (= (aref uk kn1) (aref uk (1+ kn1)))))
                  (incf kn1))
                (setf kn2 (1+ kn1))
                (let ((k1 (nl-min kp1 kp2)))
                  (setf kp1 k1 kp2 k1))
                (let ((k1 (nl-min kn3 kn4)))
                  (setf kn3 k1 kn4 k1)))))))
    (values uk ns)))

(defun %srf-fit-missing-knots (a hi b deg x)
  "Write into X, in order, the knots A[DEG+1..HI] (with their multiplicities)
that the knot array B lacks or holds fewer times, as N_FitSrfToPtsAndBoundary
compares knot vectors; return the highest index written, -1 for none."
  (declare (type real-vector a b x) (type fixnum hi deg))
  (let ((k1 -1)
        (jj (1+ deg))
        (ii (1+ deg)))
    (declare (type fixnum k1 jj ii))
    (do () ((not (<= ii hi)))
      (let ((mult1 1) (mult2 0))
        (declare (type fixnum mult1 mult2))
        (do () ((not (= (aref a ii) (aref a (+ ii mult1)))))
          (incf mult1))
        (do () ((not (< (aref b jj) (aref a ii))))
          (incf jj))
        (when (= (aref b jj) (aref a ii))
          (setf mult2 1)
          (do () ((not (= (aref b jj) (aref b (+ jj mult2)))))
            (incf mult2)))
        (do ((kk 1 (1+ kk))) ((> kk (- mult1 mult2)))
          (declare (type fixnum kk))
          (incf k1)
          (setf (aref x k1) (aref a ii)))
        (incf jj mult2)
        (incf ii mult1)))
    k1))

(defun fit-srf-to-pts-and-boundary (pnet mu mv up vp cur-u cur-v meth n m)
  "The surface approximating the grid of points PNET[0..MU][0..MV] (a
point-net, its boundary rows and columns on the boundary curves) whose four
boundaries are exactly the boundary curves: CUR-U (a sequence of two curves,
at v = vmin and v = vmax) and CUR-V (two curves, at u = umin and u = umax),
each pair compatible (same degree above 1, control point count and end
knots; :inp-err otherwise, and for MU or MV not above the degree) and
nonrational.  UP[0..MU] and VP[0..MV] are the parameters of the points, or
both NIL to have them computed from closest points on the boundaries
(:num-err when none is found for a row).  METH 1 fits with N+1 x M+1 control
points (degree <= N < MU and degree <= M < MV, :inp-err otherwise), knots of
the boundaries taken where they fit and new ones elsewhere; METH 2 uses only
the boundaries' knots (:num-err when too few fit).  The least-squares surface
gets the boundaries' missing knots inserted, the boundary curves the
surface's, and the outer control points are replaced by the curves'.  Returns
a fresh surface.
NLib: N_FitSrfToPtsAndBoundary."
  (declare (type point-net pnet) (type fixnum mu mv meth n m)
           (type (or null real-vector) up vp) (type sequence cur-u cur-v))
  (when (or (and (null up) vp) (and (null vp) up))
    (nurbs-error :inp-err 'fit-srf-to-pts-and-boundary))
  (when (and (= meth 1) (or (>= n mu) (>= m mv)))
    (nurbs-error :inp-err 'fit-srf-to-pts-and-boundary))
  (let* ((cu0 (elt cur-u 0)) (cu1 (elt cur-u 1))
         (cv0 (elt cur-v 0)) (cv1 (elt cur-v 1))
         (nn (curve-n cu0)) (mm (curve-n cv0))
         (p (curve-degree cu0)) (q (curve-degree cv0))
         (us (aref (curve-knots cu0) 0)) (ue (aref (curve-knots cu0) (curve-m cu0)))
         (vs (aref (curve-knots cv0) 0)) (ve (aref (curve-knots cv0) (curve-m cv0)))
         ;; the knots compared below are those of the second curve of each pair
         (uu (curve-knots cu1))
         (vv (curve-knots cv1)))
    (declare (type curve cu0 cu1 cv0 cv1) (type fixnum nn mm p q)
             (type double-float us ue vs ve) (type real-vector uu vv))
    (when (or (/= nn (curve-n cu1)) (/= p (curve-degree cu1)))
      (nurbs-error :inp-err 'fit-srf-to-pts-and-boundary))
    (when (or (/= us (aref uu 0)) (/= ue (aref uu (curve-m cu1))))
      (nurbs-error :inp-err 'fit-srf-to-pts-and-boundary))
    (when (or (<= mu p) (= p 1))
      (nurbs-error :inp-err 'fit-srf-to-pts-and-boundary))
    (when (or (/= mm (curve-n cv1)) (/= q (curve-degree cv1)))
      (nurbs-error :inp-err 'fit-srf-to-pts-and-boundary))
    (when (or (/= vs (aref vv 0)) (/= ve (aref vv (curve-m cv1))))
      (nurbs-error :inp-err 'fit-srf-to-pts-and-boundary))
    (when (or (<= mv q) (= q 1))
      (nurbs-error :inp-err 'fit-srf-to-pts-and-boundary))
    (when (and (= meth 1) (or (< n p) (< m q)))
      (nurbs-error :inp-err 'fit-srf-to-pts-and-boundary))
    (let ((upars up)
          (vpars vp)
          (q* (make-point))
          (pt (make-point)))
      (declare (type point q* pt))
      ;; compute the parameters if necessary: those the boundaries imply
      (unless up
        (let ((top (* 10d0 *mtol*))
              (toc 1d-5))
          (declare (type double-float top toc))
          (flet ((params (cnt kb ke c0 c1 fetch)
                   ;; parameters 0..CNT from KB to KE: the average of the
                   ;; closest points on the curves C0 and C1 to the points
                   ;; FETCH returns, from guesses near the step to the end
                   (declare (type fixnum cnt) (type double-float kb ke) (type function fetch))
                   (let ((par (make-real-vector (1+ cnt))))
                     (setf (aref par 0) kb
                           (aref par cnt) ke)
                     (do ((ii 1 (1+ ii))) ((>= ii cnt))
                       (declare (type fixnum ii))
                       (let ((k1 0)
                             (duv (/ (- ke (aref par (1- ii)))
                                     (+ (- (float cnt 1d0) (float ii 1d0)) 1d0))))
                         (declare (type fixnum k1) (type double-float duv))
                         (setf (aref par ii) 0d0)
                         (dotimes (jj 2)
                           (let ((uv (+ (aref par (1- ii)) duv)))
                             (declare (type double-float uv))
                             (do ((kk 1 (1+ kk))) ((> kk 3))
                               (declare (type fixnum kk))
                               (let ((d1 (handler-case
                                             (crv-closest-pt (if (= jj 0) c0 c1) (funcall fetch ii jj pt)
                                                             uv top toc q*)
                                           (nurbs-error () nil))))
                                 (if d1
                                     (progn
                                       (setf (aref par ii) (+ (aref par ii) (the double-float d1)))
                                       (incf k1)
                                       (return))
                                     (cond ((= kk 1)
                                            (setf uv (+ (aref par (1- ii)) (* 0.67d0 duv))))
                                           ((= kk 2)
                                            (setf uv (+ (aref par (1- ii)) (* 1.33d0 duv))))))))))
                         (if (= k1 0)
                             (nurbs-error :num-err 'fit-srf-to-pts-and-boundary)
                             (setf (aref par ii) (/ (aref par ii) (float k1 1d0))))))
                     par)))
            (setf upars (params mu us ue cu0 cu1 (lambda (ii jj x) (%net-pt pnet ii (* jj mv) x))))
            (setf vpars (params mv vs ve cv0 cv1 (lambda (ii jj x) (%net-pt pnet (* jj mu) ii x)))))))
      (let* ((ns (if (= meth 1) n (nl-min nn (1- mu))))
             (ms (if (= meth 1) m (nl-min mm (1- mv))))
             (kmax (nl-max (+ ns p 1) (+ ms q 1)))
             (ki (make-real-vector (1+ kmax)))
             (kp (make-real-vector (1+ kmax)))
             (uk (make-real-vector 0))
             (vk (make-real-vector 0)))
        (declare (type fixnum ns ms kmax) (type real-vector ki kp uk vk upars vpars))
        ;; the knots and number of control points for the fit
        (multiple-value-setq (uk ns)
          (%srf-fit-boundary-knots upars mu nn p ns us ue meth uu ki kp 'fit-srf-to-pts-and-boundary))
        (multiple-value-setq (vk ms)
          (%srf-fit-boundary-knots vpars mv mm q ms vs ve meth vv ki kp 'fit-srf-to-pts-and-boundary))
        ;; the surface fit
        (let* ((sur (fit-srf-lst-sq-knots pnet mu mv +epoint+ upars vpars
                                          (subseq uk 0 (+ ns p 2)) (subseq vk 0 (+ ms q 2))
                                          ns ms p q))
               (x (make-real-vector (1+ (+ (nl-max (nl-max nn mm) (nl-max ns ms)) (nl-max p q)))))
               (uw0 (curve-cpoints cu0)) (uw1 (curve-cpoints cu1))
               (vw0 (curve-cpoints cv0)) (vw1 (curve-cpoints cv1))
               (k1 0))
          (declare (type surface sur) (type real-vector x) (type cpoint-array uw0 uw1 vw0 vw1)
                   (type fixnum k1))
          ;; refine the surface with the boundaries' knots it lacks
          (setf k1 (%srf-fit-missing-knots uu nn uk p x))
          (when (>= k1 0)
            (setf sur (srf-insert-knots sur (knot-vector-from-real-array x k1) +udir+)))
          (setf k1 (%srf-fit-missing-knots vv mm vk q x))
          (when (>= k1 0)
            (setf sur (srf-insert-knots sur (knot-vector-from-real-array x k1) +vdir+)))
          ;; refine the boundary curves with the surface's knots they lack
          (let* ((su (surface-knots-u sur))
                 (sv (surface-knots-v sur)))
            (declare (type real-vector su sv))
            (setf k1 (%srf-fit-missing-knots su (- (length su) p 2) uu p x))
            (when (>= k1 0)
              (let ((knx (knot-vector-from-real-array x k1)))
                (setf uw0 (curve-cpoints (crv-refine cu0 knx))
                      uw1 (curve-cpoints (crv-refine cu1 knx)))))
            (setf k1 (%srf-fit-missing-knots sv (- (length sv) q 2) vv q x))
            (when (>= k1 0)
              (let ((knx (knot-vector-from-real-array x k1)))
                (setf vw0 (curve-cpoints (crv-refine cv0 knx))
                      vw1 (curve-cpoints (crv-refine cv1 knx))))))
          ;; replace the outer control points with those of the boundary curves
          (let* ((pw (surface-cpoints sur))
                 (sn (surface-n sur))
                 (sm (surface-m sur))
                 (c (make-cpoint)))
            (declare (type cpoint-net pw) (type fixnum sn sm) (type cpoint c))
            (flet ((boundary (arr ii i j)
                     ;; N_CPtToPtEuclid( arr[ii], &Q ); N_PtToCPt( Q, &Pw[i][j] )
                     (declare (type cpoint-array arr) (type fixnum ii i j))
                     (set-cpoint c (aref arr ii 0) (aref arr ii 1) (aref arr ii 2) (aref arr ii 3))
                     (%c-pt-net (pt-to-c-pt (c-pt-to-pt-euclid c q*) c) pw i j)))
              (dotimes (ii (1+ sn))
                (boundary uw0 ii ii 0)
                (boundary uw1 ii ii sm))
              (dotimes (ii (1+ sm))
                (boundary vw0 ii 0 ii)
                (boundary vw1 ii sn ii))))
          sur)))))

;;; ------------------------------------------------ approximation to a tolerance

(defun %srf-fit-sync-knots (st kn r-old)
  "Bring ST, the C's knot storage of a surface, up to date after knot removal
left the knots KN: the C shifts its knots down in place, so ST[0..r] becomes
KN and ST[r+1..R-OLD] holds the end knot the shifts left there; the rest of ST
is untouched.  Returns ST."
  (declare (type real-vector st kn) (type fixnum r-old))
  (let ((r (1- (length kn))))
    (declare (type fixnum r))
    (replace st kn)
    (do ((i (1+ r) (1+ i))) ((> i r-old))
      (declare (type fixnum i))
      (setf (aref st i) (aref kn r)))
    st))

(defun fit-srf-approx-tol (pnet mu mv ps pr qs qr e ktp atp)
  "A surface of degrees PR, QR approximating the grid of points
PNET[0..MU][0..MV] (a point-net, chord-length parameters, each row and column
on an isoparameter line) within the tolerance E, found as the C finds it:
interpolate with degrees (PS, QS), then repeatedly remove every knot the
tolerance allows, raise the degrees by one towards (PR, QR) and fit by least
squares, adjusting the parameters by closest points; a failed fit restarts
from an interpolation one degree higher.  KTP +single+ adds one knot per
span for the higher degree, anything else (+multiple+) raises every knot's
multiplicity; ATP +yes+ takes the knots so made from the knot removal, else
new ones are computed from the parameters.  Signals :inp-err for PR > MU,
QR > MV, PR < PS or QR < QS, and what the parametrization, the interpolation
and the knot removal signal.  As in the C, whose knot vectors share the
surface's storage, a least-squares step after one direction reached its
degree reuses the size and the stale knots of the step before.  Returns a
fresh surface.
NLib: N_FitSrfApproxTol."
  (declare (type point-net pnet) (type fixnum mu mv ps pr qs qr ktp atp)
           (type double-float e))
  (let* ((diag (pts-2d-get-max-extent pnet mu mv))
         (ltop (* diag 1d-4))
         (ltoc 1d-6))
    (declare (type double-float diag ltop ltoc))
    (when (or (> pr mu) (> qr mv))
      (nurbs-error :inp-err 'fit-srf-approx-tol))
    (when (or (< pr ps) (< qr qs))
      (nurbs-error :inp-err 'fit-srf-approx-tol))
    ;; UST and VST are the knot arrays the C allocates for the surface, which
    ;; its knot vectors KNU and KNV share
    (let ((ust (make-real-vector (+ mu pr 2)))
          (vst (make-real-vector (+ mv qr 2)))
          (er (make-real-matrix (1+ mu) (1+ mv)))
          (u (make-real-vector (1+ mu)))
          (us (make-real-vector (1+ mu)))
          (v (make-real-vector (1+ mv)))
          (vs (make-real-vector (1+ mv)))
          (sd (make-point-net 3 3))
          (q* (make-point))
          (pt (make-point))
          (sur nil)
          (iu ps) (iv qs) (ju 0) (jv 0)
          (nh 0) (mh 0))
      (declare (type real-vector ust vst u us v vs) (type real-matrix er)
               (type point-net sd) (type point q* pt)
               (type fixnum iu iv ju jv nh mh))
      ;; parameters assuming a regular grid of points
      (fit-calc-srf-param-values pnet mu mv +epoint+ +chordlength+ us vs)
      (block outer
        (do () ((not (and (<= iu pr) (<= iv qr))))
          ;; interpolate with degrees (iu, iv)
          (dotimes (k (1+ mu))
            (setf (aref u k) (aref us k))
            (dotimes (l (1+ mv))
              (setf (aref er k l) 0d0)))
          (dotimes (l (1+ mv))
            (setf (aref v l) (aref vs l)))
          (fit-crv-calc-knot-vector u mu iu ust)
          (fit-crv-calc-knot-vector v mv iv vst)
          (setf sur (fit-srf-to-pts-knots pnet mu mv +epoint+ u v
                                          (subseq ust 0 (+ mu iu 2)) (subseq vst 0 (+ mv iv 2))
                                          iu iv))
          (setf ju iu
                jv iv)
          (block inner
            (do () ((not (and (<= ju pr) (<= jv qr))))
              ;; remove as many knots as possible
              (let ((r-old (1- (length (surface-knots-u sur))))
                    (s-old (1- (length (surface-knots-v sur)))))
                (declare (type fixnum r-old s-old))
                (fit-srf-approx-remove-knots sur u v er mu mv e +uvdir+)
                (%srf-fit-sync-knots ust (surface-knots-u sur) r-old)
                (%srf-fit-sync-knots vst (surface-knots-v sur) s-old))
              (when (and (= ju pr) (= jv qr))
                (return-from inner))
              (let ((ns (surface-n sur))
                    (ms (surface-m sur))
                    (rs (1- (length (surface-knots-u sur))))
                    (ss (1- (length (surface-knots-v sur))))
                    (p (if (< ju pr) (1+ ju) ju))
                    (q (if (< jv qr) (1+ jv) jv)))
                (declare (type fixnum ns ms rs ss p q))
                ;; the new knot vectors
                (cond
                  ((and (= atp +yes+) (= ktp +single+))
                   (when (< ju pr)
                     (setf nh (1+ ns))
                     (when (> nh mu)
                       (return-from inner))
                     (let ((rh (+ rs 2)))
                       (declare (type fixnum rh))
                       (dotimes (k (+ ju 2))
                         (setf (aref ust rh) (aref ust rs))
                         (decf rh))
                       (do ((k ns (1- k))) ((< k (1+ ju)))
                         (declare (type fixnum k))
                         (setf (aref ust rh) (aref ust k))
                         (decf rh))
                       (dotimes (k (+ ju 2))
                         (setf (aref ust rh) (aref ust 0))
                         (decf rh))))
                   (when (< jv qr)
                     (setf mh (1+ ms))
                     (when (> mh mv)
                       (return-from inner))
                     (let ((sh (+ ss 2)))
                       (declare (type fixnum sh))
                       (dotimes (k (+ jv 2))
                         (setf (aref vst sh) (aref vst ss))
                         (decf sh))
                       (do ((k ms (1- k))) ((< k (1+ jv)))
                         (declare (type fixnum k))
                         (setf (aref vst sh) (aref vst k))
                         (decf sh))
                       (dotimes (k (+ jv 2))
                         (setf (aref vst sh) (aref vst 0))
                         (decf sh)))))
                  ((= atp +yes+)
                   ;; multiple knots: every distinct knot once more
                   (when (< ju pr)
                     (let* ((nsu (basis-get-span-count (surface-knots-u sur) ju))
                            (rh (+ rs nsu 1)))
                       (declare (type fixnum nsu rh))
                       (setf nh (+ ns nsu))
                       (when (> nh mu)
                         (return-from inner))
                       (do () ((not (> rs 0)))
                         (let ((k rs))
                           (declare (type fixnum k))
                           (do () ((not (and (> rs 0) (= (aref ust rs) (aref ust (1- rs))))))
                             (decf rs))
                           (dotimes (l (+ (- k rs) 2))
                             (setf (aref ust rh) (aref ust rs))
                             (decf rh))
                           (decf rs)))))
                   (when (< jv qr)
                     (let* ((nsv (basis-get-span-count (surface-knots-v sur) jv))
                            (sh (+ ss nsv 1)))
                       (declare (type fixnum nsv sh))
                       (setf mh (+ ms nsv))
                       (when (> mh mv)
                         (return-from inner))
                       (do () ((not (> ss 0)))
                         (let ((k ss))
                           (declare (type fixnum k))
                           (do () ((not (and (> ss 0) (= (aref vst ss) (aref vst (1- ss))))))
                             (decf ss))
                           (dotimes (l (+ (- k ss) 2))
                             (setf (aref vst sh) (aref vst ss))
                             (decf sh))
                           (decf ss))))))
                  (t
                   ;; knots from clumping the parameters
                   (setf nh (nl-min (1+ ns) mu)
                         mh (nl-min (1+ ms) mv))
                   (fit-calc-knot-vector-crv-approx u mu nh p ust)
                   (fit-calc-knot-vector-crv-approx v mv mh q vst)))
                ;; approximate by least squares; a failure restarts.  A size
                ;; left over from a step that stopped at "nh > mu" (or "mh >
                ;; mv") fails the fit's own checks before it reads a knot
                (when (or (> nh mu) (> mh mv))
                  (return-from inner))
                (setf sur (handler-case
                              (fit-srf-lst-sq-knots pnet mu mv +epoint+ u v
                                                    (subseq ust 0 (+ nh p 2)) (subseq vst 0 (+ mh q 2))
                                                    nh mh p q)
                            (nurbs-error () (return-from inner))))
                ;; adjust the parameters and the error matrix
                (do ((k 1 (1+ k))) ((>= k mu))
                  (declare (type fixnum k))
                  (do ((l 1 (1+ l))) ((>= l mv))
                    (declare (type fixnum l))
                    (handler-case
                        (multiple-value-bind (uu vv)
                            (get-closest-pt-on-srf sur (%net-pt pnet k l pt) (aref u k) (aref v l)
                                                   ltop ltoc q* sd)
                          (setf (aref u k) uu
                                (aref v l) vv))
                      (nurbs-error () (return-from inner)))
                    (setf (aref er k l) (dist-pt-pt (%net-pt pnet k l pt) q*))
                    (when (> (aref er k l) e)
                      (return-from inner))))
                (when (< ju pr) (incf ju))
                (when (< jv qr) (incf jv)))))
          (when (and (= ju pr) (= jv qr))
            (return-from outer))
          (when (< iu pr) (incf iu))
          (when (< iv qr) (incf iv))))
      (srf-compress sur))))

;;; ------------------------------------------------ interpolation with boundaries

(defun fit-srf-interp-boundary (pnet k l bnd-u bnd-v u v)
  "The surface interpolating the grid of points PNET[0..K][0..L] (a
point-net) whose four boundaries are the curves BND-U (a sequence of two: v =
vmin and v = vmax) and BND-V (two: u = umin and u = umax), each pair
non-rational and compatible (:inp-err otherwise).  U[0..K] and V[0..L] are the
parameters of the points (rescaled to the boundaries' domains when their ends
differ), or NIL to have them blended from the projections of the boundary rows
and columns onto the boundary curves.  The rows are interpolated in the
v-direction first (degree of BND-V, knots offered by BND-V's), the columns of
the compatible control points then in the u-direction, with
fit-crv-knots-and-tangents; whatever the projections, the fits and the
compatibility routine signal is passed on.  Returns a fresh surface.
NLib: N_FitSrfInterpBoundary."
  (declare (type point-net pnet) (type fixnum k l) (type sequence bnd-u bnd-v)
           (type (or null real-vector) u v))
  (let* ((bu (vector (elt bnd-u 0) (elt bnd-u 1)))
         (bv (vector (elt bnd-v 0) (elt bnd-v 1)))
         (per 0.8d0)
         (pdt 0.001d0))
    (declare (type simple-vector bu bv) (type double-float per pdt))
    ;; check incoming data
    (when (is-crv-rat (svref bu 0)) (nurbs-error :inp-err 'fit-srf-interp-boundary))
    (when (is-crv-rat (svref bu 1)) (nurbs-error :inp-err 'fit-srf-interp-boundary))
    (when (is-crv-rat (svref bv 0)) (nurbs-error :inp-err 'fit-srf-interp-boundary))
    (when (is-crv-rat (svref bv 1)) (nurbs-error :inp-err 'fit-srf-interp-boundary))
    (unless (crvs-are-combatible bu 1) (nurbs-error :inp-err 'fit-srf-interp-boundary))
    (unless (crvs-are-combatible bv 1) (nurbs-error :inp-err 'fit-srf-interp-boundary))
    (let* ((kbu (curve-knots (svref bu 0)))
           (kbv (curve-knots (svref bv 0)))
           (r (1- (length kbu)))
           (s (1- (length kbv)))
           (p (curve-degree (svref bu 0)))
           (q (curve-degree (svref bv 0)))
           (qa (make-point-array (1+ (nl-max k l))))
           (pt (make-point))
           (ui (make-real-vector 0)) (vi (make-real-vector 0))
           (ub (make-real-vector 0)) (ut (make-real-vector 0))
           (vl (make-real-vector 0)) (vr (make-real-vector 0)))
      (declare (type real-vector kbu kbv ui vi ub ut vl vr) (type fixnum r s p q)
               (type point-array qa) (type point pt))
      ;; adjust the parameters if needed
      (if u
          (let ((u u))
            (declare (type real-vector u))
            (if (or (/= (aref u 0) (aref kbu 0)) (/= (aref u k) (aref kbu r)))
                (let ((fac (/ (- (aref kbu r) (aref kbu 0)) (- (aref u k) (aref u 0)))))
                  (declare (type double-float fac))
                  (setf ui (make-real-vector (1+ k)))
                  (do ((i 1 (1+ i))) ((>= i k))
                    (declare (type fixnum i))
                    (setf (aref ui i) (+ (aref kbu 0) (* fac (- (aref u i) (aref u 0))))))
                  (setf (aref ui 0) (aref kbu 0)
                        (aref ui k) (aref kbu r)))
                (setf ui u)))
          (progn
            (setf ui (make-real-vector (1+ k)))
            (dotimes (i (1+ k))
              (%pt-row (%net-pt pnet i 0 pt) qa i))
            (setf ub (nth-value 1 (crv-project-pts (svref bu 0) qa k pdt)))
            (dotimes (i (1+ k))
              (%pt-row (%net-pt pnet i l pt) qa i))
            (setf ut (nth-value 1 (crv-project-pts (svref bu 1) qa k pdt)))))
      (if v
          (let ((v v))
            (declare (type real-vector v))
            (if (or (/= (aref v 0) (aref kbv 0)) (/= (aref v l) (aref kbv s)))
                (let ((fac (/ (- (aref kbv s) (aref kbv 0)) (- (aref v l) (aref v 0)))))
                  (declare (type double-float fac))
                  (setf vi (make-real-vector (1+ l)))
                  (do ((j 1 (1+ j))) ((>= j l))
                    (declare (type fixnum j))
                    (setf (aref vi j) (+ (aref kbv 0) (* fac (- (aref v j) (aref v 0))))))
                  (setf (aref vi 0) (aref kbv 0)
                        (aref vi l) (aref kbv s)))
                (setf vi v)))
          (progn
            (setf vi (make-real-vector (1+ l)))
            (dotimes (j (1+ l))
              (%pt-row (%net-pt pnet 0 j pt) qa j))
            (setf vl (nth-value 1 (crv-project-pts (svref bv 0) qa l pdt)))
            (dotimes (j (1+ l))
              (%pt-row (%net-pt pnet k j pt) qa j))
            (setf vr (nth-value 1 (crv-project-pts (svref bv 1) qa l pdt)))))
      ;; interpolate in the v-direction first
      (let ((knv (knots-copy kbv nil))
            (cur-v (make-array (1+ k)))
            (row (make-point-array (1+ l))))
        (declare (type real-vector knv) (type simple-vector cur-v) (type point-array row))
        (setf (svref cur-v 0) (crv-copy (svref bv 0)))
        (setf (svref cur-v k) (crv-copy (svref bv 1)))
        (let ((fac (/ 1d0 (float k 1d0))))
          (declare (type double-float fac))
          (do ((i 1 (1+ i))) ((>= i k))
            (declare (type fixnum i))
            (let* ((alf (* (float i 1d0) fac))
                   (oma (- 1d0 alf)))
              (declare (type double-float alf oma))
              (unless v
                (dotimes (j (1+ l))
                  (setf (aref vi j) (+ (* oma (aref vl j)) (* alf (aref vr j))))))
              ;; the row P[i]
              (dotimes (j (1+ l))
                (%pt-row (%net-pt pnet i j pt) row j))
              (multiple-value-bind (cur kn)
                  (fit-crv-knots-and-tangents row l vi nil nil +tangent+ knv per q)
                (setf (svref cur-v i) cur
                      knv kn)))))
        ;; make the curves compatible
        (crvs-make-compatible cur-v k)
        (let* ((vi* (curve-knots (svref cur-v 0)))
               (mi (curve-n (svref cur-v 0)))
               (knu (knots-copy kbu nil))
               (cur-u (make-array (1+ mi)))
               (c (make-cpoint)))
          (declare (type real-vector vi* knu) (type fixnum mi) (type simple-vector cur-u)
                   (type cpoint c))
          ;; now interpolate in the u-direction
          (setf (svref cur-u 0) (crv-copy (svref bu 0)))
          (setf (svref cur-u mi) (crv-copy (svref bu 1)))
          (let ((fac (/ 1d0 (float mi 1d0))))
            (declare (type double-float fac))
            (do ((j 1 (1+ j))) ((>= j mi))
              (declare (type fixnum j))
              (let* ((alf (* (float j 1d0) fac))
                     (oma (- 1d0 alf)))
                (declare (type double-float alf oma))
                (dotimes (i (1+ k))
                  (%row-c-pt (curve-cpoints (svref cur-v i)) j c)
                  (%pt-row (c-pt-to-pt-euclid c pt) qa i))
                (unless u
                  (dotimes (i (1+ k))
                    (setf (aref ui i) (+ (* oma (aref ub i)) (* alf (aref ut i))))))
                (multiple-value-bind (cur kn)
                    (fit-crv-knots-and-tangents qa k ui nil nil +tangent+ knu per p)
                  (setf (svref cur-u j) cur
                        knu kn)))))
          ;; make the curves compatible
          (crvs-make-compatible cur-u mi)
          (let* ((ui* (curve-knots (svref cur-u 0)))
                 (ni (curve-n (svref cur-u 0)))
                 (sw (make-cpoint-net (1+ ni) (1+ mi)))
                 (us (make-real-vector (length ui*)))
                 (vs (make-real-vector (length vi*))))
            (declare (type real-vector ui* us vs) (type fixnum ni) (type cpoint-net sw))
            ;; the output surface
            (dotimes (j (1+ mi))
              (let ((cw (curve-cpoints (svref cur-u j))))
                (declare (type cpoint-array cw))
                (dotimes (i (1+ (curve-n (svref cur-u j))))
                  (%c-pt-net (%row-c-pt cw i c) sw i j))))
            (replace us ui*)
            (replace vs vi*)
            (%make-surface p q us vs sw)))))))

;;; ------------------------------------------------ bicubic interpolation

(defun fit-srf-interp-bicubic (pnet k l tan)
  "The C11 nonrational bicubic surface interpolating the points
PNET[0..K][0..L] (a point-net), with tangents by TAN (+bessel+ or +akima+):
FIT-PTS-NORMALS with no normals.  Returns a fresh surface.
NLib: N_FitSrfInterpBicubic."
  (declare (type point-net pnet) (type fixnum k l tan))
  (fit-pts-normals pnet nil k l tan))
