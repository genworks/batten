(in-package :batten)

;;; ------------------------------------------------------------ net helpers
;;;
;;; NLib's control nets are NL_CPOINT** and its routines hand single entries
;;; to N_CopyCPt and N_Combine2CPts.  A Batten net is one (* * 4) array, so
;;; these move an entry through a scratch cpoint and call the same routines.

(declaim (inline %net-cpt %net-copy %net-combine))

(defun %net-cpt (net i j cp)
  "Copy entry [I][J] of cpoint-net NET into cpoint CP (N_CopyCPt from a net)."
  (declare (type cpoint-net net) (type fixnum i j) (type cpoint cp))
  (fast (set-cpoint cp (aref net i j 0) (aref net i j 1) (aref net i j 2) (aref net i j 3))))

(defun %net-copy (src si sj dst di dj)
  "Copy entry SRC[SI][SJ] into DST[DI][DJ] (N_CopyCPt between nets)."
  (declare (type cpoint-net src dst) (type fixnum si sj di dj))
  (fast
    (let ((x (aref src si sj 0)) (y (aref src si sj 1))
          (z (aref src si sj 2)) (w (aref src si sj 3)))
      (setf (aref dst di dj 0) x (aref dst di dj 1) y
            (aref dst di dj 2) z (aref dst di dj 3) w))))

(defun %net-combine (alpha an ai aj beta bn bi bj cn ci cj)
  "CN[CI][CJ] = ALPHA*AN[AI][AJ] + BETA*BN[BI][BJ], by N_Combine2CPts."
  (declare (type double-float alpha beta) (type cpoint-net an bn cn)
           (type fixnum ai aj bi bj ci cj))
  (fast
    (let ((a (make-array 4 :element-type 'double-float))
          (b (make-array 4 :element-type 'double-float)))
      (declare (dynamic-extent a b))
      (%net-cpt an ai aj a)
      (%net-cpt bn bi bj b)
      (combine-2-c-pts alpha a beta b a)
      (setf (aref cn ci cj 0) (aref a 0) (aref cn ci cj 1) (aref a 1)
            (aref cn ci cj 2) (aref a 2) (aref cn ci cj 3) (aref a 3)))))

;;; -------------------------------------------------------- Bezier decomposition

(defun srf-decompose-to-bez (sur-p)
  "Decompose surface SUR-P into its Bezier patches without knot refinement.
Returns three values: a fresh (kk+1) by (ll+1) array of surfaces, element
[i][j] the (i, j)-th patch as a NURBS surface of degrees p, q with clamped
knot vectors of 2p+2 and 2q+2 knots; then kk and ll, the highest indexes.
NLib: N_SrfDecomposeToBez."
  (declare (type surface sur-p))
  (let* ((m (surface-m sur-p))
         (pw (surface-cpoints sur-p))
         (p (surface-degree-u sur-p)) (q (surface-degree-v sur-p))
         (up (surface-knots-u sur-p)) (vp (surface-knots-v sur-p))
         (r (1- (length up))) (s (1- (length vp)))
         (nsu (basis-get-span-count up p))
         (nsv (basis-get-span-count vp q))
         (sur-a (make-array (list nsu nsv)))
         (bw (make-cpoint-net (1+ p) (1+ m)))
         (nbw (make-cpoint-net (1+ p) (1+ m)))
         (uals (make-real-vector (1+ p))) (omus (make-real-vector (1+ p)))
         (vals (make-real-vector (1+ q))) (omvs (make-real-vector (1+ q)))
         (num 0d0)
         (nqw nil))
    (declare (type fixnum m p q r s nsu nsv) (type cpoint-net pw bw nbw)
             (type real-vector up vp uals omus vals omvs) (type double-float num)
             (type (or null cpoint-net) nqw))
    ;; the patches, as N_Alloc2dArraySrfPtrsParameters lays them out
    (dotimes (i nsu)
      (dotimes (j nsv)
        (setf (aref sur-a i j)
              (%make-surface p q (make-real-vector (+ (* 2 p) 2)) (make-real-vector (+ (* 2 q) 2))
                             (make-cpoint-net (1+ p) (1+ q))))))
    ;; initialize for u-directional decomposition
    (let ((isu p) (ieu (1+ p)) (iq -1) (mlu 0) (ru 0))
      (declare (type fixnum isu ieu iq mlu ru))
      (dotimes (i (1+ p))
        (dotimes (l (1+ m))
          (%net-copy pw i l bw i l)))
      ;; decompose in u-direction into Bezier strips
      (do () ((not (< ieu r)))
        (incf iq)
        ;; knot multiplicity
        (let ((i ieu))
          (declare (type fixnum i))
          (do () ((not (and (< ieu r) (= (aref up ieu) (aref up (1+ ieu))))))
            (incf ieu))
          (setf mlu (+ (- ieu i) 1)
                ru (- p mlu)))
        ;; insert the knot
        (when (< mlu p)
          (setf num (- (aref up ieu) (aref up isu)))
          (do ((i p (1- i))) ((not (> i mlu)))
            (declare (type fixnum i))
            (setf (aref uals (- i mlu 1)) (/ num (- (aref up (+ isu i)) (aref up isu))))
            (setf (aref omus (- i mlu 1)) (- 1d0 (aref uals (- i mlu 1)))))
          (do ((i 1 (1+ i))) ((> i ru))
            (declare (type fixnum i))
            (let ((su (+ mlu i)) (save (- ru i)))
              (declare (type fixnum su save))
              (do ((j p (1- j))) ((< j su))
                (declare (type fixnum j))
                (dotimes (l (1+ m))
                  (%net-combine (aref uals (- j su)) bw j l (aref omus (- j su)) bw (1- j) l bw j l)))
              (when (< ieu r)
                (dotimes (l (1+ m))
                  (%net-copy bw p l nbw save l))))))
        ;; Bezier strip completed; initialize for v-directional decomposition
        (let ((isv q) (iev (1+ q)) (jq -1) (mlv 0) (rv 0))
          (declare (type fixnum isv iev jq mlv rv))
          (let ((qw (surface-cpoints (aref sur-a iq 0))))
            (declare (type cpoint-net qw))
            (dotimes (j (1+ q))
              (dotimes (k (1+ p))
                (%net-copy bw k j qw k j))))
          ;; decompose in v-direction into Bezier patches
          (do () ((not (< iev s)))
            (incf jq)
            (let* ((patch (aref sur-a iq jq))
                   (qw (surface-cpoints patch))
                   (uq (surface-knots-u patch))
                   (vq (surface-knots-v patch)))
              (declare (type surface patch) (type cpoint-net qw) (type real-vector uq vq))
              (when (< jq (1- nsv))
                (setf nqw (surface-cpoints (aref sur-a iq (1+ jq)))))
              ;; knot multiplicity
              (let ((i iev))
                (declare (type fixnum i))
                (do () ((not (and (< iev s) (= (aref vp iev) (aref vp (1+ iev))))))
                  (incf iev))
                (setf mlv (+ (- iev i) 1)
                      rv (- q mlv)))
              ;; insert the knot
              (when (< mlv q)
                (setf num (- (aref vp iev) (aref vp isv)))
                (do ((i q (1- i))) ((not (> i mlv)))
                  (declare (type fixnum i))
                  (setf (aref vals (- i mlv 1)) (/ num (- (aref vp (+ isv i)) (aref vp isv))))
                  (setf (aref omvs (- i mlv 1)) (- 1d0 (aref vals (- i mlv 1)))))
                (do ((i 1 (1+ i))) ((> i rv))
                  (declare (type fixnum i))
                  (let ((sv (+ mlv i)) (save (- rv i)))
                    (declare (type fixnum sv save))
                    (do ((j q (1- j))) ((< j sv))
                      (declare (type fixnum j))
                      (dotimes (k (1+ p))
                        (%net-combine (aref vals (- j sv)) qw k j (aref omvs (- j sv)) qw k (1- j) qw k j)))
                    (when (< iev s)
                      (dotimes (k (1+ p))
                        (%net-copy qw k q nqw k save))))))
              ;; knot vectors
              (dotimes (i (1+ p))
                (setf (aref uq i) (aref up isu)
                      (aref uq (+ i p 1)) (aref up ieu)))
              (dotimes (j (1+ q))
                (setf (aref vq j) (aref vp isv)
                      (aref vq (+ j q 1)) (aref vp iev)))
              ;; patch completed: prepare for the next Bezier patch
              (when (< iev s)
                (do ((i rv (1+ i))) ((> i q))
                  (declare (type fixnum i))
                  (dotimes (k (1+ p))
                    (%net-copy bw k (+ (- iev q) i) nqw k i))))
              (setf isv iev
                    iev (1+ iev)))))
        ;; Bezier strip decomposed: prepare for the next strip
        (when (< ieu r)
          (do ((i ru (1+ i))) ((> i p))
            (declare (type fixnum i))
            (dotimes (l (1+ m))
              (%net-copy pw (+ (- ieu p) i) l nbw i l))))
        (setf isu ieu
              ieu (1+ ieu))
        (rotatef bw nbw)))
    (values sur-a (1- nsu) (1- nsv))))

;;; ----------------------------------------------------------------- splitting

(defun srf-split (sur dsplit dir)
  "Split surface SUR at the parameter DSPLIT, strictly inside its domain, in
direction DIR (+udir+ or +vdir+).  Returns (values sur-l sur-r), fresh: the
part over [U[0], DSPLIT] (or [V[0], DSPLIT]) and the part over [DSPLIT, U[r]]
(or [DSPLIT, V[s]]).  Signals :par-err when DSPLIT is on or outside an end of
the domain and :cal-err for a bad DIR.  Where DSPLIT is a knot of multiplicity
above the degree (a bad knot vector) the C returns without error and without
writing its outputs; this returns (values nil nil) there.
NLib: N_SrfSplit."
  (declare (type surface sur) (type double-float dsplit) (type fixnum dir))
  (let* ((n (surface-n sur)) (m (surface-m sur))
         (pw (surface-cpoints sur))
         (p (surface-degree-u sur)) (q (surface-degree-v sur))
         (u (surface-knots-u sur)) (v (surface-knots-v sur))
         (r (1- (length u))) (s (1- (length v)))
         (a (nl-max p q))
         (spu 0) (mlu 0) (spv 0) (mlv 0)
         (nl 0) (ml 0) (rl 0) (sl 0) (nr 0) (mr 0) (rr 0) (sr 0))
    (declare (type fixnum n m p q r s a spu mlu spv mlv nl ml rl sl nr mr rr sr)
             (type cpoint-net pw) (type real-vector u v))
    ;; check parameters and compute highest indexes
    (cond
      ((= dir +udir+)
       (knot-vector-is-end-param u dsplit 'srf-split)
       (multiple-value-setq (spu mlu) (basis-find-span-and-mult u p dsplit +left+))
       (when (> mlu p)
         ;; bad knot vector: NL_OUT with no error set
         (return-from srf-split (values nil nil)))
       (setf nl (- spu mlu)
             ml m
             rl (+ nl p 1)
             sl s
             nr (- (+ n p) spu)
             mr m
             rr (+ nr p 1)
             sr s))
      ((= dir +vdir+)
       (knot-vector-is-end-param v dsplit 'srf-split)
       (multiple-value-setq (spv mlv) (basis-find-span-and-mult v q dsplit +left+))
       (when (> mlv q)
         (return-from srf-split (values nil nil)))
       (setf nl n
             ml (- spv mlv)
             rl r
             sl (+ ml q 1)
             nr n
             mr (- (+ m q) spv)
             rr r
             sr (+ mr q 1)))
      (t (nurbs-error :cal-err 'srf-split)))
    (let* ((lw (make-cpoint-net (1+ nl) (1+ ml)))
           (ul (make-real-vector (1+ rl)))
           (vl (make-real-vector (1+ sl)))
           (rw (make-cpoint-net (1+ nr) (1+ mr)))
           (ur (make-real-vector (1+ rr)))
           (vr (make-real-vector (1+ sr)))
           (sw (make-cpoint-net 1 (1+ a)))
           (alf (make-real-matrix (1+ a) (1+ a)))
           (oma (make-real-matrix (1+ a) (1+ a))))
      (declare (type cpoint-net lw rw sw) (type real-vector ul vl ur vr)
               (type real-matrix alf oma))
      (when (= dir +udir+)
        ;; save the alphas
        (do ((i 1 (1+ i))) ((> i (- p mlu)))
          (declare (type fixnum i))
          (let ((a (+ (- spu p) i)))
            (declare (type fixnum a))
            (do ((j 0 (1+ j))) ((> j (- p i mlu)))
              (declare (type fixnum j))
              (setf (aref alf i j) (/ (- dsplit (aref u (+ a j))) (- (aref u (+ spu j 1)) (aref u (+ a j)))))
              (setf (aref oma i j) (- 1d0 (aref alf i j))))))
        ;; for each row
        (let ((a (- spu p)))
          (declare (type fixnum a))
          (do ((l 0 (1+ l))) ((> l m))
            (declare (type fixnum l))
            ;; load auxiliary control points
            (do ((i 0 (1+ i))) ((> i (- p mlu)))
              (declare (type fixnum i))
              (%net-copy pw (+ a i) l sw 0 i))
            ;; save unaltered control points
            (do ((i 0 (1+ i))) ((> i a))
              (declare (type fixnum i))
              (%net-copy pw i l lw i l))
            (do ((i (- spu mlu) (1+ i))) ((> i n))
              (declare (type fixnum i))
              (%net-copy pw i l rw (- i a) l))
            ;; now split the surface
            (do ((i 1 (1+ i))) ((> i (- p mlu)))
              (declare (type fixnum i))
              (let ((b (+ a i))
                    (c (- p mlu i)))
                (declare (type fixnum b c))
                (do ((j 0 (1+ j))) ((> j (- p i mlu)))
                  (declare (type fixnum j))
                  (%net-combine (aref alf i j) sw 0 (1+ j) (aref oma i j) sw 0 j sw 0 j))
                (%net-copy sw 0 0 lw b l)
                (%net-copy sw 0 c rw c l)))))
        ;; load knot vectors
        (let ((a (- spu mlu)))
          (declare (type fixnum a))
          (do ((i 0 (1+ i))) ((> i a))
            (declare (type fixnum i))
            (setf (aref ul i) (aref u i)))
          (do ((i 0 (1+ i))) ((> i p))
            (declare (type fixnum i))
            (setf (aref ul (+ a i 1)) dsplit)))
        (let ((a (1+ spu)))
          (declare (type fixnum a))
          (do ((i 0 (1+ i))) ((> i p))
            (declare (type fixnum i))
            (setf (aref ur i) dsplit))
          (do ((i a (1+ i))) ((> i r))
            (declare (type fixnum i))
            (setf (aref ur (+ (- i a) p 1)) (aref u i))))
        (do ((i 0 (1+ i))) ((> i s))
          (declare (type fixnum i))
          (setf (aref vl i) (aref v i)
                (aref vr i) (aref v i))))
      (when (= dir +vdir+)
        ;; save the alphas
        (do ((i 1 (1+ i))) ((> i (- q mlv)))
          (declare (type fixnum i))
          (let ((a (+ (- spv q) i)))
            (declare (type fixnum a))
            (do ((j 0 (1+ j))) ((> j (- q i mlv)))
              (declare (type fixnum j))
              (setf (aref alf i j) (/ (- dsplit (aref v (+ a j))) (- (aref v (+ spv j 1)) (aref v (+ a j)))))
              (setf (aref oma i j) (- 1d0 (aref alf i j))))))
        ;; for each column
        (let ((a (- spv q)))
          (declare (type fixnum a))
          (do ((k 0 (1+ k))) ((> k n))
            (declare (type fixnum k))
            ;; load auxiliary control points
            (do ((i 0 (1+ i))) ((> i (- q mlv)))
              (declare (type fixnum i))
              (%net-copy pw k (+ a i) sw 0 i))
            ;; save unaltered control points
            (do ((i 0 (1+ i))) ((> i a))
              (declare (type fixnum i))
              (%net-copy pw k i lw k i))
            (do ((i (- spv mlv) (1+ i))) ((> i m))
              (declare (type fixnum i))
              (%net-copy pw k i rw k (- i a)))
            ;; now split the surface
            (do ((i 1 (1+ i))) ((> i (- q mlv)))
              (declare (type fixnum i))
              (let ((b (+ a i))
                    (c (- q mlv i)))
                (declare (type fixnum b c))
                (do ((j 0 (1+ j))) ((> j (- q i mlv)))
                  (declare (type fixnum j))
                  (%net-combine (aref alf i j) sw 0 (1+ j) (aref oma i j) sw 0 j sw 0 j))
                (%net-copy sw 0 0 lw k b)
                (%net-copy sw 0 c rw k c)))))
        ;; load knot vectors
        (let ((a (- spv mlv)))
          (declare (type fixnum a))
          (do ((i 0 (1+ i))) ((> i a))
            (declare (type fixnum i))
            (setf (aref vl i) (aref v i)))
          (do ((i 0 (1+ i))) ((> i q))
            (declare (type fixnum i))
            (setf (aref vl (+ a i 1)) dsplit)))
        (let ((a (1+ spv)))
          (declare (type fixnum a))
          (do ((i 0 (1+ i))) ((> i q))
            (declare (type fixnum i))
            (setf (aref vr i) dsplit))
          (do ((i a (1+ i))) ((> i s))
            (declare (type fixnum i))
            (setf (aref vr (+ (- i a) q 1)) (aref v i))))
        (do ((i 0 (1+ i))) ((> i r))
          (declare (type fixnum i))
          (setf (aref ul i) (aref u i)
                (aref ur i) (aref u i))))
      (values (%make-surface p q ul vl lw)
              (%make-surface p q ur vr rw)))))

;;; ---------------------------------------------------------------- iso-curves

(defun srf-extract-iso-crv (sur tt dir)
  "The iso-curve of surface SUR at the parameter TT, as a fresh curve: for
DIR +udir+ the u-curve at v = TT, for +vdir+ the v-curve at u = TT.  Signals
:cal-err for a bad DIR and :quit (NL_QUIT, no NLib error code) where TT is a
knot of multiplicity above the degree.  NLib: N_SrfExtractIsoCrv."
  (declare (type surface sur) (type double-float tt) (type fixnum dir))
  (let* ((n (surface-n sur)) (m (surface-m sur))
         (pw (surface-cpoints sur))
         (p (surface-degree-u sur)) (q (surface-degree-v sur))
         (u (surface-knots-u sur)) (v (surface-knots-v sur))
         (r (1- (length u))) (s (1- (length v)))
         (a (nl-max p q))
         (spu 0) (mlu 0) (spv 0) (mlv 0)
         (ne 0) (pe 0) (me 0))
    (declare (type fixnum n m p q r s a spu mlu spv mlv ne pe me)
             (type cpoint-net pw) (type real-vector u v))
    ;; check parameters and compute highest indexes
    (cond
      ((= dir +udir+)
       (multiple-value-setq (spv mlv) (basis-find-span-and-mult v q tt +left+))
       (setf ne n pe p me r))
      ((= dir +vdir+)
       (multiple-value-setq (spu mlu) (basis-find-span-and-mult u p tt +left+))
       (setf ne m pe q me s))
      (t (nurbs-error :cal-err 'srf-extract-iso-crv)))
    (let ((cw (make-cpoint-array (1+ ne)))
          (uc (make-real-vector (1+ me))))
      (declare (type cpoint-array cw) (type real-vector uc))
      (flet ((net-to-row (i j k)
               (setf (aref cw k 0) (aref pw i j 0) (aref cw k 1) (aref pw i j 1)
                     (aref cw k 2) (aref pw i j 2) (aref cw k 3) (aref pw i j 3))))
        (declare (inline net-to-row))
        (cond
          ;; a boundary curve
          ((and (= dir +udir+) (or (= tt (aref v q)) (= tt (aref v (- s q)))))
           (if (= tt (aref v q))
               (dotimes (i (1+ n)) (net-to-row i 0 i))
               (dotimes (i (1+ n)) (net-to-row i m i)))
           (dotimes (i (1+ r))
             (setf (aref uc i) (aref u i))))
          ((and (= dir +vdir+) (or (= tt (aref u p)) (= tt (aref u (- r p)))))
           (if (= tt (aref u p))
               (dotimes (j (1+ m)) (net-to-row 0 j j))
               (dotimes (j (1+ m)) (net-to-row n j j)))
           (dotimes (j (1+ s))
             (setf (aref uc j) (aref v j))))
          (t
           (let ((rw (make-cpoint-array (1+ a)))
                 (alf (make-real-matrix (1+ a) (1+ a)))
                 (oma (make-real-matrix (1+ a) (1+ a))))
             (declare (type cpoint-array rw) (type real-matrix alf oma))
             ;; extract the u-curve
             (when (= dir +udir+)
               (when (> mlv q)
                 (nurbs-error :quit 'srf-extract-iso-crv))
               ;; save the v-alphas
               (do ((i 1 (1+ i))) ((> i (- q mlv)))
                 (declare (type fixnum i))
                 (let ((a (+ (- spv q) i)))
                   (declare (type fixnum a))
                   (do ((j 0 (1+ j))) ((> j (- q i mlv)))
                     (declare (type fixnum j))
                     (setf (aref alf i j) (/ (- tt (aref v (+ a j))) (- (aref v (+ spv j 1)) (aref v (+ a j)))))
                     (setf (aref oma i j) (- 1d0 (aref alf i j))))))
               ;; for each column compute a curve control point
               (let ((a (- spv q)))
                 (declare (type fixnum a))
                 (do ((k 0 (1+ k))) ((> k n))
                   (declare (type fixnum k))
                   (do ((i 0 (1+ i))) ((> i (- q mlv)))
                     (declare (type fixnum i))
                     (setf (aref rw i 0) (aref pw k (+ a i) 0) (aref rw i 1) (aref pw k (+ a i) 1)
                           (aref rw i 2) (aref pw k (+ a i) 2) (aref rw i 3) (aref pw k (+ a i) 3)))
                   (do ((i 1 (1+ i))) ((> i (- q mlv)))
                     (declare (type fixnum i))
                     (do ((j 0 (1+ j))) ((> j (- q i mlv)))
                       (declare (type fixnum j))
                       (%combine-2-c-pt-rows (aref alf i j) rw (1+ j) (aref oma i j) rw j rw j)))
                   (%copy-c-pt-row rw 0 cw k)))
               (dotimes (i (1+ r))
                 (setf (aref uc i) (aref u i))))
             ;; extract the v-curve
             (when (= dir +vdir+)
               (when (> mlu p)
                 (nurbs-error :quit 'srf-extract-iso-crv))
               ;; save the u-alphas
               (do ((i 1 (1+ i))) ((> i (- p mlu)))
                 (declare (type fixnum i))
                 (let ((a (+ (- spu p) i)))
                   (declare (type fixnum a))
                   (do ((j 0 (1+ j))) ((> j (- p i mlu)))
                     (declare (type fixnum j))
                     (setf (aref alf i j) (/ (- tt (aref u (+ a j))) (- (aref u (+ spu j 1)) (aref u (+ a j)))))
                     (setf (aref oma i j) (- 1d0 (aref alf i j))))))
               ;; for each row compute a curve control point
               (let ((a (- spu p)))
                 (declare (type fixnum a))
                 (do ((l 0 (1+ l))) ((> l m))
                   (declare (type fixnum l))
                   (do ((i 0 (1+ i))) ((> i (- p mlu)))
                     (declare (type fixnum i))
                     (setf (aref rw i 0) (aref pw (+ a i) l 0) (aref rw i 1) (aref pw (+ a i) l 1)
                           (aref rw i 2) (aref pw (+ a i) l 2) (aref rw i 3) (aref pw (+ a i) l 3)))
                   (do ((i 1 (1+ i))) ((> i (- p mlu)))
                     (declare (type fixnum i))
                     (do ((j 0 (1+ j))) ((> j (- p i mlu)))
                       (declare (type fixnum j))
                       (%combine-2-c-pt-rows (aref alf i j) rw (1+ j) (aref oma i j) rw j rw j)))
                   (%copy-c-pt-row rw 0 cw l)))
               (dotimes (j (1+ s))
                 (setf (aref uc j) (aref v j))))))))
      (%make-curve pe uc cw))))

;;; ------------------------------------------------------------ knot refinement

(defun srf-insert-knots (sur-p knx dir)
  "Refine surface SUR-P with the knots KNX (a real-vector, sorted, strictly
inside the domain) in direction DIR, +udir+ or +vdir+.  Returns the refined
surface, fresh.  Signals :inp-err for an empty KNX, :par-err when its first or
last knot is on or outside an end of the domain, :cal-err for a bad DIR.
NLib: N_SrfInsertKnots (the C's in-place case, surP = surQ, computes the
same surface)."
  (declare (type surface sur-p) (type real-vector knx) (type fixnum dir))
  (let* ((n (surface-n sur-p)) (m (surface-m sur-p))
         (pw (surface-cpoints sur-p))
         (p (surface-degree-u sur-p)) (q (surface-degree-v sur-p))
         (up (surface-knots-u sur-p)) (vp (surface-knots-v sur-p))
         (r (1- (length up))) (s (1- (length vp)))
         (x knx)
         (xr (1- (length knx)))
         (ni 0) (mi 0) (ri 0) (si 0))
    (declare (type fixnum n m p q r s xr ni mi ri si) (type cpoint-net pw)
             (type real-vector up vp x))
    ;; check parameters and compute highest indexes
    (when (< xr 0)
      (nurbs-error :inp-err 'srf-insert-knots))
    (cond ((= dir +udir+)
           (knot-vector-is-end-param up (aref x 0) 'srf-insert-knots)
           (knot-vector-is-end-param up (aref x xr) 'srf-insert-knots)
           (setf ni (+ n xr 1) mi m ri (+ r xr 1) si s))
          ((= dir +vdir+)
           (knot-vector-is-end-param vp (aref x 0) 'srf-insert-knots)
           (knot-vector-is-end-param vp (aref x xr) 'srf-insert-knots)
           (setf ni n mi (+ m xr 1) ri r si (+ s xr 1)))
          (t (nurbs-error :cal-err 'srf-insert-knots)))
    (let* ((uq (make-real-vector (1+ ri)))
           (vq (make-real-vector (1+ si)))
           (qw (make-cpoint-net (1+ ni) (1+ mi)))
           (sur-q (%make-surface p q uq vq qw)))
      (declare (type real-vector uq vq) (type cpoint-net qw))
      (cond
        ((= dir +udir+)
         ;; knot span indexes
         (let* ((a (basis-find-span up p (aref x 0) +left+))
                (b (1+ (basis-find-span up p (aref x xr) +left+)))
                (i 0) (k 0))
           (declare (type fixnum a b i k))
           ;; output knot vectors
           (do ((i 0 (1+ i))) ((> i a))
             (declare (type fixnum i))
             (setf (aref uq i) (aref up i)))
           (do ((i (+ b p) (1+ i))) ((> i r))
             (declare (type fixnum i))
             (setf (aref uq (+ i xr 1)) (aref up i)))
           (do ((j 0 (1+ j))) ((> j s))
             (declare (type fixnum j))
             (setf (aref vq j) (aref vp j)))
           ;; unaltered control points
           (do ((col 0 (1+ col))) ((> col m))
             (declare (type fixnum col))
             (do ((j 0 (1+ j))) ((> j (- a p)))
               (declare (type fixnum j))
               (%net-copy pw j col qw j col))
             (do ((j (1- b) (1+ j))) ((> j n))
               (declare (type fixnum j))
               (%net-copy pw j col qw (+ j xr 1) col)))
           ;; refine the knot vector
           (setf i (+ b p -1)
                 k (+ b p xr))
           (do ((j xr (1- j))) ((< j 0))
             (declare (type fixnum j))
             (do () ((not (and (<= (aref x j) (aref up i)) (> i a))))
               (do ((col 0 (1+ col))) ((> col m))
                 (declare (type fixnum col))
                 (%net-copy pw (- i p 1) col qw (- k p 1) col))
               (setf (aref uq k) (aref up i))
               (decf k)
               (decf i))
             (do ((col 0 (1+ col))) ((> col m))
               (declare (type fixnum col))
               (%net-copy qw (- k p) col qw (- k p 1) col))
             (do ((l 1 (1+ l))) ((> l p))
               (declare (type fixnum l))
               (let ((tt (+ (- k p) l))
                     (alf (- (aref uq (+ k l)) (aref x j))))
                 (declare (type fixnum tt) (type double-float alf))
                 (if (<= (abs alf) 0d0)
                     (do ((col 0 (1+ col))) ((> col m))
                       (declare (type fixnum col))
                       (%net-copy qw tt col qw (1- tt) col))
                     (let* ((alf (/ alf (- (aref uq (+ k l)) (aref up (+ (- i p) l)))))
                            (oma (- 1d0 alf)))
                       (declare (type double-float alf oma))
                       (do ((col 0 (1+ col))) ((> col m))
                         (declare (type fixnum col))
                         (%net-combine alf qw (1- tt) col oma qw tt col qw (1- tt) col))))))
             (setf (aref uq k) (aref x j))
             (decf k))))
        ((= dir +vdir+)
         ;; knot span indexes
         (let* ((a (basis-find-span vp q (aref x 0) +left+))
                (b (1+ (basis-find-span vp q (aref x xr) +left+)))
                (i 0) (k 0))
           (declare (type fixnum a b i k))
           ;; output knot vectors
           (do ((j 0 (1+ j))) ((> j a))
             (declare (type fixnum j))
             (setf (aref vq j) (aref vp j)))
           (do ((j (+ b q) (1+ j))) ((> j s))
             (declare (type fixnum j))
             (setf (aref vq (+ j xr 1)) (aref vp j)))
           (do ((i 0 (1+ i))) ((> i r))
             (declare (type fixnum i))
             (setf (aref uq i) (aref up i)))
           ;; unaltered control points
           (do ((row 0 (1+ row))) ((> row n))
             (declare (type fixnum row))
             (do ((j 0 (1+ j))) ((> j (- a q)))
               (declare (type fixnum j))
               (%net-copy pw row j qw row j))
             (do ((j (1- b) (1+ j))) ((> j m))
               (declare (type fixnum j))
               (%net-copy pw row j qw row (+ j xr 1))))
           ;; refine the knot vector
           (setf i (+ b q -1)
                 k (+ b q xr))
           (do ((j xr (1- j))) ((< j 0))
             (declare (type fixnum j))
             (do () ((not (and (<= (aref x j) (aref vp i)) (> i a))))
               (do ((row 0 (1+ row))) ((> row n))
                 (declare (type fixnum row))
                 (%net-copy pw row (- i q 1) qw row (- k q 1)))
               (setf (aref vq k) (aref vp i))
               (decf k)
               (decf i))
             (do ((row 0 (1+ row))) ((> row n))
               (declare (type fixnum row))
               (%net-copy qw row (- k q) qw row (- k q 1)))
             (do ((l 1 (1+ l))) ((> l q))
               (declare (type fixnum l))
               (let ((tt (+ (- k q) l))
                     (alf (- (aref vq (+ k l)) (aref x j))))
                 (declare (type fixnum tt) (type double-float alf))
                 (if (<= (abs alf) 0d0)
                     (do ((row 0 (1+ row))) ((> row n))
                       (declare (type fixnum row))
                       (%net-copy qw row tt qw row (1- tt)))
                     (let* ((alf (/ alf (- (aref vq (+ k l)) (aref vp (+ (- i q) l)))))
                            (oma (- 1d0 alf)))
                       (declare (type double-float alf oma))
                       (do ((row 0 (1+ row))) ((> row n))
                         (declare (type fixnum row))
                         (%net-combine alf qw row (1- tt) oma qw row tt qw row (1- tt)))))))
             (setf (aref vq k) (aref x j))
             (decf k)))))
      sur-q)))

;;; ------------------------------------------------------------- knot removal

(defun srf-remove-one-knot (sur r s f l dir mr)
  "The removal error bound MR updated for removing knot T[R] (multiplicity S,
T[R] /= T[R+1], interior) once from surface SUR in direction DIR (+udir+ or
+vdir+, T the U or V knots), over rows/columns F..L.  MR = +bigd+ starts the
bound afresh at -1.  Returns the updated bound.  Signals :quit (NL_QUIT, no
NLib error code) in the u-direction when S is so large that the C would index
before its scratch array, and :cal-err for a bad DIR.
NLib: N_SrfRemoveOneKnot."
  (declare (type surface sur) (type fixnum r s f l dir) (type double-float mr))
  (let* ((pw (surface-cpoints sur))
         (p (surface-degree-u sur)) (q (surface-degree-v sur))
         (u (surface-knots-u sur)) (v (surface-knots-v sur))
         (size (1+ (* 2 (nl-max p q))))
         (alf (make-real-vector size)) (oma (make-real-vector size))
         (bet (make-real-vector size)) (omb (make-real-vector size))
         (rw (make-array size))
         (a (make-cpoint))
         (tmp (make-cpoint))
         (dw 0d0) (del 0d0) (omd 0d0))
    (declare (type cpoint-net pw) (type fixnum p q size) (type real-vector u v alf oma bet omb)
             (type simple-vector rw) (type cpoint a tmp) (type double-float dw del omd))
    (dotimes (k size) (setf (svref rw k) (make-cpoint)))
    (when (= mr +bigd+)
      (setf mr -1d0))
    (cond
      ((= dir +udir+)
       (let* ((first (- r p)) (last (- r s)) (off (1- first))
              (i first) (j last))
         (declare (type fixnum first last off i j))
         ;; avoid a negative index [last + 1 - off]
         (when (> off (1+ last))
           (nurbs-error :quit 'srf-remove-one-knot))
         ;; save some parameters
         (do () ((not (> (- j i) 0)))
           (setf (aref alf (- i first)) (/ (- (aref u (+ i p 1)) (aref u i)) (- (aref u r) (aref u i))))
           (setf (aref oma (- i first)) (- 1d0 (aref alf (- i first))))
           (setf (aref bet (- j first)) (/ (- (aref u (+ j p 1)) (aref u j)) (- (aref u (+ j p 1)) (aref u r))))
           (setf (aref omb (- j first)) (- 1d0 (aref bet (- j first))))
           (incf i)
           (decf j))
         (setf del (/ (- (aref u r) (aref u i)) (- (aref u (+ i p 1)) (aref u i)))
               omd (- 1d0 del))
         ;; update the maximum error over the requested columns
         (do ((col f (1+ col))) ((> col l))
           (declare (type fixnum col))
           (let ((i first) (j last) (ii 1) (jj (- last off)))
             (declare (type fixnum i j ii jj))
             (%net-cpt pw off col (svref rw 0))
             (%net-cpt pw (1+ last) col (svref rw (- (1+ last) off)))
             ;; new control points for one removal step
             (do () ((not (> (- j i) 0)))
               (%net-cpt pw i col tmp)
               (combine-2-c-pts (aref alf (- i first)) tmp (aref oma (- i first)) (svref rw (1- ii))
                                (svref rw ii))
               (%net-cpt pw j col tmp)
               (combine-2-c-pts (aref bet (- j first)) tmp (aref omb (- j first)) (svref rw (1+ jj))
                                (svref rw jj))
               (incf i) (decf j) (incf ii) (decf jj))
             ;; the error
             (if (< (- j i) 0)
                 (setf dw (dist-cpt-cpt-homo (svref rw (1- ii)) (svref rw (1+ jj))))
                 (progn
                   (combine-2-c-pts del (svref rw (1+ jj)) omd (svref rw (1- ii)) a)
                   (%net-cpt pw i col tmp)
                   (setf dw (dist-cpt-cpt-homo tmp a))))
             (when (> dw mr)
               (setf mr dw))))))
      ((= dir +vdir+)
       (let* ((first (- r q)) (last (- r s)) (off (1- first))
              (i first) (j last))
         (declare (type fixnum first last off i j))
         ;; save some parameters
         (do () ((not (> (- j i) 0)))
           (setf (aref alf (- i first)) (/ (- (aref v (+ i q 1)) (aref v i)) (- (aref v r) (aref v i))))
           (setf (aref oma (- i first)) (- 1d0 (aref alf (- i first))))
           (setf (aref bet (- j first)) (/ (- (aref v (+ j q 1)) (aref v j)) (- (aref v (+ j q 1)) (aref v r))))
           (setf (aref omb (- j first)) (- 1d0 (aref bet (- j first))))
           (incf i)
           (decf j))
         (setf del (/ (- (aref v r) (aref v i)) (- (aref v (+ i q 1)) (aref v i)))
               omd (- 1d0 del))
         ;; update the maximum error over the requested rows
         (do ((row f (1+ row))) ((> row l))
           (declare (type fixnum row))
           (let ((i first) (j last) (ii 1) (jj (- last off)))
             (declare (type fixnum i j ii jj))
             (%net-cpt pw row off (svref rw 0))
             (%net-cpt pw row (1+ last) (svref rw (- (1+ last) off)))
             ;; new control points for one removal step
             (do () ((not (> (- j i) 0)))
               (%net-cpt pw row i tmp)
               (combine-2-c-pts (aref alf (- i first)) tmp (aref oma (- i first)) (svref rw (1- ii))
                                (svref rw ii))
               (%net-cpt pw row j tmp)
               (combine-2-c-pts (aref bet (- j first)) tmp (aref omb (- j first)) (svref rw (1+ jj))
                                (svref rw jj))
               (incf i) (decf j) (incf ii) (decf jj))
             ;; the error
             (if (< (- j i) 0)
                 (setf dw (dist-cpt-cpt-homo (svref rw (1- ii)) (svref rw (1+ jj))))
                 (progn
                   (combine-2-c-pts del (svref rw (1+ jj)) omd (svref rw (1- ii)) a)
                   (%net-cpt pw row i tmp)
                   (setf dw (dist-cpt-cpt-homo tmp a))))
             (when (> dw mr)
               (setf mr dw))))))
      (t (nurbs-error :cal-err 'srf-remove-one-knot)))
    mr))
