(in-package :batten)

;;; ------------------------------------------------ subsurface bounded by 4 curves

;;; The C's thread-local statics Gpnt, Gcur, Gsur, G_us, G_ue, G_vs, G_ve,
;;; which carry the distance function's data into N_FuncFindMinima;
;;; approx-sub-srf-with-srf binds them.
(defvar *srf-approx--gpnt* (make-point)
  "Gpnt: the point whose distance srf-approx--st-get-dist measures.")
(defvar *srf-approx--gcur* nil
  "Gcur: the 2D (u,v) curve srf-approx--st-get-dist maps onto the surface.")
(defvar *srf-approx--gsur* nil
  "Gsur: the surface srf-approx--st-get-dist evaluates.")
(defvar *srf-approx--g-us* 0d0 "G_us: the surface's lowest u.")
(defvar *srf-approx--g-ue* 0d0 "G_ue: the surface's highest u.")
(defvar *srf-approx--g-vs* 0d0 "G_vs: the surface's lowest v.")
(defvar *srf-approx--g-ve* 0d0 "G_ve: the surface's highest v.")

(defun srf-approx--st-get-dist (par)
  "The distance from *SRF-APPROX--GPNT* to the point of surface
*SRF-APPROX--GSUR* at the (u,v) of the curve *SRF-APPROX--GCUR* at PAR,
clamped to the surface's domain; -1 when an evaluation fails.
NLib: ST_GetDist."
  (declare (type double-float par))
  (let ((p (make-point)))
    (declare (type point p) (dynamic-extent p))
    (handler-case (crv-eval *srf-approx--gcur* par +left+ p)
      (nurbs-error () (return-from srf-approx--st-get-dist -1d0)))
    (multiple-value-bind (u v) (pt-to-xyz p)
      (declare (type double-float u v))
      (let ((gus *srf-approx--g-us*) (gue *srf-approx--g-ue*)
            (gvs *srf-approx--g-vs*) (gve *srf-approx--g-ve*))
        (declare (type double-float gus gue gvs gve))
        (when (< u gus) (setf u gus))
        (when (> u gue) (setf u gue))
        (when (< v gvs) (setf v gvs))
        (when (> v gve) (setf v gve)))
      (handler-case (srf-eval-pt *srf-approx--gsur* u v +left+ +left+ p)
        (nurbs-error () (return-from srf-approx--st-get-dist -1d0))))
    (dist-pt-pt p *srf-approx--gpnt*)))

(defun srf-approx--st-get-point (scur2 tcur2 sfn2 tfn2 s tt uvp corners us ue vs ve)
  "Write into the point UVP the (u,v) point, clamped to [US,UE] x [VS,VE],
of the Coons (Boolean sum) blend at (S, TT) of the four 2D boundary curves
SCUR2 (two, at t = 0 and 1) and TCUR2 (two, at s = 0 and 1), each evaluated
at its correspondence function (SFN2, TFN2) of S or TT, with the blend
parameters the averages of those function values and CORNERS (a 2 x 2 x 2
array) the corner (u,v) points.  Signals what the evaluations signal.
Returns UVP.
NLib: ST_GetPoint."
  (declare (type simple-vector scur2 tcur2 sfn2 tfn2) (type double-float s tt us ue vs ve)
           (type point uvp) (type (simple-array double-float (2 2 2)) corners))
  (let ((uv (make-array '(4 2) :element-type 'double-float :initial-element 0d0))
        (temp (make-array 2 :element-type 'double-float :initial-element 0d0))
        (pp (make-point))
        (s1 0d0) (t1 0d0) (s2 0d0) (t2 0d0) (ss 0d0) (tt* 0d0))
    (declare (type (simple-array double-float (4 2)) uv) (type (simple-array double-float (2)) temp)
             (type point pp) (type double-float s1 t1 s2 t2 ss tt*)
             (dynamic-extent uv temp pp))
    (flet ((load-uv (k cur par)
             (declare (type fixnum k) (type double-float par))
             (crv-eval cur par +left+ pp)
             (setf (aref uv k 0) (aref pp 0)
                   (aref uv k 1) (aref pp 1))))
      (setf s1 (c-func-eval (svref sfn2 0) s +left+))
      (load-uv 0 (svref scur2 0) s1)
      (setf s2 (c-func-eval (svref sfn2 1) s +left+))
      (load-uv 1 (svref scur2 1) s2)
      (setf t1 (c-func-eval (svref tfn2 0) tt +left+))
      (load-uv 2 (svref tcur2 0) t1)
      (setf t2 (c-func-eval (svref tfn2 1) tt +left+))
      (load-uv 3 (svref tcur2 1) t2))
    (setf ss (* 0.5d0 (+ s1 s2))
          tt* (* 0.5d0 (+ t1 t2)))
    (setf s1 (- 1d0 ss)
          t1 (- 1d0 tt*))
    ;; Boolean sum
    (dotimes (ij 2)
      (setf (aref temp ij)
            (- (- (- (- (+ (+ (+ (* s1 (aref uv 2 ij)) (* ss (aref uv 3 ij)))
                              (* t1 (aref uv 0 ij)))
                           (* tt* (aref uv 1 ij)))
                        (* (* s1 t1) (aref corners 0 0 ij)))
                     (* (* ss t1) (aref corners 1 0 ij)))
                  (* (* s1 tt*) (aref corners 0 1 ij)))
               (* (* ss tt*) (aref corners 1 1 ij)))))
    (when (< (aref temp 0) us) (setf (aref temp 0) us))
    (when (> (aref temp 0) ue) (setf (aref temp 0) ue))
    (when (< (aref temp 1) vs) (setf (aref temp 1) vs))
    (when (> (aref temp 1) ve) (setf (aref temp 1) ve))
    (pt-from-xyz (aref temp 0) (aref temp 1) 0d0 uvp)))

(defun %srf-approx-sample-count (c0 c1 deg)
  "The number of samples N_ApproxSubSrfWithSrf takes along a pair of
boundary curves C0, C1 of (largest) degree DEG."
  (declare (type curve c0 c1) (type fixnum deg))
  (let* ((kk (nl-max (curve-n c0) (curve-n c1)))
         (ii (cond ((< kk 10) 8) ((< kk 20) 17) (t 28))))
    (declare (type fixnum kk ii))
    (nl-max (+ deg 4) ii)))

(defun approx-sub-srf-with-srf (cur-s-3d cur-t-3d cur-s-2d cur-t-2d sur ufn vgn)
  "Approximate the subsurface of surface SUR bounded by four curves lying on
it: CUR-S-3D (a sequence of two 3D curves, at t = 0 and t = 1), CUR-T-3D (two,
at s = 0 and s = 1), and CUR-S-2D, CUR-T-2D their (u,v) curves in SUR's
domain; none need be compatible, and all are taken as non-rational (copies are
reparametrized onto [0,1]).  The result is a surface on 0 <= s,t <= 1 whose
boundaries are the 3D curves.  UFN and VGN, both true or both false (:inp-err
otherwise), ask for the functions u = f(s,t) and v = g(s,t) as well.
Signals :num-err when a boundary correspondence has no bracketed minimum, and
what the evaluations, closest point searches and fits signal.  Returns
(values subsur ufn vgn), the functions NIL when not asked for.
NLib: N_ApproxSubSrfWithSrf."
  (declare (type sequence cur-s-3d cur-t-3d cur-s-2d cur-t-2d) (type surface sur))
  (when (or (and (null ufn) vgn) (and (null vgn) ufn))
    (nurbs-error :inp-err 'approx-sub-srf-with-srf))
  (multiple-value-bind (us ue vs ve) (srf-get-parameter-bounds sur)
    (declare (type double-float us ue vs ve))
    (let ((*srf-approx--g-us* us) (*srf-approx--g-ue* ue)
          (*srf-approx--g-vs* vs) (*srf-approx--g-ve* ve)
          (*srf-approx--gpnt* (make-point))
          (*srf-approx--gcur* nil)
          (*srf-approx--gsur* nil)
          (scur2 (make-array 2)) (scur3 (make-array 2))
          (tcur2 (make-array 2)) (tcur3 (make-array 2))
          (sfn2 (make-array 2 :initial-element nil))
          (tfn2 (make-array 2 :initial-element nil))
          (corners (make-array '(2 2 2) :element-type 'double-float :initial-element 0d0))
          (uvpnt (make-point)) (q* (make-point)) (r* (make-point)) (pt (make-point))
          (d1 0d0) (d2 0d0) (d3 0d0) (d4 0d0)
          (u 0d0) (v 0d0)
          (p 0) (q 0) (kk 0) (usam 0) (vsam 0)
          (mtol *mtol*))
      (declare (type simple-vector scur2 scur3 tcur2 tcur3 sfn2 tfn2)
               (type (simple-array double-float (2 2 2)) corners)
               (type point uvpnt q* r* pt)
               (type double-float d1 d2 d3 d4 u v mtol) (type fixnum p q kk usam vsam))
      ;; copies of all input curves, all on [0,1], all weights +no-w+
      (flet ((prepare (src)
               (let ((c (crv-copy src)))
                 (multiple-value-bind (a b) (crv-get-param-bounds c)
                   (declare (type double-float a b))
                   (setf d1 a d2 b)
                   (when (or (/= a 0d0) (/= b 1d0))
                     (crv-reparam c 0d0 1d0)))
                 (crv-rat-to-non-rat c))))
        (dotimes (ii 2)
          (setf (svref scur2 ii) (prepare (elt cur-s-2d ii)))
          (setf (svref scur3 ii) (prepare (elt cur-s-3d ii)))
          (setf (svref tcur2 ii) (prepare (elt cur-t-2d ii)))
          (setf (svref tcur3 ii) (prepare (elt cur-t-3d ii)))))
      ;; the s,t -> u,v correspondence on the boundaries, loading boundary
      ;; fit points on the way
      (setf *srf-approx--gsur* sur)
      (setf p (nl-max (curve-degree (svref scur3 0)) (curve-degree (svref scur3 1))))
      (when (< p 2)
        (setf (svref scur3 0) (crv-elevate-degree (svref scur3 0) 1))
        (setf p 2))
      (setf q (nl-max (curve-degree (svref tcur3 0)) (curve-degree (svref tcur3 1))))
      (when (< q 2)
        (setf (svref tcur3 0) (crv-elevate-degree (svref tcur3 0) 1))
        (setf q 2))
      (setf usam (%srf-approx-sample-count (svref scur3 0) (svref scur3 1) p))
      (setf vsam (%srf-approx-sample-count (svref tcur3 0) (svref tcur3 1) q))
      (let ((pnts (make-point-net (1+ usam) (1+ vsam)))
            (f1 (make-real-vector (1+ (nl-max usam vsam))))
            (s (make-real-vector (1+ usam)))
            (tv (make-real-vector (1+ vsam))))
        (declare (type point-net pnts) (type real-vector f1 s tv))
        (flet ((correspondence (sam par c3 c2 fns along-s)
                 ;; the boundary correspondence functions of one direction:
                 ;; SAM samples at parameters PAR along the 3D curves C3, the
                 ;; functions into FNS; ALONG-S for the s curves (rows of
                 ;; PNTS at t = 0 and 1), else the t curves (columns)
                 (declare (type fixnum sam) (type real-vector par)
                          (type simple-vector c3 c2 fns))
                 (flet ((net-index (a b)
                          ;; the PNTS entry of sample A on boundary B (0 or 1)
                          (declare (type fixnum a b))
                          (if along-s
                              (values a (* b vsam))
                              (values (* b usam) a))))
                   (dotimes (ii 2)
                     (if (= ii 0)
                         (progn
                           (setf d1 0d0 d2 0d0)
                           (do ((jj 0 (1+ jj))) ((> jj sam))
                             (declare (type fixnum jj))
                             (multiple-value-bind (i j) (net-index jj 0)
                               (%pt-net (crv-eval (svref c3 0) (aref par jj) +left+ pt) pnts i j)
                               (when (> jj 0)
                                 (multiple-value-bind (i0 j0) (net-index (1- jj) 0)
                                   (setf d3 (dist-pt-pt (%net-pt pnts i j pt) (%net-pt pnts i0 j0 q*)))))
                               ;; the s curves add the distance inside the
                               ;; test, the t curves after it (a stale d3 at
                               ;; jj = 0)
                               (when (or (not along-s) (> jj 0))
                                 (setf d1 (+ d1 d3))))
                             (multiple-value-bind (i j) (net-index jj 1)
                               (%pt-net (crv-eval (svref c3 1) (aref par jj) +left+ pt) pnts i j)
                               (when (> jj 0)
                                 (multiple-value-bind (i0 j0) (net-index (1- jj) 1)
                                   (setf d3 (dist-pt-pt (%net-pt pnts i j pt) (%net-pt pnts i0 j0 q*)))))
                               (when (or (not along-s) (> jj 0))
                                 (setf d2 (+ d2 d3)))))
                           (setf kk (if (> d1 d2) 0 1)))
                         (setf kk (mod (1+ kk) 2)))
                     (setf *srf-approx--gcur* (svref c2 kk))
                     (do ((jj 1 (1+ jj))) ((>= jj sam))
                       (declare (type fixnum jj))
                       (multiple-value-bind (i j) (net-index jj kk)
                         (%net-pt pnts i j *srf-approx--gpnt*))
                       (let* ((xb (aref par jj))
                              (fb (srf-approx--st-get-dist xb))
                              (xa xb)
                              (xc xb))
                         (declare (type double-float xb fb xa xc))
                         (do () (nil)
                           (setf xa (- xa 0.02d0))
                           (when (< xa 0d0) (setf xa 0d0))
                           (setf d3 (srf-approx--st-get-dist xa))
                           (unless (and (> xa 0d0) (<= d3 fb)) (return)))
                         (when (<= d3 fb)
                           (nurbs-error :num-err 'approx-sub-srf-with-srf))
                         (do () (nil)
                           (setf xc (+ xc 0.02d0))
                           (when (> xc 1d0) (setf xc 1d0))
                           (setf d3 (srf-approx--st-get-dist xc))
                           (unless (and (< xc 1d0) (<= d3 fb)) (return)))
                         (when (<= d3 fb)
                           (nurbs-error :num-err 'approx-sub-srf-with-srf))
                         (multiple-value-bind (xmin fmin)
                             (func-find-minima xa xb xc fb #'srf-approx--st-get-dist 6d-8 mtol)
                           (declare (type double-float xmin fmin))
                           (setf (aref f1 jj) xmin
                                 d3 fmin))))
                     (setf (svref fns kk) (fit-func-interp-given-params f1 sam 2 par))
                     ;; handle 0-length curves
                     (when (<= (nl-min d1 d2) mtol)
                       (setf (svref fns (mod (1+ kk) 2)) (crv-func-copy (svref fns kk)))
                       (return))))))
          ;; the s direction
          (let ((ds (/ 1d0 (float usam 1d0))))
            (declare (type double-float ds))
            (setf (aref s 0) 0d0 (aref f1 0) 0d0
                  (aref s usam) 1d0 (aref f1 usam) 1d0)
            (do ((ii 1 (1+ ii))) ((>= ii usam))
              (declare (type fixnum ii))
              (setf (aref s ii) (* (float ii 1d0) ds))))
          (correspondence usam s scur3 scur2 sfn2 t)
          ;; the t direction
          (let ((dt (/ 1d0 (float vsam 1d0))))
            (declare (type double-float dt))
            (setf (aref tv 0) 0d0 (aref f1 0) 0d0
                  (aref tv vsam) 1d0 (aref f1 vsam) 1d0)
            (do ((ii 1 (1+ ii))) ((>= ii vsam))
              (declare (type fixnum ii))
              (setf (aref tv ii) (* (float ii 1d0) dt))))
          (correspondence vsam tv tcur3 tcur2 tfn2 nil))
        ;; the corner u,v points for the local function
        (flet ((corner (i j sc spar tc tpar)
                 (declare (type fixnum i j) (type double-float spar tpar))
                 (crv-eval sc spar +left+ uvpnt)
                 (multiple-value-bind (x y z) (pt-to-xyz uvpnt)
                   (setf (aref corners i j 0) x
                         (aref corners i j 1) y
                         d1 z))
                 (crv-eval tc tpar +left+ uvpnt)
                 (multiple-value-bind (x y z) (pt-to-xyz uvpnt)
                   (setf u x v y d1 z))
                 (setf (aref corners i j 0) (* 0.5d0 (+ u (aref corners i j 0)))
                       (aref corners i j 1) (* 0.5d0 (+ v (aref corners i j 1))))))
          (corner 0 0 (svref scur2 0) 0d0 (svref tcur2 0) 0d0)
          (corner 1 0 (svref scur2 0) 1d0 (svref tcur2 1) 0d0)
          (corner 0 1 (svref scur2 1) 0d0 (svref tcur2 0) 1d0)
          (corner 1 1 (svref scur2 1) 1d0 (svref tcur2 1) 1d0))
        (dotimes (ii 2)
          (dotimes (jj 2)
            (when (< (aref corners ii jj 0) us) (setf (aref corners ii jj 0) us))
            (when (> (aref corners ii jj 0) ue) (setf (aref corners ii jj 0) ue))
            (when (< (aref corners ii jj 1) vs) (setf (aref corners ii jj 1) vs))
            (when (> (aref corners ii jj 1) ve) (setf (aref corners ii jj 1) ve))))
        ;; the remaining interior fit points
        (do ((ii 1 (1+ ii))) ((>= ii usam))
          (declare (type fixnum ii))
          (do ((jj 1 (1+ jj))) ((>= jj vsam))
            (declare (type fixnum jj))
            (srf-approx--st-get-point scur2 tcur2 sfn2 tfn2 (aref s ii) (aref tv jj) uvpnt
                                      corners us ue vs ve)
            (multiple-value-bind (x y z) (pt-to-xyz uvpnt)
              (setf u x v y d1 z))
            (%pt-net (srf-eval-pt sur u v +left+ +left+ pt) pnts ii jj)))
        ;; make the 3D boundaries compatible, then the initial surface fit
        (let* ((nn (nl-min (nl-max (curve-n (svref scur3 0)) (curve-n (svref scur3 1))) (- usam 2)))
               (mm 0))
          (declare (type fixnum nn mm))
          (crvs-make-compatible scur3 1)
          (setf mm (nl-min (nl-max (curve-n (svref tcur3 0)) (curve-n (svref tcur3 1))) (- vsam 2)))
          (crvs-make-compatible tcur3 1)
          (let* ((sur1 (fit-srf-to-pts-and-boundary pnts usam vsam s tv scur3 tcur3 1 nn mm))
                 ;; fit points for the final surface and fit values for the
                 ;; parameter correspondence functions, from the initial one
                 (ns (curve-n (svref scur3 0)))
                 (nt (curve-n (svref tcur3 0)))
                 (kk (nl-max (curve-m (svref scur3 0)) (curve-m (svref tcur3 0))))
                 (st (make-real-vector (1+ kk)))
                 (ms (* 2 ns))
                 (mt (* 2 nt))
                 (s (make-real-vector (1+ ms)))
                 (tv (make-real-vector (1+ mt))))
            (declare (type surface sur1) (type fixnum ns nt kk ms mt) (type real-vector st s tv))
            (basis-find-index-node-array (curve-knots (svref scur3 0)) p st)
            (setf (aref s 0) 0d0)
            (let ((k 0))
              (declare (type fixnum k))
              (do ((ii 1 (1+ ii))) ((> ii ns))
                (declare (type fixnum ii))
                (setf (aref s (incf k)) (* 0.5d0 (+ (aref st (1- ii)) (aref st ii))))
                (setf (aref s (incf k)) (aref st ii))))
            (basis-find-index-node-array (curve-knots (svref tcur3 0)) q st)
            (setf (aref tv 0) 0d0)
            (let ((k 0))
              (declare (type fixnum k))
              (do ((ii 1 (1+ ii))) ((> ii nt))
                (declare (type fixnum ii))
                (setf (aref tv (incf k)) (* 0.5d0 (+ (aref st (1- ii)) (aref st ii))))
                (setf (aref tv (incf k)) (aref st ii))))
            ;; loop and compute points at (s,t) locations
            (let ((pnts (make-point-net (1+ ms) (1+ mt)))
                  (fu (make-real-matrix (1+ ms) (1+ mt)))
                  (fv (make-real-matrix (1+ ms) (1+ mt)))
                  (sd (make-point-net 3 3))
                  (top mtol)
                  (toc 1d-5)
                  (uvtop 0d0))
              (declare (type point-net pnts sd) (type real-matrix fu fv)
                       (type double-float top toc uvtop))
              (setf (aref fu 0 0) (aref corners 0 0 0)
                    (aref fv 0 0) (aref corners 0 0 1)
                    (aref fu 0 mt) (aref corners 0 1 0)
                    (aref fv 0 mt) (aref corners 0 1 1)
                    (aref fu ms 0) (aref corners 1 0 0)
                    (aref fv ms 0) (aref corners 1 0 1)
                    (aref fu ms mt) (aref corners 1 1 0)
                    (aref fv ms mt) (aref corners 1 1 1))
              (%pt-net (crv-eval (svref scur3 0) 0d0 +left+ pt) pnts 0 0)
              (%pt-net (crv-eval (svref scur3 0) 1d0 +left+ pt) pnts ms 0)
              (%pt-net (crv-eval (svref tcur3 0) 1d0 +left+ pt) pnts 0 mt)
              (%pt-net (crv-eval (svref tcur3 1) 1d0 +left+ pt) pnts ms mt)
              (multiple-value-bind (a b c d) (srf-get-parameter-bounds sur)
                (declare (type double-float a b c d))
                (setf d1 a d2 b d3 c d4 d))
              (setf d1 (sqrt (the (double-float 0d0)
                                  (+ (* (- d2 d1) (- d2 d1)) (* (- d4 d3) (- d4 d3))))))
              (setf uvtop (* d1 1d-7))
              (do ((ii 0 (1+ ii))) ((> ii ms))
                (declare (type fixnum ii))
                (do ((jj 0 (1+ jj))) ((> jj mt))
                  (declare (type fixnum jj))
                  (unless (or (and (= ii 0) (= jj 0)) (and (= ii ms) (= jj 0))
                              (and (= ii 0) (= jj mt)) (and (= ii ms) (= jj mt)))
                    (srf-eval-pt sur1 (aref s ii) (aref tv jj) +left+ +left+ q*)
                    (srf-approx--st-get-point scur2 tcur2 sfn2 tfn2 (aref s ii) (aref tv jj) uvpnt
                                              corners us ue vs ve)
                    (multiple-value-bind (x y z) (pt-to-xyz uvpnt)
                      (setf u x v y d1 z))
                    (multiple-value-bind (uu vv) (get-closest-pt-on-srf sur q* u v top toc r* sd)
                      (declare (type double-float uu vv))
                      (setf u uu v vv))
                    (if (and (> ii 0) (< ii ms) (> jj 0) (< jj mt))
                        (copy-pt r* q*)
                        (flet ((onto (fn par cur)
                                 ;; d1 = fn(par); uvpnt = closest point on
                                 ;; cur to uvpnt from d1
                                 (declare (type double-float par))
                                 (setf d1 (c-func-eval fn par +left+))
                                 (copy-pt uvpnt pt)
                                 (setf d1 (crv-closest-pt cur pt d1 uvtop toc uvpnt))))
                          (pt-from-xyz u v 0d0 uvpnt)
                          (when (= ii 0)
                            (onto (svref tfn2 0) (aref tv jj) (svref tcur2 0)))
                          (when (= ii ms)
                            (onto (svref tfn2 1) (aref tv jj) (svref tcur2 1)))
                          (when (= jj 0)
                            (onto (svref sfn2 0) (aref s ii) (svref scur2 0)))
                          (when (= jj mt)
                            (onto (svref sfn2 1) (aref s ii) (svref scur2 1)))
                          (multiple-value-bind (x y z) (pt-to-xyz uvpnt)
                            (setf u x v y d1 z))))
                    (when (< u us) (setf u us))
                    (when (> u ue) (setf u ue))
                    (when (< v vs) (setf v vs))
                    (when (> v ve) (setf v ve))
                    (setf (aref fu ii jj) u
                          (aref fv ii jj) v)
                    (%pt-net q* pnts ii jj))))
              ;; now do the fits
              (let ((subsur (fit-srf-to-pts-and-boundary pnts ms mt s tv scur3 tcur3 2 0 0))
                    (uf nil)
                    (vg nil))
                (when (and ufn vgn)
                  (when (> ms 70)
                    ;; don't need this many; ms is even
                    (let ((k 0))
                      (declare (type fixnum k))
                      (do ((ii 2 (+ ii 2))) ((> ii ms))
                        (declare (type fixnum ii))
                        (setf (aref s (incf k)) (aref s ii))
                        (do ((jj 0 (1+ jj))) ((> jj mt))
                          (declare (type fixnum jj))
                          (setf (aref fu k jj) (aref fu ii jj))))
                      (setf ms k)))
                  (when (> mt 70)
                    ;; don't need this many; mt is even
                    (let ((k 0))
                      (declare (type fixnum k))
                      (do ((ii 2 (+ ii 2))) ((> ii mt))
                        (declare (type fixnum ii))
                        (setf (aref tv (incf k)) (aref tv ii))
                        (do ((jj 0 (1+ jj))) ((> jj ms))
                          (declare (type fixnum jj))
                          (setf (aref fv jj k) (aref fv jj ii))))
                      (setf mt k)))
                  (setf uf (fit-srf-func-interp fu ms mt 2 2 s tv))
                  (setf vg (fit-srf-func-interp fv ms mt 2 2 s tv)))
                (values subsur uf vg)))))))))
