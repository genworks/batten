(in-package :batten)

;;; ------------------------------------------------- row helpers (not NLib)

;;; N_CopyCPt and N_Combine2CPts on elements of NL_CPOINT arrays, done on rows
;;; of cpoint-arrays with the same arithmetic, every input coordinate read
;;; before any output is written, as C's by-value arguments are.


;;; ------------------------------------------------------- knot insertion

(defun crv-insert-knot (cur-p u r)
  "Curve CUR-P with the knot U, strictly inside the domain, inserted R times,
as a fresh curve.  Signals :par-err when U is on or outside an end of the
domain, when R is negative, or when U's multiplicity plus R exceeds the
degree.  NLib: N_CrvInsertKnot (the C's in-place case, curP = curQ, computes
the same curve)."
  (declare (type curve cur-p) (type double-float u) (type fixnum r))
  (let* ((n (curve-n cur-p))
         (pw (curve-cpoints cur-p))
         (p (curve-degree cur-p))
         (m (curve-m cur-p))
         (up (curve-knots cur-p)))
    (declare (type fixnum n p m) (type cpoint-array pw) (type real-vector up))
    ;; check parameter and get knot span
    (knot-vector-is-end-param up u 'crv-insert-knot)
    (multiple-value-bind (spn mlt) (basis-find-span-and-mult up p u +left+)
      (declare (type fixnum spn mlt))
      (when (or (> (+ mlt r) p) (< r 0))
        (nurbs-error :par-err 'crv-insert-knot))
      (let ((k (- spn p))
            (qw (make-cpoint-array (+ n r 1)))
            (uq (make-real-vector (+ m r 1)))
            (rw (make-cpoint-array (1+ p))))
        (declare (type fixnum k) (type cpoint-array qw rw) (type real-vector uq))
        (fast
          ;; auxiliary control points
          (do ((i 0 (1+ i))) ((> i (- p mlt)))
            (declare (type fixnum i))
            (%copy-c-pt-row pw (+ k i) rw i))
          ;; unaltered control points
          (do ((i 0 (1+ i))) ((> i k))
            (declare (type fixnum i))
            (%copy-c-pt-row pw i qw i))
          (do ((i (- spn mlt) (1+ i))) ((> i n))
            (declare (type fixnum i))
            (%copy-c-pt-row pw i qw (+ i r)))
          ;; now insert the knot
          (do ((i 1 (1+ i))) ((> i r))
            (declare (type fixnum i))
            (setf k (+ (- spn p) i))
            (do ((j 0 (1+ j))) ((> j (- p i mlt)))
              (declare (type fixnum j))
              (let* ((alf (/ (- u (aref up (+ k j))) (- (aref up (+ spn j 1)) (aref up (+ k j)))))
                     (oma (- 1d0 alf)))
                (declare (type double-float alf oma))
                (%combine-2-c-pt-rows alf rw (1+ j) oma rw j rw j)))
            (%copy-c-pt-row rw 0 qw k)
            (%copy-c-pt-row rw (- p i mlt) qw (- (+ spn r) i mlt)))
          ;; load the remaining control points
          (do ((i (1+ k) (1+ i))) ((>= i (- spn mlt)))
            (declare (type fixnum i))
            (%copy-c-pt-row rw (- i k) qw i))
          ;; load the knot vector
          (do ((i 0 (1+ i))) ((> i spn))
            (declare (type fixnum i))
            (setf (aref uq i) (aref up i)))
          (do ((i 1 (1+ i))) ((> i r))
            (declare (type fixnum i))
            (setf (aref uq (+ i spn)) u))
          (do ((i (1+ spn) (1+ i))) ((> i m))
            (declare (type fixnum i))
            (setf (aref uq (+ i r)) (aref up i))))
        (%make-curve p uq qw)))))

;;; ------------------------------------------------------- decomposition

(defun %next-bez-cpoints (nqw)
  "NQW, the next Bezier segment's control points, checked: where the C would
write through its still-NULL pointer (an unclamped single-span curve) and
crash, signal instead."
  (if (typep nqw 'cpoint-array)
      nqw
      (nurbs-error :cal-err 'crv-decompose-bez)))

(defun crv-decompose-bez (cur)
  "The Bezier segments of curve CUR, extracted without knot refinement: one
degree-p curve with knots (a ... a b ... b) per non-zero span.  Returns
(values curves k): CURVES a simple-vector of the k+1 fresh segments.
NLib: N_CrvDecomposeBez."
  (declare (type curve cur))
  (let* ((p (curve-degree cur))
         (pw (curve-cpoints cur))
         (up (curve-knots cur))
         (m (curve-m cur))
         (nsp (basis-get-span-count up p))
         (cura (make-array nsp)))
    (declare (type fixnum p m nsp) (type cpoint-array pw) (type real-vector up)
             (type simple-vector cura))
    (dotimes (i nsp)
      (setf (svref cura i) (%make-curve p (make-real-vector (+ p p 2)) (make-cpoint-array (1+ p)))))
    (fast
      (let ((alfs (make-array (1+ p) :element-type 'double-float :initial-element 0d0))
            (omas (make-array (1+ p) :element-type 'double-float :initial-element 0d0))
            (is p)
            (ie (1+ p))
            (iq -1)
            (nqw nil))
        (declare (dynamic-extent alfs omas) (type fixnum is ie iq))
        ;; skip over first knot over-multiplicity (bad data correction)
        (do () ((not (and (< ie m) (= (aref up (1- ie)) (aref up ie)))))
          (incf is)
          (incf ie))
        (let ((qw (curve-cpoints (svref cura 0))))
          (declare (type cpoint-array qw))
          (dotimes (i (1+ p))
            (%copy-c-pt-row pw (- (+ i is) p) qw i)))
        (do () ((not (< ie m)))
          (incf iq)
          (when (>= iq nsp)
            ;; NL_QUIT: the C fails without setting an error code
            (nurbs-error :quit 'crv-decompose-bez))
          (let ((qw (curve-cpoints (svref cura iq)))
                (uq (curve-knots (svref cura iq))))
            (declare (type cpoint-array qw) (type real-vector uq))
            (when (< iq (1- nsp))
              (setf nqw (curve-cpoints (svref cura (1+ iq)))))
            (let ((i ie))
              (declare (type fixnum i))
              (do () ((not (and (< ie m) (= (aref up ie) (aref up (1+ ie))))))
                (incf ie))
              (let* ((mlt (+ (- ie i) 1))
                     (r (- p mlt)))
                (declare (type fixnum mlt r))
                ;; insert the knot on the rhs only
                (when (< mlt p)
                  (let ((num (- (aref up ie) (aref up is))))
                    (declare (type double-float num))
                    (do ((i p (1- i))) ((<= i mlt))
                      (declare (type fixnum i))
                      (setf (aref alfs (- i mlt 1)) (/ num (- (aref up (+ is i)) (aref up is))))
                      (setf (aref omas (- i mlt 1)) (- 1d0 (aref alfs (- i mlt 1))))))
                  (do ((i 1 (1+ i))) ((> i r))
                    (declare (type fixnum i))
                    (let ((s (+ mlt i))
                          (save (- r i)))
                      (declare (type fixnum s save))
                      (do ((j p (1- j))) ((< j s))
                        (declare (type fixnum j))
                        (%combine-2-c-pt-rows (aref alfs (- j s)) qw j
                                              (aref omas (- j s)) qw (1- j)
                                              qw j))
                      (when (< ie m)
                        (%copy-c-pt-row qw p (%next-bez-cpoints nqw) save)))))
                ;; the Bezier segment's knot vector
                (dotimes (i (1+ p))
                  (setf (aref uq i) (aref up is)
                        (aref uq (+ i p 1)) (aref up ie)))
                ;; the next segment's remaining control points
                (when (< ie m)
                  (when (< r 0) (setf r 0))
                  (do ((i r (1+ i))) ((> i p))
                    (declare (type fixnum i))
                    (%copy-c-pt-row pw (+ (- ie p) i) (%next-bez-cpoints nqw) i)))
                (setf is ie
                      ie (1+ ie)))))))
      (values cura (1- nsp)))))

(defun crv-decompose-continuity (curp)
  "Split curve CURP at its interior knots of multiplicity at least its degree,
into pieces each at least C1 inside.  Returns (values curves k): CURVES a
simple-vector of the k+1 fresh pieces (one copy of CURP when it has no such
knot, k = 0).  NLib: N_CrvDecomposeContinuity."
  (declare (type curve curp))
  (let* ((n (curve-n curp))
         (pw (curve-cpoints curp))
         (p (curve-degree curp))
         (m (curve-m curp))
         (up (curve-knots curp))
         (r (1+ (truncate n p)))
         (ks (make-index-vector (1+ r)))
         (ke (make-index-vector (1+ r)))
         (ns (make-index-vector (1+ r)))
         (ne (make-index-vector (1+ r)))
         (ie (1+ p)))
    (declare (type fixnum n p m r ie) (type cpoint-array pw) (type real-vector up)
             (type index-vector ks ke ns ne))
    (setf r -1
          (aref ns 0) 0
          (aref ks 0) ie)
    (do () ((not (< ie m)))
      (let ((i ie))
        (declare (type fixnum i))
        (do () ((not (and (< ie m) (= (aref up ie) (aref up (1+ ie))))))
          (incf ie))
        (when (>= (+ (- ie i) 1) p)
          (incf r)
          (setf (aref ne r) (1- i)
                (aref ke r) i)
          (when (< ie m)
            (setf (aref ns (1+ r)) (aref ne r)
                  (aref ks (1+ r)) (1+ ie))))
        (incf ie)))
    (let ((cura (make-array (1+ r))))
      (dotimes (i (1+ r))
        (let* ((ni (- (aref ne i) (aref ns i)))
               (mi (+ (- (aref ke i) (aref ks i)) (* 2 p) 1))
               (qw (make-cpoint-array (1+ ni)))
               (uq (make-real-vector (1+ mi)))
               (l 0))
          (declare (type fixnum ni mi l))
          (dotimes (j (1+ ni))
            (%copy-c-pt-row pw (+ (aref ns i) j) qw j))
          (dotimes (j (1+ p))
            (setf (aref uq j) (aref up (1- (aref ks i)))))
          (do ((j (1+ p) (1+ j))) ((> j ni))
            (declare (type fixnum j))
            (setf (aref uq j) (aref up (+ (aref ks i) l)))
            (incf l))
          (do ((j (1+ ni) (1+ j))) ((> j mi))
            (declare (type fixnum j))
            (setf (aref uq j) (aref up (aref ke i))))
          (setf (svref cura i) (%make-curve p uq qw))))
      (values cura r))))

;;; ---------------------------------------------------------- refinement

(defun crv-refine (curp knx)
  "Curve CURP with the knots of KNX (a non-decreasing real-vector strictly
inside CURP's domain) inserted, as a fresh curve.  Signals :inp-err when KNX
is empty and :par-err when its first or last knot is not inside the domain.
NLib: N_CrvRefine."
  (declare (type curve curp) (type real-vector knx))
  (let* ((n (curve-n curp))
         (pw (curve-cpoints curp))
         (p (curve-degree curp))
         (m (curve-m curp))
         (up (curve-knots curp))
         (r (1- (length knx)))
         (x knx))
    (declare (type fixnum n p m r) (type cpoint-array pw) (type real-vector up x))
    (when (< r 0)
      (nurbs-error :inp-err 'crv-refine))
    (knot-vector-is-end-param up (aref x 0) 'crv-refine)
    (knot-vector-is-end-param up (aref x r) 'crv-refine)
    (let* ((qw (make-cpoint-array (+ n r 2)))
           (uq (make-real-vector (+ m r 2)))
           (a (basis-find-span up p (aref x 0) +left+))
           (b (1+ (basis-find-span up p (aref x r) +left+))))
      (declare (type cpoint-array qw) (type real-vector uq) (type fixnum a b))
      (fast
        (do ((j 0 (1+ j))) ((> j a))
          (declare (type fixnum j))
          (setf (aref uq j) (aref up j)))
        (do ((j (+ b p) (1+ j))) ((> j m))
          (declare (type fixnum j))
          (setf (aref uq (+ j r 1)) (aref up j)))
        (do ((j 0 (1+ j))) ((> j (- a p)))
          (declare (type fixnum j))
          (%copy-c-pt-row pw j qw j))
        (do ((j (1- b) (1+ j))) ((> j n))
          (declare (type fixnum j))
          (%copy-c-pt-row pw j qw (+ j r 1)))
        (let ((i (+ b p -1))
              (k (+ b p r)))
          (declare (type fixnum i k))
          (do ((j r (1- j))) ((< j 0))
            (declare (type fixnum j))
            (do () ((not (and (<= (aref x j) (aref up i)) (> i a))))
              (%copy-c-pt-row pw (- i p 1) qw (- k p 1))
              (setf (aref uq k) (aref up i))
              (decf k)
              (decf i))
            (%copy-c-pt-row qw (- k p) qw (- k p 1))
            (do ((l 1 (1+ l))) ((> l p))
              (declare (type fixnum l))
              (let ((tt (+ (- k p) l))
                    (alf (- (aref uq (+ k l)) (aref x j))))
                (declare (type fixnum tt) (type double-float alf))
                (if (<= (abs alf) 0d0)
                    (%copy-c-pt-row qw tt qw (1- tt))
                    (let* ((alf (/ alf (- (aref uq (+ k l)) (aref up (+ (- i p) l)))))
                           (oma (- 1d0 alf)))
                      (declare (type double-float alf oma))
                      (%combine-2-c-pt-rows alf qw (1- tt) oma qw tt qw (1- tt))))))
            (setf (aref uq k) (aref x j))
            (decf k))))
      (%make-curve p uq qw))))

;;; ---------------------------------------------------------- segments

(defun crv-extract-crv-seg (cur-p ul ur)
  "The segment of curve CUR-P over [UL, UR], as a fresh clamped curve.
Signals :inp-err when UR <= UL or the segment has no control points.
NLib: N_CrvExtractCrvSeg (the C's in-place case, curP = curQ, computes the
same curve)."
  (declare (type curve cur-p) (type double-float ul ur))
  (let* ((pw (curve-cpoints cur-p))
         (p (curve-degree cur-p))
         (m (curve-m cur-p))
         (up (curve-knots cur-p)))
    (declare (type fixnum p m) (type cpoint-array pw) (type real-vector up))
    ;; check parameters
    (when (<= ur ul)
      (nurbs-error :inp-err 'crv-extract-crv-seg))
    ;; find knot spans and set new indexes
    (multiple-value-bind (spl mll) (basis-find-span-and-mult up p ul +left+)
      (declare (type fixnum spl mll))
      (multiple-value-bind (spr mlr) (basis-find-span-and-mult up p ur +left+)
        (declare (type fixnum spr mlr))
        (let ((is (- spl p)))
          (declare (type fixnum is))
          (when (= ur (aref up (- m p)))
            (setf spr m
                  mlr (1+ p)))
          (let* ((ie (- spr mlr))
                 (nn (- ie is))
                 (mm (+ (- spr spl mlr) (* 2 p) 1)))
            (declare (type fixnum ie nn mm))
            (when (< nn 0)
              (nurbs-error :inp-err 'crv-extract-crv-seg))
            (let ((qw (make-cpoint-array (1+ nn)))
                  (uq (make-real-vector (1+ mm))))
              (declare (type cpoint-array qw) (type real-vector uq))
              (fast
                ;; initial control points
                (do ((i is (1+ i))) ((> i ie))
                  (declare (type fixnum i))
                  (%copy-c-pt-row pw i qw (- i is)))
                ;; insert the left knot
                (let ((ll (- spl p)))
                  (declare (type fixnum ll))
                  (do ((i 1 (1+ i))) ((> i (- p mll)))
                    (declare (type fixnum i))
                    (do ((j 0 (1+ j))) ((> j (- p i mll)))
                      (declare (type fixnum j))
                      (let* ((left (aref up (+ ll i j)))
                             (alf (/ (- ul left) (- (aref up (+ spl j 1)) left)))
                             (oma (- 1d0 alf)))
                        (declare (type double-float left alf oma))
                        (%combine-2-c-pt-rows alf qw (1+ j) oma qw j qw j)))))
                ;; insert the right knot
                (let ((lr (- spr p))
                      (lk (+ (- nn p) mlr)))
                  (declare (type fixnum lr lk))
                  (do ((i 1 (1+ i))) ((> i (- p mlr)))
                    (declare (type fixnum i))
                    (do ((j (- p i mlr) (1- j))) ((< j 0))
                      (declare (type fixnum j))
                      (let ((k (+ lk i j))
                            (left (aref up (+ lr i j))))
                        (declare (type fixnum k) (type double-float left))
                        (when (< left ul)
                          (setf left ul))
                        (let* ((alf (/ (- ur left) (- (aref up (+ spr j 1)) left)))
                               (oma (- 1d0 alf)))
                          (declare (type double-float alf oma))
                          (%combine-2-c-pt-rows alf qw k oma qw (1- k) qw k))))))
                ;; load the knot vector
                (let ((j -1))
                  (declare (type fixnum j))
                  (dotimes (i (1+ p))
                    (setf (aref uq (incf j)) ul))
                  (do ((i (1+ spl) (1+ i))) ((> i (- spr mlr)))
                    (declare (type fixnum i))
                    (setf (aref uq (incf j)) (aref up i)))
                  (dotimes (i (1+ p))
                    (setf (aref uq (incf j)) ur))))
              (%make-curve p uq qw))))))))

;;; ------------------------------------------------------------ knot removal

(defun crv-remove-knot-max-err (cur r s)
  "The maximum error of removing knot U[R], of multiplicity S, once from curve
CUR.  U[R] must be an interior knot with U[R] /= U[R+1] and 0 < S <= p; this
is not checked.  NLib: N_CrvRemoveKnotMaxErr."
  (declare (type curve cur) (type fixnum r s))
  (let* ((pw (curve-cpoints cur))
         (p (curve-degree cur))
         (u (curve-knots cur))
         (rw (make-array (list (1+ (* 2 p)) 4) :element-type 'double-float :initial-element 0d0))
         (ca (make-cpoint)) (cb (make-cpoint)) (cc (make-cpoint))
         (i (- r p))
         (j (- r s))
         (ii 1)
         (jj (+ (- p s) 1)))
    (declare (type cpoint-array pw rw) (type fixnum p i j ii jj) (type real-vector u)
             (dynamic-extent rw ca cb cc))
    (fast
      (%copy-c-pt-row pw (- r p 1) rw 0)
      (%copy-c-pt-row pw (+ (- r s) 1) rw (+ (- p s) 2))
      (do () ((not (> (- j i) 0)))
        (let* ((alf (/ (- (aref u (+ i p 1)) (aref u i)) (- (aref u r) (aref u i))))
               (oma (- 1d0 alf))
               (bet (/ (- (aref u (+ j p 1)) (aref u j)) (- (aref u (+ j p 1)) (aref u r))))
               (omb (- 1d0 bet)))
          (declare (type double-float alf oma bet omb))
          (%combine-2-c-pt-rows alf pw i oma rw (1- ii) rw ii)
          (%combine-2-c-pt-rows bet pw j omb rw (1+ jj) rw jj)
          (incf i)
          (decf j)
          (incf ii)
          (decf jj))))
    (if (< (- j i) 0)
        (dist-cpt-cpt-homo (%row-c-pt rw (1- ii) ca)
                           (%row-c-pt rw (1+ jj) cb))
        (let* ((alf (/ (- (aref u r) (aref u i)) (- (aref u (+ i p 1)) (aref u i))))
               (oma (- 1d0 alf)))
          (declare (type double-float alf oma))
          (combine-2-c-pts alf (%row-c-pt rw (1+ ii) ca)
                           oma (%row-c-pt rw (1- ii) cb) cc)
          (dist-cpt-cpt-homo (%row-c-pt pw i ca) cc)))))

;;; ------------------------------------------------------------ level 2, group 2

(defconstant +crv-tool--cto+ 1.0d-5 "NL_CrvTool.cpp's cto.")

(defun crv-remove-knot (cur-p u nu tol)
  "Remove the interior knot U of curve CUR-P up to NU times (at most its
multiplicity), each removal allowed only while it moves the curve by no more
than TOL (scaled by the weights for a rational curve) and keeps the weights
inside [*wmin*, *wmax*].  Returns (values ru cur-q): RU the number of knots
removed and CUR-Q the resulting fresh curve (a copy of CUR-P when RU is 0).
Signals :par-err when U is on or outside an end of the domain.
NLib: N_CrvRemoveKnot (the C's in-place case, curP = curQ, computes the same
curve)."
  (declare (type curve cur-p) (type double-float u tol) (type fixnum nu))
  (let* ((n (curve-n cur-p))
         (pw (curve-cpoints cur-p))
         (p (curve-degree cur-p))
         (m (curve-m cur-p))
         (up (curve-knots cur-p))
         (rat (is-crv-rat cur-p)))
    (declare (type fixnum n p m) (type cpoint-array pw) (type real-vector up))
    ;; adjust removal tolerance in case of rational curves
    (when rat
      (multiple-value-bind (wmin wmax pmin pmax) (crv-get-min-max-weights-and-pts cur-p)
        (declare (type double-float wmin pmax) (ignore wmax pmin))
        (setf tol (/ (* tol wmin) (+ 1d0 pmax)))))
    (let ((lto (* +crv-tool--cto+ (abs (- (aref up m) (aref up 0))))))
      (declare (type double-float lto))
      ;; check parameter and get knot span
      (knot-vector-is-end-param up u 'crv-remove-knot)
      (multiple-value-bind (spn mlt) (basis-find-span-and-mult up p u +left+)
        (declare (type fixnum spn mlt))
        (when (> nu mlt)
          (setf nu mlt))
        (let ((qw (make-cpoint-array (1+ n)))
              (uq (make-real-vector (1+ m)))
              (rw (make-cpoint-array (1+ (* 2 p))))
              (a (make-cpoint)) (ca (make-cpoint)) (cb (make-cpoint))
              (fout (truncate (- (* 2 spn) mlt p) 2))
              (first (- spn p))
              (last (- spn mlt))
              (k 0))
          (declare (type cpoint-array qw rw) (type real-vector uq)
                   (type fixnum fout first last k) (dynamic-extent a ca cb))
          (fast
            (dotimes (i (1+ n))
              (%copy-c-pt-row pw i qw i))
            (dotimes (i (1+ m))
              (setf (aref uq i) (aref up i))))
          (flet ((global-max (i)
                   ;; the C falls back on the bound max = 1 when
                   ;; N_BasisFindGlobalMax fails
                   (handler-case (values (basis-find-global-max uq i p lto))
                     (nurbs-error () 1d0))))
            ;; remove the knot NU times
            (do () ((not (< k nu)))
              (let* ((off (- first 1))
                     (i first)
                     (j last)
                     (ii 1)
                     (jj (- last off))
                     (alf 0.5d0) (bet 0.5d0))
                (declare (type fixnum off i j ii jj) (type double-float alf bet))
                (%copy-c-pt-row qw off rw 0)
                (%copy-c-pt-row qw (1+ last) rw (- (1+ last) off))
                ;; new control points for one removal step
                (do () ((not (> (- j i) k)))
                  (setf alf (/ (- (aref uq (+ i p 1)) (aref uq i)) (- u (aref uq i))))
                  (let ((oma (- 1d0 alf)))
                    (declare (type double-float oma))
                    (setf bet (/ (- (aref uq (+ (- j k) p 1)) (aref uq (- j k)))
                                 (- (aref uq (+ (- j k) p 1)) u)))
                    (let ((omb (- 1d0 bet)))
                      (declare (type double-float omb))
                      (%combine-2-c-pt-rows alf qw i oma rw (1- ii) rw ii)
                      (%combine-2-c-pt-rows bet qw j omb rw (1+ jj) rw jj)))
                  (incf i)
                  (decf j)
                  (incf ii)
                  (decf jj))
                ;; is the knot removable?
                (let* ((del (/ (- u (aref uq i)) (- (aref uq (+ i p 1)) (aref uq i))))
                       (omd (- 1d0 del)))
                  (declare (type double-float del omd))
                  (if (< (- j i) k)
                      (let* ((lam (/ alf (+ alf bet)))
                             (oml (- 1d0 lam))
                             (dw (dist-cpt-cpt-homo (%row-c-pt rw (1- ii) ca)
                                                    (%row-c-pt rw (1+ jj) cb)))
                             (maxl (global-max (1- i)))
                             (maxr (global-max i))
                             (max (nl-max (* (* lam alf) maxl) (* (* oml omd) maxr))))
                        (declare (type double-float lam oml dw maxl maxr max))
                        (when (> (* max dw) tol)
                          (return))
                        (%combine-2-c-pt-rows lam rw (1+ jj) oml rw (1- ii) rw (1+ jj)))
                      (progn
                        (combine-2-c-pts del (%row-c-pt rw (1+ jj) ca) omd (%row-c-pt rw (1- ii) cb) a)
                        (let* ((dw (dist-cpt-cpt-homo (%row-c-pt qw i ca) a))
                               (max (global-max i)))
                          (declare (type double-float dw max))
                          (when (> (* max dw) tol)
                            (return))))))
                ;; disallowed weights
                (when rat
                  (let ((i first) (j last) (wmin +bigd+) (wmax +smad+))
                    (declare (type fixnum i j) (type double-float wmin wmax))
                    (do () ((not (> (- j i) k)))
                      (let ((wi (aref rw (- i off) 3))
                            (wj (aref rw (- j off) 3)))
                        (declare (type double-float wi wj))
                        (when (< wi wmin) (setf wmin wi))
                        (when (< wj wmin) (setf wmin wj))
                        (when (> wi wmax) (setf wmax wi))
                        (when (> wj wmax) (setf wmax wj)))
                      (incf i)
                      (decf j))
                    (when (or (< wmin (the double-float *wmin*)) (> wmax (the double-float *wmax*)))
                      (return))))
                ;; save the new control points
                (let ((i first) (j last))
                  (declare (type fixnum i j))
                  (do () ((not (> (- j i) k)))
                    (%copy-c-pt-row rw (- i off) qw i)
                    (%copy-c-pt-row rw (- j off) qw j)
                    (incf i)
                    (decf j)))
                ;; close the gap in the knot array
                (do ((l (- spn k) (1+ l))) ((> l (- m k 1)))
                  (declare (type fixnum l))
                  (setf (aref uq l) (aref uq (1+ l))))
                (decf first)
                (incf last)
                (incf k))))
          (when (= k 0)
            (return-from crv-remove-knot (values 0 (%make-curve p uq qw))))
          ;; shift down control points
          (let* ((j fout) (i j))
            (declare (type fixnum i j))
            (do ((l 1 (1+ l))) ((>= l k))
              (declare (type fixnum l))
              (if (oddp l) (incf i) (decf j)))
            (do ((l (1+ i) (1+ l))) ((> l n))
              (declare (type fixnum l))
              (%copy-c-pt-row qw l qw j)
              (incf j)))
          ;; the output curve's highest indexes are n-k and m-k
          (let ((qw2 (make-cpoint-array (1+ (- n k))))
                (uq2 (make-real-vector (1+ (- m k)))))
            (declare (type cpoint-array qw2) (type real-vector uq2))
            (fast
              (dotimes (i (1+ (- n k)))
                (%copy-c-pt-row qw i qw2 i))
              (dotimes (i (1+ (- m k)))
                (setf (aref uq2 i) (aref uq i))))
            (values k (%make-curve p uq2 qw2))))))))

;;; ------------------------------------------------------------ level 3, group 5

(defconstant +crv-tool--norem+ 1.0d25 "NL_CrvTool.cpp's NOREM: a knot marked not removable.")

(defun crv-remove-knots (cur-p tol)
  "Curve CUR-P with every removable knot removed, as a fresh curve: knots
are tried in order of their removal error bound, and each removal is allowed
while the accumulated error over every span it affects stays within TOL
(scaled by the weights for a rational curve) and the new weights stay inside
[*wmin*, *wmax*].  A copy of CUR-P when nothing can be removed.
The C keeps the error vector update of a removal that the weight test then
refuses; so does this.
NLib: N_CrvRemoveKnots (the C's in-place case, curP = curQ, computes the same
curve)."
  (declare (type curve cur-p) (type double-float tol))
  (let* ((n (curve-n cur-p))
         (p (curve-degree cur-p))
         (m (curve-m cur-p))
         (up (curve-knots cur-p))
         (ns n)
         (rat nil))
    (declare (type fixnum n p m ns) (type real-vector up))
    ;; adjust removal tolerance in case of rational curves
    (when (is-crv-rat cur-p)
      (multiple-value-bind (wmin wmax pmin pmax) (crv-get-min-max-weights-and-pts cur-p)
        (declare (type double-float wmin pmax) (ignore wmax pmin))
        (setf tol (/ (* tol wmin) (+ 1d0 pmax))
              rat t)))
    (let* ((lto (* +crv-tool--cto+ (abs (- (aref up m) (aref up 0)))))
           (curq (crv-copy cur-p))
           (qw (curve-cpoints curq))
           ;; UQ is the knot vector of the current curve, re-made one shorter
           ;; at each removal, as the C's NL_KNOTVECTOR m goes down
           (uq (curve-knots curq))
           (rw (make-cpoint-array (1+ (* 2 p))))
           (br (make-real-vector (1+ m)))
           (sr (make-index-vector (1+ m)))
           (er (make-real-vector (1+ m)))
           (te (make-real-vector (1+ m)))
           (minl (make-real-vector (1+ p)))
           (maxl (make-real-vector (1+ p)))
           (minr (make-real-vector (1+ p)))
           (maxr (make-real-vector (1+ p)))
           (mx (make-real-vector (+ p 2)))
           (lam 0d0) (oml 0d0))
      (declare (type double-float lto lam oml) (type cpoint-array qw rw)
               (type real-vector uq br er te minl maxl minr maxr mx) (type index-vector sr))
      (dotimes (i (1+ m))
        (setf (aref br i) +bigd+
              (aref sr i) 0
              (aref er i) 0d0))
      ;; knot removal errors for each distinct knot
      (let ((r (1+ p)))
        (declare (type fixnum r))
        (do () ((not (<= r n)))
          (let ((i r))
            (declare (type fixnum i))
            (do () ((not (and (<= r n) (= (aref uq r) (aref uq (1+ r))))))
              (incf r))
            (setf (aref sr r) (+ (- r i) 1))
            (setf (aref br r) (crv-remove-knot-max-err cur-p r (aref sr r)))
            (incf r))))
      ;; try to remove each knot
      (block main
        (do () (nil)
          (block continue
            (let ((b (aref br (1+ p)))
                  (s (aref sr (1+ p)))
                  (r (1+ p))
                  (rmf t)
                  (k 0) (l 0))
              (declare (type double-float b) (type fixnum s r k l))
              ;; knot with the smallest error
              (do ((i (+ p 2) (1+ i))) ((> i (- m p 1)))
                (declare (type fixnum i))
                (when (< (aref br i) b)
                  (setf b (aref br i)
                        s (aref sr i)
                        r i)))
              ;; no more removable knots
              (when (or (= b +bigd+) (= b +crv-tool--norem+))
                (return-from main))
              (if (oddp (+ p s))
                  ;; maximums of the basis functions over each span
                  (let* ((alf 0d0) (bet 0d0) (omb 0d0))
                    (declare (type double-float alf bet omb))
                    (setf k (truncate (+ p s 1) 2)
                          l (+ (- r k) p 1))
                    (setf alf (/ (- (aref uq r) (aref uq (- r k)))
                                 (- (aref uq (+ (- r k) p 1)) (aref uq (- r k))))
                          bet (/ (- (aref uq r) (aref uq (+ (- r k) 1)))
                                 (- (aref uq (+ (- r k) p 2)) (aref uq (+ (- r k) 1))))
                          omb (- 1d0 bet)
                          lam (/ alf (+ alf bet))
                          oml (- 1d0 lam))
                    (handler-case (basis-find-all-span-maxima uq (- r k) p lto minl maxl)
                      (nurbs-error ()
                        (dotimes (i (1+ p))
                          (setf (aref minl i) 0d0
                                (aref maxl i) 1d0))))
                    (handler-case (basis-find-all-span-maxima uq (+ (- r k) 1) p lto minr maxr)
                      (nurbs-error ()
                        (dotimes (i (1+ p))
                          (setf (aref minr i) 0d0
                                (aref maxr i) 1d0))))
                    (setf (aref mx 0) (* (* lam alf) (aref maxl 0)))
                    (do ((i 1 (1+ i))) ((> i p))
                      (declare (type fixnum i))
                      (setf (aref minl i) (* (aref minl i) (* lam alf))
                            (aref minr (1- i)) (* (aref minr (1- i)) (* oml omb))
                            (aref maxl i) (* (aref maxl i) (* lam alf))
                            (aref maxr (1- i)) (* (aref maxr (1- i)) (* oml omb)))
                      (setf (aref mx i) (nl-max (abs (- (aref maxl i) (aref minr (1- i))))
                                                (abs (- (aref maxr (1- i)) (aref minl i))))))
                    (setf (aref mx (1+ p)) (* (* oml omb) (aref maxr p))))
                  ;; maximum of the basis function
                  (progn
                    (setf k (truncate (+ p s) 2)
                          l (+ (- r k) p))
                    (handler-case (basis-find-all-span-maxima uq (- r k) p lto minl mx)
                      (nurbs-error ()
                        (dotimes (i (1+ p))
                          (setf (aref mx i) 1d0))))))
              ;; check the error
              (do ((i (- r k) (1+ i))) ((> i l))
                (declare (type fixnum i))
                (when (/= (aref uq i) (aref uq (1+ i)))
                  (setf (aref te i) (+ (aref er i) (* (aref mx (+ (- i r) k)) b)))
                  (when (> (aref te i) tol)
                    (setf rmf nil)
                    (return))))
              (cond
                ((not rmf)
                 ;; knot is not removable
                 (setf (aref br r) +crv-tool--norem+))
                (t
                 ;; update the error vector and remove the knot
                 (do ((i (- r k) (1+ i))) ((> i l))
                   (declare (type fixnum i))
                   (when (/= (aref uq i) (aref uq (1+ i)))
                     (setf (aref er i) (aref te i))))
                 (let* ((fout (truncate (- (* 2 r) s p) 2))
                        (first (- r p))
                        (last (- r s))
                        (off (- first 1))
                        (i first)
                        (j last)
                        (ii 1)
                        (jj (- last off)))
                   (declare (type fixnum fout first last off i j ii jj))
                   (%copy-c-pt-row qw off rw 0)
                   (%copy-c-pt-row qw (1+ last) rw (- (1+ last) off))
                   ;; new control points for one removal step
                   (fast
                     (do () ((not (> (- j i) 0)))
                       (let* ((alf (/ (- (aref uq (+ i p 1)) (aref uq i)) (- (aref uq r) (aref uq i))))
                              (oma (- 1d0 alf))
                              (bet (/ (- (aref uq (+ j p 1)) (aref uq j)) (- (aref uq (+ j p 1)) (aref uq r))))
                              (omb (- 1d0 bet)))
                         (declare (type double-float alf oma bet omb))
                         (%combine-2-c-pt-rows alf qw i oma rw (1- ii) rw ii)
                         (%combine-2-c-pt-rows bet qw j omb rw (1+ jj) rw jj))
                       (incf i)
                       (decf j)
                       (incf ii)
                       (decf jj)))
                   ;; disallowed weights
                   (when rat
                     (let ((i first) (j last) (wmin +bigd+) (wmax +smad+) (cw (make-cpoint)))
                       (declare (type fixnum i j) (type double-float wmin wmax)
                                (dynamic-extent cw))
                       (do () ((not (> (- j i) 0)))
                         (let ((wi (c-pt-get-w (%row-c-pt rw (- i off) cw)))
                               (wj (c-pt-get-w (%row-c-pt rw (- j off) cw))))
                           (declare (type double-float wi wj))
                           (when (< wi wmin) (setf wmin wi))
                           (when (< wj wmin) (setf wmin wj))
                           (when (> wi wmax) (setf wmax wi))
                           (when (> wj wmax) (setf wmax wj)))
                         (incf i)
                         (decf j))
                       (when (or (< wmin (the double-float *wmin*)) (> wmax (the double-float *wmax*)))
                         (setf (aref br r) +crv-tool--norem+)
                         (return-from continue))))
                   ;; save the new control points
                   (when (oddp (+ p s))
                     (%combine-2-c-pt-rows lam rw (1+ jj) oml rw (1- ii) rw (1+ jj)))
                   (let ((i first) (j last))
                     (declare (type fixnum i j))
                     (do () ((not (> (- j i) 0)))
                       (%copy-c-pt-row rw (- i off) qw i)
                       (%copy-c-pt-row rw (- j off) qw j)
                       (incf i)
                       (decf j)))
                   ;; shift down some parameters
                   (when (= s 1)
                     (setf (aref er (1- r)) (nl-max (aref er (1- r)) (aref er r))))
                   (when (> s 1)
                     (setf (aref sr (1- r)) (1- (aref sr r))))
                   (do ((i (1+ r) (1+ i))) ((> i m))
                     (declare (type fixnum i))
                     (setf (aref br (1- i)) (aref br i)
                           (aref sr (1- i)) (aref sr i)
                           (aref er (1- i)) (aref er i)))
                   ;; shift down knots and control points
                   (let ((nuq (make-real-vector m)))
                     (declare (type real-vector nuq))
                     (dotimes (i r)
                       (setf (aref nuq i) (aref uq i)))
                     (do ((i (1+ r) (1+ i))) ((> i m))
                       (declare (type fixnum i))
                       (setf (aref nuq (1- i)) (aref uq i)))
                     (setf uq nuq))
                   (do ((i (1+ fout) (1+ i))) ((> i n))
                     (declare (type fixnum i))
                     (%copy-c-pt-row qw i qw (1- i)))
                   (decf n)
                   (decf m)
                   ;; no more internal knots
                   (when (= n p)
                     (return-from main))
                   ;; update the error bounds
                   (let ((cur (%make-curve p uq qw)))
                     (setf k (nl-max (- r p) (1+ p))
                           l (nl-min n (- (+ r p) s)))
                     (do ((i k (1+ i))) ((> i l))
                       (declare (type fixnum i))
                       (when (and (/= (aref uq i) (aref uq (1+ i)))
                                  (/= (aref br i) +crv-tool--norem+))
                         (setf (aref br i) (crv-remove-knot-max-err cur i (aref sr i)))))))))))))
      ;; the output curve: compact when knots were removed
      (if (< n ns)
          (let ((qw2 (make-cpoint-array (1+ n))))
            (declare (type cpoint-array qw2))
            (dotimes (i (1+ n))
              (%copy-c-pt-row qw i qw2 i))
            (%make-curve p uq qw2))
          curq))))

;;; ------------------------------------------------------- degree elevation

(defun crv-elevate-degree (cur-p tt)
  "Curve CUR-P with its degree raised by TT, as a fresh curve of degree p+TT
(a copy of CUR-P when TT is 0).  Signals :deg-err when TT is negative or p+TT
exceeds *dmax*, and :knt-err when CUR-P's knot vector is not valid.
NLib: N_CrvElevateDegree (the C's in-place case, curP = curQ, computes the
same curve)."
  (declare (type curve cur-p) (type fixnum tt))
  (let* ((np (curve-n cur-p))
         (pw (curve-cpoints cur-p))
         (p (curve-degree cur-p))
         (mp (curve-m cur-p))
         (up (curve-knots cur-p)))
    (declare (type fixnum np p mp) (type cpoint-array pw) (type real-vector up))
    (when (or (< tt 0) (> (+ p tt) (the fixnum *dmax*)))
      (nurbs-error :deg-err 'crv-elevate-degree))
    (knot-vector-is-valid up p 'crv-elevate-degree)
    (let* ((s (basis-get-span-count up p))
           (nq (+ np (* tt s)))
           (q (+ p tt))
           (mq (+ mp (* tt (1+ s))))
           (qw (make-cpoint-array (1+ nq)))
           (uq (make-real-vector (1+ mq))))
      (declare (type fixnum s nq q mq) (type cpoint-array qw) (type real-vector uq))
      ;; no elevation required
      (when (= tt 0)
        (fast
          (dotimes (i (1+ np))
            (%copy-c-pt-row pw i qw i))
          (dotimes (i (1+ mp))
            (setf (aref uq i) (aref up i))))
        (return-from crv-elevate-degree (%make-curve q uq qw)))
      (let ((bw (make-cpoint-array (1+ p)))
            (nw (make-cpoint-array (1+ p)))
            (dw (make-cpoint-array (1+ q)))
            (alfs (make-real-vector (1+ p)))
            (omas (make-real-vector (1+ p)))
            (a p)
            (b (1+ p))
            (r -1)
            (cind 1)
            (kind (1+ q)))
        (declare (type cpoint-array bw nw dw) (type real-vector alfs omas)
                 (type fixnum a b r cind kind))
        (dotimes (i (1+ q))
          (setf (aref uq i) (aref up a)))
        (%copy-c-pt-row pw 0 qw 0)
        (dotimes (i (1+ p))
          (%copy-c-pt-row pw i bw i))
        ;; the degree elevation matrix
        (let ((dm (make-rmatrix q p (bez-get-degree-elevation-matrix p tt) +mt-full+ p)))
          ;; extract each Bezier segment, elevate it, and remove the knot
          ;; between it and the one before
          (fast
            (do () ((not (< b mp)))
              ;; multiplicity of the knot
              (let ((i b))
                (declare (type fixnum i))
                (do () ((not (and (< b mp) (= (aref up b) (aref up (1+ b))))))
                  (incf b))
                (let* ((mlt (+ (- b i) 1))
                       (oldr r)
                       (lbz 0) (rbz 0))
                  (declare (type fixnum mlt oldr lbz rbz))
                  (setf r (- p mlt))
                  (setf lbz (if (> oldr 0) (truncate (+ oldr 2) 2) 1))
                  (setf rbz (if (> r 0) (- q (truncate (1+ r) 2)) q))
                  ;; insert the knot to get the Bezier segment
                  (when (> r 0)
                    (let ((num (- (aref up b) (aref up a))))
                      (declare (type double-float num))
                      (do ((k p (1- k))) ((<= k mlt))
                        (declare (type fixnum k))
                        (setf (aref alfs (- k mlt 1)) (/ num (- (aref up (+ a k)) (aref up a))))
                        (setf (aref omas (- k mlt 1)) (- 1d0 (aref alfs (- k mlt 1))))))
                    (do ((j 1 (1+ j))) ((> j r))
                      (declare (type fixnum j))
                      (let ((save (- r j))
                            (s (+ mlt j)))
                        (declare (type fixnum save s))
                        (do ((k p (1- k))) ((< k s))
                          (declare (type fixnum k))
                          (%combine-2-c-pt-rows (aref alfs (- k s)) bw k (aref omas (- k s)) bw (1- k) bw k))
                        (%copy-c-pt-row bw p nw save))))
                  ;; degree elevate the Bezier segment
                  (bez-elevate-degree bw p tt dm lbz q dw)
                  ;; remove the knot UP[a]
                  (when (> oldr 1)
                    (let* ((first (- kind 2))
                           (last kind)
                           (den (- (aref up b) (aref up a)))
                           (bet (/ (- (aref up b) (aref uq (1- kind))) den))
                           (omb (- 1d0 bet)))
                      (declare (type fixnum first last) (type double-float den bet omb))
                      (do ((k 1 (1+ k))) ((>= k oldr))
                        (declare (type fixnum k))
                        (let* ((i first)
                               (j last)
                               (l (+ (- j kind) 1)))
                          (declare (type fixnum i j l))
                          (do () ((not (> (- j i) k)))
                            (when (< i cind)
                              (let* ((alf (/ (- (aref up b) (aref uq i)) (- (aref up a) (aref uq i))))
                                     (oma (- 1d0 alf)))
                                (declare (type double-float alf oma))
                                (%combine-2-c-pt-rows alf qw i oma qw (1- i) qw i)))
                            (when (>= j lbz)
                              (if (<= (- j k) (+ (- kind q) oldr))
                                  (let* ((gam (/ (- (aref up b) (aref uq (- j k))) den))
                                         (omg (- 1d0 gam)))
                                    (declare (type double-float gam omg))
                                    (%combine-2-c-pt-rows gam dw l omg dw (1+ l) dw l))
                                  (%combine-2-c-pt-rows bet dw l omb dw (1+ l) dw l)))
                            (incf i)
                            (decf j)
                            (decf l)))
                        (decf first)
                        (incf last))))
                  ;; load the knot vector and control points
                  (when (/= a p)
                    (dotimes (i (- q oldr))
                      (setf (aref uq kind) (aref up a))
                      (incf kind)))
                  (do ((i lbz (1+ i))) ((> i rbz))
                    (declare (type fixnum i))
                    (%copy-c-pt-row dw i qw cind)
                    (incf cind))
                  ;; initialize for the next pass
                  (if (< b mp)
                      (progn
                        (dotimes (i r)
                          (%copy-c-pt-row nw i bw i))
                        (do ((i r (1+ i))) ((> i p))
                          (declare (type fixnum i))
                          (%copy-c-pt-row pw (+ (- b p) i) bw i))
                        (setf a b)
                        (incf b))
                      ;; the end knot
                      (dotimes (i (1+ q))
                        (setf (aref uq (+ kind i)) (aref up b))))))))))
      (%make-curve q uq qw))))

;;; ------------------------------------------------------------- L5-g1

(defun crvs-make-compatible-knot-tol (cur k knot-tol)
  "Make the curves CUR[0..K] (a simple-vector of curves, each modified in
place) compatible: the same rationality and dimension (CRVS-MAKE-RAT-COMPATIBLE),
all reparametrized onto [0, 1] when their domains differ by more than 1e-12,
all elevated to the highest degree, and their knot vectors merged and
inserted.  Knots closer than KNOT-TOL count as one (and are moved to their
average, in place); KNOT-TOL 0 means 0.001 after a reparametrization, else a
thousandth of CUR[0]'s domain, and a KNOT-TOL of 1e-8 or less means 1e-8.  A
nil CUR is left alone.  Returns CUR.  Signals what the elevation, the merge
and the refinement signal.
NLib: N_CrvsMakeCompatibleKnotTol."
  (declare (type (or null simple-vector) cur) (type fixnum k) (type double-float knot-tol))
  (when (null cur)
    (return-from crvs-make-compatible-knot-tol nil))
  (crvs-make-rat-compatible cur k)
  ;; if necessary, scale the knot vectors to the unit interval
  (multiple-value-bind (us ue) (crv-get-param-bounds (svref cur 0))
    (declare (type double-float us ue))
    (let ((i 1))
      (declare (type fixnum i))
      ;; remember whether any curve's bounds differ
      (do () ((> i k))
        (multiple-value-bind (u1 u2) (crv-get-param-bounds (svref cur i))
          (declare (type double-float u1 u2))
          (when (or (> (abs (- u1 us)) 1.0d-12) (> (abs (- u2 ue)) 1.0d-12))
            (return)))
        (incf i))
      (when (<= i k)
        (let ((unitspan (make-real-vector 2)))
          (create-interval unitspan 0d0 1d0)
          (dotimes (j (1+ k))
            (crv-reparam-to-interval (svref cur j) unitspan)))
        (when (= knot-tol 0d0)
          (setf knot-tol 0.001d0))))
    (when (= knot-tol 0d0)
      (setf knot-tol (/ (- ue us) 1000.0d0))))
  ;; the highest degree
  (let ((ph (curve-degree (svref cur 0))))
    (declare (type fixnum ph))
    (do ((i 1 (1+ i))) ((> i k))
      (declare (type fixnum i))
      (let ((p (curve-degree (svref cur i))))
        (declare (type fixnum p))
        (when (> p ph)
          (setf ph p))))
    ;; elevate the degrees
    (dotimes (i (1+ k))
      (let ((tt (- ph (curve-degree (svref cur i)))))
        (declare (type fixnum tt))
        (when (> tt 0)
          (%crv-become (svref cur i) (crv-elevate-degree (svref cur i) tt))))))
  ;; merge the knot vectors
  (let ((knt (make-array (1+ k))))
    (declare (type simple-vector knt))
    (dotimes (i (1+ k))
      (setf (svref knt i) (curve-knots (svref cur i))))
    (let ((knx (if (<= knot-tol 1.0d-8)
                   (get-compatible-knot-array knt k)
                   (get-compatible-knot-vector-to-tol knt k knot-tol))))
      (declare (type simple-vector knx))
      ;; refine the curves
      (dotimes (i (1+ k))
        (let ((x (svref knx i)))
          (declare (type real-vector x))
          (when (>= (1- (length x)) 0)
            (%crv-become (svref cur i) (crv-refine (svref cur i) x)))))))
  cur)

;;; ------------------------------------------------------------- L6-g1

(defun crvs-make-compatible (cur k)
  "Make the curves CUR[0..K] (a simple-vector of curves, each modified in
place) compatible: crvs-make-compatible-knot-tol with the default knot
tolerance (KNOT-TOL 0).  Returns CUR.
NLib: N_CrvsMakeCompatible."
  (declare (type (or null simple-vector) cur) (type fixnum k))
  (crvs-make-compatible-knot-tol cur k 0d0))

;;; ------------------------------------------------------------- L12-g0

(defun crv-reduce-degree-once (cur-p tol)
  "Reduce the degree of curve CUR-P by one, if that moves the curve by no more
than TOL (scaled by the weights for a rational curve) and keeps the weights
of a rational curve inside [*wmin*, *wmax*]: each Bezier segment is
extracted by knot insertion and degree reduced, and the knot between it and
the segment before is removed again, the error bounds accumulating per knot
span.  Returns (values rfl cur-q mtol): RFL +yes+ with CUR-Q the fresh
degree p-1 curve, or +no+ with CUR-Q NIL (the C frees curQ); MTOL the
largest error bound reached (0 for degree 1 or less, where the C leaves it
unset and RFL is +no+).  Signals as bez-reduce-degree does.
NLib: N_CrvReduceDegreeOnce (the C's in-place case, curP = curQ, computes
the same curve)."
  (declare (type curve cur-p) (type double-float tol))
  (let* ((np (curve-n cur-p))
         (pw (curve-cpoints cur-p))
         (p (curve-degree cur-p))
         (mp (curve-m cur-p))
         (up (curve-knots cur-p))
         (rat +no+))
    (declare (type fixnum np p mp rat) (type cpoint-array pw) (type real-vector up))
    (when (<= p 1)
      (return-from crv-reduce-degree-once (values +no+ nil 0d0)))
    ;; adjust the tolerance in case of rational curves
    (if (is-crv-rat cur-p)
        (multiple-value-bind (wmin wmax pmin pmax) (crv-get-min-max-weights-and-pts cur-p)
          (declare (type double-float wmin pmax) (ignore wmax pmin))
          (setf tol (/ (* tol wmin) (+ 1d0 pmax)))
          (setf rat +yes+))
        (setf rat +no+))
    (let* ((lto (* +crv-tool--cto+ (abs (- (aref up mp) (aref up 0)))))
           (s (basis-get-span-count up p))
           (nq (- np s))
           (q (- p 1))
           (mq (- mp s 1))
           (qw (make-cpoint-array (1+ nq)))
           (uq (make-real-vector (1+ mq)))
           (bw (make-cpoint-array (1+ p)))
           (nw (make-cpoint-array (1+ p)))
           (dw (make-cpoint-array (1+ q)))
           (alfs (make-real-vector (1+ p)))
           (omas (make-real-vector (1+ p)))
           (dalf (make-real-vector (1+ p)))
           (doma (make-real-vector (1+ p)))
           (dbet (make-real-vector (1+ p)))
           (domb (make-real-vector (1+ p)))
           (x (make-real-vector (+ (* 3 p) 3)))
           (e (make-real-vector (1+ mp)))
           (minl (make-real-vector (1+ p)))
           (maxl (make-real-vector (1+ p)))
           (minr (make-real-vector (1+ p)))
           (maxr (make-real-vector (1+ p)))
           (mx (make-real-vector (+ p 2)))
           (aw (make-cpoint)) (ca (make-cpoint)) (cb (make-cpoint))
           (a p)
           (b (1+ p))
           (r -1)
           (spn (1+ p))
           (cind 1)
           (kind (1+ q))
           (mlt (1+ p))
           (oldmlt 0)
           (oldr 0)
           (lbz 0)
           (rfl +yes+)
           (mtol 0d0)
           (lam 0d0)
           (oml 0d0))
      (declare (type double-float lto mtol lam oml)
               (type fixnum s nq q mq a b r spn cind kind mlt oldmlt oldr lbz rfl)
               (type cpoint-array qw bw nw dw)
               (type real-vector uq alfs omas dalf doma dbet domb x e minl maxl minr maxr mx)
               (type cpoint aw ca cb) (dynamic-extent aw ca cb))
      ;; the degree reduction coefficients
      (bez-degree-reduce-coefs p dalf doma dbet domb)
      ;; initialize
      (dotimes (i (1+ q))
        (setf (aref uq i) (aref up a)))
      (%copy-c-pt-row pw 0 qw 0)
      (dotimes (i (1+ p))
        (%copy-c-pt-row pw i bw i))
      ;; through the knot vector: (1) extract the next Bezier segment, (2)
      ;; degree reduce it, (3) remove the knot between it and the one before
      (block segments
        (do () ((not (< b mp)))
          ;; multiplicity of the knot
          (let ((i spn))
            (declare (type fixnum i))
            (do () ((not (and (< spn mp) (= (aref up spn) (aref up (1+ spn))))))
              (incf spn))
            (setf oldmlt mlt
                  mlt (+ (- spn i) 1)))
          ;; insert the knot to get the Bezier segment
          (setf b (+ b mlt -1)
                oldr r
                r (- p mlt))
          (setf lbz (if (> oldr 0) (truncate (+ oldr 2) 2) 1))
          (when (> r 0)
            ;; save the alphas
            (let ((num (- (aref up b) (aref up a))))
              (declare (type double-float num))
              (do ((k p (1- k))) ((<= k mlt))
                (declare (type fixnum k))
                (setf (aref alfs (- k mlt 1)) (/ num (- (aref up (+ a k)) (aref up a))))
                (setf (aref omas (- k mlt 1)) (- 1d0 (aref alfs (- k mlt 1))))))
            ;; now insert the knot
            (fast
              (do ((j 1 (1+ j))) ((> j r))
                (declare (type fixnum j))
                (let ((save (- r j))
                      (s (+ mlt j)))
                  (declare (type fixnum save s))
                  (do ((k p (1- k))) ((< k s))
                    (declare (type fixnum k))
                    (%combine-2-c-pt-rows (aref alfs (- k s)) bw k (aref omas (- k s)) bw (1- k) bw k))
                  (%copy-c-pt-row bw p nw save)))))
          ;; degree reduce the Bezier segment
          (let ((de (bez-reduce-degree bw p dalf doma dbet domb dw)))
            (declare (type double-float de))
            (setf (aref e a) (+ (aref e a) de)))
          (when (> (aref e a) mtol)
            (setf mtol (aref e a)))
          (when (> (aref e a) tol)
            (setf rfl +no+)
            (return-from segments))
          ;; remove the knot UP[a]
          (when (> oldr 0)
            (let ((first kind)
                  (last kind)
                  (den (- (aref up b) (aref up a)))
                  (i 0) (j 0) (l 0))
              (declare (type fixnum first last i j l) (type double-float den))
              (block removal
                (do ((k 0 (1+ k))) ((>= k oldr))
                  (declare (type fixnum k))
                  (setf i first
                        j last
                        l (- j kind))
                  (block step
                    (do () ((not (> (- j i) k)))
                      (let* ((alf (/ (- (aref up b) (aref uq (- i 1))) (- (aref up a) (aref uq (- i 1)))))
                             (oma (- 1d0 alf))
                             (bet (/ (- (aref up b) (aref uq (- j k 1))) den))
                             (omb (- 1d0 bet)))
                        (declare (type double-float alf oma bet omb))
                        (%combine-2-c-pt-rows alf qw (- i 1) oma qw (- i 2) qw (- i 1))
                        (%combine-2-c-pt-rows bet dw l omb dw (+ l 1) dw l))
                      (when (= rat +yes+)
                        (let ((wi (aref qw (- i 1) 3))
                              (wl (aref dw l 3))
                              (wmn *wmin*)
                              (wmx *wmax*))
                          (declare (type double-float wi wl wmn wmx))
                          (when (or (< wi wmn) (< wl wmn) (> wi wmx) (> wl wmx))
                            (setf rfl +no+)
                            (return-from step))))
                      (incf i)
                      (decf j)
                      (decf l)))
                  (when (= rfl +no+)
                    (return-from removal))
                  ;; load the knot vector to compute the precise error
                  (let* ((kk (- (+ a oldr) k))
                         (ll (- kk (truncate (+ (- (* 2 p) k) 1) 2)))
                         (jj (mod k 2))
                         (c -1)
                         (dwd 0d0))
                    (declare (type fixnum kk ll jj c) (type double-float dwd))
                    (do ((ii 0 (1+ ii))) ((> ii p))
                      (declare (type fixnum ii))
                      (setf (aref x (incf c)) (aref up ll)))
                    (do ((ii (+ ll 1) (1+ ii))) ((> ii (- a oldmlt)))
                      (declare (type fixnum ii))
                      (setf (aref x (incf c)) (aref up ii)))
                    (do ((ii 1 (1+ ii))) ((> ii (- p k)))
                      (declare (type fixnum ii))
                      (setf (aref x (incf c)) (aref up a)))
                    (do ((ii (- kk ll jj) (1+ ii))) ((> ii (* 2 p)))
                      (declare (type fixnum ii))
                      (setf (aref x (incf c)) (aref up b)))
                    (let ((knx (knot-vector-from-real-array x c)))
                      (declare (type real-vector knx))
                      ;; compute the error
                      (if (< (- j i) k)
                          (let* ((alf (/ (- (aref up a) (aref uq (- i 2))) (- (aref up b) (aref uq (- i 2)))))
                                 (bet (/ (- (aref up a) (aref uq (- i 1))) (- (aref up b) (aref uq (- i 1)))))
                                 (omb (- 1d0 bet)))
                            (declare (type double-float alf bet omb))
                            (setf lam (/ alf (+ alf bet))
                                  oml (- 1d0 lam))
                            (setf dwd (dist-cpt-cpt-homo (%row-c-pt qw (- i 2) ca) (%row-c-pt dw (+ l 1) cb)))
                            ;; the C falls back on the bounds 0 and 1 when
                            ;; N_BasisFindAllSpanMaxima fails
                            (handler-case (basis-find-all-span-maxima knx p p lto minl maxl)
                              (nurbs-error ()
                                (dotimes (ii (1+ p))
                                  (setf (aref minl ii) 0d0
                                        (aref maxl ii) 1d0))))
                            (handler-case (basis-find-all-span-maxima knx (+ p 1) p lto minr maxr)
                              (nurbs-error ()
                                (dotimes (ii (1+ p))
                                  (setf (aref minr ii) 0d0
                                        (aref maxr ii) 1d0))))
                            (setf (aref mx 0) (abs (* (* lam alf) (aref maxl 0))))
                            (do ((ii 1 (1+ ii))) ((> ii p))
                              (declare (type fixnum ii))
                              (setf (aref minl ii) (* (aref minl ii) (* lam alf))
                                    (aref minr (- ii 1)) (* (aref minr (- ii 1)) (* oml omb))
                                    (aref maxl ii) (* (aref maxl ii) (* lam alf))
                                    (aref maxr (- ii 1)) (* (aref maxr (- ii 1)) (* oml omb)))
                              (setf (aref mx ii) (nl-max (abs (- (aref maxl ii) (aref minr (- ii 1))))
                                                         (abs (- (aref maxr (- ii 1)) (aref minl ii))))))
                            (setf (aref mx (+ p 1)) (abs (* (* oml omb) (aref maxr p)))))
                          (let* ((alf (/ (- (aref up a) (aref uq (- i 1))) (- (aref up b) (aref uq (- i 1)))))
                                 (oma (- 1d0 alf)))
                            (declare (type double-float alf oma))
                            (combine-2-c-pts alf (%row-c-pt dw (+ l 1) ca) oma (%row-c-pt qw (- i 2) cb) aw)
                            (setf dwd (dist-cpt-cpt-homo (%row-c-pt qw (- i 1) ca) aw))
                            (handler-case (basis-find-all-span-maxima knx p p lto minl mx)
                              (nurbs-error ()
                                (dotimes (ii (1+ p))
                                  (setf (aref mx ii) 1d0)))))))
                    (do ((ii ll (1+ ii))) ((> ii a))
                      (declare (type fixnum ii))
                      (when (/= (aref up ii) (aref up (1+ ii)))
                        (setf (aref e ii) (+ (aref e ii) (* dwd (aref mx (- ii ll)))))
                        (when (> (aref e ii) mtol)
                          (setf mtol (aref e ii)))
                        (when (> (aref e ii) tol)
                          (setf rfl +no+)
                          (return)))))
                  (when (= rfl +no+)
                    (return-from removal))
                  ;; average the control points
                  (when (< (- j i) k)
                    (%combine-2-c-pt-rows lam dw (+ l 1) oml qw (- i 2) qw (- i 2)))
                  (decf first)
                  (incf last)))
              (when (= rfl +no+)
                (return-from segments))
              (setf cind (- i 1))))
          ;; load the knot vector and the control points
          (when (/= a p)
            (dotimes (i (- q oldr))
              (setf (aref uq kind) (aref up a))
              (incf kind)))
          (do ((i lbz (1+ i))) ((> i q))
            (declare (type fixnum i))
            (%copy-c-pt-row dw i qw cind)
            (incf cind))
          ;; initialize for the next pass
          (if (< b mp)
              (progn
                (dotimes (i r)
                  (%copy-c-pt-row nw i bw i))
                (do ((i r (1+ i))) ((> i p))
                  (declare (type fixnum i))
                  (%copy-c-pt-row pw (+ (- b p) i) bw i))
                (setf a b)
                (incf b)
                (incf spn))
              (dotimes (i (1+ q))
                (setf (aref uq (+ kind i)) (aref up b))))))
      (if (= rfl +yes+)
          (values +yes+ (%make-curve q uq qw) mtol)
          (values +no+ nil mtol)))))
