(define-oracle-test calc-circ-arc-derivs (:file "geom" :trials 3000)
  (let* ((o (random-point))
         (x (some-vector))
         (y (if (zerop (rnd 2)) (%perp-to x) (some-vector)))
         (r (case (rnd 6) (0 0d0) (t (rnd-range 0d0 50d0))))
         (ang (case (rnd 8)
                (0 0d0) (1 90d0) (2 180d0) (3 -270d0) (4 360d0)
                (t (rnd-range -720d0 720d0))))
         (k (rnd 10)))
    (agree (list o x y r ang k)
           (list (batten::calc-circ-arc-derivs o x y r ang k (make-point-array (1+ k))))
           (with-foreign ((op o :point) (xp x :point) (yp y :point))
             (with-foreign-out ((d :point-array (1+ k)))
               (c-calc-circ-arc-derivs op xp yp r ang k d)
               (values nil (list (from-foreign d :point-array (1+ k)))))))))
