(defun %line-pair ()
  "Two lines covering the branches of the line-line intersection: meeting
(within or beyond bounded ends), parallel, skew, or with a zero direction."
  (let* ((p1 (random-point)) (v1 (some-vector))
         (b1 (rnd 2)) (b2 (rnd 2)))
    (case (rnd 6)
      ((0 1)                            ; meeting at P1 + s*V1
       (let* ((s (case (rnd 4) (0 0d0) (1 1d0) (t (rnd-range -0.5d0 1.5d0))))
              (x (%pt+ p1 s v1))
              (v2 (random-point))
              (tt (case (rnd 4) (0 0d0) (1 1d0) (t (rnd-range -0.5d0 1.5d0)))))
         (values (batten::%make-lineseg p1 v1 b1)
                 (batten::%make-lineseg (%pt+ x (- tt) v2) v2 b2))))
      (2                                ; parallel
       (values (batten::%make-lineseg p1 v1 b1)
               (batten::%make-lineseg (random-point)
                                      (batten::vector-scale v1 (rnd-range -3d0 3d0) (make-point)) b2)))
      (t (values (batten::%make-lineseg p1 v1 b1)
                 (batten::%make-lineseg (random-point) (some-vector) b2))))))

(define-oracle-test isect-line-line (:file "geom" :trials 4000)
  (multiple-value-bind (l1 l2) (%line-pair)
    (agree (list l1 l2)
