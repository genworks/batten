      (values (random-point 1d0) (random-point 1d0) (random-point 1d0))
      (let* ((x (let ((x (make-point))) (batten::vector-normalize (random-point) x) x))
             (y (batten::vector-cross x (random-point) (make-point))))
        (batten::vector-normalize y y)
        (values x y (batten::vector-cross x y (make-point))))))

