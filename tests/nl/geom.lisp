      (let* ((o1 (random-point)) (o2 (if (zerop (rnd 5)) (copy-seq o1) (random-point)))
             ;; the output: NULL, an existing 4x4 or 5x5, or a too small 3x3
             (size (case (rnd 6) ((0 1 2) nil) ((3 4) 4) (t (if (zerop (rnd 2)) 5 3)))))
        (agree (list o1 x1 y1 z1 o2 x2 y2 z2 size)
               (let ((rma (if size
                              (batten::make-rmatrix (1- size) (1- size) (make-real-matrix size size)
                                                    +mt-full+ size)
                              (batten::make-rmatrix))))
                 (batten::create-transform-matrix-from-axes o1 x1 y1 z1 o2 x2 y2 z2 rma)
                 (list rma))
               (with-stacks (s)
                 (with-foreign ((op1 o1 :point) (xp1 x1 :point) (yp1 y1 :point) (zp1 z1 :point)
                                (op2 o2 :point) (xp2 x2 :point) (yp2 y2 :point) (zp2 z2 :point))
                   (with-foreign-out ((rm0 :rmatrix) (rmx :rmatrix (or size 1) (or size 1)))
                     (let* ((rm (if size rmx rm0))
                            (err (c-flag-error-p
                                  (c-create-transform-matrix-from-axes op1 xp1 yp1 zp1 op2 xp2 yp2 zp2 rm s))))
                       (values err (unless err
                                     (list (if size
                                               (from-foreign rm :rmatrix size size)
                                               (from-foreign rm :rmatrix))))))))))))))

