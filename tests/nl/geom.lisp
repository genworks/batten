;;; ------------------------------------------------------------ level 0, group 1

(defun %pt+ (p alpha v)
  "A fresh point P + ALPHA*V."
  (make-point (+ (aref p 0) (* alpha (aref v 0)))
              (+ (aref p 1) (* alpha (aref v 1)))
              (+ (aref p 2) (* alpha (aref v 2)))))

(defun %perp-to (v)
  "A fresh random vector perpendicular to V (zero when V is)."
  (batten::vector-cross v (random-point) (make-point)))

(defun %segment-case ()
  "Point P and segment AB as three values, covering the special cases of the
point-segment routines: degenerate segments, P at or near an end, P projecting
onto an end or beyond it, P on the segment, and P anywhere."
  (let* ((a (random-point)) (b (random-point)) (ba (batten::vector-diff b a (make-point))))
    (case (rnd 12)
      (0 (values (random-point) a (%pt+ a 1d-9 (random-point 1d0))))
      (1 (values (random-point) a (copy-seq a)))
      (2 (values (%pt+ a 1d-9 (random-point 1d0)) a b))
      (3 (values (copy-seq b) a b))
      (4 (values (%pt+ a 1d0 (%perp-to ba)) a b))
      (5 (values (%pt+ b 1d0 (%perp-to ba)) a b))
      (6 (values (%pt+ a (rnd-range 0d0 1d0) ba) a b))
      (7 (values (%pt+ (%pt+ a (rnd-range -1d0 2d0) ba) 1d0 (%perp-to ba)) a b))
      (8 (values (%pt+ a (rnd-range -2d0 0d0) ba) a b))
      (9 (values (%pt+ a (rnd-range 1d0 3d0) ba) a b))
      (t (values (random-point) a b)))))

(defun %random-lineseg ()
  (batten::%make-lineseg (random-point) (some-vector) (rnd 2)))

(defun %random-plane ()
  (batten::%make-plane (random-point) (some-vector)))

;;; TO-FOREIGN's :lineseg and :plane branches call LINESEG-P / PLANE-P
;;; unqualified in BATTEN-ORACLE, where they are undefined (BATTEN does not
;;; export them), so these fill an empty foreign struct from WITH-FOREIGN-OUT.
(defun %fill-foreign-lineseg (ptr lsg)
  (let ((p (batten::lineseg-p lsg)) (v (batten::lineseg-v lsg)))
    (batten-oracle::put-doubles ptr 0 (aref p 0) (aref p 1) (aref p 2) (aref v 0) (aref v 1) (aref v 2))
    (setf (cffi:foreign-slot-value ptr '(:struct batten-oracle::nl-lineseg) 'batten-oracle::bounded)
          (batten::lineseg-bounded lsg))
    ptr))

(defun %fill-foreign-plane (ptr pln)
  (let ((p (batten::plane-p pln)) (n (batten::plane-n pln)))
    (batten-oracle::put-doubles ptr 0 (aref p 0) (aref p 1) (aref p 2) (aref n 0) (aref n 1) (aref n 2))
    ptr))

