;;;; Differential tests for src/nl/crv-common.lisp against NLib.

(in-package :batten-tests)

;;; ------------------------------------------------------------ level 2, group 5

(defun %cc-arc-input ()
  "Random arc data (list c x y r as ae at): axes orthogonal, nearly so, or
just not parallel, now and then unnormalized or zero; angles anywhere, with
sweeps near the 90/120/180/240/270/360 degree breaks, tiny sweeps and full
circles."
  (let* ((c (random-point))
         (x (random-point (if (zerop (rnd 3)) 1d0 50d0)))
         (y (let ((v (random-point 1d0)))
              ;; Gram-Schmidt against X, fully or partly
              (let* ((xx (+ (* (aref x 0) (aref x 0)) (* (aref x 1) (aref x 1)) (* (aref x 2) (aref x 2))))
                     (dot (+ (* (aref x 0) (aref v 0)) (* (aref x 1) (aref v 1)) (* (aref x 2) (aref v 2))))
                     (f (case (rnd 3) (0 0.7d0) (t 1d0)))
                     (s (* f (/ dot xx))))
                (dotimes (k 3) (setf (aref v k) (- (aref v k) (* s (aref x k)))))
                (when (zerop (rnd 2))
                  (dotimes (k 3) (setf (aref v k) (* 30d0 (aref v k)))))
                v)))
         (r (case (rnd 8) (0 0d0) (1 (- (rnd 10d0))) (t (rnd 100d0))))
         (as (case (rnd 4) (0 0d0) (1 (float (* 90 (- (rnd 9) 4)) 1d0)) (t (- (rnd 1440d0) 720d0))))
         (sweep (case (rnd 12)
                  (0 0d0)
                  (1 360d0)
                  (2 (+ 1d-6 (rnd 1d-4)))
                  (3 (+ 360d0 (- (rnd 0.05d0) 0.025d0)))
                  (4 (+ (float (* 30 (1+ (rnd 12))) 1d0) (- (rnd 2d0) 1d0)))
                  (5 (- (rnd 1440d0) 720d0))
                  (t (rnd 360d0))))
         (ae (+ as sweep))
         (at (case (rnd 4) (0 0.01d0) (1 0d0) (2 1d0) (t (rnd 5d0)))))
    (case (rnd 40)
      (0 (setf x (make-point)))
      (1 (setf y (make-point))))
    (list c x y r as ae at)))

(defmacro %cc-arc-test (lisp-fn c-fn)
  `(destructuring-bind (c x y r as ae at) (%cc-arc-input)
     (agree (list :c c :x x :y y :r r :as as :ae ae :at at)
            (let ((xc (copy-seq x)) (yc (copy-seq y)))
              (list (,lisp-fn c xc yc r as ae at)
                    ;; the axes are the caller's: they come back untouched
                    (equalp xc x) (equalp yc y)))
            (with-stacks (s)
              (with-foreign ((fc c :point) (fx x :point) (fy y :point))
                (with-foreign-out ((cur :curve))
                  (let ((rc (,c-fn fc fx fy r as ae at cur s)))
                    (values (c-flag-error-p rc)
                            (unless (c-flag-error-p rc)
                              (list (from-foreign cur :curve) t t))))))))))

(define-oracle-test create-quadratic-arc-tol (:file "crv-common" :trials 4000)
  (%cc-arc-test batten::create-quadratic-arc-tol c-create-quadratic-arc-tol))

(define-oracle-test create-quartic-arc-tol (:file "crv-common" :trials 4000)
  (%cc-arc-test batten::create-quartic-arc-tol c-create-quartic-arc-tol))

;;; ------------------------------------------------------------ level 3, group 5

(define-oracle-test create-quintic-arc-tol (:file "crv-common" :trials 3000)
  (%cc-arc-test batten::create-quintic-arc-tol c-create-quintic-arc-tol))

(defun %cc-conic-input ()
  "Inputs for N_CreateConicArc, as (list P0 T0 P2 T2 P): a conic arc of
middle weight from -0.95 to 6 (P on it, tangents along the control
triangle, scaled or reversed), parallel tangents, zero tangents, random
points, or P at an end; planar a third of the time."
  (let* ((planar (zerop (rnd 3)))
         (pt (lambda () (let ((q (random-point))) (when planar (setf (aref q 2) 0d0)) q)))
         (p0 (funcall pt)) (p2 (funcall pt)) (p1 (funcall pt))
         (lin (lambda (a x b y) (make-point (+ (* a (aref x 0)) (* b (aref y 0)))
                                            (+ (* a (aref x 1)) (* b (aref y 1)))
                                            (+ (* a (aref x 2)) (* b (aref y 2)))))))
    (case (rnd 12)
      ((0 1 2 3 4)                       ; a conic arc
       (let* ((w (case (rnd 6)
                   (0 (rnd-range -0.95d0 0d0))
                   (1 (rnd-range 1d0 6d0))
                   (2 1d0)
                   (t (rnd-range 0.02d0 1d0))))
              (u (case (rnd 8) (0 0.5d0) (t (rnd-range 0.05d0 0.95d0))))
              (a (* (- 1d0 u) (- 1d0 u))) (b (* 2d0 u (- 1d0 u) w)) (c (* u u))
              (d (+ a b c))
              (sc (rnd-range 0.2d0 3d0))
              (q (make-point (/ (+ (* a (aref p0 0)) (* b (aref p1 0)) (* c (aref p2 0))) d)
                             (/ (+ (* a (aref p0 1)) (* b (aref p1 1)) (* c (aref p2 1))) d)
                             (/ (+ (* a (aref p0 2)) (* b (aref p1 2)) (* c (aref p2 2))) d))))
         (when (zerop (rnd 4))
           ;; a sharp (or obtuse) control triangle: P1 near the chord's middle
           ;; or far out
           (setf p1 (funcall lin 0.5d0 (funcall lin 1d0 p0 1d0 p2) (rnd-range -0.3d0 0.3d0) p1)))
         (list p0 (funcall lin sc p1 (- sc) p0)
               p2 (funcall lin (if (zerop (rnd 6)) -1d0 1d0) p2 -1d0 p1) q)))
      ((5 6)                             ; parallel tangents
       (let* ((tv (funcall pt))
              (s (case (rnd 6) (0 0d0) (1 1d0) (t (rnd 1d0))))
              (k (rnd-range -2d0 2d0)))
         (list p0 tv p2 (funcall lin (if (zerop (rnd 2)) 1d0 -1.5d0) tv 0d0 tv)
               (funcall lin 1d0 (funcall lin (- 1d0 s) p0 s p2) k tv))))
      (7 (list p0 (funcall pt) p2 (funcall pt) (funcall pt)))
      (8 (list p0 (make-point) p2 (funcall pt) (funcall pt)))
      (9 (list p0 (funcall pt) p2 (make-point) (funcall pt)))
      (t (list p0 (funcall lin 1d0 p1 -1d0 p0) p2 (funcall lin 1d0 p2 -1d0 p1)
               (if (zerop (rnd 2)) (copy-seq p2) (copy-seq p0)))))))

(define-oracle-test create-conic-arc (:file "crv-common" :trials 5000)
  (destructuring-bind (p0 t0 p2 t2 p) (%cc-conic-input)
    (agree (list :p0 p0 :t0 t0 :p2 p2 :t2 t2 :p p)
           (list (batten::create-conic-arc p0 t0 p2 t2 p))
           (with-stacks (s)
             (with-foreign ((a p0 :point) (b t0 :point) (c p2 :point) (d t2 :point) (e p :point))
               (with-foreign-out ((cur :curve))
                 (let ((rc (c-create-conic-arc a b c d e cur s)))
                   (values (c-flag-error-p rc)
                           (unless (c-flag-error-p rc)
                             (list (from-foreign cur :curve)))))))))))

;;; ------------------------------------------------------------- L4-g0

(define-oracle-test create-circ-arc-tol (:file "crv-common" :trials 4000)
  (destructuring-bind (c x y r as ae at) (%cc-arc-input)
    ;; mostly the three kinds; now and then cubic or garbage (:cal-err)
    (let ((ctp (case (rnd 20) (0 +cubic+) (1 (- (rnd 10) 3)) (t (elt (list +quadratic+ +quartic+ +quintic+) (rnd 3))))))
      (agree (list :c c :x x :y y :r r :as as :ae ae :at at :ctp ctp)
             (let ((xc (copy-seq x)) (yc (copy-seq y)))
               (list (batten::create-circ-arc-tol c xc yc r as ae at ctp)
                     (equalp xc x) (equalp yc y)))
             (with-stacks (s)
               (with-foreign ((fc c :point) (fx x :point) (fy y :point))
                 (with-foreign-out ((cur :curve))
                   (let ((rc (c-create-circ-arc-tol fc fx fy r as ae at ctp cur s)))
                     (values (c-flag-error-p rc)
                             (unless (c-flag-error-p rc)
                               (list (from-foreign cur :curve) t t)))))))))))

;;; ------------------------------------------------------------- L5-g0

(defun %cc-ctp ()
  "Mostly the three conic kinds; now and then cubic or garbage (:cal-err)."
  (case (rnd 20)
    (0 +cubic+)
    (1 (- (rnd 10) 3))
    (t (elt (list +quadratic+ +quartic+ +quintic+) (rnd 3)))))

(define-oracle-test create-circ-arc (:file "crv-common" :trials 4000)
  (destructuring-bind (c x y r as ae at) (%cc-arc-input)
    (declare (ignore at))
    (let ((ctp (%cc-ctp)))
      (agree (list :c c :x x :y y :r r :as as :ae ae :ctp ctp)
             (let ((xc (copy-seq x)) (yc (copy-seq y)))
               (list (batten::create-circ-arc c xc yc r as ae ctp)
                     (equalp xc x) (equalp yc y)))
             (with-stacks (s)
               (with-foreign ((fc c :point) (fx x :point) (fy y :point))
                 (with-foreign-out ((cur :curve))
                   (let ((rc (c-create-circ-arc fc fx fy r as ae ctp cur s)))
                     (values (c-flag-error-p rc)
                             (unless (c-flag-error-p rc)
                               (list (from-foreign cur :curve) t t)))))))))))

(define-oracle-test create-elliptical-arc-ang-type-tol (:file "crv-common" :trials 4000)
  (destructuring-bind (c x y r1 as ae at) (%cc-arc-input)
    ;; no zero radius: R2 or R1 zero makes both end angles 0/0, a NaN sweep
    ;; the C fails on (and Batten's vector-normalize crashes on)
    (let* ((r1 (if (and (zerop (rnd 10)) (/= r1 0d0)) r1 (rnd-range 0.5d0 80d0)))
           (r2 (case (rnd 10)
                 (0 r1)
                 (1 (* r1 (rnd-range 1d-4 1d-2)))
                 (2 (* r1 (rnd-range 1d0 3d0)))
                 (3 (- -0.1d0 (rnd 10d0)))
                 (t (* r1 (rnd-range 0.05d0 1d0)))))
           (atp (case (rnd 6) (0 0) (1 1) (2 (rnd 5)) (t (rnd 2))))
           (ctp (%cc-ctp)))
      (agree (list :c c :x x :y y :r1 r1 :r2 r2 :as as :ae ae :at at :atp atp :ctp ctp)
             (let ((xc (copy-seq x)) (yc (copy-seq y)))
               (list (batten::create-elliptical-arc-ang-type-tol c xc yc r1 r2 as ae at atp ctp)
                     (equalp xc x) (equalp yc y)))
             (with-stacks (s)
               (with-foreign ((fc c :point) (fx x :point) (fy y :point))
                 (with-foreign-out ((cur :curve))
                   (let ((rc (c-create-elliptical-arc-ang-type-tol fc fx fy r1 r2 as ae at atp ctp cur s)))
                     (values (c-flag-error-p rc)
                             (unless (c-flag-error-p rc)
                               (list (from-foreign cur :curve) t t)))))))))))

;;; ------------------------------------------------------------- L6-g1

(define-oracle-test calc-circ-weights (:file "crv-common" :trials 4000)
  (destructuring-bind (c x y r as ae at) (%cc-arc-input)
    (declare (ignore c x y r at))
    (let ((ctp (%cc-ctp)))
      (agree (list :as as :ae ae :ctp ctp)
             (let* ((w (make-array 64 :element-type 'double-float :initial-element 0d0))
                    (k (batten::calc-circ-weights as ae ctp w)))
               (list k (coerce (subseq w 0 (1+ k)) 'list)))
             (with-foreign ()
               (let ((w (batten-oracle::falloc :double 64)))
                 (with-scalars ((k :long))
                   (let ((rc (c-calc-circ-weights as ae ctp w k)))
                     (values (c-flag-error-p rc)
                             (unless (c-flag-error-p rc)
                               (let ((kk (cffi:mem-ref k :long)) (out nil))
                                 (dotimes (i (1+ kk))
                                   (push (cffi:mem-aref w :double i) out))
                                 (list kk (nreverse out)))))))))))))

