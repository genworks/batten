(define-oracle-test crvs-make-rat-compatible (:file "crv-basic" :trials 2000)
  (let* ((k (rnd 5))
         (rat (case (rnd 3) (0 nil) (1 t) (t :random)))
         (two-d (case (rnd 3) (0 nil) (1 t) (t :random)))
         (curves (make-array (1+ k))))
    (dotimes (i (1+ k))
      (setf (svref curves i) (random-curve :rational rat :two-d two-d :max-extra 6)))
    (agree (list :curves curves :k k)
           (let ((copies (map 'simple-vector #'batten::crv-copy curves)))
             (batten::crvs-make-rat-compatible copies k)
             (coerce copies 'list))
           (with-foreign ()
             (let ((arr (batten-oracle::falloc :pointer (1+ k))))
               (dotimes (i (1+ k))
                 (setf (cffi:mem-aref arr :pointer i)
                       (batten-oracle::to-foreign (svref curves i) :curve)))
               (c-crvs-make-rat-compatible arr k)
               (values nil (let (out)
                             (dotimes (i (1+ k) (nreverse out))
                               (push (from-foreign (cffi:mem-aref arr :pointer i) :curve) out)))))))))

(defun %planar-curve (tol)
  "A random curve whose Euclidean control points lie near a random plane,
off it by some multiple of TOL; now and then 2D, a line, a point, or with
fewer than three control points."
  (let* ((c (case (rnd 10)
              (0 (random-curve :max-degree 1 :max-extra 1))
              (t (random-curve))))
         (pw (curve-cpoints c))
         (n (1- (array-dimension pw 0)))
         (o (random-point))
         (u (random-point 1d0)) (v (random-point 1d0))
         (nv (make-point))
         (noise (case (rnd 4) (0 0d0) (1 (* 0.4d0 tol)) (2 (* 0.9d0 tol)) (t (* 3d0 tol))))
         (shape (rnd 12)))
    (batten::vector-cross u v nv)
    (let ((mag (batten::vector-magnitude nv)))
      (when (> mag 0d0) (batten::vector-scale nv (/ 1d0 mag) nv)))
    (dotimes (i (1+ n))
      (let* ((s (case shape (0 0d0) (t (- (rnd 200d0) 100d0))))
             (tt (case shape ((0 1) 0d0) (t (- (rnd 200d0) 100d0))))
             (e (- (rnd (* 2 noise)) noise))
             (w (if (= (aref pw i 3) +no-w+) 1d0 (aref pw i 3)))
             (two-d (= (aref pw i 2) +no-z+)))
        (setf (aref pw i 0) (* w (+ (aref o 0) (* s (aref u 0)) (* tt (aref v 0)) (* e (aref nv 0))))
              (aref pw i 1) (* w (+ (aref o 1) (* s (aref u 1)) (* tt (aref v 1)) (* e (aref nv 1)))))
        (unless two-d
          (setf (aref pw i 2) (* w (+ (aref o 2) (* s (aref u 2)) (* tt (aref v 2)) (* e (aref nv 2))))))))
    (when (and (> n 1) (zerop (rnd 3)))
      ;; repeated control points (zero edge vectors) and collinear runs
      (dotimes (r (1+ (rnd 3)))
        (let ((i (rnd n)))
          (if (zerop (rnd 2))
              (dotimes (k 4) (setf (aref pw (1+ i) k) (aref pw i k)))
              (when (< (1+ i) n)
                (let ((wi (if (= (aref pw i 3) +no-w+) 1d0 (aref pw i 3)))
                      (wj (if (= (aref pw (+ i 2) 3) +no-w+) 1d0 (aref pw (+ i 2) 3)))
                      (wm (if (= (aref pw (1+ i) 3) +no-w+) 1d0 (aref pw (1+ i) 3))))
                  (dotimes (k (if (= (aref pw i 2) +no-z+) 2 3))
                    (setf (aref pw (1+ i) k)
                          (* wm (* 0.5d0 (+ (/ (aref pw i k) wi) (/ (aref pw (+ i 2) k) wj))))))))))))
    c))

(define-oracle-test crv-is-planar (:file "crv-basic" :trials 4000)
  (let* ((tol (case (rnd 4) (0 1d-3) (1 1d-6) (2 0.5d0) (t 0d0)))
         (c (case (rnd 6)
              (0 (random-curve))
              (1 (%line-curve (if (zerop tol) 1d-6 tol)))
              (2 (%degenerate-curve))
              (t (%planar-curve (if (zerop tol) 1d-6 tol))))))
    (agree (list :curve c :tol tol)
           (let* ((pp (make-point)) (nn (make-point))
                  (flt (batten::crv-is-planar c tol pp nn)))
             (list flt pp nn))
           (with-stacks (s)
             (with-foreign ((cp c :curve))
               (with-foreign-out ((pp :point) (nn :point))
                 (with-scalars ((flt :short))
                   (let ((rc (c-crv-is-planar cp tol pp nn flt s)))
                     (values (c-flag-error-p rc)
                             (list (cffi:mem-ref flt :short)
                                   (from-foreign pp :point) (from-foreign nn :point)))))))))))
