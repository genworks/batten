(define-oracle-test is-crv-rat (:file "crv-basic" :trials 1000)
  (let ((c (random-curve)))
    (agree c
           (list (if (batten::is-crv-rat c) 1 0))
           (with-foreign ((cp c :curve))
             (values nil (list (c-is-crv-rat cp)))))))

