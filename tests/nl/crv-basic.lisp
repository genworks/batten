(define-oracle-test crv-reparam-to-interval (:file "crv-basic" :trials 2000)
  (let* ((c (random-curve))
         (u (curve-knots c))
         (u0 (aref u 0)) (um (aref u (1- (length u))))
         (a (if (zerop (rnd 4)) u0 (- (rnd 20d0) 10d0)))
         (b (case (rnd 4) (0 um) (1 (+ a (rnd 1d-3))) (t (+ a 0.01d0 (rnd 20d0)))))
         (iv (make-array 2 :element-type 'double-float :initial-contents (list a b))))
    (agree (list :curve c :i iv)
           (list (batten::crv-reparam-to-interval (batten::crv-copy c) iv))
           (with-foreign ((cp c :curve) (fi iv :interval))
             (c-crv-reparam-to-interval cp fi)
             (values nil (list (from-foreign cp :curve)))))))

