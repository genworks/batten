(define-oracle-test crv-from-c-pts-and-knots (:file "crv-basic" :trials 1000)
  ;; N and M are the arrays' highest indexes, or now and then smaller ones
  (let* ((c (random-curve))
         (pw (curve-cpoints c)) (u (curve-knots c)) (p (curve-degree c))
         (n (if (zerop (rnd 3)) (rnd (array-dimension pw 0)) (1- (array-dimension pw 0))))
         (m (if (zerop (rnd 3)) (rnd (length u)) (1- (length u)))))
    (agree (list :pw pw :n n :p p :u u :m m)
           (list (batten::crv-from-c-pts-and-knots
                  (%make-curve 0 (make-real-vector 0) (make-cpoint-array 0)) pw n p u m))
           (with-stacks (s)
             (with-foreign ((fpw pw :cpoint-array) (fu u :real-vector))
               (with-foreign-out ((cur :curve))
                 (let ((rc (c-crv-from-c-pts-and-knots cur fpw n p fu m s)))
                   (values (c-flag-error-p rc)
                           (list (from-foreign cur :curve))))))))))

(define-oracle-test crv-compress (:file "crv-basic" :trials 1000)
  ;; the C frees the old arrays on SG; they are not on the fresh stack, so
  ;; the frees find nothing and the foreign copies stay WITH-FOREIGN's to free
  (let ((c (random-curve)))
    (agree c
           (list (batten::crv-compress (batten::crv-copy c)))
           (with-stacks (s)
             (with-foreign ((cp c :curve))
               (let ((rc (c-crv-compress cp s)))
                 (values (c-flag-error-p rc) (list (from-foreign cp :curve)))))))))

(defun %line-curve (tol)
  "A random curve whose control points lie near a line from A to B, within
some multiple of TOL, with interior points now and then beyond the ends; A
and B now and then coincide or lie within TOL of each other."
  (let* ((c (random-curve))
         (pw (curve-cpoints c))
         (n (1- (array-dimension pw 0)))
         (a (random-point))
         (b (case (rnd 6)
              (0 (make-point (aref a 0) (aref a 1) (aref a 2)))
              (1 (make-point (+ (aref a 0) (* tol (rnd 0.9d0))) (aref a 1) (aref a 2)))
              (t (random-point))))
         (noise (case (rnd 4) (0 0d0) (1 (* 0.4d0 tol)) (2 (* 0.9d0 tol)) (t (* 3d0 tol))))
         (beyond (zerop (rnd 4))))
    (dotimes (i (1+ n) c)
      (let* ((s (cond ((= i 0) 0d0)
                      ((= i n) 1d0)
                      (beyond (- (rnd 1.2d0) 0.1d0))
                      (t (rnd 1d0))))
             (w (if (= (aref pw i 3) +no-w+) 1d0 (aref pw i 3)))
             (two-d (= (aref pw i 2) +no-z+))
             (x (+ (aref a 0) (* s (- (aref b 0) (aref a 0))) (if (< 0 i n) (- (rnd (* 2 noise)) noise) 0d0)))
             (y (+ (aref a 1) (* s (- (aref b 1) (aref a 1))) (if (< 0 i n) (- (rnd (* 2 noise)) noise) 0d0)))
             (z (+ (aref a 2) (* s (- (aref b 2) (aref a 2))) (if (< 0 i n) (- (rnd (* 2 noise)) noise) 0d0))))
        (setf (aref pw i 0) (* w x)
              (aref pw i 1) (* w y))
        (unless two-d (setf (aref pw i 2) (* w z)))))))

(define-oracle-test crv-is-line (:file "crv-basic" :trials 4000)
  (let* ((tol (case (rnd 4) (0 1d-3) (1 1d-6) (2 0.5d0) (t 0d0)))
         (c (if (zerop (rnd 5)) (random-curve) (%line-curve (if (zerop tol) 1d-6 tol)))))
    (agree (list :curve c :tol tol)
           (list (if (batten::crv-is-line c tol) 1 0))
           (with-foreign ((cp c :curve))
             (values nil (list (c-crv-is-line cp tol)))))))

(defun %compatible-curves (k)
  "K+1 random curves, usually alike in rationality, dimension, indexes and
knots (the knots now and then nudged by about *ptol*), now and then not."
  (let* ((c0 (random-curve))
         (p (curve-degree c0))
         (n+1 (array-dimension (curve-cpoints c0) 0))
         (rat (batten::is-crv-rat c0))
         (two-d (not (batten::crv-is-3d c0)))
         (v (make-array (1+ k))))
    (setf (svref v 0) c0)
    (do ((i 1 (1+ i))) ((> i k) v)
      (setf (svref v i)
            (case (rnd 12)
              (0 (random-curve))
              (1 (%make-curve p (copy-seq (curve-knots c0)) (%random-cpoints-like n+1 two-d (not rat))))
              (2 (%make-curve p (copy-seq (curve-knots c0)) (%random-cpoints-like n+1 (not two-d) rat)))
              (3 (let ((u (copy-seq (curve-knots c0))))
                   (setf (aref u (rnd (length u)))
                         (+ (aref u (rnd (length u))) (case (rnd 3) (0 5d-13) (1 2d-12) (t 1d-6))))
                   (%make-curve p u (%random-cpoints-like n+1 two-d rat))))
              (t (%make-curve p (copy-seq (curve-knots c0)) (%random-cpoints-like n+1 two-d rat))))))))

(define-oracle-test crvs-are-combatible (:file "crv-basic" :trials 3000)
  (let* ((k (rnd 5)) (curves (%compatible-curves k)))
    (agree (list :curves curves :k k)
           (list (if (batten::crvs-are-combatible curves k) 1 0))
           (with-foreign ()
             (let ((arr (batten-oracle::falloc :pointer (1+ k))))
               (dotimes (i (1+ k))
                 (setf (cffi:mem-aref arr :pointer i)
                       (batten-oracle::to-foreign (svref curves i) :curve)))
               (values nil (list (c-crvs-are-combatible arr k))))))))

