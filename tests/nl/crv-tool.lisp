;;;; Differential tests for src/nl/crv-tool.lisp against NLib.

(in-package :batten-tests)

(defun %crv-tool-knots (p n+1 lo hi &key (full 4))
  "A clamped knot vector for N+1 control points of degree P on [LO, HI] whose
interior knots come in runs: of multiplicity P about one time in FULL, P-1
now and then, else 1."
  (let ((left (- n+1 p 1)) (interior nil))
    (do () ((<= left 0))
      (let ((v (+ lo (* (- hi lo) (+ 0.02d0 (rnd 0.96d0)))))
            (mult (min left (case (rnd full)
                              (0 p)
                              (1 (max 1 (1- p)))
                              (t 1)))))
        (dotimes (k mult) (push v interior))
        (decf left mult)))
    (coerce (append (make-list (1+ p) :initial-element lo)
                    (sort interior #'<)
                    (make-list (1+ p) :initial-element hi))
            'real-vector)))

(defun %crv-tool-curve (&key (full 4) (min-extra 0))
  "A random curve (rational or not, 2D now and then) with knots from
%CRV-TOOL-KNOTS and at least MIN-EXTRA interior knots."
  (let* ((c (random-curve :max-degree 7 :max-extra 12))
         (p (curve-degree c))
         (knots (curve-knots c))
         (lo (aref knots 0))
         (hi (aref knots (1- (length knots))))
         (pw (curve-cpoints c)))
    (when (< (- (curve-n c) p) min-extra)
      (let ((more (make-cpoint-array (+ p 1 min-extra))))
        (dotimes (i (array-dimension more 0))
          (dotimes (k 4)
            (setf (aref more i k)
                  (if (< i (array-dimension pw 0))
                      (aref pw i k)
                      (if (= k 3)
                          (aref pw 0 3)
                          (if (and (= k 2) (= (aref pw 0 2) +no-z+))
                              +no-z+
                              (* (if (= (aref pw 0 3) +no-w+) 1d0 (aref pw 0 3))
                                 (- (rnd 200d0) 100d0))))))))
        (setf pw more)))
    (%make-curve p (%crv-tool-knots p (array-dimension pw 0) lo hi :full full) pw)))

(define-oracle-test crv-decompose-continuity (:file "crv-tool" :trials 3000)
  (let ((c (%crv-tool-curve :full (+ 2 (rnd 4)))))
    (agree (list :curve c)
           (multiple-value-bind (curves k) (batten::crv-decompose-continuity c)
             (list k (coerce curves 'list)))
           (with-foreign ((cp c :curve))
             (with-stacks (sq)
               (with-scalars ((k :long))
                 (cffi:with-foreign-object (cq :pointer)
                   (setf (cffi:mem-ref cq :pointer) (cffi:null-pointer))
                   (if (c-flag-error-p (c-crv-decompose-continuity cp cq k sq))
                       (values t nil)
                       (let ((kk (cffi:mem-ref k :long))
                             (arr (cffi:mem-ref cq :pointer))
                             (curves nil))
                         (dotimes (i (1+ kk))
                           (push (from-foreign (cffi:mem-aref arr :pointer i) :curve) curves))
                         (values nil (list kk (nreverse curves))))))))))))

(define-oracle-test crv-decompose-bez (:file "crv-tool" :trials 3000)
  (let ((c (if (zerop (rnd 2)) (%crv-tool-curve :full (+ 2 (rnd 4))) (random-curve))))
    (agree (list :curve c)
           (multiple-value-bind (curves k) (batten::crv-decompose-bez c)
             (list k (coerce curves 'list)))
           (with-foreign ((cp c :curve))
             (with-stacks (sq)
               (with-scalars ((k :long) (cq :pointer))
                 (if (c-flag-error-p (c-crv-decompose-bez cp cq k sq))
                     (values t nil)
                     (let ((kk (cffi:mem-ref k :long))
                           (arr (cffi:mem-ref cq :pointer))
                           (curves nil))
                       (dotimes (i (1+ kk))
                         (push (from-foreign (cffi:mem-aref arr :pointer i) :curve) curves))
                       (values nil (list kk (nreverse curves)))))))))))

(defun %crv-tool-knot-runs (knots p)
  "The interior knot runs of KNOTS (degree P) as a list of (value last-index
multiplicity)."
  (let ((m (1- (length knots))) (runs nil))
    (do ((i (1+ p))) ((>= i (- m p)) (nreverse runs))
      (let ((j i))
        (do () ((not (and (< (1+ j) (- m p)) (= (aref knots (1+ j)) (aref knots i)))))
          (incf j))
        (push (list (aref knots i) j (1+ (- j i))) runs)
        (setf i (1+ j))))))

(defun %crv-tool-refinement (c)
  "A knot vector to refine curve C with: non-decreasing, strictly inside the
domain, keeping every multiplicity at most the degree; empty or touching an
end now and then, for the error paths."
  (let* ((knots (curve-knots c))
         (p (curve-degree c))
         (lo (aref knots 0))
         (hi (aref knots (1- (length knots))))
         (runs (%crv-tool-knot-runs knots p))
         (count (1+ (rnd 9)))
         (x nil))
    (case (rnd 20)
      (0 (return-from %crv-tool-refinement (make-real-vector 0)))
      (1 (push lo x))
      (2 (push hi x)))
    (do () ((<= count 0))
      (let ((run (and runs (zerop (rnd 3)) (nth (rnd (length runs)) runs))))
        (if (and run (< (third run) p))
            (let ((k (min count (1+ (rnd (- p (third run)))))))
              (dotimes (i k) (push (first run) x))
              (setf (third run) (+ (third run) k))
              (decf count k))
            (let ((v (+ lo (* (- hi lo) (+ 0.01d0 (rnd 0.98d0)))))
                  (k (min count (1+ (rnd p)))))
              (dotimes (i k) (push v x))
              (decf count k)))))
    (coerce (sort x #'<) 'real-vector)))

(define-oracle-test crv-refine (:file "crv-tool" :trials 3000)
  (let* ((c (if (zerop (rnd 2)) (random-curve) (%crv-tool-curve)))
         (x (%crv-tool-refinement c)))
    (agree (list :curve c :knx x)
           (list (batten::crv-refine c x))
           (with-foreign ((cp c :curve) (kx x :knots))
             (with-foreign-out ((cq :curve))
               (with-stacks (sp)
                 (with-stacks (sq)
                   (if (c-flag-error-p (c-crv-refine cp kx cq sp sq))
                       (values t nil)
                       (values nil (list (from-foreign cq :curve)))))))))))

(defun %crv-tool-insertion (c)
  "A knot and a count to insert it into curve C with: usually a new interior
value or an existing interior knot with room to spare, now and then an end
of the domain, a negative count or one too many, for the error paths."
  (let* ((knots (curve-knots c))
         (p (curve-degree c))
         (lo (aref knots 0))
         (hi (aref knots (1- (length knots))))
         (runs (%crv-tool-knot-runs knots p))
         (u (case (rnd 12)
              (0 lo)
              (1 hi)
              ((2 3 4) (if runs (first (nth (rnd (length runs)) runs)) (rnd-range lo hi)))
              (t (rnd-range lo hi))))
         (mult (count u knots :test #'=))
         (r (case (rnd 20)
              (0 -1)
              (1 (+ (- p mult) 1))
              (t (rnd (+ (max 0 (- p mult)) 1))))))
    (values u r)))

(define-oracle-test crv-insert-knot (:file "crv-tool" :trials 4000)
  (let ((c (if (zerop (rnd 2)) (random-curve) (%crv-tool-curve))))
    (multiple-value-bind (u r) (%crv-tool-insertion c)
      (agree (list :curve c :u u :r r)
             (list (batten::crv-insert-knot c u r))
             (with-foreign ((cp c :curve))
               (with-foreign-out ((cq :curve))
                 (with-stacks (sp)
                   (with-stacks (sq)
                     (if (c-flag-error-p (c-crv-insert-knot cp u r cq sp sq))
                         (values t nil)
                         (values nil (list (from-foreign cq :curve))))))))))))

(defun %crv-tool-segment-end (knots runs)
  "A parameter for one end of a segment: an end of the domain, an interior
knot or a value inside."
  (let ((lo (aref knots 0))
        (hi (aref knots (1- (length knots)))))
    (case (rnd 10)
      (0 lo)
      (1 hi)
      ((2 3 4) (if runs (first (nth (rnd (length runs)) runs)) (rnd-range lo hi)))
      (t (rnd-range lo hi)))))

(define-oracle-test crv-extract-crv-seg (:file "crv-tool" :trials 4000)
  (let* ((c (if (zerop (rnd 2)) (random-curve) (%crv-tool-curve)))
         (knots (curve-knots c))
         (runs (%crv-tool-knot-runs knots (curve-degree c)))
         (a (%crv-tool-segment-end knots runs))
         (b (%crv-tool-segment-end knots runs))
         ;; mostly ordered; equal or reversed now and then, for the error path
         (ul (if (zerop (rnd 25)) (max a b) (min a b)))
         (ur (if (zerop (rnd 25)) (min a b) (max a b))))
    (agree (list :curve c :ul ul :ur ur)
           (list (batten::crv-extract-crv-seg c ul ur))
           (with-foreign ((cp c :curve))
             (with-foreign-out ((cq :curve))
               (with-stacks (sp)
                 (with-stacks (sq)
                   (if (c-flag-error-p (c-crv-extract-crv-seg cp ul ur cq sp sq))
                       (values t nil)
                       (values nil (list (from-foreign cq :curve)))))))))))

(define-oracle-test crv-remove-knot-max-err (:file "crv-tool" :trials 4000)
  (let* ((c (%crv-tool-curve :full (+ 2 (rnd 4)) :min-extra 1))
         (runs (%crv-tool-knot-runs (curve-knots c) (curve-degree c)))
         (run (nth (rnd (length runs)) runs))
         (r (second run))
         (s (third run)))
    (agree (list :curve c :r r :s s)
           (list (batten::crv-remove-knot-max-err c r s))
           (with-foreign ((cp c :curve))
             (with-scalars ((br :double))
               (values (c-flag-error-p (c-crv-remove-knot-max-err cp r s br))
                       (list (cffi:mem-ref br :double))))))))
