(defun %crv-tool-knot-runs (knots p)
  "The interior knot runs of KNOTS (degree P) as a list of (value last-index
multiplicity)."
  (let ((m (1- (length knots))) (runs nil))
    (do ((i (1+ p))) ((>= i (- m p)) (nreverse runs))
      (let ((j i))
        (do () ((not (and (< (1+ j) (- m p)) (= (aref knots (1+ j)) (aref knots i)))))
          (incf j))
        (push (list (aref knots i) j (1+ (- j i))) runs)
        (setf i (1+ j))))))

(defun %crv-tool-refinement (c)
  "A knot vector to refine curve C with: non-decreasing, strictly inside the
domain, keeping every multiplicity at most the degree; empty or touching an
end now and then, for the error paths."
  (let* ((knots (curve-knots c))
         (p (curve-degree c))
         (lo (aref knots 0))
         (hi (aref knots (1- (length knots))))
         (runs (%crv-tool-knot-runs knots p))
         (count (1+ (rnd 9)))
         (x nil))
    (case (rnd 20)
      (0 (return-from %crv-tool-refinement (make-real-vector 0)))
      (1 (push lo x))
      (2 (push hi x)))
    (do () ((<= count 0))
      (let ((run (and runs (zerop (rnd 3)) (nth (rnd (length runs)) runs))))
        (if (and run (< (third run) p))
            (let ((k (min count (1+ (rnd (- p (third run)))))))
              (dotimes (i k) (push (first run) x))
              (setf (third run) (+ (third run) k))
              (decf count k))
            (let ((v (+ lo (* (- hi lo) (+ 0.01d0 (rnd 0.98d0)))))
                  (k (min count (1+ (rnd p)))))
              (dotimes (i k) (push v x))
              (decf count k)))))
    (coerce (sort x #'<) 'real-vector)))

(define-oracle-test crv-refine (:file "crv-tool" :trials 3000)
  (let* ((c (if (zerop (rnd 2)) (random-curve) (%crv-tool-curve)))
         (x (%crv-tool-refinement c)))
    (agree (list :curve c :knx x)
           (list (batten::crv-refine c x))
           (with-foreign ((cp c :curve) (kx x :knots))
             (with-foreign-out ((cq :curve))
               (with-stacks (sp)
                 (with-stacks (sq)
                   (if (c-flag-error-p (c-crv-refine cp kx cq sp sq))
                       (values t nil)
                       (values nil (list (from-foreign cq :curve)))))))))))

(defun %crv-tool-insertion (c)
  "A knot and a count to insert it into curve C with: usually a new interior
value or an existing interior knot with room to spare, now and then an end
of the domain, a negative count or one too many, for the error paths."
  (let* ((knots (curve-knots c))
         (p (curve-degree c))
         (lo (aref knots 0))
         (hi (aref knots (1- (length knots))))
         (runs (%crv-tool-knot-runs knots p))
         (u (case (rnd 12)
              (0 lo)
              (1 hi)
              ((2 3 4) (if runs (first (nth (rnd (length runs)) runs)) (rnd-range lo hi)))
              (t (rnd-range lo hi))))
         (mult (count u knots :test #'=))
         (r (case (rnd 20)
              (0 -1)
              (1 (+ (- p mult) 1))
              (t (rnd (+ (max 0 (- p mult)) 1))))))
    (values u r)))

(define-oracle-test crv-insert-knot (:file "crv-tool" :trials 4000)
  (let ((c (if (zerop (rnd 2)) (random-curve) (%crv-tool-curve))))
    (multiple-value-bind (u r) (%crv-tool-insertion c)
      (agree (list :curve c :u u :r r)
             (list (batten::crv-insert-knot c u r))
             (with-foreign ((cp c :curve))
               (with-foreign-out ((cq :curve))
                 (with-stacks (sp)
                   (with-stacks (sq)
                     (if (c-flag-error-p (c-crv-insert-knot cp u r cq sp sq))
                         (values t nil)
                         (values nil (list (from-foreign cq :curve))))))))))))

(defun %crv-tool-segment-end (knots runs)
  "A parameter for one end of a segment: an end of the domain, an interior
knot or a value inside."
  (let ((lo (aref knots 0))
        (hi (aref knots (1- (length knots)))))
    (case (rnd 10)
      (0 lo)
      (1 hi)
      ((2 3 4) (if runs (first (nth (rnd (length runs)) runs)) (rnd-range lo hi)))
      (t (rnd-range lo hi)))))

(define-oracle-test crv-extract-crv-seg (:file "crv-tool" :trials 4000)
  (let* ((c (if (zerop (rnd 2)) (random-curve) (%crv-tool-curve)))
         (knots (curve-knots c))
         (runs (%crv-tool-knot-runs knots (curve-degree c)))
         (a (%crv-tool-segment-end knots runs))
         (b (%crv-tool-segment-end knots runs))
         ;; mostly ordered; equal or reversed now and then, for the error path
         (ul (if (zerop (rnd 25)) (max a b) (min a b)))
         (ur (if (zerop (rnd 25)) (min a b) (max a b))))
    (agree (list :curve c :ul ul :ur ur)
           (list (batten::crv-extract-crv-seg c ul ur))
           (with-foreign ((cp c :curve))
             (with-foreign-out ((cq :curve))
               (with-stacks (sp)
                 (with-stacks (sq)
                   (if (c-flag-error-p (c-crv-extract-crv-seg cp ul ur cq sp sq))
                       (values t nil)
                       (values nil (list (from-foreign cq :curve)))))))))))

(define-oracle-test crv-remove-knot-max-err (:file "crv-tool" :trials 4000)
  (let* ((c (%crv-tool-curve :full (+ 2 (rnd 4)) :min-extra 1))
         (runs (%crv-tool-knot-runs (curve-knots c) (curve-degree c)))
         (run (nth (rnd (length runs)) runs))
         (r (second run))
         (s (third run)))
    (agree (list :curve c :r r :s s)
           (list (batten::crv-remove-knot-max-err c r s))
           (with-foreign ((cp c :curve))
             (with-scalars ((br :double))
               (values (c-flag-error-p (c-crv-remove-knot-max-err cp r s br))
                       (list (cffi:mem-ref br :double))))))))

;;; ------------------------------------------------------------ level 2, group 2

(defun %crv-tool-removal (c)
  "A curve, knot, count and tolerance to remove a knot from: usually C with a
knot inserted (so that removal succeeds to about rounding), now and then C
itself with one of its interior knots, a value that is no knot, or an end of
the domain, for the other paths."
  (let* ((knots (curve-knots c))
         (p (curve-degree c))
         (lo (aref knots 0))
         (hi (aref knots (1- (length knots))))
         (tol (case (rnd 7) (0 0d0) (1 1d-9) (2 1d-6) (3 1d-3) (4 1d0) (5 1d3) (t 1d8))))
    (case (rnd 10)
      ((0 1 2 3 4)
       ;; insert a fresh or an existing knot, then remove it again
       (let* ((runs (%crv-tool-knot-runs knots p))
              (run (and runs (zerop (rnd 2)) (nth (rnd (length runs)) runs)))
              (u (if (and run (< (third run) p)) (first run) (+ lo (* (- hi lo) (+ 0.01d0 (rnd 0.98d0))))))
              (mult (count u knots :test #'=))
              (r (1+ (rnd (max 1 (- p mult)))))
              (ci (if (> (+ mult r) p) c (batten::crv-insert-knot c u r))))
         (values ci u (rnd (+ p 2)) tol)))
      ((5 6 7)
       (let ((runs (%crv-tool-knot-runs knots p)))
         (values c (if runs (first (nth (rnd (length runs)) runs)) (rnd-range lo hi))
                 (rnd (+ p 2)) tol)))
      (8 (values c (rnd-range lo hi) (1+ (rnd p)) tol))
      (t (values c (if (zerop (rnd 2)) lo hi) 1 tol)))))

(define-oracle-test crv-remove-knot (:file "crv-tool" :trials 4000)
  (multiple-value-bind (c u nu tol)
      (%crv-tool-removal (if (zerop (rnd 2)) (random-curve) (%crv-tool-curve :full (+ 2 (rnd 4)))))
    (agree (list :curve c :u u :nu nu :tol tol)
           (multiple-value-list (batten::crv-remove-knot c u nu tol))
           (with-foreign ((cp c :curve))
             (with-foreign-out ((cq :curve))
               (with-stacks (sq)
                 (with-scalars ((ru :long))
                   (if (c-flag-error-p (c-crv-remove-knot cp u nu tol ru cq sq))
                       (values t nil)
                       (values nil (list (cffi:mem-ref ru :long) (from-foreign cq :curve)))))))))))

;;; ------------------------------------------------------------ level 3, group 5

(defun %crv-tool-removals-input ()
  "A curve and tolerance for removing all removable knots: a random curve, the
same refined (so its new knots come out again to about rounding) or degree
elevated (its knots removable once each), with tolerances from zero to past
the curve's size; weights spread wide now and then, to reach the weight
test."
  (let* ((c (if (zerop (rnd 2)) (random-curve :max-extra 10) (%crv-tool-curve :full (+ 2 (rnd 4)))))
         (c (case (rnd 10)
              ((0 1 2 3) (let ((x (%crv-tool-refinement c)))
                           (handler-case (batten::crv-refine c x)
                             (nurbs-error () c))))
              ((4 5) (if (< (curve-degree c) 6) (batten::crv-elevate-degree c (1+ (rnd 2))) c))
              (t c)))
         (tol (case (rnd 9)
                (0 0d0) (1 1d-12) (2 1d-9) (3 1d-6) (4 1d-3) (5 1d-1) (6 1d0) (7 1d2) (t 1d6))))
    (when (and (/= (aref (curve-cpoints c) 0 3) +no-w+) (zerop (rnd 4)))
      ;; wide weights: scale each control point by a factor in [0.01, 50]
      (let ((pw (curve-cpoints c)))
        (dotimes (i (array-dimension pw 0))
          (let ((f (expt 10d0 (rnd-range -2d0 1.7d0))))
            (dotimes (k 4)
              (unless (or (and (= k 2) (= (aref pw i 2) +no-z+)))
                (setf (aref pw i k) (* f (aref pw i k)))))))))
    (values c tol)))

(define-oracle-test crv-remove-knots (:file "crv-tool" :trials 3000)
  (multiple-value-bind (c tol) (%crv-tool-removals-input)
    (agree (list :curve c :tol tol)
           (list (batten::crv-remove-knots c tol))
           (with-foreign ((cp c :curve))
             (with-foreign-out ((cq :curve))
               (with-stacks (sq)
                 (if (c-flag-error-p (c-crv-remove-knots cp tol cq sq))
                     (values t nil)
                     (values nil (list (from-foreign cq :curve))))))))))

(define-oracle-test crv-elevate-degree (:file "crv-tool" :trials 3000)
  (let* ((c (if (zerop (rnd 2))
                (random-curve :max-extra 8)
                (%crv-tool-curve :full (+ 1 (rnd 5)))))
         (p (curve-degree c))
         (tt (case (rnd 20)
               (0 -1)
               (1 (- 18 p))
               (2 0)
               (t (1+ (rnd 4))))))
    (when (zerop (rnd 25))
      ;; a knot vector that is not valid: start multiplicity p
      (let ((u (curve-knots c)))
        (setf (aref u p) (* 0.5d0 (+ (aref u p) (aref u (1+ p)))))))
    (agree (list :curve c :t tt)
           (list (batten::crv-elevate-degree c tt))
           (with-foreign ((cp c :curve))
             (with-foreign-out ((cq :curve))
               (with-stacks (sp)
                 (with-stacks (sq)
                   (if (c-flag-error-p (c-crv-elevate-degree cp tt cq sp sq))
                       (values t nil)
                       (values nil (list (from-foreign cq :curve)))))))))))

;;; ------------------------------------------------------------- L5-g1

(defun %crv-tool-curve-set ()
  "K and K+1 random curves for N_CrvsMakeCompatibleKnotTol, as (values curves
k): on one domain mostly (whose knots now and then nearly coincide across
curves), domains differing by 1e-13 or 1e-11 now and then, or each its own;
rational or not, 2D or not, each at random."
  (let* ((k (rnd 4))
         (curves (make-array (1+ k)))
         (lo (if (zerop (rnd 3)) 0d0 (rnd-range -10d0 10d0)))
         (hi (+ lo 0.5d0 (rnd 10d0)))
         (dom (case (rnd 8) (0 :own) (1 :tiny) (2 :small) (t :same)))
         (shared (%crv-tool-knots 3 (+ 4 (rnd 6)) lo hi :full 6)))
    (dotimes (i (1+ k))
      (let* ((c (random-curve :max-degree 5 :max-extra 8))
             (p (curve-degree c))
             (n+1 (array-dimension (curve-cpoints c) 0)))
        (case dom
          (:own nil)
          (t
           (let ((knots (%crv-tool-knots p n+1 lo hi :full 5)))
             (when (and (plusp i) (not (eq dom :same)))
               (let ((d (if (eq dom :tiny) 1d-13 1d-11)))
                 (dotimes (j (1+ p))
                   (incf (aref knots (- (length knots) 1 j)) d))))
             ;; now and then interior knots copied, perturbed a little, from
             ;; a shared vector
             (when (and (zerop (rnd 3)) (> (- n+1 p 1) 0))
               (let ((src (subseq shared 4 (- (length shared) 4))))
                 (dotimes (j (min (length src) (- n+1 p 1)))
                   (setf (aref knots (+ p 1 j)) (+ (aref src j) (* (- hi lo) (rnd-range -1d-5 1d-5))))))
               (setf knots (sort knots #'<)))
             (setf (curve-knots c) knots))))
        (setf (svref curves i) c)))
    ;; now and then a knot vector that is not valid (start multiplicity p),
    ;; which the degree elevation rejects
    (when (and (zerop (rnd 20)) (> k 0))
      (let* ((c (svref curves (rnd (1+ k))))
             (u (curve-knots c))
             (p (curve-degree c)))
        (setf (aref u p) (* 0.5d0 (+ (aref u p) (aref u (1+ p)))))))
    (values curves k)))

(define-oracle-test crvs-make-compatible-knot-tol (:file "crv-tool" :trials 2000)
  (multiple-value-bind (curves k) (%crv-tool-curve-set)
    (let ((tol (case (rnd 9)
                 ((0 1) 0d0) (2 -1d0) (3 1d-9) (4 1d-8) (5 1d-6) (6 1d-4) (7 1d-3) (t 1d-2))))
      (if (zerop (rnd 50))
          ;; now and then no curve array at all
          (agree (list :curves nil :k k :tol tol)
                 (list (batten::crvs-make-compatible-knot-tol nil k tol))
                 (with-stacks (s)
                   (values (c-flag-error-p
                            (c-crvs-make-compatible-knot-tol (cffi:null-pointer) k tol s))
                           (list nil))))
          (agree (list :curves curves :k k :tol tol)
                 (let ((copies (map 'simple-vector #'batten::crv-copy curves)))
                   (batten::crvs-make-compatible-knot-tol copies k tol)
                   (coerce copies 'list))
                 (with-foreign ()
                   (with-stacks (s)
                     (let ((arr (batten-oracle::falloc :pointer (1+ k))))
                       (dotimes (i (1+ k))
                         (setf (cffi:mem-aref arr :pointer i)
                               (batten-oracle::to-foreign (svref curves i) :curve)))
                       (let ((failed (c-flag-error-p (c-crvs-make-compatible-knot-tol arr k tol s))))
                         (values failed
                                 (unless failed
                                   (let (out)
                                     (dotimes (i (1+ k) (nreverse out))
                                       (push (from-foreign (cffi:mem-aref arr :pointer i) :curve)
                                             out))))))))))))))

;;; ------------------------------------------------------------- L6-g1

(define-oracle-test crvs-make-compatible (:file "crv-tool" :trials 2000)
  (multiple-value-bind (curves k) (%crv-tool-curve-set)
    (if (zerop (rnd 50))
