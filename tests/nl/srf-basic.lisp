(define-oracle-test srf-reparam-to-interval (:file "srf-basic" :trials 3000)
  (let* ((s (%some-srf))
         (u (surface-knots-u s)) (v (surface-knots-v s))
         (dir (case (rnd 10) (0 0) (t (1+ (rnd 3)))))
         (lo (lambda () (- (rnd 20d0) 10d0)))
         (a (if (zerop (rnd 4)) (aref u 0) (funcall lo)))
         (b (if (zerop (rnd 4)) (aref u (1- (length u))) (+ a 0.1d0 (rnd 10d0))))
         (c (if (zerop (rnd 4)) (aref v 0) (funcall lo)))
         (d (if (zerop (rnd 4)) (aref v (1- (length v))) (+ c 0.1d0 (rnd 10d0))))
         (rect (make-array 4 :element-type 'double-float :initial-contents (list a b c d))))
    (agree (list :surface s :rect rect :dir dir)
           (list (batten::srf-reparam-to-interval (batten::srf-copy s) rect dir))
           (with-foreign ((sp s :surface) (rp rect :rectangle))
             (c-srf-reparam-to-interval sp rp dir)
             (values nil (list (from-foreign sp :surface)))))))
