(defun %sb-highest (len)
  "A highest index into an array of LEN elements: usually the last one, now
and then one short of it (the C then takes a corner or prefix)."
  (if (and (> len 1) (zerop (rnd 5))) (- len 2) (1- len)))

(define-oracle-test srf-from-c-pts-and-knots (:file "srf-basic" :trials 1000)
  (let* ((s (%some-srf))
         (pw (surface-cpoints s)) (p (surface-degree-u s)) (q (surface-degree-v s))
         (u (surface-knots-u s)) (v (surface-knots-v s))
         (n (%sb-highest (array-dimension pw 0))) (m (%sb-highest (array-dimension pw 1)))
         (r (%sb-highest (length u))) (ss (%sb-highest (length v))))
    (agree (list :surface s :n n :m m :r r :s ss)
           (list (batten::srf-from-c-pts-and-knots (%blank-surface) pw n m p q u v r ss))
           (with-foreign ((pp pw :cpoint-net) (up u :real-vector) (vp v :real-vector))
             (with-stacks (st)
               (with-foreign-out ((sp :surface))
                 (values (c-flag-error-p (c-srf-from-c-pts-and-knots sp pp n m p q up vp r ss st))
                         (list (from-foreign sp :surface)))))))))

(define-oracle-test srf-from-c-pt-coords-and-knots (:file "srf-basic" :trials 1000)
  (let* ((s (%some-srf))
         (pw (surface-cpoints s)) (p (surface-degree-u s)) (q (surface-degree-v s))
         (u (surface-knots-u s)) (v (surface-knots-v s))
         (rows (array-dimension pw 0)) (cols (array-dimension pw 1))
         (coord (lambda (c)
                  (let ((a (batten::make-real-matrix rows cols)))
                    (dotimes (i rows a) (dotimes (j cols) (setf (aref a i j) (aref pw i j c)))))))
         (wx (funcall coord 0)) (wy (funcall coord 1)) (wz (funcall coord 2)) (w (funcall coord 3))
         (n (%sb-highest rows)) (m (%sb-highest cols))
         (r (%sb-highest (length u))) (ss (%sb-highest (length v))))
    (agree (list :surface s :n n :m m :r r :s ss)
           (list (batten::srf-from-c-pt-coords-and-knots (%blank-surface) wx wy wz w n m p q u v r ss))
           (with-foreign ((fx wx :real-matrix) (fy wy :real-matrix) (fz wz :real-matrix)
                          (fw w :real-matrix) (up u :real-vector) (vp v :real-vector))
             (with-stacks (st)
               (with-foreign-out ((sp :surface))
                 (values (c-flag-error-p (c-srf-from-c-pt-coords-and-knots sp fx fy fz fw n m p q
                                                                           up vp r ss st))
                         (list (from-foreign sp :surface)))))))))

