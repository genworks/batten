(define-oracle-test srf-set-c-pts-and-knots (:file "srf-basic" :trials 1000)
  (let* ((s (%some-srf))
         (pw (%random-net-like (surface-cpoints s)))
         (u (random-knots (surface-degree-u s) (array-dimension pw 0) :lo -1d0 :hi 3d0))
         (v (random-knots (surface-degree-v s) (array-dimension pw 1) :lo 2d0 :hi 5d0)))
