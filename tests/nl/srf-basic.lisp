(define-oracle-test srf-get-e-net (:file "srf-basic" :trials 2000)
  (let* ((s (%some-srf)) (n (surface-n s)) (m (surface-m s))
         (ku (rnd (1+ n))) (lu (+ ku (rnd (1+ (- n ku)))))
         (kv (rnd (1+ m))) (lv (+ kv (rnd (1+ (- m kv))))))
    ;; now and then an index out of range or crossed (:ind-err)
    (case (rnd 30)
      (0 (setf ku -1)) (1 (setf lu (1+ n))) (2 (rotatef ku lu) (incf ku))
      (3 (setf kv -1)) (4 (setf lv (1+ m))) (5 (rotatef kv lv) (incf kv)))
    (agree (list :surface s :ku ku :lu lu :kv kv :lv lv)
           (list (batten::srf-get-e-net s ku lu kv lv))
           (with-foreign ((sp s :surface))
             (with-stacks (st)
               (with-foreign-out ((ntl :enet))
                 (if (c-flag-error-p (c-srf-get-e-net sp ku lu kv lv ntl st))
                     (values t nil)
                     (values nil (list (from-foreign ntl :enet))))))))))

