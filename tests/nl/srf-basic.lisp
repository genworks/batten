             (c-srf-set-c-pts-and-knots sp pp up vp)
             (values nil (list (from-foreign sp :surface)))))))

(define-oracle-test srf-is-closed (:file "srf-basic" :trials 3000)
  (let* ((s (%some-srf)) (net (surface-cpoints s))
         (n (surface-n s)) (m (surface-m s))
         (dir (case (rnd 10) (0 0) (1 3) (t (if (zerop (rnd 2)) batten::+udir+ batten::+vdir+)))))
    ;; close it most of the time: the last row or column a copy of the first,
    ;; with its own weight, maybe nudged by about NL_MTOL
    (when (plusp (rnd 4))
      (let ((nudge (case (rnd 4) (0 0d0) (1 5d-8) (2 2d-7) (t 1d-6)))
            (closed-dir (if (zerop (rnd 4))
                            (if (= dir batten::+udir+) batten::+vdir+ batten::+udir+)
                            dir)))
        (flet ((copy (i0 j0 i1 j1)
                 (let* ((w0 (aref net i0 j0 3)) (rat (/= w0 batten::+no-w+))
                        (w1 (if rat (aref net i1 j1 3) 1d0))
                        (r0 (if rat (/ 1d0 w0) 1d0)))
                   (dotimes (c 3)
                     (unless (and (= c 2) (= (aref net i0 j0 2) batten::+no-z+))
                       (setf (aref net i1 j1 c)
                             (* w1 (+ (* (aref net i0 j0 c) r0) (if (zerop (rnd 3)) nudge 0d0)))))))))
          (if (= closed-dir batten::+udir+)
              (dotimes (j (1+ m)) (copy 0 j n j))
              (dotimes (i (1+ n)) (copy i 0 i m))))))
    (agree (list :surface s :dir dir)
           (list (if (batten::srf-is-closed s dir) 1 0))
           (with-foreign ((sp s :surface))
             (values nil (list (c-srf-is-closed sp dir)))))))

(define-oracle-test 1d-pt-set-is-closed (:file "srf-basic" :trials 3000)
  (let* ((len (1+ (rnd 8)))
         (ptp (case (rnd 10) (0 batten::+rvalue+) (t (if (zerop (rnd 2)) batten::+epoint+ batten::+hpoint+))))
         (homo (= ptp batten::+hpoint+))
         (a (if homo
                (let ((a (batten::make-cpoint-array len)) (two-d (zerop (rnd 3))) (rat (zerop (rnd 2))))
                  (dotimes (i len a)
                    (let ((cp (random-cpoint :rational (if (zerop (rnd 5)) :random rat)
                                             :two-d (if (zerop (rnd 5)) (zerop (rnd 2)) two-d))))
                      (dotimes (c 4) (setf (aref a i c) (aref cp c))))))
                (random-points len)))
         (m (rnd len))
         (tol (case (rnd 4) (0 0d0) (1 1d-7) (2 1d0) (t (rnd 300d0)))))
    ;; close it now and then, within a little of tol
    (when (zerop (rnd 2))
      (dotimes (c (array-dimension a 1))
        (setf (aref a m c) (+ (aref a 0 c) (if (zerop (rnd 3)) (* 0.5d0 tol) 0d0)))))
    (agree (list :a a :m m :ptp ptp :tol tol)
           (list (if (batten::1d-pt-set-is-closed a m ptp tol) 1 0))
           (with-foreign ((ap a (if homo :cpoint-array :point-array)))
             (values nil (list (c-1d-pt-set-is-closed ap m ptp tol)))))))

