(in-package :batten-tests)

(define-oracle-test is-srf-rat (:file "srf-basic" :trials 1000)
  (let ((s (random-surface)))
    (agree s
           (list (if (batten::is-srf-rat s) 1 0))
           (with-foreign ((sp s :surface))
             (values nil (list (c-is-srf-rat sp)))))))

(define-oracle-test srf-get-parameter-bounds (:file "srf-basic" :trials 1000)
  (let ((s (random-surface)))
    (agree s
           (multiple-value-list (batten::srf-get-parameter-bounds s))
           (with-foreign ((sp s :surface))
             (with-scalars ((ul :double) (ur :double) (vb :double) (vt :double))
               (c-srf-get-parameter-bounds sp ul ur vb vt)
               (values nil (list (cffi:mem-ref ul :double) (cffi:mem-ref ur :double)
                                 (cffi:mem-ref vb :double) (cffi:mem-ref vt :double))))))))

;;; ---------------------------------------------------------------- helpers

(defun %some-srf ()
  "A random surface: rational or not, 2D a fifth of the time."
  (random-surface :two-d (zerop (rnd 5))))

(defun %cnet-to-foreign (net)
  "A foreign NL_CNET over cpoint-net NET, inside the enclosing WITH-FOREIGN."
  (let ((c (batten-oracle::falloc '(:struct batten-oracle::nl-cnet) 1)))
    (setf (cffi:foreign-slot-value c '(:struct batten-oracle::nl-cnet) 'batten-oracle::n)
          (1- (array-dimension net 0))
          (cffi:foreign-slot-value c '(:struct batten-oracle::nl-cnet) 'batten-oracle::m)
          (1- (array-dimension net 1))
          (cffi:foreign-slot-value c '(:struct batten-oracle::nl-cnet) 'batten-oracle::pw)
          (batten-oracle::net-to-foreign net))
    c))

(defun %cnet-from-foreign (c)
  "A fresh cpoint-net read from foreign NL_CNET C."
  (batten-oracle::read-net
   (cffi:foreign-slot-value c '(:struct batten-oracle::nl-cnet) 'batten-oracle::pw)
   (1+ (cffi:foreign-slot-value c '(:struct batten-oracle::nl-cnet) 'batten-oracle::n))
   (1+ (cffi:foreign-slot-value c '(:struct batten-oracle::nl-cnet) 'batten-oracle::m))
   4))

(defun %blank-surface ()
  (%make-surface 0 0 (batten::make-real-vector 0) (batten::make-real-vector 0)
                 (batten::make-cpoint-net 0 0)))

(defun %random-net-like (net)
  "A random cpoint-net of NET's dimensions and rationality."
  (let ((out (batten::make-cpoint-net (array-dimension net 0) (array-dimension net 1)))
        (rational (/= (aref net 0 0 3) batten::+no-w+))
        (two-d (= (aref net 0 0 2) batten::+no-z+)))
    (dotimes (i (array-dimension net 0) out)
      (dotimes (j (array-dimension net 1))
        (let ((w (if rational (+ 0.2d0 (rnd 4.8d0)) 1d0)))
          (setf (aref out i j 0) (* w (- (rnd 200d0) 100d0))
                (aref out i j 1) (* w (- (rnd 200d0) 100d0))
                (aref out i j 2) (if two-d batten::+no-z+ (* w (- (rnd 200d0) 100d0)))
                (aref out i j 3) (if rational w batten::+no-w+)))))))

;;; ------------------------------------------------------------------ tests

(define-oracle-test srf-weights-are-valid (:file "srf-basic" :trials 2000)
  (let* ((s (%some-srf)) (net (surface-cpoints s)))
    ;; now and then a weight outside, or exactly on, [NL_WMIN, NL_WMAX]
    (when (and (batten::is-srf-rat s) (zerop (rnd 2)))
      (let ((i (rnd (array-dimension net 0))) (j (rnd (array-dimension net 1)))
            (w (case (rnd 6) (0 1d-4) (1 200d0) (2 1d-3) (3 100d0)
                     (4 (* 1d-3 (- 1 double-float-epsilon))) (t 0d0))))
        (setf (aref net i j 3) w)))
    (agree s
           (progn (batten::srf-weights-are-valid s 'srf-weights-are-valid) (list t))
           (with-foreign ((sp s :surface))
             (cffi:with-foreign-string (rn "N_SrfWeightsAreValid")
               (values (c-flag-error-p (c-srf-weights-are-valid sp rn)) (list t)))))))

