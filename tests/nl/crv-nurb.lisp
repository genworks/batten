;;;; Differential tests for src/nl/crv-nurb.lisp against NLib.

(in-package :batten-tests)

(define-oracle-test crv-eval (:file "crv-nurb" :trials 4000)
  (let* ((c (random-curve)) (u (random-parameter (curve-knots c))) (flg (random-side)))
    (agree (list :curve c :u u :flg flg)
           (list (batten::crv-eval c u flg (make-point)))
           (with-foreign ((cur c :curve))
             (with-foreign-out ((pt :point))
               (values (c-flag-error-p (c-crv-eval cur u flg pt))
                       (list (from-foreign pt :point))))))))

(define-oracle-test crv-derivs (:file "crv-nurb" :trials 4000)
  (let* ((c (random-curve)) (u (random-parameter (curve-knots c))) (flg (random-side))
         (der (rnd (1+ +maxder+))))
    (agree (list :curve c :u u :flg flg :der der)
           (list (batten::crv-derivs c u flg der (make-point-array (1+ der))))
           (with-foreign ((cur c :curve))
             (with-foreign-out ((cd :point-array (1+ der)))
               (values (c-flag-error-p (c-crv-derivs cur u flg der cd))
                       (list (from-foreign cd :point-array (1+ der)))))))))

(defun %curve-with-flat-start ()
  "A random curve whose first control points coincide (a zero first
derivative at the start) or are collinear (a zero curvature there)."
  (let* ((c (random-curve))
         (pw (curve-cpoints c))
         (n+1 (array-dimension pw 0))
         (k (min n+1 (+ 2 (rnd 3))))
         (collinear (zerop (rnd 2))))
    (dotimes (i k c)
      (let ((w (if (= (aref pw i 3) +no-w+) 1d0 (aref pw i 3)))
            (w0 (if (= (aref pw 0 3) +no-w+) 1d0 (aref pw 0 3)))
            (s (if collinear (float (* 3 i) 1d0) 0d0)))
        (setf (aref pw i 0) (* w (+ (/ (aref pw 0 0) w0) s))
              (aref pw i 1) (* w (+ (/ (aref pw 0 1) w0) s)))
        (unless (= (aref pw i 2) +no-z+)
          (setf (aref pw i 2) (* w (+ (/ (aref pw 0 2) w0) s))))))))

(define-oracle-test crv-eval-tangent (:file "crv-nurb" :trials 3000)
  (let* ((c (if (zerop (rnd 6)) (%curve-with-flat-start) (random-curve)))
         (u (if (zerop (rnd 6)) (aref (curve-knots c) 0) (random-parameter (curve-knots c))))
         (flg (random-side)))
    (agree (list :curve c :u u :flg flg)
           (let ((p (make-point)) (tv (make-point)))
             (batten::crv-eval-tangent c u flg p tv)
             (list p tv))
           (with-foreign ((cur c :curve))
             (with-foreign-out ((p :point) (tv :point))
               (values (c-flag-error-p (c-crv-eval-tangent cur u flg p tv))
                       (list (from-foreign p :point) (from-foreign tv :point))))))))

(define-oracle-test crv-get-min-max-weights-and-pts (:file "crv-nurb" :trials 3000)
  (let ((c (random-curve)))
    (agree c
           (multiple-value-list (batten::crv-get-min-max-weights-and-pts c))
           (with-foreign ((cur c :curve))
             (with-scalars ((wmin :double) (wmax :double) (pmin :double) (pmax :double))
               (c-crv-get-min-max-weights-and-pts cur wmin wmax pmin pmax)
               (values nil (list (cffi:mem-ref wmin :double) (cffi:mem-ref wmax :double)
                                 (cffi:mem-ref pmin :double) (cffi:mem-ref pmax :double))))))))

(define-oracle-test crv-line-from-pt-and-vector (:file "crv-nurb" :trials 1000)
  (let ((p (random-point)) (v (random-point (if (zerop (rnd 4)) 1d-3 100d0))))
    (agree (list :p p :v v)
           (list (batten::crv-line-from-pt-and-vector p v))
           (with-stacks (s)
             (with-foreign ((fp p :point) (fv v :point))
               (with-foreign-out ((cur :curve))
                 (let ((rc (c-crv-line-from-pt-and-vector fp fv cur s)))
                   (values (c-flag-error-p rc)
                           (unless (c-flag-error-p rc) (list (from-foreign cur :curve)))))))))))

(define-oracle-test crv-get-curvature-deriv (:file "crv-nurb" :trials 3000)
  (let* ((c (case (rnd 6)
              (0 (%curve-with-flat-start))
              (1 (random-curve :max-degree 2))
              (t (random-curve))))
         (u (if (zerop (rnd 6)) (aref (curve-knots c) 0) (random-parameter (curve-knots c))))
         (ufl (random-side)))
    (agree (list :curve c :u u :ufl ufl)
           (list (batten::crv-get-curvature-deriv c u ufl))
           (with-foreign ((cur c :curve))
             (with-scalars ((kpp :double))
               (let ((rc (c-crv-get-curvature-deriv cur u ufl kpp)))
                 (values (c-flag-error-p rc)
                         (list (cffi:mem-ref kpp :double)))))))))
