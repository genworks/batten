;;;; Differential tests for src/nl/crv-nurb.lisp against NLib.

(in-package :batten-tests)

(define-oracle-test crv-eval (:file "crv-nurb" :trials 4000)
  (let* ((c (random-curve)) (u (random-parameter (curve-knots c))) (flg (random-side)))
    (agree (list :curve c :u u :flg flg)
           (list (batten::crv-eval c u flg (make-point)))
           (with-foreign ((cur c :curve))
             (with-foreign-out ((pt :point))
               (values (c-flag-error-p (c-crv-eval cur u flg pt))
                       (list (from-foreign pt :point))))))))

(define-oracle-test crv-derivs (:file "crv-nurb" :trials 4000)
  (let* ((c (random-curve)) (u (random-parameter (curve-knots c))) (flg (random-side))
         (der (rnd (1+ +maxder+))))
    (agree (list :curve c :u u :flg flg :der der)
           (list (batten::crv-derivs c u flg der (make-point-array (1+ der))))
           (with-foreign ((cur c :curve))
             (with-foreign-out ((cd :point-array (1+ der)))
               (values (c-flag-error-p (c-crv-derivs cur u flg der cd))
                       (list (from-foreign cd :point-array (1+ der)))))))))

(defun %curve-with-flat-start ()
  "A random curve whose first control points coincide (a zero first
derivative at the start) or are collinear (a zero curvature there)."
  (let* ((c (random-curve))
         (pw (curve-cpoints c))
         (n+1 (array-dimension pw 0))
         (k (min n+1 (+ 2 (rnd 3))))
         (collinear (zerop (rnd 2))))
    (dotimes (i k c)
      (let ((w (if (= (aref pw i 3) +no-w+) 1d0 (aref pw i 3)))
            (w0 (if (= (aref pw 0 3) +no-w+) 1d0 (aref pw 0 3)))
            (s (if collinear (float (* 3 i) 1d0) 0d0)))
        (setf (aref pw i 0) (* w (+ (/ (aref pw 0 0) w0) s))
              (aref pw i 1) (* w (+ (/ (aref pw 0 1) w0) s)))
        (unless (= (aref pw i 2) +no-z+)
          (setf (aref pw i 2) (* w (+ (/ (aref pw 0 2) w0) s))))))))

(define-oracle-test crv-eval-tangent (:file "crv-nurb" :trials 3000)
  (let* ((c (if (zerop (rnd 6)) (%curve-with-flat-start) (random-curve)))
         (u (if (zerop (rnd 6)) (aref (curve-knots c) 0) (random-parameter (curve-knots c))))
         (flg (random-side)))
    (agree (list :curve c :u u :flg flg)
           (let ((p (make-point)) (tv (make-point)))
             (batten::crv-eval-tangent c u flg p tv)
             (list p tv))
           (with-foreign ((cur c :curve))
             (with-foreign-out ((p :point) (tv :point))
               (values (c-flag-error-p (c-crv-eval-tangent cur u flg p tv))
                       (list (from-foreign p :point) (from-foreign tv :point))))))))

(define-oracle-test crv-get-min-max-weights-and-pts (:file "crv-nurb" :trials 3000)
  (let ((c (random-curve)))
    (agree c
           (multiple-value-list (batten::crv-get-min-max-weights-and-pts c))
           (with-foreign ((cur c :curve))
             (with-scalars ((wmin :double) (wmax :double) (pmin :double) (pmax :double))
               (c-crv-get-min-max-weights-and-pts cur wmin wmax pmin pmax)
               (values nil (list (cffi:mem-ref wmin :double) (cffi:mem-ref wmax :double)
                                 (cffi:mem-ref pmin :double) (cffi:mem-ref pmax :double))))))))

(define-oracle-test crv-line-from-pt-and-vector (:file "crv-nurb" :trials 1000)
  (let ((p (random-point)) (v (random-point (if (zerop (rnd 4)) 1d-3 100d0))))
    (agree (list :p p :v v)
           (list (batten::crv-line-from-pt-and-vector p v))
           (with-stacks (s)
             (with-foreign ((fp p :point) (fv v :point))
               (with-foreign-out ((cur :curve))
                 (let ((rc (c-crv-line-from-pt-and-vector fp fv cur s)))
                   (values (c-flag-error-p rc)
                           (unless (c-flag-error-p rc) (list (from-foreign cur :curve)))))))))))

(define-oracle-test crv-get-curvature-deriv (:file "crv-nurb" :trials 3000)
  (let* ((c (case (rnd 6)
              (0 (%curve-with-flat-start))
              (1 (random-curve :max-degree 2))
              (t (random-curve))))
         (u (if (zerop (rnd 6)) (aref (curve-knots c) 0) (random-parameter (curve-knots c))))
         (ufl (random-side)))
    (agree (list :curve c :u u :ufl ufl)
           (list (batten::crv-get-curvature-deriv c u ufl))
           (with-foreign ((cur c :curve))
             (with-scalars ((kpp :double))
               (let ((rc (c-crv-get-curvature-deriv cur u ufl kpp)))
                 (values (c-flag-error-p rc)
                         (list (cffi:mem-ref kpp :double)))))))))

;;; ------------------------------------------------------------ level 1, group 4

(define-oracle-test crv-reverse (:file "crv-nurb" :trials 3000)
  (let* ((c (random-curve :max-extra (if (zerop (rnd 3)) 2 12)))
         (in-place (zerop (rnd 2))))
    (agree (list :curve c :in-place in-place)
           (list (if in-place
                     (let ((cc (batten::%make-curve (curve-degree c) (copy-seq (curve-knots c))
                                                    (let ((a (make-cpoint-array (1+ (curve-n c))))
                                                          (src (curve-cpoints c)))
                                                      (dotimes (i (array-total-size a) a)
                                                        (setf (row-major-aref a i) (row-major-aref src i)))))))
                       (batten::crv-reverse cc cc))
                     (batten::crv-reverse c nil)))
           (with-stacks (s)
             (with-foreign ((cur c :curve))
               (if in-place
                   (let ((rc (c-crv-reverse cur cur s)))
                     (values (c-flag-error-p rc) (list (from-foreign cur :curve))))
                   (with-foreign-out ((q :curve))
                     (let ((rc (c-crv-reverse cur q s)))
                       (values (c-flag-error-p rc)
                               (unless (c-flag-error-p rc) (list (from-foreign q :curve))))))))))))

;;; ------------------------------------------------------------ level 2, group 5

(defun %cn-copy-curve (c)
  "A fresh copy of curve C."
  (batten::%make-curve (curve-degree c) (copy-seq (curve-knots c))
                       (let ((a (make-cpoint-array (1+ (curve-n c))))
                             (src (curve-cpoints c)))
                         (dotimes (i (array-total-size a) a)
                           (setf (row-major-aref a i) (row-major-aref src i))))))

(defun %cn-random-transform ()
  "A random 4x4 rmatrix with a small projective row, so the denominators stay
away from zero; now and then a plain affine one."
  (let ((rm (random-real-matrix 4 4 2d0)))
    (dotimes (j 3) (setf (aref rm 3 j) (if (zerop (rnd 3)) 0d0 (rnd-range -0.002d0 0.002d0))))
    (setf (aref rm 3 3) (if (zerop (rnd 3)) 1d0 (rnd-range 0.5d0 2d0)))
    (batten::make-rmatrix 3 3 rm batten::+mt-full+ 4)))

(define-oracle-test crv-get-b-box (:file "crv-nurb" :trials 3000)
  (let ((c (random-curve)))
    (agree c
           (list (batten::crv-get-b-box c (make-real-vector 6)))
           (with-foreign ((cur c :curve))
             (with-foreign-out ((box :box))
               (let ((rc (c-crv-get-b-box cur box)))
                 (values (c-flag-error-p rc) (list (from-foreign box :box)))))))))

(define-oracle-test crv-eval-frenet-frame (:file "crv-nurb" :trials 3000)
  (let* ((c (case (rnd 8)
              (0 (%curve-with-flat-start))
              (1 (random-curve :max-degree 1))
              (2 (random-curve :max-degree 2))
              (t (random-curve))))
         (u (if (zerop (rnd 6)) (aref (curve-knots c) 0) (random-parameter (curve-knots c))))
         (flg (random-side)))
    (agree (list :curve c :u u :flg flg)
           (let ((p (make-point)) (tv (make-point)) (nv (make-point)) (bv (make-point)))
             (batten::crv-eval-frenet-frame c u flg p tv nv bv)
             (list p tv nv bv))
           (with-foreign ((cur c :curve))
             (with-foreign-out ((p :point) (tv :point) (nv :point) (bv :point))
               (let ((rc (c-crv-eval-frenet-frame cur u flg p tv nv bv)))
                 (values (c-flag-error-p rc)
                         (list (from-foreign p :point) (from-foreign tv :point)
                               (from-foreign nv :point) (from-foreign bv :point)))))))))

(define-oracle-test crv-transform (:file "crv-nurb" :trials 3000)
  (let* ((c (random-curve)) (rma (%cn-random-transform)))
    (agree (list :curve c :rm (batten::rmatrix-rm rma))
           (list (batten::crv-transform (%cn-copy-curve c) rma))
           (with-foreign ((cur c :curve) (rp rma :rmatrix))
             (c-crv-transform cur rp)
             (values nil (list (from-foreign cur :curve)))))))

(define-oracle-test crv-translate (:file "crv-nurb" :trials 3000)
  (let* ((c (random-curve)) (tv (random-point (if (zerop (rnd 4)) 1d-3 100d0))))
    (agree (list :curve c :t tv)
           (list (batten::crv-translate (%cn-copy-curve c) tv))
           (with-foreign ((cur c :curve) (tp tv :point))
             (c-crv-translate cur tp)
             (values nil (list (from-foreign cur :curve)))))))

(define-oracle-test crv-reparam (:file "crv-nurb" :trials 3000)
  (let* ((c (random-curve))
         (k (curve-knots c))
         (ul (if (zerop (rnd 4)) (aref k 0) (- (rnd 20d0) 10d0)))
         (ur (if (zerop (rnd 4)) (aref k (1- (length k))) (+ ul 0.1d0 (rnd 10d0)))))
    (agree (list :curve c :ul ul :ur ur)
           (list (batten::crv-reparam (%cn-copy-curve c) ul ur))
           (with-foreign ((cur c :curve))
             (c-crv-reparam cur ul ur)
             (values nil (list (from-foreign cur :curve)))))))
