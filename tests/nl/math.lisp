;;;; Differential tests for src/nl/math.lisp against NLib.

(in-package :batten-tests)

(defun some-cpoint ()
  "A random control point: rational or not, 2D now and then."
  (random-cpoint :two-d (zerop (rnd 4))))

(defun some-scalar () (rnd-range -3d0 3d0))

(define-oracle-test float-op-is-bad (:file "math" :trials 4000)
  (let ((x (if (zerop (rnd 10)) 0d0 (* (expt 10d0 (- (rnd 600) 300)) (rnd-range -1d0 1d0))))
        (y (if (zerop (rnd 10)) 0d0 (* (expt 10d0 (- (rnd 600) 300)) (rnd-range -1d0 1d0))))
        (op (1+ (rnd 4))))
    (agree (list x y op)
           (list (if (batten::float-op-is-bad x y op) 1 0))
           (values nil (list (c-float-op-is-bad x y op))))))

(define-oracle-test c-pt-to-pt-euclid (:file "math" :trials 3000)
  (let ((pw (some-cpoint)))
    (agree pw
           (list (batten::c-pt-to-pt-euclid pw (make-point)))
           (with-foreign ((a pw :cpoint))
             (with-foreign-out ((p :point))
               (c-c-pt-to-pt-euclid a p)
               (values nil (list (from-foreign p :point))))))))

(define-oracle-test combine-2-c-pts (:file "math" :trials 3000)
  (let ((alpha (some-scalar)) (aw (some-cpoint)) (beta (some-scalar)) (bw (some-cpoint)))
    (agree (list alpha aw beta bw)
           (list (batten::combine-2-c-pts alpha aw beta bw (make-cpoint)))
           (with-foreign ((a aw :cpoint) (b bw :cpoint))
             (with-foreign-out ((c :cpoint))
               (c-combine-2-c-pts alpha a beta b c)
               (values nil (list (from-foreign c :cpoint))))))))

