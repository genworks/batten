(define-oracle-test weight (:file "math" :trials 3000)
  (let ((p (random-point)) (w (if (zerop (rnd 3)) +no-w+ (rnd-range 0.2d0 5d0))))
    (agree (list p w)
           (list (batten::weight p w (make-cpoint)))
           (with-foreign ((pp p :point))
             (with-foreign-out ((out :cpoint))
               (c-weight pp w out)
               (values nil (list (from-foreign out :cpoint))))))))

