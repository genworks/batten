(defun %random-insert-knots (knots p)
  "Knots to insert into KNOTS (degree P): sorted, strictly inside the domain,
some existing interior knots and some repeated, every resulting multiplicity
at most P.  Now and then an end knot, which NLib refuses, or none at all."
  (let* ((lo (aref knots 0)) (hi (aref knots (1- (length knots))))
         (interior (remove-if (lambda (x) (or (= x lo) (= x hi))) (coerce knots 'list)))
         (count (1+ (rnd 6)))
         (cands nil))
    (dotimes (i count)
      (push (case (rnd 6)
              (0 (if interior (nth (rnd (length interior)) interior) (rnd-range lo hi)))
              (1 (if cands (first cands) (rnd-range lo hi)))
              (t (rnd-range lo hi)))
            cands))
    (setf cands (sort (remove-if (lambda (x) (or (<= x lo) (>= x hi))) cands) #'<))
    (let ((accepted nil))
      (dolist (x cands)
        (when (<= (+ (%knot-multiplicity knots x) (count x accepted :test #'=) 1) p)
          (push x accepted)))
      (setf accepted (nreverse accepted))
      (case (rnd 20)
        (0 (setf accepted nil))
        (1 (push lo accepted))
        (2 (setf accepted (append accepted (list hi)))))
      (coerce accepted 'real-vector))))

(define-oracle-test srf-insert-knots (:file "srf-tool" :trials 6000)
  (let* ((s (%srf-tool-surface))
         (dir (case (rnd 41) (0 3) (t (if (zerop (rnd 2)) batten::+udir+ batten::+vdir+))))
         (knx (if (= dir batten::+vdir+)
                  (%random-insert-knots (surface-knots-v s) (surface-degree-v s))
                  (%random-insert-knots (surface-knots-u s) (surface-degree-u s)))))
    (agree (list :surface s :knx knx :dir dir)
           (list (batten::srf-insert-knots s knx dir))
           (with-foreign ((sp s :surface) (kx knx :knots))
             (with-foreign-out ((sq :surface))
               (with-stacks (stp)
                 (with-stacks (stq)
                   (if (c-flag-error-p (c-srf-insert-knots sp kx dir sq stp stq))
                       (values t nil)
                       (values nil (list (from-foreign sq :surface)))))))))))

(defun %random-removal-knot (knots p n)
  "An interior knot index r of KNOTS (degree P, highest control point index N)
with knots[r] /= knots[r+1], and its multiplicity; NIL when there is none."
  (let ((cands nil))
    (do ((r (1+ p) (1+ r))) ((> r n))
      (when (/= (aref knots r) (aref knots (1+ r)))
        (push r cands)))
    (when cands
      (let* ((r (nth (rnd (length cands)) cands))
             (s 0))
        (do ((i r (1- i))) ((or (< i 0) (/= (aref knots i) (aref knots r))))
          (incf s))
        (list r s)))))

(define-oracle-test srf-remove-one-knot (:file "srf-tool" :trials 10000)
  (let* ((s (random-surface :two-d (zerop (rnd 5)) :max-extra 8))
         (dir (case (rnd 41) (0 3) (t (if (zerop (rnd 2)) batten::+udir+ batten::+vdir+))))
         (vdir (= dir batten::+vdir+))
         (deg (if vdir (surface-degree-v s) (surface-degree-u s)))
         (rs (if vdir
                 (%random-removal-knot (surface-knots-v s) deg (surface-m s))
                 (%random-removal-knot (surface-knots-u s) deg (surface-n s))))
         (other (if vdir (surface-n s) (surface-m s))))
    (when rs
      (let* ((r (first rs))
             ;; now and then a multiplicity so large the C quits (u-direction only:
             ;; the v-direction has no such guard and would index out of bounds)
             (mult (if (and (= dir batten::+udir+) (zerop (rnd 20))) (+ deg 3 (rnd 3)) (second rs)))
             (f (rnd (1+ other)))
             (l (if (zerop (rnd 10)) (max 0 (1- f)) (+ f (rnd (- (1+ other) f)))))
             (mr (if (zerop (rnd 2)) most-positive-double-float (rnd 50d0))))
        (agree (list :surface s :r r :s mult :f f :l l :dir dir :mr mr)
               (list (batten::srf-remove-one-knot s r mult f l dir mr))
               (with-foreign ((sp s :surface))
                 (with-scalars ((cmr :double))
                   (setf (cffi:mem-ref cmr :double) mr)
                   (if (c-flag-error-p (c-srf-remove-one-knot sp r mult f l dir cmr))
                       (values t nil)
                       (values nil (list (cffi:mem-ref cmr :double)))))))))))

(defun %srf-removable-surface ()
  "A random surface with knots inserted in u, v or both (so some are removable
exactly), its control points now and then perturbed a little (removable
within some tolerance)."
  (let ((s (random-surface :max-degree 4 :max-extra 4 :two-d (zerop (rnd 5)))))
    (dolist (dir (list +udir+ +vdir+))
      (when (plusp (rnd 3))
        (let* ((vd (= dir +vdir+))
               (knots (if vd (surface-knots-v s) (surface-knots-u s)))
               (p (if vd (surface-degree-v s) (surface-degree-u s)))
               (lo (aref knots 0))
               (hi (aref knots (1- (length knots))))
               (xs (if (zerop (rnd 2))
                       (coerce (%random-insert-knots knots p) 'list)
                       (let (l)
                         (dotimes (i (1+ (rnd 5)) l)
                           (let ((x (+ lo (* (- hi lo) (+ 0.03d0 (rnd 0.94d0))))))
                             (push x l)
                             (case (rnd 6)
                               ;; a repeated knot
                               ((0 1) (when (> p 1) (push x l)))
                               ;; a nearly coincident one: steep basis
                               ;; functions, whose span maxima may not converge
                               (2 (push (+ x (* (- hi lo) (expt 10d0 (- (+ 5 (rnd 10)))))) l))))))))
               (xs (sort (remove-if (lambda (x) (or (<= x lo) (>= x hi))) xs) #'<)))
          (when xs
            (setf s (batten::srf-insert-knots s (coerce xs 'batten::real-vector) dir))))))
    (when (zerop (rnd 3))
      (let ((eps (expt 10d0 (- (rnd 10)))) (pw (surface-cpoints s)))
        (dotimes (i (array-dimension pw 0))
          (dotimes (j (array-dimension pw 1))
            (dotimes (k 2) (incf (aref pw i j k) (* eps (- (rnd 2d0) 1d0))))))))
    s))

(define-oracle-test srf-remove-all-knots (:file "srf-tool" :trials 2000)
  (let ((s (%srf-removable-surface))
        (tol (case (rnd 8) (0 0d0) (1 1d-9) (2 1d-6) (3 1d-3) (4 1d-1) (5 1d0) (6 30d0) (t 1d6)))
        (dir (case (rnd 3) (0 +udir+) (1 +vdir+) (t +uvdir+))))
    (agree (list :surface s :tol tol :dir dir)
           (list (batten::srf-remove-all-knots s tol dir))
           (with-foreign ((sp s :surface))
             (with-stacks (sq)
               (with-foreign-out ((q :surface))
                 (let ((failed (c-flag-error-p (c-srf-remove-all-knots sp tol dir q sq))))
                   (values failed (unless failed (list (from-foreign q :surface)))))))))))

(defun %patch-param (knots)
  "A parameter for a patch corner in the domain of KNOTS: inside, an end, an
existing knot, or within the C's 1e-8 snapping tolerance of a knot (an end
knot nudged outward snaps back onto it)."
  (let* ((lo (aref knots 0)) (hi (aref knots (1- (length knots))))
         (k (aref knots (rnd (length knots)))))
    (case (rnd 12)
      (0 lo)
      (1 hi)
      ((2 3) k)
      ((4 5) (let ((x (+ k (- (rnd 1.8d-8) 0.9d-8))))
               ;; an end knot nudged outward snaps back; keep others inside
               (if (or (= k lo) (= k hi)) x (max lo (min hi x)))))
      (t (rnd-range lo hi)))))

(defun %patch-interval (knots)
  "Two corner parameters (values a b) in the domain of KNOTS, usually a < b,
now and then reversed or equal (NLib refuses those)."
  (let ((a (%patch-param knots)) (b (%patch-param knots)))
    ;; equal corners are refused; draw again so most trials get a patch
    (dotimes (i 4)
      (when (< (abs (- a b)) 2d-8)
        (setf b (%patch-param knots))))
    (case (rnd 40)
      (0 (values a a))
      (1 (values (max a b) (min a b)))
      (t (values (min a b) (max a b))))))

(define-oracle-test srf-extract-patch (:file "srf-tool" :trials 6000)
  (let ((s (%srf-tool-surface)))
    (multiple-value-bind (ul ur) (%patch-interval (surface-knots-u s))
      (multiple-value-bind (vl vr) (%patch-interval (surface-knots-v s))
        (agree (list :surface s :ul ul :ur ur :vl vl :vr vr)
               (list (batten::srf-extract-patch s ul ur vl vr))
               (with-foreign ((sp s :surface))
                 (with-foreign-out ((sq :surface))
                   (with-stacks (stp)
                     (with-stacks (stq)
                       (if (c-flag-error-p (c-srf-extract-patch sp ul ur vl vr sq stp stq))
                           (values t nil)
                           (values nil (list (from-foreign sq :surface)))))))))))))

(defun %spoil-knots (knots p)
  "A copy of the clamped degree-P KNOTS whose start multiplicity is P, which
N_KnotVectorIsValid refuses."
  (let ((k (copy-seq knots)))
    (setf (aref k p) (* 0.5d0 (+ (aref k p) (aref k (1+ p)))))
    k))

(define-oracle-test srf-elevate-degree (:file "srf-tool" :trials 4000)
  (let* ((s0 (%srf-tool-surface))
         (dir (%srf-tool-dir))
         (tt (case (rnd 30) (0 -1) (1 (- 18 (rnd 2))) (t (rnd 4))))
         (s (if (zerop (rnd 25))
                (batten::%make-surface (surface-degree-u s0) (surface-degree-v s0)
                                       (if (= dir batten::+vdir+)
                                           (surface-knots-u s0)
                                           (%spoil-knots (surface-knots-u s0) (surface-degree-u s0)))
                                       (if (= dir batten::+vdir+)
                                           (%spoil-knots (surface-knots-v s0) (surface-degree-v s0))
                                           (surface-knots-v s0))
                                       (surface-cpoints s0))
                s0)))
    (agree (list :surface s :t tt :dir dir)
           (list (batten::srf-elevate-degree s tt dir))
           (with-foreign ((sp s :surface))
             (with-foreign-out ((sq :surface))
               (with-stacks (stp)
                 (with-stacks (stq)
                   (if (c-flag-error-p (c-srf-elevate-degree sp tt dir sq stp stq))
                       (values t nil)
                       (values nil (list (from-foreign sq :surface)))))))))))

;;; ------------------------------------------------------------- L5-g0

(defun %msc-knots (p pool lo hi)
  "A clamped degree-P knot vector on [LO, HI] whose interior knots are some of
the POOL values (fractions of the domain), each up to multiplicity min(P, 2),
now and then nudged by less or more than the 1e-8 merging tolerance."
  (let ((interior nil))
    (dolist (x pool)
      (when (zerop (rnd 2))
        (let ((v (+ lo (* (- hi lo) (+ x (case (rnd 8) (0 4.5d-9) (1 3d-8) (2 -2d-9) (t 0d0)))))))
          (dotimes (j (1+ (rnd (min p 2))))
            (push v interior)))))
    (coerce (append (make-list (1+ p) :initial-element lo)
                    (sort interior #'<)
                    (make-list (1+ p) :initial-element hi))
            'batten::real-vector)))

(defun %msc-surfaces ()
  "(values surfaces k): K+1 random surfaces for N_MakeSrfsCompatible, of
degrees 1 to 4, rational or not, all 3D or all 2D, mostly sharing their
domains (exactly) and drawing interior knots from a shared pool."
  (let* ((k (rnd 4))
         (two-d (zerop (rnd 6)))
         (pool-u (let (l) (dotimes (i (1+ (rnd 4)) l) (push (rnd-range 0.05d0 0.95d0) l))))
         (pool-v (let (l) (dotimes (i (1+ (rnd 4)) l) (push (rnd-range 0.05d0 0.95d0) l))))
         (ulo (if (zerop (rnd 3)) 0d0 (rnd-range -5d0 5d0))) (uhi (+ ulo 0.5d0 (rnd 5d0)))
         (vlo (if (zerop (rnd 3)) 0d0 (rnd-range -5d0 5d0))) (vhi (+ vlo 0.5d0 (rnd 5d0)))
         (share-u (/= 0 (rnd 3))) (share-v (/= 0 (rnd 3)))
         (surfaces (make-array (1+ k))))
    (dotimes (i (1+ k))
      (let* ((p (1+ (rnd 4))) (q (1+ (rnd 4)))
             (rational (zerop (rnd 3)))
             (u (if (or share-u (zerop (rnd 3)))
                    (%msc-knots p pool-u ulo uhi)
                    (multiple-value-bind (lo hi) (batten-random::random-domain) (%msc-knots p pool-u lo hi))))
             (v (if (or share-v (zerop (rnd 3)))
                    (%msc-knots q pool-v vlo vhi)
                    (multiple-value-bind (lo hi) (batten-random::random-domain) (%msc-knots q pool-v lo hi))))
             (n+1 (- (length u) p 1)) (m+1 (- (length v) q 1))
             (net (make-cpoint-net n+1 m+1)))
        (dotimes (a n+1)
          (dotimes (b m+1)
            (let ((w (if rational (rnd-range 0.2d0 5d0) 1d0)))
              (setf (aref net a b 0) (* w (- (rnd 200d0) 100d0))
                    (aref net a b 1) (* w (- (rnd 200d0) 100d0))
                    (aref net a b 2) (if two-d +no-z+ (* w (- (rnd 200d0) 100d0)))
                    (aref net a b 3) (if rational w +no-w+)))))
        (setf (svref surfaces i) (batten::%make-surface p q u v net))))
    (values surfaces k)))

(defun %copy-surface-deep (s)
  "A copy of surface S sharing no arrays with it."
  (batten::%make-surface (surface-degree-u s) (surface-degree-v s)
                         (copy-seq (surface-knots-u s)) (copy-seq (surface-knots-v s))
                         (%msc-copy-array (surface-cpoints s))))

(defun %msc-copy-array (a)
  "A fresh copy of double-float array A."
  (let ((b (make-array (array-dimensions a) :element-type 'double-float)))
    (dotimes (i (array-total-size a) b)
      (setf (row-major-aref b i) (row-major-aref a i)))))

(define-oracle-test make-srfs-compatible (:file "srf-tool" :trials 1500)
  (multiple-value-bind (surfaces k) (%msc-surfaces)
    (let ((uorv (case (rnd 3) (0 +udir+) (1 +vdir+) (t +uvdir+))))
      (agree (list :surfaces surfaces :k k :uorv uorv)
             (let ((sc (map 'simple-vector #'%copy-surface-deep surfaces)))
               (coerce (batten::make-srfs-compatible sc k uorv) 'list))
             (with-stacks (s)
               (cffi:with-foreign-objects ((sp :pointer (1+ k)))
                 ;; TO-FOREIGN inside WITH-FOREIGN: the copies are freed with it
                 (with-foreign ((dummy (make-real-vector 1) :real-vector))
                   (declare (ignore dummy))
                   (dotimes (i (1+ k))
                     (setf (cffi:mem-aref sp :pointer i) (to-foreign (svref surfaces i) :surface)))
                   (let ((failed (c-flag-error-p (c-make-srfs-compatible sp k uorv s))))
                     (values failed
                             (unless failed
                               (let ((out nil))
                                 (dotimes (i (1+ k) (nreverse out))
                                   (push (from-foreign (cffi:mem-aref sp :pointer i) :surface) out)))))))))))))

(define-oracle-test make-srfs-compatible-uv (:file "srf-tool" :trials 800)
  (multiple-value-bind (surfaces k) (%msc-surfaces)
    (agree (list :surfaces surfaces :k k)
           (let ((sc (map 'simple-vector #'%copy-surface-deep surfaces)))
             (coerce (batten::make-srfs-compatible-uv sc k) 'list))
           (with-stacks (s)
             (cffi:with-foreign-objects ((sp :pointer (1+ k)))
               ;; TO-FOREIGN inside WITH-FOREIGN: the copies are freed with it
               (with-foreign ((dummy (make-real-vector 1) :real-vector))
                 (declare (ignore dummy))
                 (dotimes (i (1+ k))
                   (setf (cffi:mem-aref sp :pointer i) (to-foreign (svref surfaces i) :surface)))
                 (let ((failed (c-flag-error-p (c-make-srfs-compatible-uv sp k s))))
                   (values failed
                           (unless failed
                             (let ((out nil))
                               (dotimes (i (1+ k) (nreverse out))
                                 (push (from-foreign (cffi:mem-aref sp :pointer i) :surface) out))))))))))))
