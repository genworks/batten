(defun %random-insert-knots (knots p)
  "Knots to insert into KNOTS (degree P): sorted, strictly inside the domain,
some existing interior knots and some repeated, every resulting multiplicity
at most P.  Now and then an end knot, which NLib refuses, or none at all."
  (let* ((lo (aref knots 0)) (hi (aref knots (1- (length knots))))
         (interior (remove-if (lambda (x) (or (= x lo) (= x hi))) (coerce knots 'list)))
         (count (1+ (rnd 6)))
         (cands nil))
    (dotimes (i count)
      (push (case (rnd 6)
              (0 (if interior (nth (rnd (length interior)) interior) (rnd-range lo hi)))
              (1 (if cands (first cands) (rnd-range lo hi)))
              (t (rnd-range lo hi)))
            cands))
    (setf cands (sort (remove-if (lambda (x) (or (<= x lo) (>= x hi))) cands) #'<))
    (let ((accepted nil))
      (dolist (x cands)
        (when (<= (+ (%knot-multiplicity knots x) (count x accepted :test #'=) 1) p)
          (push x accepted)))
      (setf accepted (nreverse accepted))
      (case (rnd 20)
        (0 (setf accepted nil))
        (1 (push lo accepted))
        (2 (setf accepted (append accepted (list hi)))))
      (coerce accepted 'real-vector))))

(define-oracle-test srf-insert-knots (:file "srf-tool" :trials 6000)
  (let* ((s (%srf-tool-surface))
         (dir (case (rnd 41) (0 3) (t (if (zerop (rnd 2)) batten::+udir+ batten::+vdir+))))
         (knx (if (= dir batten::+vdir+)
                  (%random-insert-knots (surface-knots-v s) (surface-degree-v s))
                  (%random-insert-knots (surface-knots-u s) (surface-degree-u s)))))
    (agree (list :surface s :knx knx :dir dir)
           (list (batten::srf-insert-knots s knx dir))
           (with-foreign ((sp s :surface) (kx knx :knots))
             (with-foreign-out ((sq :surface))
               (with-stacks (stp)
                 (with-stacks (stq)
                   (if (c-flag-error-p (c-srf-insert-knots sp kx dir sq stp stq))
                       (values t nil)
                       (values nil (list (from-foreign sq :surface)))))))))))

(defun %random-removal-knot (knots p n)
  "An interior knot index r of KNOTS (degree P, highest control point index N)
with knots[r] /= knots[r+1], and its multiplicity; NIL when there is none."
  (let ((cands nil))
    (do ((r (1+ p) (1+ r))) ((> r n))
      (when (/= (aref knots r) (aref knots (1+ r)))
        (push r cands)))
    (when cands
      (let* ((r (nth (rnd (length cands)) cands))
             (s 0))
        (do ((i r (1- i))) ((or (< i 0) (/= (aref knots i) (aref knots r))))
          (incf s))
        (list r s)))))

(define-oracle-test srf-remove-one-knot (:file "srf-tool" :trials 10000)
  (let* ((s (random-surface :two-d (zerop (rnd 5)) :max-extra 8))
         (dir (case (rnd 41) (0 3) (t (if (zerop (rnd 2)) batten::+udir+ batten::+vdir+))))
         (vdir (= dir batten::+vdir+))
         (deg (if vdir (surface-degree-v s) (surface-degree-u s)))
         (rs (if vdir
                 (%random-removal-knot (surface-knots-v s) deg (surface-m s))
                 (%random-removal-knot (surface-knots-u s) deg (surface-n s))))
         (other (if vdir (surface-n s) (surface-m s))))
    (when rs
      (let* ((r (first rs))
             ;; now and then a multiplicity so large the C quits (u-direction only:
             ;; the v-direction has no such guard and would index out of bounds)
             (mult (if (and (= dir batten::+udir+) (zerop (rnd 20))) (+ deg 3 (rnd 3)) (second rs)))
             (f (rnd (1+ other)))
             (l (if (zerop (rnd 10)) (max 0 (1- f)) (+ f (rnd (- (1+ other) f)))))
             (mr (if (zerop (rnd 2)) most-positive-double-float (rnd 50d0))))
        (agree (list :surface s :r r :s mult :f f :l l :dir dir :mr mr)
               (list (batten::srf-remove-one-knot s r mult f l dir mr))
               (with-foreign ((sp s :surface))
                 (with-scalars ((cmr :double))
                   (setf (cffi:mem-ref cmr :double) mr)
                   (if (c-flag-error-p (c-srf-remove-one-knot sp r mult f l dir cmr))
                       (values t nil)
                       (values nil (list (cffi:mem-ref cmr :double)))))))))))

(defun %patch-param (knots)
  "A parameter for a patch corner in the domain of KNOTS: inside, an end, an
existing knot, or within the C's 1e-8 snapping tolerance of a knot (an end
knot nudged outward snaps back onto it)."
  (let* ((lo (aref knots 0)) (hi (aref knots (1- (length knots))))
         (k (aref knots (rnd (length knots)))))
    (case (rnd 12)
      (0 lo)
      (1 hi)
      ((2 3) k)
      ((4 5) (let ((x (+ k (- (rnd 1.8d-8) 0.9d-8))))
               ;; an end knot nudged outward snaps back; keep others inside
               (if (or (= k lo) (= k hi)) x (max lo (min hi x)))))
      (t (rnd-range lo hi)))))

(defun %patch-interval (knots)
  "Two corner parameters (values a b) in the domain of KNOTS, usually a < b,
now and then reversed or equal (NLib refuses those)."
  (let ((a (%patch-param knots)) (b (%patch-param knots)))
    ;; equal corners are refused; draw again so most trials get a patch
    (dotimes (i 4)
      (when (< (abs (- a b)) 2d-8)
        (setf b (%patch-param knots))))
    (case (rnd 40)
      (0 (values a a))
      (1 (values (max a b) (min a b)))
      (t (values (min a b) (max a b))))))

(define-oracle-test srf-extract-patch (:file "srf-tool" :trials 6000)
  (let ((s (%srf-tool-surface)))
    (multiple-value-bind (ul ur) (%patch-interval (surface-knots-u s))
      (multiple-value-bind (vl vr) (%patch-interval (surface-knots-v s))
        (agree (list :surface s :ul ul :ur ur :vl vl :vr vr)
               (list (batten::srf-extract-patch s ul ur vl vr))
               (with-foreign ((sp s :surface))
                 (with-foreign-out ((sq :surface))
                   (with-stacks (stp)
                     (with-stacks (stq)
                       (if (c-flag-error-p (c-srf-extract-patch sp ul ur vl vr sq stp stq))
                           (values t nil)
                           (values nil (list (from-foreign sq :surface)))))))))))))

(defun %spoil-knots (knots p)
  "A copy of the clamped degree-P KNOTS whose start multiplicity is P, which
N_KnotVectorIsValid refuses."
  (let ((k (copy-seq knots)))
    (setf (aref k p) (* 0.5d0 (+ (aref k p) (aref k (1+ p)))))
    k))

(define-oracle-test srf-elevate-degree (:file "srf-tool" :trials 4000)
  (let* ((s0 (%srf-tool-surface))
         (dir (%srf-tool-dir))
         (tt (case (rnd 30) (0 -1) (1 (- 18 (rnd 2))) (t (rnd 4))))
         (s (if (zerop (rnd 25))
                (batten::%make-surface (surface-degree-u s0) (surface-degree-v s0)
                                       (if (= dir batten::+vdir+)
                                           (surface-knots-u s0)
                                           (%spoil-knots (surface-knots-u s0) (surface-degree-u s0)))
                                       (if (= dir batten::+vdir+)
                                           (%spoil-knots (surface-knots-v s0) (surface-degree-v s0))
                                           (surface-knots-v s0))
                                       (surface-cpoints s0))
                s0)))
    (agree (list :surface s :t tt :dir dir)
           (list (batten::srf-elevate-degree s tt dir))
           (with-foreign ((sp s :surface))
             (with-foreign-out ((sq :surface))
               (with-stacks (stp)
                 (with-stacks (stq)
                   (if (c-flag-error-p (c-srf-elevate-degree sp tt dir sq stp stq))
                       (values t nil)
                       (values nil (list (from-foreign sq :surface)))))))))))
