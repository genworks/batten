(in-package :batten-tests)

(defun %copy-real-matrix (a)
  (let ((b (make-real-matrix (array-dimension a 0) (array-dimension a 1))))
    (dotimes (i (array-total-size a) b)
      (setf (row-major-aref b i) (row-major-aref a i)))))

(defun %removable-knot (knots deg count)
  "A random knot index r of an interior knot with knots[r] /= knots[r+1], and
its multiplicity s, for a knot vector of degree DEG with control points
0..COUNT; NIL when there is no interior knot."
  (let ((rs nil))
    (do ((r (1+ deg) (1+ r))) ((> r count))
      (when (/= (aref knots r) (aref knots (1+ r))) (push r rs)))
    (when rs
      (let* ((r (nth (rnd (length rs)) rs))
             (s (do ((j r (1- j)) (c 0 (1+ c))) ((/= (aref knots j) (aref knots r)) c))))
        (values r s)))))

(define-oracle-test fit-srf-removal-boundary (:file "srf-fit" :trials 8000)
  (let ((dir (if (zerop (rnd 50)) 3 (if (zerop (rnd 2)) batten::+udir+ batten::+vdir+)))
        sur r s)
    ;; a surface with an interior knot in the direction of removal
    (do () (r)
      (setf sur (random-surface :two-d (zerop (rnd 5))))
      (multiple-value-setq (r s)
        (if (= dir batten::+vdir+)
            (%removable-knot (surface-knots-v sur) (surface-degree-v sur) (surface-m sur))
            (%removable-knot (surface-knots-u sur) (surface-degree-u sur) (surface-n sur)))))
    (let* ((n (surface-n sur)) (m (surface-m sur))
           (other (if (= dir batten::+vdir+) n m))
           (f (rnd (1+ other)))
           (l (if (zerop (rnd 10)) (max 0 (1- f)) (+ f (rnd (- (1+ other) f)))))
           (br (random-real-matrix (1+ n) (1+ m) 1d0))
           (mr (case (rnd 3) (0 batten::+bigd+) (1 -1d0) (t (rnd 100d0)))))
      (agree (list :surface sur :r r :s s :f f :l l :dir dir :mr mr)
             (let ((b (%copy-real-matrix br)))
               (list (batten::fit-srf-removal-boundary sur r s f l dir b mr) b))
             (with-foreign ((sp sur :surface) (bp br :real-matrix))
               (with-scalars ((mrp :double))
                 (setf (cffi:mem-ref mrp :double) mr)
                 (values (c-flag-error-p (c-fit-srf-removal-boundary sp r s f l dir bp mrp))
                         (list (cffi:mem-ref mrp :double)
                               (from-foreign bp :real-matrix (1+ n) (1+ m))))))))))

;;; ------------------------------------------------ least-squares surface fits

(defun %copy-net (a)
  (let ((b (make-array (array-dimensions a) :element-type 'double-float)))
    (dotimes (i (array-total-size a) b)
      (setf (row-major-aref b i) (row-major-aref a i)))))

(defun %random-grid (rows cols &key (k 3) (rational nil) (two-d nil))
  "A ROWS x COLS net of K-coordinate points sampled roughly from a grid: a
perturbed lattice with a wavy height most of the time, scattered points now
and then, and now and then repeated rows or columns or one point everywhere
(the degenerate cases).  For K = 4 the points are weighted when RATIONAL and
lack z when TWO-D."
  (let ((a (make-array (list rows cols k) :element-type 'double-float :initial-element 0d0))
        (kind (rnd 12))
        (dx (+ 0.5d0 (rnd 10d0))) (dy (+ 0.5d0 (rnd 10d0)))
        (noise (case (rnd 3) (0 0d0) (1 0.1d0) (t (rnd 2d0))))
        (amp (rnd 20d0)) (fu (rnd 2d0)) (fv (rnd 2d0)))
    (dotimes (i rows)
      (dotimes (j cols)
        (let* ((x (if (= kind 0) (- (rnd 200d0) 100d0) (+ (* i dx) (- (rnd (* 2 noise)) noise))))
               (y (if (= kind 0) (- (rnd 200d0) 100d0) (+ (* j dy) (- (rnd (* 2 noise)) noise))))
               (z (if (= kind 0) (- (rnd 200d0) 100d0) (* amp (sin (+ (* fu i) (* fv j))))))
               (w (if rational (+ 0.2d0 (rnd 4.8d0)) 1d0)))
          (setf (aref a i j 0) (* w x) (aref a i j 1) (* w y))
          (when (>= k 3)
            (setf (aref a i j 2) (if two-d +no-z+ (* w z))))
          (when (= k 4)
            (setf (aref a i j 3) (if rational w +no-w+))))))
    (case kind
      ;; a repeated row or column
      (1 (when (> rows 2)
           (let ((i (1+ (rnd (- rows 2)))))
             (dotimes (j cols) (dotimes (c k) (setf (aref a i j c) (aref a (1- i) j c)))))))
      (2 (when (> cols 2)
           (let ((j (1+ (rnd (- cols 2)))))
             (dotimes (i rows) (dotimes (c k) (setf (aref a i j c) (aref a i (1- j) c)))))))
      ;; every point the same
      (3 (when (zerop (rnd 4))
           (dotimes (i rows) (dotimes (j cols) (dotimes (c k) (setf (aref a i j c) (aref a 0 0 c))))))))
    a))

(define-oracle-test fit-calc-srf-param-values (:file "srf-fit" :trials 6000)
  (let* ((n (rnd 11)) (m (rnd 11))
         (ptp (case (rnd 40) (0 3) (t (if (zerop (rnd 2)) +epoint+ +hpoint+))))
         (par (case (rnd 40) (0 7) (t (1+ (rnd 3)))))
         (a (if (= ptp +hpoint+)
                (%random-grid (1+ n) (1+ m) :k 4 :rational (zerop (rnd 2)) :two-d (zerop (rnd 5)))
                (%random-grid (1+ n) (1+ m))))
         (u0 (random-real-vector (1+ n)))
         (v0 (random-real-vector (1+ m))))
    (agree (list :n n :m m :ptp ptp :par par :a a)
           (let ((u (copy-seq u0)) (v (copy-seq v0)))
             (batten::fit-calc-srf-param-values a n m ptp par u v)
             (list u v))
           (with-foreign ((ap a (if (= ptp +hpoint+) :cpoint-net :point-net))
                          (up u0 :real-vector) (vp v0 :real-vector))
             (if (c-flag-error-p (c-fit-calc-srf-param-values ap n m ptp par up vp))
                 (values t nil)
                 (values nil (list (from-foreign up :real-vector (1+ n))
                                   (from-foreign vp :real-vector (1+ m)))))))))

(defun %random-fit-sizes ()
  "Highest data indexes R, S, control point indexes N, M and degrees P, Q for
a least-squares surface fit: valid mostly, now and then out of range."
  (let* ((r (1+ (rnd 12))) (s (1+ (rnd 12)))
         (n (1+ (rnd r))) (m (1+ (rnd s)))
         (p (1+ (rnd (min n 5)))) (q (1+ (rnd (min m 5)))))
    ;; ruled and bilinear cases more often
    (case (rnd 12)
      (0 (setf n 1 p 1))
      (1 (setf m 1 q 1))
      (2 (setf n 1 p 1 m 1 q 1))
      (3 (setf n r p (1+ (rnd (min n 5)))))
      (4 (case (rnd 5)
           (0 (setf n (1+ r)))
           (1 (setf n 0))
           (2 (setf p (1+ n)))
           (3 (setf m (1+ s)))
           (t (setf q (1+ m))))))
    (values r s n m p q)))

(define-oracle-test fit-srf-lst-sq-approx (:file "srf-fit" :trials 6000)
  (multiple-value-bind (r s n m p q) (%random-fit-sizes)
    (let ((pts (%random-grid (1+ r) (1+ s)))
          (par (case (rnd 40) (0 7) (t (1+ (rnd 3))))))
      (agree (list :r r :s s :n n :m m :p p :q q :par par :p-net pts)
             (let ((pl (%copy-net pts)))
               (list (batten::fit-srf-lst-sq-approx pl r s n m p q par) pl))
             (with-foreign ((pp pts :point-net))
               (with-stacks (sg)
                 (with-foreign-out ((sur :surface))
                   (if (c-flag-error-p (c-fit-srf-lst-sq-approx pp r s n m p q par sur sg))
                       (values t nil)
                       (values nil (list (from-foreign sur :surface)
                                         (from-foreign pp :point-net (1+ r) (1+ s))))))))))))

(defun %random-fit-params (count lo hi)
  "COUNT+1 nondecreasing parameters from LO to HI, now and then repeated."
  (let ((u (make-real-vector (1+ count))))
    (dotimes (i (1+ count))
      (setf (aref u i) (+ lo (rnd (- hi lo)))))
    (setf u (sort u #'<))
    (setf (aref u 0) lo (aref u count) hi)
    (when (and (> count 2) (zerop (rnd 6)))
      (let ((i (1+ (rnd (1- count)))))
        (setf (aref u i) (aref u (1- i)))))
    u))

(define-oracle-test fit-srf-lst-sq-knots (:file "srf-fit" :trials 6000)
  (multiple-value-bind (r s n m p q) (%random-fit-sizes)
    (let* ((ptp (case (rnd 40) (0 3) (t (if (zerop (rnd 2)) +epoint+ +hpoint+))))
           (a (if (= ptp +hpoint+)
                  (%random-grid (1+ r) (1+ s) :k 4 :rational (zerop (rnd 2)) :two-d (zerop (rnd 5)))
                  (%random-grid (1+ r) (1+ s))))
           (ulo (if (zerop (rnd 2)) 0d0 (- (rnd 10d0) 5d0))) (uhi (+ ulo 0.5d0 (rnd 5d0)))
           (vlo (if (zerop (rnd 2)) 0d0 (- (rnd 10d0) 5d0))) (vhi (+ vlo 0.5d0 (rnd 5d0)))
           (u (%random-fit-params r ulo uhi))
           (v (%random-fit-params s vlo vhi))
           (knu (if (and (<= 1 p n) (<= n r) (zerop (rnd 2)))
                    (batten::fit-calc-knot-vector-crv-approx u r n p (make-real-vector (+ n p 2)))
                    (random-knots (max p 1) (+ n 1) :lo ulo :hi uhi)))
           (knv (if (and (<= 1 q m) (<= m s) (zerop (rnd 2)))
                    (batten::fit-calc-knot-vector-crv-approx v s m q (make-real-vector (+ m q 2)))
                    (random-knots (max q 1) (+ m 1) :lo vlo :hi vhi))))
      ;; now and then a knot vector of the wrong length
      (when (zerop (rnd 30))
        (setf knu (random-knots (max p 1) (+ n 2) :lo ulo :hi uhi)))
      (agree (list :r r :s s :ptp ptp :u u :v v :knu knu :knv knv :n n :m m :p p :q q :a a)
             (let ((al (%copy-net a)))
               (list (batten::fit-srf-lst-sq-knots al r s ptp u v knu knv n m p q) al))
             (with-foreign ((ap a (if (= ptp +hpoint+) :cpoint-net :point-net))
                            (up u :real-vector) (vp v :real-vector)
                            (ku knu :knots) (kv knv :knots))
               (with-stacks (sg)
                 (with-foreign-out ((sur :surface))
                   (if (c-flag-error-p (c-fit-srf-lst-sq-knots ap r s ptp up vp ku kv n m p q sur sg))
                       (values t nil)
                       (values nil (list (from-foreign sur :surface)
                                         (from-foreign ap (if (= ptp +hpoint+) :cpoint-net :point-net)
                                                       (1+ r) (1+ s))))))))))))

;;; ------------------------------------------------ interpolation with given knots

(define-oracle-test fit-srf-to-pts-knots (:file "srf-fit" :trials 5000)
  (let* ((n (if (zerop (rnd 20)) 0 (1+ (rnd 10)))) (m (if (zerop (rnd 20)) 0 (1+ (rnd 10))))
         ;; degrees at least 1 (the C writes outside its band matrix for 0),
         ;; now and then above the point count; q = 0 is harmless
         (p (if (zerop (rnd 15)) (+ n 1) (1+ (rnd (max 1 (min n 5))))))
         (q (case (rnd 30) (0 0) (1 (+ m 1)) (t (1+ (rnd (max 1 (min m 5)))))))
         (ptp (case (rnd 40) (0 3) (t (if (zerop (rnd 2)) +epoint+ +hpoint+))))
         (a (if (= ptp +hpoint+)
                (%random-grid (1+ n) (1+ m) :k 4 :rational (zerop (rnd 2)) :two-d (zerop (rnd 5)))
                (%random-grid (1+ n) (1+ m))))
         (ulo (if (zerop (rnd 2)) 0d0 (- (rnd 10d0) 5d0))) (uhi (+ ulo 0.5d0 (rnd 5d0)))
         (vlo (if (zerop (rnd 2)) 0d0 (- (rnd 10d0) 5d0))) (vhi (+ vlo 0.5d0 (rnd 5d0)))
         (u (%random-fit-params n ulo uhi))
         (v (%random-fit-params m vlo vhi))
         ;; averaged knots mostly (a solvable system), random knots now and then
         (knu (if (and (<= p n) (plusp (rnd 6)))
                  (batten::fit-crv-calc-knot-vector u n p (make-real-vector (+ n p 2)))
                  (random-knots p (+ n 1) :lo ulo :hi uhi)))
         (knv (if (and (<= q m) (plusp (rnd 6)))
                  ;; degree 0 averages no parameters: 0/0 knots, as in the C
                  (batten::with-c-float-environment
                    (batten::fit-crv-calc-knot-vector v m q (make-real-vector (+ m q 2))))
                  (random-knots q (+ m 1) :lo vlo :hi vhi))))
    ;; now and then a knot vector of the wrong length
    (when (zerop (rnd 30))
      (setf knv (random-knots q (+ m 2) :lo vlo :hi vhi)))
    (agree (list :n n :m m :ptp ptp :u u :v v :knu knu :knv knv :p p :q q :a a)
           (list (batten::fit-srf-to-pts-knots a n m ptp u v knu knv p q))
           (with-foreign ((ap a (if (= ptp +hpoint+) :cpoint-net :point-net))
                          (up u :real-vector) (vp v :real-vector)
                          (ku knu :knots) (kv knv :knots))
             (with-stacks (sg)
               (with-foreign-out ((sur :surface))
                 (if (c-flag-error-p (c-fit-srf-to-pts-knots ap n m ptp up vp ku kv p q sur sg))
                     (values t nil)
                     (values nil (list (from-foreign sur :surface))))))))))

(define-oracle-test fit-srf-to-pts (:file "srf-fit" :trials 5000)
  (let* ((n (if (zerop (rnd 25)) 0 (1+ (rnd 10)))) (m (if (zerop (rnd 25)) 0 (1+ (rnd 10))))
         ;; degrees at least 1 (the C asks for a negative band for 0), now and
         ;; then above the point count; q = 0 is harmless (0/0 knots, as in C)
         (p (if (zerop (rnd 15)) (+ n 1) (1+ (rnd (max 1 (min n 5))))))
         (q (case (rnd 30) (0 0) (1 (+ m 1)) (t (1+ (rnd (max 1 (min m 5)))))))
         (par (case (rnd 40) (0 7) (t (1+ (rnd 3)))))
         (pts (%random-grid (1+ n) (1+ m))))
    (agree (list :n n :m m :p p :q q :par par :p-net pts)
           (list (batten::fit-srf-to-pts pts n m p q par))
           (with-foreign ((pp pts :point-net))
             (with-stacks (sg)
               (with-foreign-out ((sur :surface))
                 (if (c-flag-error-p (c-fit-srf-to-pts pp n m p q par sur sg))
                     (values t nil)
                     (values nil (list (from-foreign sur :surface))))))))))

;;; ------------------------------------------------ bicubic fit to points and normals

(defun %random-normals (rows cols)
  "A ROWS x COLS point-net of normals: random directions, now and then a zero
one (its projections fail) or a tiny one."
  (let ((a (make-point-net rows cols)))
    (dotimes (i rows a)
      (dotimes (j cols)
        (let ((x (- (rnd 2d0) 1d0)) (y (- (rnd 2d0) 1d0)) (z (+ 0.2d0 (rnd 1d0))))
          (case (rnd 40)
            (0 (setf x 0d0 y 0d0 z 0d0))
            (1 (setf x 1d-200 y 0d0 z 0d0)))
          (setf (aref a i j 0) x (aref a i j 1) y (aref a i j 2) z))))))

(define-oracle-test fit-pts-normals (:file "srf-fit" :trials 3000)
  ;; K, L >= 2: the C reads tangents it never set for less
  (let* ((k (+ 2 (rnd 7))) (l (+ 2 (rnd 7)))
         (pts (%random-grid (1+ k) (1+ l)))
         (nrm (unless (zerop (rnd 5)) (%random-normals (1+ k) (1+ l))))
         (tan (case (rnd 40) (0 0) (t (if (zerop (rnd 2)) +bessel+ +akima+)))))
    ;; closed now and then in u, in v or both
    (when (zerop (rnd 4))
      (dotimes (j (1+ l)) (dotimes (c 3) (setf (aref pts k j c) (aref pts 0 j c)))))
    (when (zerop (rnd 4))
      (dotimes (i (1+ k)) (dotimes (c 3) (setf (aref pts i l c) (aref pts i 0 c)))))
    (agree (list :k k :l l :tan tan :p-net pts :n-net nrm)
           (list (batten::fit-pts-normals pts nrm k l tan))
           (with-foreign ((pp pts :point-net))
             (with-stacks (sg)
               (with-foreign-out ((sur :surface))
                 (flet ((run (np)
                          (if (c-flag-error-p (c-fit-pts-normals pp np k l tan sur sg))
                              (values t nil)
                              (values nil (list (from-foreign sur :surface))))))
                   (if nrm
                       (with-foreign ((np nrm :point-net)) (run np))
                       (run (cffi:null-pointer))))))))))

;;; ------------------------------------------------ fit to points and boundary curves

(defun %net-row-curve (deg knots net fixed index-u)
  "The curve of degree DEG and KNOTS whose control points are row (INDEX-U
true: Pw[i][FIXED]) or column (Pw[FIXED][j]) of the cpoint-net NET."
  (let* ((cnt (if index-u (array-dimension net 0) (array-dimension net 1)))
         (cp (make-cpoint-array cnt)))
    (dotimes (i cnt)
      (dotimes (c 4)
        (setf (aref cp i c) (if index-u (aref net i fixed c) (aref net fixed i c)))))
    (batten::%make-curve deg (copy-seq knots) cp)))

(defun %sorted-params (count lo hi)
  "COUNT+1 sorted parameters from LO to HI, the ends exact; crowded towards
LO now and then."
  (let ((u (make-real-vector (1+ count)))
        (e (if (zerop (rnd 2)) 1 (+ 2 (rnd 3)))))
    (dotimes (i (1+ count)) (setf (aref u i) (+ lo (* (- hi lo) (expt (rnd 1d0) e)))))
    (setf u (sort u #'<))
    (setf (aref u 0) lo (aref u count) hi)
    u))

(defun %tame-surface ()
  "A surface of degrees 2 or 3 (1 now and then) over a perturbed lattice of
control points, so that its boundary curves do not fold back on themselves;
rational now and then."
  (let* ((p (if (zerop (rnd 30)) 1 (+ 2 (rnd 2)))) (q (if (zerop (rnd 30)) 1 (+ 2 (rnd 2))))
         (n+1 (+ p 1 (rnd 7))) (m+1 (+ q 1 (rnd 7)))
         (rational (zerop (rnd 10)))
         (net (make-cpoint-net n+1 m+1))
         (dx (+ 1d0 (rnd 10d0))) (dy (+ 1d0 (rnd 10d0)))
         (noise (* 0.3d0 (min dx dy) (rnd 1d0)))
         (amp (rnd 10d0)) (fu (rnd 1.5d0)) (fv (rnd 1.5d0)))
    (dotimes (i n+1)
      (dotimes (j m+1)
        (let ((w (if rational (+ 0.5d0 (rnd 2d0)) 1d0)))
          (setf (aref net i j 0) (* w (+ (* i dx) (- (rnd (* 2 noise)) noise)))
                (aref net i j 1) (* w (+ (* j dy) (- (rnd (* 2 noise)) noise)))
                (aref net i j 2) (* w amp (sin (+ (* fu i) (* fv j))))
                (aref net i j 3) (if rational w +no-w+)))))
    (flet ((knots (deg cnt lo hi)
             ;; random knots, crowded towards LO now and then
             (let ((k (random-knots deg cnt :lo lo :hi hi))
                   (e (if (zerop (rnd 2)) 1 (+ 2 (rnd 3)))))
               (when (> e 1)
                 (do ((i (1+ deg) (1+ i))) ((>= i cnt))
                   (setf (aref k i) (+ lo (* (- hi lo) (expt (/ (- (aref k i) lo) (- hi lo)) e))))))
               k)))
      (multiple-value-bind (ulo uhi) (batten-random::random-domain)
        (multiple-value-bind (vlo vhi) (batten-random::random-domain)
          (batten::%make-surface p q (knots p n+1 ulo uhi) (knots q m+1 vlo vhi) net))))))

(define-oracle-test fit-srf-to-pts-and-boundary (:file "srf-fit" :trials 3000)
  ;; boundary curves that do not fold back on themselves: the parameters
  ;; computed from closest points on them stay ascending (the least-squares
  ;; fit reads memory the C never set for unsorted ones)
  (let* ((sur (%tame-surface))
         (p (surface-degree-u sur)) (q (surface-degree-v sur))
         (ku (surface-knots-u sur)) (kv (surface-knots-v sur))
         (net (surface-cpoints sur))
         (n0 (surface-n sur)) (m0 (surface-m sur))
         ;; MU > p and MV > q, now and then many points per span
         (mu (+ p 1 (if (zerop (rnd 3)) (+ 20 (rnd 60)) (rnd 12))))
         (mv (+ q 1 (if (zerop (rnd 3)) (+ 20 (rnd 60)) (rnd 12))))
         (u (%sorted-params mu (aref ku 0) (aref ku (1- (length ku)))))
         (v (%sorted-params mv (aref kv 0) (aref kv (1- (length kv)))))
         (pts (make-point-net (1+ mu) (1+ mv)))
         (noise (case (rnd 3) (0 0d0) (1 0.01d0) (t 1d0)))
         (cur-u (list (%net-row-curve p ku net 0 t) (%net-row-curve p ku net m0 t)))
         (cur-v (list (%net-row-curve q kv net 0 nil) (%net-row-curve q kv net n0 nil)))
         (meth (case (rnd 20) (0 3) (t (1+ (rnd 2)))))
         (n (+ p (rnd (max 1 (- mu p)))))
         (m (+ q (rnd (max 1 (- mv q)))))
         (given (zerop (rnd 3)))
         (up (when given u))
         (vp (when given v)))
    ;; the points: the surface at the parameters, the interior perturbed
    (let ((pt (make-point)))
      (dotimes (i (1+ mu))
        (dotimes (j (1+ mv))
          (batten::srf-eval-pt sur (aref u i) (aref v j) +left+ +left+ pt)
          (dotimes (c 3)
            (setf (aref pts i j c)
                  (if (and (< 0 i mu) (< 0 j mv))
                      (+ (aref pt c) (- (rnd (* 2 noise)) noise))
                      (aref pt c)))))))
    ;; now and then something out of range
    (case (rnd 40)
      (0 (setf n mu))
      (1 (setf vp nil))
      (2 (setf cur-u (list (first cur-u) (%net-row-curve p (surface-knots-v sur) net m0 t)))))
    (agree (list :mu mu :mv mv :up up :vp vp :cur-u cur-u :cur-v cur-v :meth meth :n n :m m :p-net pts)
           (list (batten::fit-srf-to-pts-and-boundary pts mu mv up vp cur-u cur-v meth n m))
           (with-foreign ((pp pts :point-net))
             (let ((cu (batten-oracle::falloc :pointer 2))
                   (cv (batten-oracle::falloc :pointer 2)))
               (setf (cffi:mem-aref cu :pointer 0) (batten-oracle::to-foreign (first cur-u) :curve)
                     (cffi:mem-aref cu :pointer 1) (batten-oracle::to-foreign (second cur-u) :curve)
                     (cffi:mem-aref cv :pointer 0) (batten-oracle::to-foreign (first cur-v) :curve)
                     (cffi:mem-aref cv :pointer 1) (batten-oracle::to-foreign (second cur-v) :curve))
               (with-stacks (sg)
                 (with-foreign-out ((s :surface))
                   (flet ((run (upp vpp)
                            (if (c-flag-error-p (c-fit-srf-to-pts-and-boundary pp mu mv upp vpp cu cv meth n m s sg))
                                (values t nil)
                                (values nil (list (from-foreign s :surface))))))
                     (cond ((and up vp) (with-foreign ((upp up :real-vector) (vpp vp :real-vector)) (run upp vpp)))
                           (up (with-foreign ((upp up :real-vector)) (run upp (cffi:null-pointer))))
                           (t (run (cffi:null-pointer) (cffi:null-pointer))))))))))))

;;; ------------------------------------------------ approximation to a tolerance

(define-oracle-test fit-srf-approx-tol (:file "srf-fit" :trials 3000)
  (let* ((mu (+ 1 (rnd 10))) (mv (+ 1 (rnd 10)))
         ;; start degrees at least 1 (0 asks the C for a negative band)
         (ps (1+ (rnd (min mu 2)))) (qs (1+ (rnd (min mv 2))))
         (pr (min mu (+ ps (rnd 3)))) (qr (min mv (+ qs (rnd 3))))
         (pts (%random-grid (1+ mu) (1+ mv)))
         (e (case (rnd 6) (0 1d-6) (1 1d-2) (2 0.5d0) (3 (rnd 5d0)) (4 50d0) (t 1d4)))
         (ktp (if (zerop (rnd 2)) +single+ +multiple+))
         (atp (if (zerop (rnd 2)) +yes+ +no+)))
    ;; now and then degrees out of range
    (case (rnd 30)
      (0 (setf pr (1+ mu)))
      (1 (setf qr (max 1 (1- qs)))))
    (agree (list :mu mu :mv mv :ps ps :pr pr :qs qs :qr qr :e e :ktp ktp :atp atp :p-net pts)
           (list (batten::fit-srf-approx-tol pts mu mv ps pr qs qr e ktp atp))
           (with-foreign ((pp pts :point-net))
             (with-stacks (sg)
               (with-foreign-out ((sur :surface))
                 (if (c-flag-error-p (c-fit-srf-approx-tol pp mu mv ps pr qs qr e ktp atp sur sg))
                     (values t nil)
                     (values nil (list (from-foreign sur :surface))))))))))

;;; ------------------------------------------------ surface function interpolation

(defun %increasing-params (count)
  "COUNT+1 strictly increasing parameters, gaps at least 0.05."
  (let ((u (make-real-vector (1+ count)))
        (x (if (zerop (rnd 2)) 0d0 (- (rnd 10d0) 5d0))))
    (dotimes (i (1+ count) u)
      (setf (aref u i) x)
      (setf x (+ x 0.05d0 (rnd (if (zerop (rnd 3)) 0.2d0 2d0)))))))

(define-oracle-test fit-srf-func-interp (:file "srf-fit" :trials 5000)
  (let* ((n (if (zerop (rnd 20)) 0 (1+ (rnd 10)))) (m (if (zerop (rnd 20)) 0 (1+ (rnd 10))))
         ;; p >= 1 (the C writes outside its band matrix for 0); q = 0 is harmless
         (p (if (zerop (rnd 15)) (+ n 1) (1+ (rnd (max 1 (min n 5))))))
         (q (case (rnd 30) (0 0) (1 (+ m 1)) (t (1+ (rnd (max 1 (min m 5)))))))
         (f (if (zerop (rnd 10))
                (make-real-matrix (1+ n) (1+ m))
                (random-real-matrix (1+ n) (1+ m))))
         ;; strictly increasing parameters keep the C inside its band matrix
         (u (%increasing-params n))
         (v (%increasing-params m)))
    (agree (list :n n :m m :p p :q q :u u :v v :f f)
           (list (batten::fit-srf-func-interp f n m p q u v))
           (with-foreign ((fp f :real-matrix) (up u :real-vector) (vp v :real-vector))
             (with-stacks (sg)
               (with-foreign-out ((sfn :sfun))
                 (if (c-flag-error-p (c-fit-srf-func-interp fp n m p q up vp sfn sg))
                     (values t nil)
                     (values nil (list (from-foreign sfn :sfun))))))))))

;;; ------------------------------------------------ knot removal

(defun %copy-surface (sur)
  (batten::%make-surface (surface-degree-u sur) (surface-degree-v sur)
                         (copy-seq (surface-knots-u sur)) (copy-seq (surface-knots-v sur))
                         (%copy-net (surface-cpoints sur))))

(defun %new-interior-knots (knots count)
  "COUNT sorted random knots strictly inside the domain of KNOTS."
  (let* ((lo (aref knots 0)) (hi (aref knots (1- (length knots))))
         (ks (sort (let (l) (dotimes (i count l) (push (+ lo (* (- hi lo) (+ 0.01d0 (rnd 0.98d0)))) l)))
                   #'<)))
    (coerce ks 'real-vector)))

(defun %check-params (knots count)
  "COUNT+1 sorted parameters spanning the domain of KNOTS, the ends exact,
now and then a knot among them."
  (let* ((lo (aref knots 0)) (hi (aref knots (1- (length knots))))
         (u (make-real-vector (1+ count))))
    (dotimes (i (1+ count))
      (setf (aref u i) (if (zerop (rnd 6))
                           (aref knots (rnd (length knots)))
                           (+ lo (rnd (- hi lo))))))
    (setf u (sort u #'<))
    (setf (aref u 0) lo (aref u count) hi)
    u))

(define-oracle-test fit-srf-approx-remove-knots (:file "srf-fit" :trials 2000)
  (let ((sur (random-surface :max-degree 4 :max-extra 6 :two-d (zerop (rnd 5))))
        (dir (case (rnd 3) (0 +udir+) (1 +vdir+) (t +uvdir+))))
    ;; knots inserted now and then: removable within rounding
    (when (zerop (rnd 2))
      (setf sur (batten::srf-insert-knots sur (%new-interior-knots (surface-knots-u sur) (1+ (rnd 3))) +udir+)))
    (when (zerop (rnd 2))
      (setf sur (batten::srf-insert-knots sur (%new-interior-knots (surface-knots-v sur) (1+ (rnd 3))) +vdir+)))
    (let* ((mu (1+ (rnd 14))) (mv (1+ (rnd 14)))
           (up (%check-params (surface-knots-u sur) mu))
           (vp (%check-params (surface-knots-v sur) mv))
           (e (progn
                ;; now and then a parameter past the end of the domain: the
                ;; evaluations fail on it (when they reach it)
                (when (zerop (rnd 40))
                  (if (zerop (rnd 2))
                      (incf (aref up mu) 0.5d0)
                      (incf (aref vp mv) 0.5d0)))
                (case (rnd 8) (0 0d0) (1 1d-9) (2 1d-3) (3 (rnd 1d0)) (4 (rnd 20d0))
                (5 (rnd 200d0)) (6 1d4) (t 1d30))))
           (er (let ((a (make-real-matrix (1+ mu) (1+ mv))))
                 (unless (zerop (rnd 3))
                   (dotimes (i (1+ mu))
                     (dotimes (j (1+ mv))
                       (setf (aref a i j) (rnd (if (< e 1d10) (max e 1d-6) 10d0))))))
                 a)))
      (agree (list :surface sur :up up :vp vp :mu mu :mv mv :e e :dir dir :er er)
             (let ((s2 (%copy-surface sur)) (er2 (%copy-real-matrix er)))
               (batten::fit-srf-approx-remove-knots s2 up vp er2 mu mv e dir)
               (list s2 er2))
             (with-foreign ((sp sur :surface) (upp up :real-vector) (vpp vp :real-vector)
                            (erp er :real-matrix))
               (if (c-flag-error-p (c-fit-srf-approx-remove-knots sp upp vpp erp mu mv e dir))
                   (values t nil)
                   (values nil (list (from-foreign sp :surface)
                                     (from-foreign erp :real-matrix (1+ mu) (1+ mv))))))))))

;;; ------------------------------------------------ interpolation with boundaries

(defun %curve-pair-pointer (curves)
  "A foreign NL_CURVE *[2] holding the two curves of the list CURVES."
  (let ((cp (batten-oracle::falloc :pointer 2)))
    (setf (cffi:mem-aref cp :pointer 0) (batten-oracle::to-foreign (first curves) :curve)
          (cffi:mem-aref cp :pointer 1) (batten-oracle::to-foreign (second curves) :curve))
    cp))

(define-oracle-test fit-srf-interp-boundary (:file "srf-fit" :trials 2000)
  ;; a surface whose boundary rows and columns make the boundary curves, and
  ;; the grid of its points at sorted parameters, the interior perturbed
  (let* ((sur (%tame-surface))
         (p (surface-degree-u sur)) (q (surface-degree-v sur))
         (ku (surface-knots-u sur)) (kv (surface-knots-v sur))
         (net (surface-cpoints sur))
         (n0 (surface-n sur)) (m0 (surface-m sur))
         (k (+ 2 (if (zerop (rnd 4)) (+ 10 (rnd 30)) (rnd 10))))
         (l (+ 2 (if (zerop (rnd 4)) (+ 10 (rnd 30)) (rnd 10))))
         (u (%sorted-params k (aref ku 0) (aref ku (1- (length ku)))))
         (v (%sorted-params l (aref kv 0) (aref kv (1- (length kv)))))
         (pts (make-point-net (1+ k) (1+ l)))
         (noise (case (rnd 3) (0 0d0) (1 0.01d0) (t 0.5d0)))
         (bnd-u (list (%net-row-curve p ku net 0 t) (%net-row-curve p ku net m0 t)))
         (bnd-v (list (%net-row-curve q kv net 0 nil) (%net-row-curve q kv net n0 nil)))
         ;; the parameters: none, the points' own, or those on another domain
         (up (case (rnd 3)
               (0 nil)
               (1 u)
               (t (let ((a (- (rnd 4d0) 2d0)))
                    (%sorted-params k a (+ a 0.5d0 (rnd 3d0)))))))
         (vp (case (rnd 3)
               (0 nil)
               (1 v)
               (t (let ((a (- (rnd 4d0) 2d0)))
                    (%sorted-params l a (+ a 0.5d0 (rnd 3d0))))))))
    (let ((pt (make-point)))
      (dotimes (i (1+ k))
        (dotimes (j (1+ l))
          (batten::srf-eval-pt sur (aref u i) (aref v j) +left+ +left+ pt)
          (dotimes (c 3)
            (setf (aref pts i j c)
                  (if (and (< 0 i k) (< 0 j l))
                      (+ (aref pt c) (- (rnd (* 2 noise)) noise))
                      (aref pt c)))))))
    ;; non-rational boundaries (a rational one now and then), and now and
    ;; then a pair that is not compatible
    (unless (zerop (rnd 30))
      (dolist (c (append bnd-u bnd-v)) (batten::crv-rat-to-non-rat c)))
    (when (zerop (rnd 30))
      (setf bnd-v (list (first bnd-v) (%net-row-curve p (copy-seq ku) net 0 t))))
    (agree (list :k k :l l :bnd-u bnd-u :bnd-v bnd-v :u up :v vp :p-net pts)
           (list (batten::fit-srf-interp-boundary pts k l bnd-u bnd-v up vp))
           (with-foreign ((pp pts :point-net))
             (let ((cu (%curve-pair-pointer bnd-u))
                   (cv (%curve-pair-pointer bnd-v)))
               (with-stacks (sg)
                 (with-foreign-out ((s :surface))
                   (flet ((run (upp vpp)
                            (if (c-flag-error-p (c-fit-srf-interp-boundary pp k l cu cv upp vpp s sg))
                                (values t nil)
                                (values nil (list (from-foreign s :surface))))))
                     (cond ((and up vp)
                            (with-foreign ((upp up :real-vector) (vpp vp :real-vector)) (run upp vpp)))
                           (up (with-foreign ((upp up :real-vector)) (run upp (cffi:null-pointer))))
                           (vp (with-foreign ((vpp vp :real-vector)) (run (cffi:null-pointer) vpp)))
                           (t (run (cffi:null-pointer) (cffi:null-pointer))))))))))))

;;; ------------------------------------------------ bicubic interpolation

(define-oracle-test fit-srf-interp-bicubic (:file "srf-fit" :trials 2000)
  ;; K, L >= 2: N_FitPtsNormals reads tangents it never set for less
  (let* ((k (+ 2 (rnd 7))) (l (+ 2 (rnd 7)))
         (pts (%random-grid (1+ k) (1+ l)))
         (tan (case (rnd 40) (0 0) (t (if (zerop (rnd 2)) +bessel+ +akima+)))))
    ;; closed now and then in u, in v or both
    (when (zerop (rnd 4))
      (dotimes (j (1+ l)) (dotimes (c 3) (setf (aref pts k j c) (aref pts 0 j c)))))
    (when (zerop (rnd 4))
      (dotimes (i (1+ k)) (dotimes (c 3) (setf (aref pts i l c) (aref pts i 0 c)))))
    (agree (list :k k :l l :tan tan :p-net pts)
           (list (batten::fit-srf-interp-bicubic pts k l tan))
           (with-foreign ((pp pts :point-net))
             (with-stacks (sg)
               (with-foreign-out ((sur :surface))
                 (if (c-flag-error-p (c-fit-srf-interp-bicubic pp k l tan sur sg))
                     (values t nil)
                     (values nil (list (from-foreign sur :surface))))))))))
