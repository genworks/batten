(defun %cf2-conic-points (count)
  "COUNT points for conic fitting: random, or with collinear runs, corners
and a closed polygon now and then."
  (let ((pts (make-point-array count)))
    (case (rnd 6)
      (0                                ; collinear runs
       (let ((x 0d0) (y 0d0) (dx 1d0) (dy 0d0))
         (dotimes (i count)
           (setf (aref pts i 0) x (aref pts i 1) y (aref pts i 2) 0d0)
           (when (zerop (rnd 3))
             (let ((a (rnd 6.28d0))) (setf dx (cos a) dy (sin a))))
           (let ((step (+ 1d0 (rnd 5d0))))
             (setf x (+ x (* step dx)) y (+ y (* step dy)))))))
      (1                                ; on a circle, often closed
       (let ((r (+ 1d0 (rnd 50d0))) (closed (and (> count 3) (zerop (rnd 2)))))
         (dotimes (i count)
           (let ((a (* (/ (* 2 pi) (if closed (1- count) (+ count 2))) i)))
             (setf (aref pts i 0) (* r (cos a)) (aref pts i 1) (* r (sin a)) (aref pts i 2) 0d0)))
         (when closed
           (dotimes (k 3) (setf (aref pts (1- count) k) (aref pts 0 k))))))
      (2                                ; integer lattice: right angles and lines
       (let ((x 0) (y 0))
         (dotimes (i count)
           (setf (aref pts i 0) (float x 1d0) (aref pts i 1) (float y 1d0) (aref pts i 2) 0d0)
           (if (zerop (rnd 2)) (incf x (1+ (rnd 3))) (incf y (- (rnd 7) 3)))
           (when (and (= (aref pts i 0) x) (= (aref pts i 1) y)) (incf x)))))
      (t (let ((r (%cf2-planar (random-points count))))
           (dotimes (i count) (dotimes (k 3) (setf (aref pts i k) (aref r i k)))))))
    pts))

(define-oracle-test fit-crv-conics (:file "crv-fit" :trials 10000)
  (let* ((kk (if (zerop (rnd 30)) (rnd 2) (+ 2 (rnd 12))))
         (pts (%cf2-conic-points (1+ kk)))
         (par (%cf2-par))
         (tan (case (rnd 30) (0 0) (t (if (zerop (rnd 2)) +bessel+ +akima+))))
         (csp (if (zerop (rnd 2)) +cusp+ +nocusp+)))
    (agree (list :kk kk :par par :tan tan :csp csp :pts pts)
           (list (batten::fit-crv-conics pts kk par tan csp))
           (with-foreign ((pp pts :point-array))
             (%cf2-c-curve (cur sg) (c-fit-crv-conics pp kk par tan csp cur sg))))))

(defun %cf2-weighted-case ()
  "Inputs for FIT-CRV-WEIGHTED-LST-SQ-KNOTS: dense data (about four points a
span), constrained points (WP < 0) never adjacent, derivatives at ascending
indexes, the knots averaged from the parameters."
  (let* ((n (1+ (rnd 8)))
         (p (1+ (rnd (min n 5))))
         (r (+ (* 4 (1+ n)) (rnd 20)))
         (ptp (case (rnd 30) (0 3) (t (if (zerop (rnd 2)) +crv-fit-epoint+ +crv-fit-hpoint+))))
         (rational (zerop (rnd 2))) (two-d (zerop (rnd 5)))
         (e (%cf2-data (1+ r) ptp :rational rational :two-d two-d))
         (wp (let ((v (make-real-vector (1+ r))))
               (dotimes (i (1+ r) v) (setf (aref v i) (+ 0.1d0 (rnd 5d0))))))
         ;; constraints in all: fewer than n, but now and then too many
         (budget (if (zerop (rnd 15)) (+ n (rnd 2)) (rnd n))))
    ;; constrained points: the ends often, interior ones never adjacent
    (when (and (plusp budget) (zerop (rnd 2))) (setf (aref wp 0) -1d0) (decf budget))
    (when (and (plusp budget) (zerop (rnd 2))) (setf (aref wp r) -1d0) (decf budget))
    (dotimes (c (rnd (1+ budget)))
      (let ((i (1+ (rnd (1- r)))))
        (when (and (> (aref wp (1- i)) 0d0) (> (aref wp i) 0d0) (> (aref wp (1+ i)) 0d0))
          (setf (aref wp i) -1d0)
          (decf budget))))
    (let* ((idx (let (l) (dotimes (i (1+ r)) (when (zerop (rnd 6)) (push i l))) (nreverse l)))
           (s (1- (length idx)))
           (ii (make-array (length idx) :element-type 'fixnum :initial-contents idx))
           (wd (let ((v (make-real-vector (length idx))))
                 (dotimes (j (length idx) v)
                   (setf (aref v j) (if (and (plusp budget) (zerop (rnd 3)))
                                        (progn (decf budget) -1d0)
                                        (+ 0.1d0 (rnd 3d0)))))))
           (f (%cf2-data (length idx) ptp :rational rational :two-d two-d))
           (u (%cf2-params (1+ r)))
           (knt (let ((k (batten::fit-calc-knot-vector-crv-approx u r n p (make-real-vector (+ n p 2)))))
                  (if (zerop (rnd 20)) (subseq k 1) k))))
      (values e wp r f wd ii s ptp u knt n p))))

(define-oracle-test fit-crv-weighted-lst-sq-knots (:file "crv-fit" :trials 8000)
  (multiple-value-bind (e wp r f wd ii s ptp u knt n p) (%cf2-weighted-case)
    (agree (list :r r :s s :ptp ptp :n n :p p :wp wp :wd wd :ii ii :u u :knt knt)
           (list (batten::fit-crv-weighted-lst-sq-knots e wp r f wd ii s ptp u knt n p))
           (with-foreign ((ep e (%cf2-type ptp)) (wpp wp :real-vector) (fp f (%cf2-type ptp))
                          (wdp wd :real-vector) (ip ii :index-vector) (up u :real-vector) (kp knt :knots))
             (%cf2-c-curve (cur sg)
                           (c-fit-crv-weighted-lst-sq-knots ep wpp r fp wdp ip s ptp up kp n p cur sg))))))

(define-oracle-test fit-crv-high-derivs (:file "crv-fit" :trials 10000)
  (let* ((nn (1+ (rnd 12)))
         (p (1+ (rnd 7)))
         (kk (case (rnd 20) (0 p) (1 -1) (t (rnd p))))
