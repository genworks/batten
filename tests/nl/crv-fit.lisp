;;; ------------------------------------------------------------- L1-g5

(defun %crv-fit-copy-array (a)
  (let ((b (make-array (array-dimensions a) :element-type (array-element-type a))))
    (dotimes (i (array-total-size a) b) (setf (row-major-aref b i) (row-major-aref a i)))))

(defun %crv-fit-copy-rmatrix (rma)
  (let ((r (batten::copy-rmatrix rma)))
    (when (batten::rmatrix-rm r)
      (setf (batten::rmatrix-rm r) (%crv-fit-copy-array (batten::rmatrix-rm r))))
    r))

(define-oracle-test fit-crv-c-pts-from-srf-data (:file "crv-fit" :trials 3000)
  (let* ((n (rnd 9)) (m (rnd 9))
         (ptp (case (rnd 25) (0 3) (t (if (zerop (rnd 2)) +crv-fit-epoint+ +crv-fit-hpoint+))))
         (dir (case (rnd 25) (0 0) (t (if (zerop (rnd 2)) +udir+ +vdir+))))
         (k (if (= dir +vdir+) (rnd (1+ n)) (rnd (1+ m))))
         ;; the LU-decomposed matrix the C reads, sized to the row or column
         (cm (%lu-rmatrix (if (= dir +vdir+) m n)))
         (count (1+ (if (= dir +vdir+) m n)))
         (a (if (= ptp +crv-fit-hpoint+)
                (let ((net (make-cpoint-net (1+ n) (1+ m)))
                      (rational (zerop (rnd 2))) (two-d (zerop (rnd 5))))
                  (dotimes (i (1+ n) net)
                    (dotimes (j (1+ m))
                      (let ((c (random-cpoint :rational rational :two-d two-d)))
                        (dotimes (x 4) (setf (aref net i j x) (aref c x)))))))
                (let ((net (make-point-net (1+ n) (1+ m))))
                  (dotimes (i (1+ n) net)
                    (dotimes (j (1+ m))
                      (dotimes (x 3) (setf (aref net i j x) (- (rnd 200d0) 100d0)))))))))
    (agree (list :n n :m m :ptp ptp :dir dir :k k :mtp (batten::rmatrix-mtp cm))
           (list (batten::fit-crv-c-pts-from-srf-data a n m ptp k dir (%crv-fit-copy-rmatrix cm)
                                                      (make-cpoint-array count)))
           (with-foreign ((ap a (if (= ptp +crv-fit-hpoint+) :cpoint-net :point-net))
                          (cp cm :rmatrix))
             (with-foreign-out ((qw :cpoint-array count))
               (values (c-flag-error-p (c-fit-crv-c-pts-from-srf-data ap n m ptp k dir cp qw))
                       (list (from-foreign qw :cpoint-array count))))))))

(defun %crv-fit-removal-case ()
  "A curve, parameters U[0..MU] across its domain, error bounds ER and a
tolerance E for FIT-REMOVE-KNOTS: half the time a curve refined with extra
knots, which can be removed again at almost no cost."
  (let* ((c0 (random-curve :max-degree 5 :max-extra 8))
         (k0 (curve-knots c0))
         (lo (aref k0 0)) (hi (aref k0 (1- (length k0))))
         (refined (zerop (rnd 2)))
         (c (if refined
                (let ((x (sort (let (xs) (dotimes (i (1+ (rnd 6)) xs)
                                           (push (rnd-range (+ lo (* 0.01d0 (- hi lo)))
                                                            (- hi (* 0.01d0 (- hi lo))))
                                                 xs)))
                               #'<)))
                  (batten::crv-refine c0 (coerce x 'real-vector)))
                c0))
         (mu (1+ (rnd 40)))
         (u (let ((v (sort (let (xs) (dotimes (i (1+ mu) xs) (push (rnd-range lo hi) xs))) #'<)))
              (coerce v 'real-vector))))
    (setf (aref u 0) lo (aref u mu) hi)
    (when (zerop (rnd 4))                          ; parameters on knots
      (dotimes (i (rnd 5))
        (setf (aref u (1+ (rnd (max 1 (1- mu))))) (aref (curve-knots c) (rnd (length (curve-knots c))))))
      (setf u (sort u #'<)))
    (let ((er (let ((v (make-real-vector (1+ mu))))
                (dotimes (i (1+ mu) v) (setf (aref v i) (if (zerop (rnd 3)) 0d0 (rnd 0.01d0))))))
          (e (case (rnd 5)
               (0 1d-6)
               (1 (rnd 1d0))
               (2 (rnd 20d0))
               (3 (rnd 200d0))
               (t 1d30))))
      (values c u er mu e))))

(define-oracle-test fit-remove-knots (:file "crv-fit" :trials 2000)
  (multiple-value-bind (c u er mu e) (%crv-fit-removal-case)
    (agree (list :curve c :u u :er er :mu mu :e e)
           (let ((cl (%make-curve (curve-degree c) (copy-seq (curve-knots c))
                                  (%crv-fit-copy-array (curve-cpoints c))))
                 (erl (copy-seq er)))
             (batten::fit-remove-knots cl u erl mu e)
             (list cl erl))
           (with-foreign ((cp c :curve) (up u :real-vector) (ep er :real-vector))
             (let ((err (c-flag-error-p (c-fit-remove-knots cp up ep mu e))))
               (values err (list (from-foreign cp :curve) (from-foreign ep :real-vector (1+ mu)))))))))

;;; ------------------------------------------------------------- L2-g0

(defun %cf2-params (count)
  "COUNT strictly ascending parameters: [0,1] a third of the time, else a
random domain."
  (multiple-value-bind (lo hi)
      (if (zerop (rnd 3))
          (values 0d0 1d0)
          (let ((lo (- (rnd 20d0) 10d0))) (values lo (+ lo 0.5d0 (rnd 10d0)))))
    (let ((c (make-real-vector count)) (u (make-real-vector count)))
      (do ((i 1 (1+ i))) ((>= i count))
        (setf (aref c i) (+ (aref c (1- i)) 0.1d0 (rnd 1d0))))
      (dotimes (i count)
        (setf (aref u i) (if (= count 1) lo (+ lo (* (- hi lo) (/ (aref c i) (aref c (1- count))))))))
      (setf (aref u 0) lo)
      (when (> count 1) (setf (aref u (1- count)) hi))
      u)))

(defun %cf2-planar (pts)
  "PTS with z = 0, now and then (a planar data set)."
  (when (zerop (rnd 5))
    (dotimes (i (array-dimension pts 0)) (setf (aref pts i 2) 0d0)))
  pts)

(defun %cf2-data (count ptp &key rational two-d)
  "COUNT data points: a point-array for +epoint+, else a cpoint-array whose
points are all rational or all not, all 2D or all not."
  (if (= ptp +crv-fit-epoint+)
      (%cf2-planar (random-points count))
      (let ((a (make-cpoint-array count)))
        (dotimes (i count a)
          (let ((c (random-cpoint :rational rational :two-d two-d)))
            (dotimes (k 4) (setf (aref a i k) (aref c k))))))))

(defun %cf2-vector (ptp &key rational two-d)
  "A random derivative: a point for +epoint+, else a cpoint."
  (if (= ptp +crv-fit-epoint+)
      (random-point 50d0)
      (random-cpoint :rational rational :two-d two-d :scale 50d0)))

(defun %cf2-type (ptp)
  (if (= ptp +crv-fit-epoint+) :point-array :cpoint-array))

(defun %cf2-ptp ()
  (case (rnd 25) (0 3) (t (if (zerop (rnd 2)) +crv-fit-epoint+ +crv-fit-hpoint+))))

(defun %cf2-par ()
  (case (rnd 25) (0 0) (t (1+ (rnd 3)))))

(defmacro %cf2-c-curve ((cur sg) call)
  "Run CALL, a C routine filling the NULL curve CUR from stack SG; (values
error-p (list curve))."
  `(with-stacks (,sg)
     (with-foreign-out ((,cur :curve))
       (let ((err (c-flag-error-p ,call)))
         (values err (unless err (list (from-foreign ,cur :curve))))))))

(define-oracle-test fit-func-interp-given-params (:file "crv-fit" :trials 10000)
  (let* ((n (1+ (rnd 15)))
         (p (if (zerop (rnd 20)) (+ n 1 (rnd 2)) (1+ (rnd (min n 8)))))
         (u (%cf2-params (1+ n)))
         (f (random-real-vector (1+ n))))
    (agree (list :n n :p p :u u :f f)
           (list (batten::fit-func-interp-given-params f n p u))
           (with-stacks (sg)
             (with-foreign ((fp f :real-vector) (up u :real-vector))
               (with-foreign-out ((cfn :cfun))
                 (let ((err (c-flag-error-p (c-fit-func-interp-given-params fp n p up cfn sg))))
                   (values err (unless err (list (from-foreign cfn :cfun)))))))))))

(define-oracle-test fit-crv-interp (:file "crv-fit" :trials 10000)
  (let* ((n (1+ (rnd 15)))
         (p (if (zerop (rnd 20)) (+ n 1 (rnd 2)) (1+ (rnd (min n 8)))))
         (par (%cf2-par))
         (pts (%cf2-planar (random-points (1+ n)))))
    (agree (list :n n :p p :par par :pts pts)
           (list (batten::fit-crv-interp pts n p par))
           (with-foreign ((pp pts :point-array))
             (%cf2-c-curve (cur sg) (c-fit-crv-interp pp n p par cur sg))))))

(define-oracle-test fit-crv-interp-given-params (:file "crv-fit" :trials 10000)
  (let* ((n (1+ (rnd 14)))
         (p (if (and (= n 1) (zerop (rnd 3))) 2 (1+ (rnd (min n 8)))))
         (ptp (%cf2-ptp))
         (a (%cf2-data (1+ n) ptp :rational (zerop (rnd 2)) :two-d (zerop (rnd 5))))
         (u (if (and (/= ptp 3) (zerop (rnd 2)))
                (let ((v (make-real-vector (1+ n))))
                  (batten::fit-calc-crv-param-values a n ptp (1+ (rnd 3)) v))
                (%cf2-params (1+ n))))
         (knt (case (rnd 12)
                (0 (random-knots p (+ n 2) :lo (aref u 0) :hi (aref u n))) ; one knot too many
                ((1 2) (random-knots p (1+ n) :lo (aref u 0) :hi (aref u n)))
                (t (batten::fit-crv-calc-knot-vector u n p (make-real-vector (+ n p 2)))))))
    (agree (list :n n :p p :ptp ptp :u u :knt knt)
           (list (batten::fit-crv-interp-given-params a n ptp u knt p))
           (with-foreign ((ap a (%cf2-type ptp)) (up u :real-vector) (kp knt :knots))
             (%cf2-c-curve (cur sg) (c-fit-crv-interp-given-params ap n ptp up kp p cur sg))))))

(define-oracle-test fit-crv-knots-and-derivs (:file "crv-fit" :trials 10000)
  (let* ((kk (1+ (rnd 12)))
         (p (case (rnd 20) (0 1) (1 (+ kk 3)) (t (+ 2 (rnd (min 6 (1+ kk)))))))
         (ptp (%cf2-ptp))
         (rational (zerop (rnd 2))) (two-d (zerop (rnd 5)))
         (a (%cf2-data (1+ kk) ptp :rational rational :two-d two-d))
         (as (%cf2-vector ptp :rational rational :two-d two-d))
         (ae (%cf2-vector ptp :rational rational :two-d two-d))
         (u (%cf2-params (1+ kk)))
         (knt (cond ((zerop (rnd 15)) (random-knots (max p 1) (+ kk 4) :lo (aref u 0) :hi (aref u kk)))
                    ((< p 2) (make-real-vector (+ kk p 4)))
                    (t (batten::fit-calc-knot-vector-end-derivs u kk p (make-real-vector (+ kk p 4))))))
         (vt (if (= ptp +crv-fit-epoint+) :point :cpoint)))
    (agree (list :kk kk :p p :ptp ptp :u u :knt knt :as as :ae ae)
           (list (batten::fit-crv-knots-and-derivs a kk ptp u knt p as ae))
           (with-foreign ((ap a (%cf2-type ptp)) (up u :real-vector) (kp knt :knots)
                          (sp as vt) (ep ae vt))
             (%cf2-c-curve (cur sg) (c-fit-crv-knots-and-derivs ap kk ptp up kp p sp ep cur sg))))))

(define-oracle-test fit-crv-knots-and-deriv (:file "crv-fit" :trials 10000)
  (let* ((kk (1+ (rnd 12)))
         (p (case (rnd 20) (0 1) (1 (+ kk 2)) (t (+ 2 (rnd (min 6 kk))))))
         (ptp (%cf2-ptp))
         (whr (case (rnd 25) (0 0) (t (if (zerop (rnd 2)) +crv-fit-start+ +crv-fit-end+))))
         (rational (zerop (rnd 2))) (two-d (zerop (rnd 5)))
         (a (%cf2-data (1+ kk) ptp :rational rational :two-d two-d))
         (tv (%cf2-vector ptp :rational rational :two-d two-d))
         (u (%cf2-params (1+ kk)))
         (knt (cond ((zerop (rnd 15)) (random-knots (max p 1) (+ kk 3) :lo (aref u 0) :hi (aref u kk)))
                    ((or (< p 2) (> p (1+ kk))) (make-real-vector (+ kk p 3)))
                    (t (batten::fit-calc-knot-vector-deriv u kk p (if (= whr 0) +crv-fit-start+ whr)
                                                           (make-real-vector (+ kk p 3))))))
         (vt (if (= ptp +crv-fit-epoint+) :point :cpoint)))
    (agree (list :kk kk :p p :ptp ptp :whr whr :u u :knt knt :tv tv)
           (list (batten::fit-crv-knots-and-deriv a kk ptp u knt p tv whr))
           (with-foreign ((ap a (%cf2-type ptp)) (up u :real-vector) (kp knt :knots) (tp tv vt))
             (%cf2-c-curve (cur sg) (c-fit-crv-knots-and-deriv ap kk ptp up kp p tp whr cur sg))))))

(define-oracle-test fit-crv-approx-knots (:file "crv-fit" :trials 10000)
  (let* ((m (+ 2 (rnd 40)))
         (n (if (zerop (rnd 15)) 1 (+ 2 (rnd (1- m)))))
         (p (if (= n 1) (1+ (rnd 2)) (if (zerop (rnd 20)) (1+ n) (1+ (rnd (min n 6))))))
         (ptp (%cf2-ptp))
         (a (%cf2-data (1+ m) ptp :rational (zerop (rnd 2)) :two-d (zerop (rnd 5))))
         (u (if (and (/= ptp 3) (zerop (rnd 2)))
                (batten::fit-calc-crv-param-values a m ptp (1+ (rnd 3)) (make-real-vector (1+ m)))
                (%cf2-params (1+ m))))
         (knt (let ((k (batten::fit-calc-knot-vector-crv-approx u m n p (make-real-vector (+ n p 2)))))
                (if (zerop (rnd 15))         ; a knot too many
                    (concatenate 'real-vector k (vector (aref k (1- (length k)))))
                    k))))
    (agree (list :m m :n n :p p :ptp ptp :u u :knt knt)
           (list (batten::fit-crv-approx-knots a m ptp u knt n p))
           (with-foreign ((ap a (%cf2-type ptp)) (up u :real-vector) (kp knt :knots))
             (%cf2-c-curve (cur sg) (c-fit-crv-approx-knots ap m ptp up kp n p cur sg))))))

(define-oracle-test fit-crv-first-deriv (:file "crv-fit" :trials 10000)
  (let* ((kk (if (zerop (rnd 25)) 0 (1+ (rnd 12))))
         (p (case (rnd 25) (0 1) (1 4) (t (+ 2 (rnd 2)))))
         (vec (if (zerop (rnd 2)) +tangent+ +derivative+))
         (par (%cf2-par))
         (pts (%cf2-planar (random-points (1+ kk))))
         (d (let ((v (random-points (1+ kk) 50d0)))
              (when (zerop (rnd 30))              ; a zero tangent
                (let ((i (rnd (1+ kk))))
                  (dotimes (k 3) (setf (aref v i k) 0d0))))
              v)))
    (agree (list :kk kk :p p :vec vec :par par :pts pts :d d)
           (let ((dl (%crv-fit-copy-array d)))
             (list (batten::fit-crv-first-deriv pts dl kk p vec par) dl))
           (with-foreign ((pp pts :point-array) (dp d :point-array))
             (with-stacks (sg)
               (with-foreign-out ((cur :curve))
                 (let ((err (c-flag-error-p (c-fit-crv-first-deriv pp dp kk p vec par cur sg))))
                   (values err (unless err (list (from-foreign cur :curve)
                                                 (from-foreign dp :point-array (1+ kk))))))))))))

(define-oracle-test fit-crv-first-deriv-and-knots (:file "crv-fit" :trials 10000)
