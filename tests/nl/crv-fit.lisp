(define-oracle-test fit-crv-approx (:file "crv-fit" :trials 1500)
  (let* ((m (+ 3 (rnd 25)))
         (closed (zerop (rnd 3)))
         (pts (case (rnd 4)
                (0 (let ((p (%cf2-planar (random-points (1+ m)))))
                     (when closed (dotimes (j 3) (setf (aref p m j) (aref p 0 j))))
                     p))
                (t (%cf3-smooth-points (1+ m) :closed closed))))
         (cld (if (zerop (rnd 4)) batten::+no+ batten::+yes+))
         (ps (case (rnd 12)
               (0 0)
               (1 1)
               (t (if (and closed (= cld batten::+yes+)) (+ 2 (rnd 2)) (1+ (rnd 3))))))
         (pr (case (rnd 15) (0 (1- ps)) (1 (+ m 1)) (t (min m (+ (max ps 1) (rnd 3))))))
         (ext (batten::pts-1d-get-max-extent pts m))
         (e (* ext (case (rnd 6) (0 1d-5) (1 1d-3) (2 1d-2) (3 0.05d0) (4 0.3d0) (t 1d30))))
         (ktp (if (zerop (rnd 2)) batten::+single+ batten::+multiple+)))
    (when (< ps 1) (setf ps 1 pr (max pr 1)))
    (agree (list :m m :cld cld :ps ps :pr pr :e e :ktp ktp :pts pts)
           (list (batten::fit-crv-approx pts m cld ps pr e ktp))
           (with-foreign ((pp pts :point-array))
             (%cf2-c-curve (cur sg) (c-fit-crv-approx pp m cld ps pr e ktp cur sg))))))

(define-oracle-test fit-crv-knots-and-tangents (:file "crv-fit" :trials 6000)
  (let* ((k (+ 2 (rnd 12)))
         (tan (rnd 4))                  ; 0 none, 1 start, 2 end, 3 both
         (n (case tan (0 k) ((1 2) (1+ k)) (t (+ k 2))))
         (p (if (zerop (rnd 25)) 1 (+ 2 (rnd (max 1 (min 5 (1- n)))))))
         (pts (%cf2-planar (random-points (1+ k))))
         (u (when (zerop (rnd 2)) (%cf2-params (1+ k))))
         (lo (if u (aref u 0) (- (rnd 20d0) 10d0)))
         (hi (if u (aref u k) (+ lo 0.5d0 (rnd 10d0))))
         (knt nil)
         (der (if (zerop (rnd 2)) batten::+tangent+ batten::+derivative+))
         (ts (when (member tan '(1 3)) (random-point 50d0)))
         (te (when (member tan '(2 3)) (random-point 50d0)))
         (per (case (rnd 12) (0 1d0) (1 0d0) (2 (if (zerop (rnd 2)) -0.1d0 1.5d0)) (t (rnd 1d0)))))
    (setf knt (if (zerop (rnd 4))
                  nil
                  (let* ((q (1+ (rnd 4)))
                         (kv (random-knots q (+ q 1 (rnd 25)) :lo lo :hi hi)))
                    (when (and u (zerop (rnd 15)))     ; not spanning u
                      (setf (aref kv 0) (- lo 1d0)))
                    kv)))
    (let ((lts (and ts (copy-seq ts))) (lte (and te (copy-seq te))))
      (agree (list :k k :tan tan :p p :u u :knt knt :der der :ts ts :te te :per per :pts pts)
             (multiple-value-bind (cur kv)
                 (batten::fit-crv-knots-and-tangents pts k u lts lte der knt per p)
               (list cur kv lts lte))
             ;; absent inputs get dummy foreign copies and are passed as NULL
             (with-foreign ((pp pts :point-array)
                            (uf (or u (make-real-vector 1)) :real-vector)
                            (tsf (or ts (make-point)) :point)
                            (tef (or te (make-point)) :point)
                            (kf (or knt (make-real-vector 2)) :knots))
               (let ((up (if u uf (cffi:null-pointer)))
                     (tsp (if ts tsf (cffi:null-pointer)))
                     (tep (if te tef (cffi:null-pointer))))
                 (with-stacks (sc)
                   (with-stacks (sk)
                     (with-scalars ((kc :pointer))
                       (when knt
                         (setf (cffi:mem-ref kc :pointer) kf))
                       (with-foreign-out ((cur :curve))
                         (let ((err (c-flag-error-p
                                     (c-fit-crv-knots-and-tangents pp k up tsp tep der kc per p cur sc sk))))
                           (values err
                                   (unless err
                                     (list (from-foreign cur :curve)
                                           (from-foreign (cffi:mem-ref kc :pointer) :knots)
                                           (and ts (from-foreign tsp :point))
                                           (and te (from-foreign tep :point))))))))))))))))

(define-oracle-test fit-crv-approx-closed-conditions (:file "crv-fit" :trials 6000)
  (let* ((n (+ 3 (rnd 14)))
         (p (1+ (rnd 5)))
         (k (rnd (min p 5)))
         (par (case (rnd 25) (0 0) (t (1+ (rnd 3)))))
         (pts (if (zerop (rnd 2))
                  (%cf3-smooth-points (1+ n) :closed (zerop (rnd 5)))
                  (let ((q (%cf2-planar (random-points (1+ n)))))
                    (unless (zerop (rnd 5)) (dotimes (j 3) (setf (aref q n j) (aref q 0 j))))
                    q)))
         (nm (truncate n 2))
         (nl (+ (- n (max nm (- n p 1))) (min nm (1+ p))))
         ;; local interpolation needs p <= nl; else pass the derivatives in
         (d (when (or (> p nl) (zerop (rnd 3))) (random-points (1+ k) 50d0))))
    (agree (list :n n :p p :k k :par par :pts pts :d d)
           (list (batten::fit-crv-approx-closed-conditions pts n p d k par))
           (with-foreign ((pp pts :point-array) (df (or d (make-point-array 1)) :point-array))
             (let ((dp (if d df (cffi:null-pointer))))
               (%cf2-c-curve (cur sg) (c-fit-crv-approx-closed-conditions pp n p dp k par cur sg)))))))

(define-oracle-test fit-crv-pts-normals (:file "crv-fit" :trials 6000)
  (let* ((kk (1+ (rnd 12)))
         (p (+ 2 (rnd 2)))
         ;; the C projects interior points with an absolute tolerance of 1e-4,
