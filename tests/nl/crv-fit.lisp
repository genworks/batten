;;; ------------------------------------------------------------- L3-g2

(defun %cf3-end-vector (kk)
  "An end derivative: now and then the zero vector (to be estimated by the C
from four data points, so only when KK >= 3)."
  (if (and (>= kk 3) (zerop (rnd 4)))
      (make-point 0d0 0d0 0d0)
      (random-point 50d0)))

(defun %cf3-smooth-points (count &key closed)
  "COUNT points sampled from a smooth space curve at increasing parameters;
with CLOSED a closed loop whose last point is exactly the first."
  (let* ((pts (make-point-array count))
         (a (+ 1d0 (rnd 20d0))) (b (+ 1d0 (rnd 20d0))) (c (+ 0.5d0 (rnd 3d0))) (h (- (rnd 10d0) 5d0))
         (t1 (if closed (* 2 pi) (+ 1d0 (rnd 6d0))))
         (ts (let ((v (make-real-vector count)))
               (dotimes (i count v)
                 (setf (aref v i) (* t1 (/ (+ i (if (or (= i 0) (= i (1- count))) 0d0 (- (rnd 0.6d0) 0.3d0)))
                                           (1- count))))))))
    (dotimes (i count)
      (let ((tt (aref ts i)))
        (setf (aref pts i 0) (* a (cos tt))
              (aref pts i 1) (* b (sin (if closed tt (* c tt))))
              (aref pts i 2) (if closed (* h (sin (* 2 tt))) (* h tt)))))
    (when closed
      (dotimes (j 3) (setf (aref pts (1- count) j) (aref pts 0 j))))
    pts))

(define-oracle-test fit-crv-derivs (:file "crv-fit" :trials 6000)
  (let* ((kk (1+ (rnd 12)))
         (p (case (rnd 20) (0 1) (1 (+ kk 3)) (t (+ 2 (rnd (min 6 (1+ kk)))))))
         (par (case (rnd 10) (0 batten::+inherited+) (t (%cf2-par))))
         (pts (%cf2-planar (random-points (1+ kk))))
         (ds (%cf3-end-vector kk))
         (de (%cf3-end-vector kk))
         ;; a caller-sized output curve: always for +inherited+, now and then otherwise
         (presized (or (= par batten::+inherited+) (zerop (rnd 6))))
         (knots (when (and presized (<= 1 p (+ kk 2)))
                  (if (zerop (rnd 3))
                      (random-knots p (+ kk 3))
                      ;; knots a caller would inherit: averaged from parameters
                      (batten::fit-calc-knot-vector-end-derivs
                       (batten::fit-calc-crv-param-values pts kk batten::+epoint+ (1+ (rnd 3))
                                                          (make-real-vector (1+ kk)))
                       kk p (make-real-vector (+ kk p 4)))))))
    (agree (list :kk kk :p p :par par :pts pts :ds ds :de de :knots knots)
           (list (batten::fit-crv-derivs pts kk p ds de par knots) ds de)
           (with-foreign ((pp pts :point-array) (dsp ds :point) (dep de :point))
             (if knots
                 (with-stacks (sg)
                   (with-foreign ((cur (%make-curve p knots (make-cpoint-array (+ kk 3))) :curve))
                     (let ((err (c-flag-error-p (c-fit-crv-derivs pp kk p dsp dep par cur sg))))
                       (values err (unless err (list (from-foreign cur :curve)
                                                     (from-foreign dsp :point) (from-foreign dep :point)))))))
                 (with-stacks (sg)
                   (with-foreign-out ((cur :curve))
                     (let ((err (c-flag-error-p (c-fit-crv-derivs pp kk p dsp dep par cur sg))))
                       (values err (unless err (list (from-foreign cur :curve)
                                                     (from-foreign dsp :point) (from-foreign dep :point))))))))))))

(define-oracle-test fit-cubic-spline-interp (:file "crv-fit" :trials 6000)
