;;;;
;;;; Tests of the API in src/api/geometry.lisp: each function against the C routines
;;;; it wraps (or the port routines, where the C has no single counterpart).
;;;;
;;;; The inputs come from the generators of tests/nl/geom.lisp (some-vector,
;;;; %line-pair, %perp-to, %pt+), tests/nl/funcs-basic.lisp (%fb-parameter) and
;;;; tests/nl/funcs-adv.lisp (%fa-product-pair, %fa-partner-knots), which load
;;;; first.  The API takes any sequence of reals, so each point or vector is
;;;; handed to it as a Batten point, a list or a general vector, of doubles or
;;;; of the rationals equal to them (%AG-LOOSE); the C gets the doubles.

(in-package :batten-tests)

(defun %ag-loose (seq)
  "SEQ, a sequence of doubles, as the API might be given it: itself, a list or
a simple-vector, of the doubles or of the rationals equal to them."
  (let ((reals (if (zerop (rnd 3)) (map 'list #'rational seq) (coerce seq 'list))))
    (case (rnd 3)
      (0 seq)
      (1 reals)
      (t (coerce reals 'simple-vector)))))

(defun %ag-lineseg (point direction bounded)
  "A port line for the C side of a test."
  (batten::%make-lineseg point direction (if bounded +bounded+ +unbounded+)))

(defmacro %ag-unchanged ((&rest vars) &body body)
  "BODY's value consed onto T when each of VARS is still SAME as a copy taken
before BODY ran (else NIL): the API's purity, checked alongside its result."
  (let ((copies (mapcar (lambda (v) (declare (ignore v)) (gensym)) vars))
        (result (gensym "RESULT")))
    `(let ,(mapcar (lambda (c v) `(,c (%ag-copy ,v))) copies vars)
       (let ((,result (progn ,@body)))
         (list ,result (and ,@(mapcar (lambda (c v) `(values (same ,c ,v))) copies vars)))))))

(defun %ag-copy (x)
  "A copy of X, a sequence, cfun or sfun, sharing nothing with it."
  (etypecase x
    (cfun (%make-cfun (cfun-degree x) (copy-seq (cfun-knots x)) (copy-seq (cfun-vals x))))
    (sfun (%make-sfun (sfun-degree-u x) (sfun-degree-v x) (copy-seq (sfun-knots-u x))
                      (copy-seq (sfun-knots-v x)) (%ag-copy-matrix (sfun-vals x))))
    (sequence (copy-seq x))))

(defun %ag-copy-matrix (m)
  (let ((c (make-real-matrix (array-dimension m 0) (array-dimension m 1))))
    (dotimes (k (array-total-size m) c)
      (setf (row-major-aref c k) (row-major-aref m k)))))

;;; ------------------------------------------------------- points and vectors

(define-oracle-test api-distance (:file "api-geometry" :trials 1000)
  (let ((p (random-point)) (q (if (zerop (rnd 8)) (make-point) (random-point))))
    (agree (list p q)
           (%ag-unchanged (p q) (batten::distance(%ag-loose p) (%ag-loose q)))
           (with-foreign ((pp p :point) (qp q :point))
             (with-scalars ((d :double))
               (c-dist-pt-pt pp qp d)
               (values nil (list (cffi:mem-ref d :double) t)))))))

(define-oracle-test api-dot (:file "api-geometry" :trials 1000)
  (let ((a (some-vector)) (b (some-vector)))
    (agree (list a b)
           (%ag-unchanged (a b) (batten::dot(%ag-loose a) (%ag-loose b)))
           (with-foreign ((ap a :point) (bp b :point))
             (with-scalars ((d :double))
               (c-vector-dot ap bp d)
               (values nil (list (cffi:mem-ref d :double) t)))))))

(define-oracle-test api-cross (:file "api-geometry" :trials 1000)
  (let ((a (some-vector)) (b (some-vector)))
    (agree (list a b)
           (%ag-unchanged (a b)
             (let ((c (batten::cross(%ag-loose a) (%ag-loose b))))
               (assert (and (not (eq c a)) (not (eq c b))))
               c))
           (with-foreign ((ap a :point) (bp b :point))
             (with-foreign-out ((c :point))
               (c-vector-cross ap bp c)
               (values nil (list (from-foreign c :point) t)))))))

(define-oracle-test api-normalize (:file "api-geometry" :trials 1000)
  (let ((a (some-vector)))
    (agree a
           (%ag-unchanged (a) (multiple-value-list (batten::normalize(%ag-loose a))))
           (with-foreign ((ap a :point))
             (with-foreign-out ((b :point))
               (with-scalars ((mag :double))
                 (values (c-flag-error-p (c-vector-normalize ap b mag))
                         (list (list (from-foreign b :point) (cffi:mem-ref mag :double)) t))))))))

(define-oracle-test api-angle-between (:file "api-geometry" :trials 1000)
  (let* ((a (some-vector))
         (b (case (rnd 6)
              (0 (batten::vector-scale a (rnd-range 0.1d0 10d0) (make-point)))
              (1 (batten::vector-scale a (rnd-range -10d0 -0.1d0) (make-point)))
              (2 (%perp-to a))
              (t (some-vector)))))
    (agree (list a b)
           (%ag-unchanged (a b) (batten::angle-between(%ag-loose a) (%ag-loose b)))
           (with-foreign ((ap a :point) (bp b :point))
             (with-scalars ((alf :double))
               (values (c-flag-error-p (c-vectors-angle ap bp alf))
                       (list (cffi:mem-ref alf :double) t)))))))

(define-oracle-test api-project-point-to-line (:file "api-geometry" :trials 1000)
  (let* ((q (random-point)) (v (some-vector)) (bounded (zerop (rnd 2)))
         (p (case (rnd 6)
              (0 (copy-seq q))
              (1 (%pt+ q 1d0 v))
              (2 (%pt+ (%pt+ q (rnd-range 0d0 1d0) v) 1d0 (%perp-to v)))
              (3 (%pt+ (%pt+ q (rnd-range -2d0 3d0) v) 1d0 (%perp-to v)))
              (t (random-point)))))
    (agree (list :point p :line-point q :direction v :bounded bounded)
           (%ag-unchanged (p q v)
             (multiple-value-list
              (if bounded
                  (batten::project-point-to-line (%ag-loose p) (%ag-loose q) (%ag-loose v) :bounded t)
                  (batten::project-point-to-line(%ag-loose p) (%ag-loose q) (%ag-loose v)))))
           (with-foreign ((pp p :point))
             (with-foreign-out ((lp :lineseg) (qq :point))
               (%fill-foreign-lineseg lp (%ag-lineseg q v bounded))
               (with-scalars ((tt :double) (flg :short))
                 (values (c-flag-error-p (c-project-pt-line lp pp qq tt flg))
                         (list (if (= (cffi:mem-ref flg :short) +true+)
                                   (list (from-foreign qq :point) (cffi:mem-ref tt :double))
                                   (list nil))
                               t))))))))

(define-oracle-test api-project-point-to-plane (:file "api-geometry" :trials 1000)
  (let* ((r (random-point)) (n (some-vector))
         (p (case (rnd 5)
              (0 (copy-seq r))
              (1 (%pt+ r 1d0 (%perp-to n)))
              (2 (%pt+ r (rnd-range -5d0 5d0) n))
              (t (random-point)))))
    (agree (list :point p :plane-point r :normal n)
           (%ag-unchanged (p r n) (batten::project-point-to-plane(%ag-loose p) (%ag-loose r) (%ag-loose n)))
           (with-foreign ((pp p :point))
             (with-foreign-out ((pl :plane) (qq :point))
               (%fill-foreign-plane pl (batten::%make-plane r n))
               (values (c-flag-error-p (c-project-pt-plane pl pp qq))
                       (list (from-foreign qq :point) t)))))))

(define-oracle-test api-intersect-lines (:file "api-geometry" :trials 1000)
  (multiple-value-bind (l1 l2) (%line-pair)
    (let ((p1 (batten::lineseg-p l1)) (v1 (batten::lineseg-v l1))
          (b1 (= (batten::lineseg-bounded l1) +bounded+))
          (p2 (batten::lineseg-p l2)) (v2 (batten::lineseg-v l2))
          (b2 (= (batten::lineseg-bounded l2) +bounded+)))
      (agree (list l1 l2)
             (%ag-unchanged (p1 v1 p2 v2)
               (multiple-value-list
                (batten::intersect-lines (%ag-loose p1) (%ag-loose v1) (%ag-loose p2) (%ag-loose v2)
                                 :bounded1 b1 :bounded2 b2)))
             (with-foreign-out ((lp1 :lineseg) (lp2 :lineseg) (p :point))
               (%fill-foreign-lineseg lp1 l1)
               (%fill-foreign-lineseg lp2 l2)
               (with-scalars ((t1 :double) (t2 :double) (flg :short))
                 (values (c-flag-error-p (c-isect-line-line lp1 lp2 p t1 t2 flg))
                         (list (if (= (cffi:mem-ref flg :short) +true+)
                                   (list (from-foreign p :point) (cffi:mem-ref t1 :double)
                                         (cffi:mem-ref t2 :double))
                                   (list nil))
                               t))))))))

(define-oracle-test api-intersect-line-plane (:file "api-geometry" :trials 1000)
  (let* ((q (random-point)) (v (some-vector)) (bounded (zerop (rnd 2)))
         (n (case (rnd 6)
              (0 (%perp-to v))          ; parallel
              (1 (batten::vector-scale v (rnd-range -3d0 3d0) (make-point)))
              (t (some-vector))))
         (r (if (zerop (rnd 4))
                (%pt+ q (case (rnd 3) (0 0d0) (1 1d0) (t (rnd-range -0.5d0 1.5d0))) v)
                (random-point))))
    (agree (list :line-point q :direction v :bounded bounded :plane-point r :normal n)
           (%ag-unchanged (q v r n)
             (multiple-value-list
              (batten::intersect-line-plane (%ag-loose q) (%ag-loose v) (%ag-loose r) (%ag-loose n)
                                    :bounded bounded)))
           (with-foreign-out ((lp :lineseg) (pl :plane) (p :point))
             (%fill-foreign-lineseg lp (%ag-lineseg q v bounded))
             (%fill-foreign-plane pl (batten::%make-plane r n))
             (with-scalars ((tt :double) (flg :short))
               (values (c-flag-error-p (c-isect-line-plane lp pl p tt flg))
                       (list (if (= (cffi:mem-ref flg :short) +true+)
                                 (list (from-foreign p :point) (cffi:mem-ref tt :double))
                                 (list nil))
                             t)))))))

(define-oracle-test api-intersect-planes (:file "api-geometry" :trials 1000)
  (let* ((n1 (some-vector))
         (n2 (case (rnd 6)
               (0 (batten::vector-scale n1 (rnd-range -3d0 3d0) (make-point)))  ; parallel
               (1 (%pt+ n1 1d-7 (random-point 1d0)))                           ; nearly
               (2 (%perp-to n1))
               (t (some-vector))))
         (p1 (random-point))
         (p2 (if (zerop (rnd 5)) (copy-seq p1) (random-point))))
    (agree (list :point1 p1 :normal1 n1 :point2 p2 :normal2 n2)
           (%ag-unchanged (p1 n1 p2 n2)
             (multiple-value-list
              (batten::intersect-planes (%ag-loose p1) (%ag-loose n1) (%ag-loose p2) (%ag-loose n2))))
           (with-foreign-out ((pp1 :plane) (pp2 :plane) (p :point) (v :point))
             (%fill-foreign-plane pp1 (batten::%make-plane p1 n1))
             (%fill-foreign-plane pp2 (batten::%make-plane p2 n2))
             (with-scalars ((flg :short))
               (values (c-flag-error-p (c-isect-plane-plane pp1 pp2 p v flg))
                       (list (if (= (cffi:mem-ref flg :short) +true+)
                                 (list (from-foreign p :point) (from-foreign v :point))
                                 (list nil))
                             t)))))))

;;; ------------------------------------------------------ scalar B-spline functions

(define-oracle-test api-make-cfun (:file "api-geometry" :trials 500)
  (let* ((f (random-cfun))
         (fu (cfun-vals f)) (u (cfun-knots f)) (p (cfun-degree f)))
    (agree (list :cfun f)
           (%ag-unchanged (fu u)
             (let ((g (batten::make-cfun p(%ag-loose u) (%ag-loose fu))))
               (assert (and (not (eq (cfun-vals g) fu)) (not (eq (cfun-knots g) u))))
               g))
           (with-stacks (s)
             (with-foreign ((ffu fu :real-vector) (fuk u :real-vector))
               (with-foreign-out ((g :cfun))
                 (let ((rc (c-c-func-from-knots g ffu (1- (length fu)) p fuk (1- (length u)) s)))
                   (values (c-flag-error-p rc) (list (from-foreign g :cfun) t)))))))))

(define-oracle-test api-cfun-value (:file "api-geometry" :trials 1000)
  (let* ((f (random-cfun)) (u (%fb-parameter (cfun-knots f))) (side (if (zerop (rnd 2)) :left :right)))
    (agree (list :cfun f :u u :side side)
           (%ag-unchanged (f) (batten::cfun-value f (if (zerop (rnd 3)) (rational u) u) :side side))
           (with-foreign ((fp f :cfun))
             (with-scalars ((fv :double))
               (let ((rc (c-c-func-eval fp u (if (eq side :left) +left+ +right+) fv)))
                 (values (c-flag-error-p rc)
                         (unless (c-flag-error-p rc) (list (cffi:mem-ref fv :double) t)))))))))

(define-oracle-test api-cfun-derivatives (:file "api-geometry" :trials 1000)
  (let* ((f (random-cfun)) (u (%fb-parameter (cfun-knots f))) (side (if (zerop (rnd 2)) :left :right))
         (der (rnd (+ (cfun-degree f) 3))))
    (agree (list :cfun f :u u :side side :der der)
           (%ag-unchanged (f) (batten::cfun-derivatives f u der :side side))
           (with-foreign ((fp f :cfun))
             (with-foreign-out ((fd :real-vector (1+ der)))
               (let ((rc (c-c-func-derivs fp u (if (eq side :left) +left+ +right+) der fd)))
                 (values (c-flag-error-p rc)
                         (unless (c-flag-error-p rc)
                           (list (from-foreign fd :real-vector (1+ der)) t)))))))))

(define-oracle-test api-cfun-derivative (:file "api-geometry" :trials 1000)
  (let* ((f (random-cfun))
         (p (cfun-degree f))
         (d (case (rnd 20) (0 -1) (1 (1+ p)) (t (rnd (1+ p))))))
    (agree (list :cfun f :order d)
           (%ag-unchanged (f) (if (= d 1) (batten::cfun-derivative f) (batten::cfun-derivative f :order d)))
           (with-foreign ((fp f :cfun))
             (with-stacks (sg)
               (with-foreign-out ((der :cfun))
                 (if (c-flag-error-p (c-crv-func-deriv fp d der sg))
                     (values t nil)
                     (values nil (list (from-foreign der :cfun) t)))))))))

(define-oracle-test api-cfun* (:file "api-geometry" :trials 1000)
  (multiple-value-bind (f g) (%fa-product-pair)
    (agree (list :f f :g g)
           (%ag-unchanged (f g) (batten::cfun* f g))
           (with-foreign ((fp f :cfun) (gp g :cfun))
             (with-stacks (sh)
               (with-foreign-out ((hp :cfun))
                 (if (c-flag-error-p (c-crv-func-multiply-crv-func fp gp hp sh))
                     (values t nil)
                     (values nil (list (from-foreign hp :cfun) t)))))))))

(defun %ag-sum-pair ()
  "Two curve functions to add: random degrees, the second's knots of the kinds
%FA-PARTNER-KNOTS makes (now and then the first's own)."
  (let ((f (random-cfun)))
    (if (zerop (rnd 4))
        (values f (%make-cfun (cfun-degree f) (copy-seq (cfun-knots f))
                              (random-real-vector (length (cfun-vals f)))))
        (let ((qd (1+ (rnd 7))))
          (multiple-value-bind (k n+1) (%fa-partner-knots (cfun-knots f) (cfun-degree f) qd)
            (values f (%make-cfun qd k (random-real-vector n+1))))))))

(defmacro %ag-sum-test (name api-fn opr)
  `(define-oracle-test ,name (:file "api-geometry" :trials 1000)
     (multiple-value-bind (f g) (%ag-sum-pair)
       (agree (list :f f :g g)
              (%ag-unchanged (f g) (,api-fn f g))
              (with-foreign ((fp f :cfun) (gp g :cfun))
                (with-stacks (sg)
                  (with-foreign-out ((rp :cfun))
                    (if (c-flag-error-p (c-crv-func-sum-diff-crv-func fp gp ,opr +no+ rp sg))
                        (values t nil)
                        (values nil (list (from-foreign rp :cfun) t))))))))))

(%ag-sum-test api-cfun+ batten::cfun+ +plus+)
(%ag-sum-test api-cfun- batten::cfun- +minus+)

(define-oracle-test api-make-sfun (:file "api-geometry" :trials 500)
  (let* ((f (random-sfun))
         (vals (sfun-vals f))
         (rows (if (zerop (rnd 2))
                   vals
                   (let (rs)
                     (dotimes (i (array-dimension vals 0) (nreverse rs))
                       (let (row)
                         (dotimes (j (array-dimension vals 1))
                           (push (aref vals i j) row))
                         (push (%ag-loose (coerce (nreverse row) 'real-vector)) rs)))))))
    (agree (list :sfun f)
           (%ag-unchanged (f)
             (let ((g (batten::make-sfun(sfun-degree-u f) (sfun-degree-v f)
                                 (%ag-loose (sfun-knots-u f)) (%ag-loose (sfun-knots-v f)) rows)))
               (assert (not (eq (sfun-vals g) vals)))
               g))
           (with-foreign ((fp f :sfun))
             (with-foreign-out ((g :sfun))
               (c-s-func-from-knot-vectors g (%fb-slot fp nl-sfun svl) (sfun-degree-u f) (sfun-degree-v f)
                                           (%fb-slot fp nl-sfun knu) (%fb-slot fp nl-sfun knv))
               (values nil (list (from-foreign g :sfun) t)))))))
